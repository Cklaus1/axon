# Axon LLM provider config — copy to `.env` and fill in.
# axon-ai loads the nearest `.env` (walking up from the cwd) on first AI use.
# A var already set in your shell is NOT overwritten by this file.
# Keep your real `.env` out of git (it's .gitignore'd).

# ── Anthropic (default) ──────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Anthropic-compatible gateway / proxy (e.g. a trainloop gateway) ──────────
# Repoint the base URL; the gateway must speak Anthropic's /v1/messages shape.
# ANTHROPIC_BASE_URL=https://your-gateway.internal
# ANTHROPIC_API_KEY=...

# ── OpenAI-compatible backend (NVIDIA NIM, OpenRouter, vLLM, LiteLLM, …) ──────
# AXON_AI_PROVIDER=openai
# AXON_AI_BASE_URL=https://integrate.api.nvidia.com
# AXON_AI_API_KEY=nvapi-...
# AXON_AI_MODEL_BALANCED=meta/llama-3.1-70b-instruct
# AXON_AI_MODEL_CHEAP=meta/llama-3.1-8b-instruct
# AXON_AI_MODEL_STRONG=meta/llama-3.1-405b-instruct
