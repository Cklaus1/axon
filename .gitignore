/target/
Cargo.lock
*.o
*.a
*.so
*.dylib

# Compiled axon binaries (from axon build)
axon_out_*
/tmp/axon_*
# `axon build` flagship output + its manifest
/agent_task
/agent_task.axmeta
# Compiled Rust library archives left in tree by build scripts
*.rlib
# Guest VM build outputs (initramfs.cpio + vmlinuz)
/dist/

# R14 mobile build outputs (`axon target build --host mobile` → out/ios/, out/android/)
/out/

# Phase-10 AST approval markers (generated by `axon ast approve`)
*.ax.approved

# Scratch / archived probe files (created during dev; rm was sandbox-denied so
# they were moved here instead)
/.archive/
tmp_*

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code per-session state (worktrees, locks)
.claude/

# Local LLM credentials / provider config (axon-ai reads .env for API keys)
.env
.env.*
!.env.example
examples/jobs/out/
