// R51 S0b (§8 T9): a test that returns `Err` FAILS (veto kept it `ok`), as
// does one whose callee's `break`/`continue` unwound it; an `Ok` return
// passes. The same verdicts on every engine (`scripts/vm_parity.sh`'s test
// leg).
fn stop(n: i64) -> i64 {
    if n > 2 { break }
    n
}

@[test]
fn t_err() -> Result<i64, str> { Err("no") }

@[test]
fn t_ok() -> Result<i64, str> { Ok(1) }

@[test]
fn t_loop() {
    let i = 0
    while i < 5 {
        assert_eq(stop(i + 1), i + 1)
        i = i + 1
    }
}

@[test]
fn t_closure() {
    let g = |n: i64| { if n > 1 { continue }  n }
    for i in 0..4 {
        assert_eq(g(i), i)
    }
}
