// Layer-2 ASI: Uncertain<f64> arithmetic and comparison propagation.
// Mirrors uncertain_propagation.ax for the f64 monomorphisation.
fn main() {
    let a = uncertain_new_f64(2.5, 0.9)
    let b = a + 1.5                            // val=4.0, conf=0.9
    let c = a + uncertain_new_f64(0.5, 0.7)    // val=3.0, conf=0.7
    let d = a * 2.0                            // val=5.0, conf=0.9
    let e = a < uncertain_new_f64(3.0, 0.8)    // Uncertain<bool>, val=true, conf=0.8
    if b.confidence > 0.85 { println(to_str_f64(b.value)) }
    if c.confidence > 0.6  { println(to_str_f64(c.value)) }
    if d.confidence > 0.85 { println(to_str_f64(d.value)) }
    if e.value && e.confidence > 0.7 { println("less") }
}
