// verify_pass.ax
// @[verify(confidence >= 0.8)] is satisfied: the body returns
// uncertain_new(_, 0.9) which has confidence 0.9 >= 0.8.
// Expected: no E1101 error.

@[verify(confidence >= 0.8)]
fn safe() -> Uncertain<i64> {
    uncertain_new(42, 0.9)
}

fn main() {
    let r = safe()
    println(to_str(r.value))
}
