let DEPTH = 100
// R50 §4 Recursion, chain 3: `&mut` recursion (qsort's shape).
// scripts/vm_wasm_depth.sh rewrites the first line per probe.
fn r(a: &mut [i64], n: i64) {
    if n == 0 { return }
    a[0] = a[0] + 1
    r(&mut a, n - 1)
}

fn main() -> i64 {
    let a = [0]
    r(&mut a, DEPTH)
    println(to_str(a[0]))
    0
}
