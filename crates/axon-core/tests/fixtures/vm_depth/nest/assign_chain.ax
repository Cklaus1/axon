let DEPTH = 100
// AX-56 nesting probe: at the bottom of the recursion, an `Assign` whose
// operand is a 221-term `+` chain (`assign_in_place` walks it, `mentions_var`),
// the longest the wasm32 front end admits (AX-60: AST height <= 224).
// scripts/vm_wasm_depth.sh runs it deep under wasmtime's default stack
// and requires the recursion-limit panic, not a trap.
fn leaf(s: str) -> i64 {
    let t = s
    t = t + ("" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "" + "")
    str_len(t)
}
fn r(n: i64) -> i64 {
    if n == 0 { leaf("a") } else { 1 + (1 + (r(n - 1))) - 2 }
}
fn main() -> i64 {
    println(to_str(r(DEPTH)))
    0
}
