let DEPTH = 100
// vm_wasm_depth: exit0
// AX-59 drop probe: 100 levels of recursion (under the 128 guard), then a
// DEPTH-node enum list built and dropped at the bottom. Its drop glue
// recursed once per node (`Rc<EnumVal>` -> `Fields` -> `Value`) outside every
// depth guard and trapped wasmtime's default stack from about 600 nodes at
// this depth; on wasm32 it now runs at most `DROP_INLINE_DEPTH` levels deep
// (interp.rs `bounded_drop`). scripts/vm_wasm_depth.sh runs it at DEPTH
// 100000 and requires exit 0.
enum L { Nil, Cons { h: i64, t: L } }
fn build(n: i64) -> i64 {
    let l = L::Nil
    for i in 0..n { l = L::Cons { h: i, t: l } }
    n
}
fn r(k: i64, n: i64) -> i64 {
    if k == 0 { build(n) } else { r(k - 1, n) }
}
fn main() -> i64 {
    println(to_str(r(100, DEPTH)))
    0
}
