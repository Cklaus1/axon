let DEPTH = 100
// vm_wasm_depth: exit0
// AX-59 drop probe: 100 levels of recursion (under the 128 guard), then a
// chain of DEPTH values, each a tuple holding the previous value
// (read back from a dict), built and dropped at the bottom. A dict holds one
// value type (CS2-3b), so the chain nests through the one-line recursive
// enum `N`. On wasm32 its drop runs at most `DROP_INLINE_DEPTH` levels deep
// (interp.rs `Elems`, `bounded_drop`). scripts/vm_wasm_depth.sh runs it at DEPTH
// 100000 and requires exit 0.
enum N { Z, T { v: (Option<N>, i64) } }
fn build(n: i64) -> i64 {
    let d = dict_new()
    dict_set(d, "k", N::Z)
    for i in 0..n {
        let v = dict_get(d, "k")
        dict_set(d, "k", N::T { v: (v, i) })
    }
    n
}
fn r(k: i64, n: i64) -> i64 {
    if k == 0 { build(n) } else { r(k - 1, n) }
}
fn main() -> i64 {
    println(to_str(r(100, DEPTH)))
    0
}
