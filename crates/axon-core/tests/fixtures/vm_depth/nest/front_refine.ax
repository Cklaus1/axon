let DEPTH = 100
// vm_wasm_depth: front
// AX-60 front-end probe: a long `-` chain in a `let` inline-refinement predicate.
// A template: scripts/vm_wasm_depth.sh
// expands each ⟪open¦leaf¦close⟫ to open×DEPTH leaf close×DEPTH, runs it at
// DEPTH = the wasm32 nesting limit and 20× it, and requires exit 0 or the
// E0000 `expression nesting too deep` refusal (exit 2) there, the refusal
// at 20×, never a trap; it reports the deepest DEPTH that runs.
fn main() -> i64 {
    let x: i64 where _ > ⟪0 - ¦1¦⟫ = 5
    println(to_str(x))
    0
}
