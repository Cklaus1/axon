let DEPTH = 100
// AX-56 nesting probe: recursion from inside a handler arm.
// scripts/vm_wasm_depth.sh runs it deep under wasmtime's default stack
// and requires the recursion-limit panic, not a trap.
fn w(n: i64) -> i64 {
    if n == 0 { 0 } else {
        with handler { on IO(s) => { 1 + w(n - 1) } } {
            println("x")
            0
        }
    }
}
fn main() -> i64 {
    println(to_str(w(DEPTH)))
    0
}
