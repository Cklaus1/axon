let DEPTH = 100
// AX-56 nesting probe: recursion through two nested lambdas.
// scripts/vm_wasm_depth.sh runs it deep under wasmtime's default stack
// and requires the recursion-limit panic, not a trap.
fn main() -> i64 {
    println(to_str(g(DEPTH)))
    0
}
fn g(n: i64) -> i64 {
    let k = |m: i64| { let h = |q: i64| if q == 0 { 0 } else { g(q - 1) + 1 }; h(m) };
    if n == 0 { 0 } else { k(n) }
}
