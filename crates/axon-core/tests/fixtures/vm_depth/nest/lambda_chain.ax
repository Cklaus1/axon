let DEPTH = 100
// AX-56 nesting probe: 130 lambdas in a dict cycle, each entered once per
// lap, so each compiles at depth (the VM's second entry, S9): the compiling
// frame must not stay live under the body.
// scripts/vm_wasm_depth.sh runs it deep under wasmtime's default stack
// and requires the recursion-limit panic, not a trap.
fn main() -> i64 {
