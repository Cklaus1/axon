let DEPTH = 100
// AX-56 nesting probe: a fn whose body is a `let` and one `with` (a compiled
// body whose recursion runs inside a `Tree` op, through the VM's op loop).
// scripts/vm_wasm_depth.sh runs it deep under wasmtime's default stack
// and requires the recursion-limit panic, not a trap.
fn w(n: i64) -> i64 {
    let k = 0
    with handler { on Net(e) => 0 } { if n == 0 { 0 } else { k + 1 + (1 + (1 + (1 + (1 + (1 + (1 + (1 + (1 + (w(n - 1)))))))))) - 9 } }
}
fn main() -> i64 {
    println(to_str(w(DEPTH)))
    0
}
