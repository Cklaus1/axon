let DEPTH = 100
// AX-56 nesting probe: recursion inside ten nested `for` loops (run_loop_body).
// scripts/vm_wasm_depth.sh runs it deep under wasmtime's default stack
// and requires the recursion-limit panic, not a trap.
fn w(n: i64) -> i64 {
    if n == 0 { 0 } else {
        let s = 0
        for i0 in 0..1 {
            for i1 in 0..1 {
                for i2 in 0..1 {
                    for i3 in 0..1 {
                        for i4 in 0..1 {
                            for i5 in 0..1 {
                                for i6 in 0..1 {
                                    for i7 in 0..1 {
                                        for i8 in 0..1 {
                                            for i9 in 0..1 {
                                                s = s + w(n - 1) + 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        s
    }
}
fn main() -> i64 {
    println(to_str(w(DEPTH)))
    0
}
