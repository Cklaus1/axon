let DEPTH = 100
// AX-56 nesting probe: recursion inside nested `match` arms.
// scripts/vm_wasm_depth.sh runs it deep under wasmtime's default stack
// and requires the recursion-limit panic, not a trap.
fn w(n: i64) -> i64 {
    match n {
        0 => 0,
        _ => match Some(n) { Some(m) => { let r = if m > 0 { w(m - 1) } else { 0 }; r + 1 }, None => 0 },
    }
}
fn main() -> i64 {
    println(to_str(w(DEPTH)))
    0
}
