let DEPTH = 100
// AX-56 nesting probe: `&mut` recursion inside three nested `with` bodies.
// scripts/vm_wasm_depth.sh runs it deep under wasmtime's default stack
// and requires the recursion-limit panic, not a trap.
fn r(a: &mut [i64], n: i64) {
    if n == 0 { return }
    a[0] = a[0] + 1
    with handler { on Net(e) => 0 } {
        with handler { on Net(e) => 0 } {
            with handler { on Net(e) => 0 } { r(&mut a, n - 1) }
        }
    }
}
fn main() -> i64 {
    let a = [0]
    r(&mut a, DEPTH)
    println(to_str(a[0]))
    0
}
