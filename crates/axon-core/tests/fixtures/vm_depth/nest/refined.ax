let DEPTH = 100
// AX-56 nesting probe: recursion through a fn with a refined parameter (the general call path).
// scripts/vm_wasm_depth.sh runs it deep under wasmtime's default stack
// and requires the recursion-limit panic, not a trap.
type Pos = i64 where _ >= 0
fn w(n: Pos) -> i64 {
    if n == 0 { 0 } else { 1 + w(n - 1) }
}
fn main() -> i64 {
    println(to_str(w(DEPTH)))
    0
}
