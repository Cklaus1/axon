let DEPTH = 100
// AX-56 nesting probe: a fn whose whole body is a `with` (one `Tree` op
// under the VM, run on the tree), recursing inside nested parentheses.
// scripts/vm_wasm_depth.sh runs it deep under wasmtime's default stack
// and requires the recursion-limit panic, not a trap.
fn w(n: i64) -> i64 {
    with handler { on Net(e) => 0 } { if n == 0 { 0 } else { 1 + (1 + (1 + (w(n - 1)))) - 3 } }
}
fn main() -> i64 {
    println(to_str(w(DEPTH)))
    0
}
