let DEPTH = 100
// AX-56 nesting probe: a `with` per level whose body holds a never-taken
// 700-term `+` chain (handler frames point into the source, no AST clone).
// scripts/vm_wasm_depth.sh runs it deep under wasmtime's default stack
// and requires the recursion-limit panic, not a trap.
