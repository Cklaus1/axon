// R50 S3, CS2-4 (`vm_match_non_exhaustive_is_refused_at_check`): the match
// on `i64` has no catch-all, so `axon check` refuses it (E0304) on both
// engines; before CS2-4 it ran and panicked `no match arm matched`.
fn pick(n: i64) -> str {
    match n {
        1 => "one",
        2 => "two",
    }
}

fn main() -> i64 {
    println(pick(1))
    println(pick(2))
    println(pick(3))
    0
}
