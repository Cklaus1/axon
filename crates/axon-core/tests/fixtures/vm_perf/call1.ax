// R50 §10 --repros: loop_generic.ax with `s = s + i` replaced by `s = s + id(i)`.
// (instructions - loop_generic.ax's) / 1M = one one-argument call (S1: general path,
// S5: fast call).
fn id(x: i64) -> i64 { x }

fn main() -> i64 {
    let s = 0
    let i = 0
    while i < 1000000 {
        s = s + id(i)
        i = i + 1
        if i < 0 { s = 0 }
    }
    println(to_str(s))
    0
}
