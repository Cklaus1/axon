// R50 §10 --repros base from S7: loop.ax with a never-taken `if` appended to the
// body, so the loop is not a `PureLoop` and keeps the generic per-iteration
// cost. call1.ax and mutcall.ax carry the same `if`, so it cancels: the
// call/fastcall/mutcall rows are (instructions - loop_generic.ax's) / 1M.
fn main() -> i64 {
    let s = 0
    let i = 0
    while i < 1000000 {
        s = s + i
        i = i + 1
        if i < 0 { s = 0 }
    }
    println(to_str(s))
    0
}
