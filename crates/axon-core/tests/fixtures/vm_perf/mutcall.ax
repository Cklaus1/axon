// R50 §10 --repros: loop.ax plus `touch(&mut a, i)` per iteration.
// (instructions - loop.ax's) / 1M = one one-`&mut`-argument call via call_mut.
fn touch(a: &mut [i64], i: i64) { a[0] = i }

fn main() -> i64 {
    let a = [0]
    let s = 0
    let i = 0
    while i < 1000000 {
        s = s + i
        touch(&mut a, i)
        i = i + 1
    }
    println("{to_str(s)} {to_str(a[0])}")
    0
}
