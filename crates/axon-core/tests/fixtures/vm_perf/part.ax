// R50 §10 --repros: qsort's partition loop without the swap; the branch is
// taken every time. (instructions - part_base.ax's) / 1M = one iteration.
fn main() -> i64 {
    let a = arr_repeat(0, 1000000)
    let pivot = 1
    let i = 0
    for j in 0..1000000 {
        if a[j] < pivot { i = i + 1 }
    }
    println(to_str(i))
    0
}
