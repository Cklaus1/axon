// R50 §10 --repros (S8): loop_generic.ax plus `swap(&mut a, 0, 1)` per
// iteration, with qsort's three-statement `swap` body.
// (instructions - loop_generic.ax's) / 1M = one `swap` call, body included.
fn swap(a: &mut [i64], i: i64, j: i64) {
    let t = a[i]
    a[i] = a[j]
    a[j] = t
}

fn main() -> i64 {
    let a = [0, 1]
    let s = 0
    let i = 0
    while i < 1000000 {
        s = s + i
        swap(&mut a, 0, 1)
        i = i + 1
        if i < 0 { println("") }
    }
    println("{to_str(s)} {to_str(a[0])}")
    0
}
