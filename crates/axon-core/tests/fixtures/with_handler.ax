// Phase 6 handlers (interpreter): an inline `on IO(p) => resume(p)` handler
// INTERCEPTS the IO effect of `println` inside the handled body. So `safe(5)`
// calls `risky(5)`, whose `println("risky 5")` is intercepted and suppressed
// (the arm resumes), while `risky(10)` under the unresolved named handler
// `retry` is inert (prints normally). Demonstrates real tail-resumptive
// discharge. (Interpreter-only; native codegen still erases handlers.)
fn risky(x: i64) -> i64 | {IO} {
    println("risky {to_str(x)}")
    x + 1
}
fn safe(x: i64) -> i64 {
    with handler { on IO(p) => resume(p)  return(v) => v } {
        risky(x)
    }
}
fn main() {
    let r = with retry { risky(10) }
    println("done {to_str(r)} safe {to_str(safe(5))}")
}
