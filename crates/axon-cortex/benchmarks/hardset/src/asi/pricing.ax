// Axon ASI demo (cousin #6): pricing recommender with multi-objective reward.
//
// Demonstrates **reward shaping** without dedicated syntax (F10 in
// ROADMAP §9.5).  The score combines two objectives:
//
//   demand_estimate   — LLM judges plausibility of customer uptake (0..1)
//   margin_compliance — flat 1.0 if price >= floor, else 0.0
//
// score = round(70 × demand × confidence_demand + 30 × margin_compliance)
//
// A future @[reward(weight: λ)]-annotated multi-metric goal collapses
// this into one declarative line.  For now we hand-fuse.
//
// Run: ANTHROPIC_API_KEY=... axon run examples/asi/pricing.ax

// ── Domain: 5 candidate prices (cents), one is the search dimension ────────

fn candidate_price_cents(variant_id: i64) -> i64 {
    let v = variant_id % 5
    let v2 = if v < 0 { v + 5 } else { v }
    if v2 == 0 { 1999 }
    else if v2 == 1 { 2499 }
    else if v2 == 2 { 2999 }
    else if v2 == 3 { 3499 }
    else { 3999 }
}

fn price_floor_cents() -> i64 { 2400 }   // do not deploy under this

fn product_blurb() -> str {
    "A 12-month subscription to a developer-focused note-taking app with offline mode, end-to-end encryption, and unlimited devices."
}

// ── Demand estimate: ask the LLM to rate plausibility of uptake ────────────
// Returns 0..100 (with confidence) using ai_extract_uncertain_i64.

fn build_demand_prompt(price_cents: i64) -> str {
    let dollars = price_cents / 100
    let cents = price_cents % 100
    "Given this product:\n\n{product_blurb()}\n\nAt a price of ${to_str(dollars)}.{to_str(cents)}/year, output an integer 0..100 estimating customer uptake (100 = highly likely to convert, 0 = will not convert).  Output ONLY the integer."
}

fn demand_score(price_cents: i64) -> i64 {
    match ai_extract_uncertain_i64(build_demand_prompt(price_cents)) {
        Ok(u) => {
            let v = if u.value < 0 { 0 } else if u.value > 100 { 100 } else { u.value }
            // Weight by confidence: a low-confidence high estimate counts less.
            f64_to_i64(u.confidence * (i64_to_f64(v) * 0.7))
        }
        Err(_) => 0
    }
}

// ── Margin compliance: hard 0/30 ───────────────────────────────────────────

fn margin_compliance(price_cents: i64) -> i64 {
    if price_cents >= price_floor_cents() { 30 } else { 0 }
}

// ── Composite metric ────────────────────────────────────────────────────────

@[adaptive(metric: pricing_quality, target: 100)]
fn try_variant(variant_id: i64) -> i64 {
    let p = candidate_price_cents(variant_id)
    demand_score(p) + margin_compliance(p)
}

// ── Deploy gate ─────────────────────────────────────────────────────────────

@[verify(confidence >= 0.7)]
fn deploy_gate(best_score: f64) -> Uncertain<i64> {
    let conf = best_score / 100.0
    let clamped = if best_score < 0.0 { 0.0 }
                  else if best_score > 100.0 { 100.0 }
                  else { best_score }
    uncertain_dyn_i64(f64_to_i64(clamped), conf)
}

// ── Main ────────────────────────────────────────────────────────────────────

fn main() -> i64 {
    println("=== Axon ASI demo (cousin #6): multi-objective pricing ===")
    println("Composite reward: 70% LLM demand × confidence  +  30% margin compliance")
    println("Hard floor: ${to_str(price_floor_cents() / 100)}.00")
    println("")

    let _ = try_variant(0)
    let best = goal_run("try_variant", 100.0, 15)
    println("Best observed score: {to_str_f64(best)} / 100")

    let u = deploy_gate(best)
    println("Deploy gate: PASS — confidence >= 0.7")
    println("Confirmed best composite score: {to_str(u.value)}")
    0
}

@[test]
fn test_candidate_price_cents_each_variant() {
    assert_eq(candidate_price_cents(0), 1999)
    assert_eq(candidate_price_cents(1), 2499)
    assert_eq(candidate_price_cents(2), 2999)
    assert_eq(candidate_price_cents(3), 3499)
    assert_eq(candidate_price_cents(4), 3999)
}

@[test]
fn test_candidate_price_cents_wraps_modulo_five() {
    assert_eq(candidate_price_cents(5), 1999)
    assert_eq(candidate_price_cents(7), 2999)
    assert_eq(candidate_price_cents(14), 3999)
    assert_eq(candidate_price_cents(-1), 3999)
    assert_eq(candidate_price_cents(-4), 2499)
    assert_eq(candidate_price_cents(-5), 1999)
}

@[test]
fn test_price_floor_cents_value() {
    assert_eq(price_floor_cents(), 2400)
    assert(candidate_price_cents(0) < price_floor_cents())
    assert(candidate_price_cents(1) >= price_floor_cents())
}

@[test]
fn test_product_blurb_text() {
    assert(product_blurb() == "A 12-month subscription to a developer-focused note-taking app with offline mode, end-to-end encryption, and unlimited devices.")
    assert(str_contains(build_demand_prompt(2999), product_blurb()))
}

@[test]
fn test_build_demand_prompt_formats_price() {
    let p = build_demand_prompt(2499)
    assert(str_starts_with(p, "Given this product:\n\n"))
    assert(str_contains(p, "At a price of $24.99/year"))
    assert(str_ends_with(p, "Output ONLY the integer."))
    assert(str_contains(build_demand_prompt(3999), "At a price of $39.99/year"))
}

@[test]
fn test_build_demand_prompt_exact() {
    let expected_prompt = "Given this product:\n\n" + product_blurb() + "\n\nAt a price of $19.99/year, output an integer 0..100 estimating customer uptake (100 = highly likely to convert, 0 = will not convert).  Output ONLY the integer."
    assert(build_demand_prompt(1999) == expected_prompt)
    assert(str_contains(build_demand_prompt(3499), "$34.99/year"))
}

@[test]
fn test_margin_compliance_floor_boundary() {
    assert_eq(margin_compliance(2400), 30)
    assert_eq(margin_compliance(2399), 0)
    assert_eq(margin_compliance(2401), 30)
    assert_eq(margin_compliance(0), 0)
    assert_eq(margin_compliance(-100), 0)
}

@[test]
fn test_margin_compliance_of_candidates() {
    assert_eq(margin_compliance(candidate_price_cents(0)), 0)
    assert_eq(margin_compliance(candidate_price_cents(1)), 30)
    assert_eq(margin_compliance(candidate_price_cents(2)), 30)
    assert_eq(margin_compliance(candidate_price_cents(3)), 30)
    assert_eq(margin_compliance(candidate_price_cents(4)), 30)
}

@[test]
fn test_deploy_gate_full_and_threshold() {
    let u = deploy_gate(100.0)
    assert_eq(u.value, 100)
    assert(abs_f64(u.confidence - 1.0) < 0.000001)
    let w = deploy_gate(70.0)
    assert_eq(w.value, 70)
    assert(abs_f64(w.confidence - 0.7) < 0.000001)
}

@[test]
fn test_deploy_gate_midrange_and_clamp() {
    let u = deploy_gate(85.0)
    assert_eq(u.value, 85)
    assert(abs_f64(u.confidence - 0.85) < 0.000001)
    let w = deploy_gate(250.0)
    assert_eq(w.value, 100)
}
