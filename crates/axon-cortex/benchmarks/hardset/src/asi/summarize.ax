// Axon ASI demo (cousin #3): summarizer with length-vs-quality tradeoff.
//
// Demonstrates a **composite metric** (correctness + brevity) without
// reward-shaping syntax (F10 in ROADMAP §9.5).  We hand-compute the
// composite score in score_variant; once Phase 8 lands, this becomes
// `@[reward(weight: ...)]` annotations on each component.
//
// Goal: find a summarization prompt whose summaries are (a) short
// (≤ 12 words) and (b) capture the key concept (validated by a second
// LLM call that returns Uncertain<i64> confidence in coverage).
//
// Run: ANTHROPIC_API_KEY=... axon run examples/asi/summarize.ax

// ── Test set: 3 source paragraphs + their key concept ──────────────────────

fn source_text(i: i64) -> str {
    if i == 0 {
        "The Anthropic API supports prompt caching, which dramatically reduces cost for repeated context. Caches expire after five minutes by default."
    } else if i == 1 {
        "LLVM 17 introduces opaque pointers throughout its IR, simplifying type management and enabling further optimizer passes that were previously blocked by typed pointers."
    } else if i == 2 {
        "Rust's borrow checker prevents data races at compile time by enforcing that mutable references are never aliased with any other reference, mutable or shared."
    } else {
        ""
    }
}

fn key_concept(i: i64) -> str {
    if i == 0 { "prompt caching reduces API cost" }
    else if i == 1 { "LLVM 17 uses opaque pointers" }
    else if i == 2 { "Rust prevents data races at compile time" }
    else { "" }
}

// ── Prompt variants — vary terseness pressure ──────────────────────────────

fn build_prompt(variant_id: i64) -> str {
    let v = variant_id % 5
    let v2 = if v < 0 { v + 5 } else { v }
    if v2 == 0 {
        "Summarize in one short sentence (≤ 12 words). Output the summary only, no preamble. Text: "
    } else if v2 == 1 {
        "Compress to a single short sentence. Be terse. Text: "
    } else if v2 == 2 {
        "Output a one-sentence summary. Text: "
    } else if v2 == 3 {
        "TASK: 12-word-or-fewer summary. Output only the summary. Text: "
    } else {
        "Summarize tersely (≤ 12 words). Text: "
    }
}

// ── Scoring helpers ─────────────────────────────────────────────────────────
// Word count: count spaces + 1 (rough but stable for short outputs).

fn word_count(s: str) -> i64 {
    let n = str_len(s)
    let count = 0
    let i = 0
    while i < n {
        if char_at(s, i) == 32 {
            count = count + 1
        }
        i = i + 1
    }
    count + 1
}

// Length score: 12 points when ≤ 12 words, decays linearly.
fn length_score(words: i64) -> i64 {
    if words <= 12 {
        12
    } else if words >= 30 {
        0
    } else {
        12 - (words - 12)
    }
}

// Coverage score: ask the LLM "did the summary capture <concept>?".
// Returns 0..21 (Uncertain<i64> 0/1 × 0..21 confidence-weighted).

fn coverage_score(summary: str, concept: str) -> i64 {
    let q = "Does the following summary capture this key idea: '{concept}'? Output 1 for yes, 0 for no. Summary: {summary}"
    match ai_extract_uncertain_i64(q) {
        Ok(u) => {
            let correct_f = if u.value == 1 { 21.0 } else { 0.0 }
            f64_to_i64(u.confidence * correct_f)
        }
        Err(_) => 0
    }
}

// ── Score one sample (composite: length × coverage) ────────────────────────

fn score_one(prefix: str, idx: i64) -> i64 {
    let prompt = "{prefix}{source_text(idx)}"
    match ai_complete(prompt) {
        Ok(summary) => {
            let words = word_count(summary)
            let length = length_score(words)
            let coverage = coverage_score(summary, key_concept(idx))
            length + coverage
        }
        Err(_) => 0
    }
}

fn score_variant(variant_id: i64) -> i64 {
    let prefix = build_prompt(variant_id)
    let s0 = score_one(prefix, 0)
    let s1 = score_one(prefix, 1)
    let s2 = score_one(prefix, 2)
    s0 + s1 + s2
}

@[adaptive(metric: summary_quality, target: 99)]
fn try_variant(variant_id: i64) -> i64 {
    score_variant(variant_id)
}

@[verify(confidence >= 0.85)]
fn deploy_gate(best_score: f64) -> Uncertain<i64> {
    let conf = best_score / 99.0
    let clamped = if best_score < 0.0 { 0.0 }
                  else if best_score > 99.0 { 99.0 }
                  else { best_score }
    uncertain_dyn_i64(f64_to_i64(clamped), conf)
}

fn main() -> i64 {
    println("=== Axon ASI demo (cousin #3): summarizer ===")
    println("Composite metric: length (≤12 words) + coverage (LLM-judged)")
    println("Search space: 5 prompt variants")
    println("")

    let _ = try_variant(0)
    let best = goal_run("try_variant", 99.0, 15)
    println("Best observed score: {to_str_f64(best)} / 99")

    let u = deploy_gate(best)
    println("Deploy gate: PASS — confidence >= 0.85")
    println("Confirmed best score: {to_str(u.value)}")
    0
}

@[test]
fn test_source_text_known_indices() {
    assert(source_text(0) == "The Anthropic API supports prompt caching, which dramatically reduces cost for repeated context. Caches expire after five minutes by default.")
    assert(source_text(1) == "LLVM 17 introduces opaque pointers throughout its IR, simplifying type management and enabling further optimizer passes that were previously blocked by typed pointers.")
    assert(source_text(2) == "Rust's borrow checker prevents data races at compile time by enforcing that mutable references are never aliased with any other reference, mutable or shared.")
}

@[test]
fn test_source_text_out_of_range_empty() {
    assert(source_text(3) == "")
    assert(source_text(-1) == "")
    assert(source_text(100) == "")
}

@[test]
fn test_key_concept_known_indices() {
    assert(key_concept(0) == "prompt caching reduces API cost")
    assert(key_concept(1) == "LLVM 17 uses opaque pointers")
    assert(key_concept(2) == "Rust prevents data races at compile time")
}

@[test]
fn test_key_concept_out_of_range_and_word_counts() {
    assert(key_concept(3) == "")
    assert(key_concept(-2) == "")
    assert_eq(word_count(key_concept(0)), 5)
    assert_eq(word_count(key_concept(1)), 5)
    assert_eq(word_count(key_concept(2)), 7)
}

@[test]
fn test_build_prompt_each_variant() {
    assert(build_prompt(0) == "Summarize in one short sentence (≤ 12 words). Output the summary only, no preamble. Text: ")
    assert(build_prompt(1) == "Compress to a single short sentence. Be terse. Text: ")
    assert(build_prompt(2) == "Output a one-sentence summary. Text: ")
    assert(build_prompt(3) == "TASK: 12-word-or-fewer summary. Output only the summary. Text: ")
    assert(build_prompt(4) == "Summarize tersely (≤ 12 words). Text: ")
}

@[test]
fn test_build_prompt_wraps_modulo_five() {
    assert(build_prompt(5) == build_prompt(0))
    assert(build_prompt(7) == build_prompt(2))
    assert(build_prompt(14) == build_prompt(4))
    assert(build_prompt(-1) == build_prompt(4))
    assert(build_prompt(-5) == build_prompt(0))
    assert(build_prompt(-3) == build_prompt(2))
}

@[test]
fn test_word_count_simple() {
    assert_eq(word_count("hello"), 1)
    assert_eq(word_count("hello world"), 2)
    assert_eq(word_count("a b c d"), 4)
    assert_eq(word_count(""), 1)
}

@[test]
fn test_word_count_counts_spaces_plus_one() {
    assert_eq(word_count("a  b"), 3)
    assert_eq(word_count(" lead"), 2)
    assert_eq(word_count("one two three four five six seven eight nine ten eleven twelve"), 12)
    assert_eq(word_count("x\ty"), 1)
}

@[test]
fn test_length_score_within_limit() {
    assert_eq(length_score(0), 12)
    assert_eq(length_score(1), 12)
    assert_eq(length_score(12), 12)
}

@[test]
fn test_length_score_decay_and_floor() {
    assert_eq(length_score(13), 11)
    assert_eq(length_score(18), 6)
    assert_eq(length_score(23), 1)
    assert_eq(length_score(24), 0)
    assert_eq(length_score(30), 0)
    assert_eq(length_score(100), 0)
}

@[test]
fn test_length_score_of_word_count() {
    assert_eq(length_score(word_count("short summary here")), 12)
    assert_eq(length_score(word_count("one two three four five six seven eight nine ten eleven twelve thirteen")), 11)
}

@[test]
fn test_deploy_gate_full_score() {
    let u = deploy_gate(99.0)
    assert_eq(u.value, 99)
    assert(abs_f64(u.confidence - 1.0) < 0.000001)
}

@[test]
fn test_deploy_gate_partial_score() {
    let u = deploy_gate(90.0)
    assert_eq(u.value, 90)
    assert(abs_f64(u.confidence - 90.0 / 99.0) < 0.000001)
    let w = deploy_gate(85.0)
    assert_eq(w.value, 85)
    assert(abs_f64(w.confidence - 85.0 / 99.0) < 0.000001)
}

@[test]
fn test_deploy_gate_clamps_value_above_max() {
    let u = deploy_gate(150.0)
    assert_eq(u.value, 99)
    let w = deploy_gate(99.5)
    assert_eq(w.value, 99)
}
