type Vec2 = { x: f64, y: f64 }

fn dot(a: Vec2, b: Vec2) -> f64 {
    a.x * b.x + a.y * b.y
}

fn magnitude_sq(v: Vec2) -> f64 {
    dot(v, v)
}

fn is_unit(v: Vec2) -> bool {
    let msq = magnitude_sq(v)
    msq > 0.99 && msq < 1.01
}

fn sum_to(n: i64) -> i64 {
    let acc = 0
    let i = 1
    while i <= n {
        acc = acc + i
        i = i + 1
    }
    acc
}

fn collatz(n: i64) -> i64 {
    let steps = 0
    let x = n
    while x != 1 {
        if x % 2 == 0 {
            x = x / 2
        } else {
            x = x * 3 + 1
        }
        steps = steps + 1
    }
    steps
}

fn main() {
    let v = Vec2 { x: 1.0, y: 0.0 }
    println(to_str_f64(magnitude_sq(v)))
    println(to_str(sum_to(10)))
    println(to_str(sum_to(100)))
    println(to_str(collatz(27)))
    println(to_str(collatz(6)))
    let name = "Axon"
    let version = 2
    println("language: {name} v{to_str(version)}")
}

@[test]
fn test_dot_products() {
    let a = Vec2 { x: 1.0, y: 2.0 }
    let b = Vec2 { x: 3.0, y: 4.0 }
    assert(abs_f64(dot(a, b) - 11.0) < 0.000001)
    assert(abs_f64(dot(b, a) - 11.0) < 0.000001)
    assert(abs_f64(dot(Vec2 { x: 1.0, y: 0.0 }, Vec2 { x: 0.0, y: 1.0 })) < 0.000001)
    assert(abs_f64(dot(Vec2 { x: -2.0, y: 3.0 }, Vec2 { x: 4.0, y: 5.0 }) - 7.0) < 0.000001)
}

@[test]
fn test_magnitude_sq_values() {
    assert(abs_f64(magnitude_sq(Vec2 { x: 1.0, y: 0.0 }) - 1.0) < 0.000001)
    assert(abs_f64(magnitude_sq(Vec2 { x: 3.0, y: 4.0 }) - 25.0) < 0.000001)
    assert(abs_f64(magnitude_sq(Vec2 { x: -3.0, y: -4.0 }) - 25.0) < 0.000001)
    assert(abs_f64(magnitude_sq(Vec2 { x: 0.0, y: 0.0 })) < 0.000001)
}

@[test]
fn test_is_unit_true_cases() {
    assert(is_unit(Vec2 { x: 1.0, y: 0.0 }))
    assert(is_unit(Vec2 { x: 0.0, y: -1.0 }))
    assert(is_unit(Vec2 { x: 0.6, y: 0.8 }))
    assert(is_unit(Vec2 { x: 0.999, y: 0.0 }))
}

@[test]
fn test_is_unit_false_cases_and_bounds() {
    assert(!is_unit(Vec2 { x: 0.0, y: 0.0 }))
    assert(!is_unit(Vec2 { x: 2.0, y: 0.0 }))
    assert(!is_unit(Vec2 { x: 0.5, y: 0.5 }))
    assert(!is_unit(Vec2 { x: 1.1, y: 0.0 }))
    assert(!is_unit(Vec2 { x: 0.9, y: 0.0 }))
}

@[test]
fn test_sum_to_values() {
    assert_eq(sum_to(10), 55)
    assert_eq(sum_to(100), 5050)
    assert_eq(sum_to(1), 1)
}

@[test]
fn test_sum_to_empty_ranges() {
    assert_eq(sum_to(0), 0)
    assert_eq(sum_to(-5), 0)
    assert_eq(sum_to(2), 3)
    assert_eq(sum_to(4), 10)
}

@[test]
fn test_collatz_known_values() {
    assert_eq(collatz(27), 111)
    assert_eq(collatz(6), 8)
    assert_eq(collatz(1), 0)
}

@[test]
fn test_collatz_short_chains() {
    assert_eq(collatz(2), 1)
    assert_eq(collatz(3), 7)
    assert_eq(collatz(8), 3)
    assert_eq(collatz(5), 5)
}
