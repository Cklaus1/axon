enum Shape {
    Circle { radius: f64 },
    Rect { w: f64, h: f64 },
    Point,
}

fn area(s: Shape) -> f64 {
    match s {
        Shape::Circle { radius } => radius * radius
        Shape::Rect { w, h } => w * h
        _ => 0.0
    }
}

fn main() {
    let c = Shape::Circle { radius: 3.0 }
    println(to_str_f64(area(c)))
}

@[test]
fn test_area_rect() {
    assert(abs_f64(area(Shape::Rect { w: 2.0, h: 3.0 }) - 6.0) < 0.000001)
    assert(abs_f64(area(Shape::Rect { w: 2.5, h: 4.0 }) - 10.0) < 0.000001)
    assert(abs_f64(area(Shape::Rect { w: 0.0, h: 7.0 })) < 0.000001)
    assert(abs_f64(area(Shape::Rect { w: 1.0, h: 1.0 }) - 1.0) < 0.000001)
}

@[test]
fn test_area_point_is_zero() {
    assert(abs_f64(area(Shape::Point)) < 0.000001)
    assert(abs_f64(area(Shape::Rect { w: 5.0, h: 0.0 })) < 0.000001)
}

@[test]
fn test_area_circle_grows_with_radius() {
    assert(abs_f64(area(Shape::Circle { radius: 0.0 })) < 0.000001)
    assert(area(Shape::Circle { radius: 3.0 }) > area(Shape::Circle { radius: 2.0 }))
    assert(area(Shape::Circle { radius: 2.0 }) > area(Shape::Circle { radius: 1.0 }))
    assert(area(Shape::Circle { radius: 1.0 }) > 0.0)
}
