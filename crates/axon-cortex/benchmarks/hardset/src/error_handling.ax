// error_handling.ax — idiomatic Result / Option usage in Axon
//
// Key concepts shown here:
//   • Result<T, E>: Ok / Err construction and exhaustive match
//   • ? propagation — unwraps Ok or returns Err early from the enclosing fn
//   • Chained operations that stay on the "happy path" until something fails
//   • Helper functions that accept and forward errors cleanly

// Parse a string into a positive integer.
// Returns Err if the string is not numeric or the value is not > 0.
fn parse_positive(s: str) -> Result<i64, str> {
    let n = parse_int(s)?          // ? propagates Err("parse error") automatically
    if n <= 0 {
        Err("expected a positive number, got {s}")
    } else {
        Ok(n)
    }
}

// Integer square-root approximation (Newton's method, 20 iterations).
fn isqrt(n: i64) -> Result<i64, str> {
    if n < 0 {
        Err("cannot take square root of a negative number: {to_str(n)}")
    } else if n == 0 {
        Ok(0)
    } else {
        let x = n
        let i = 0
        while i < 20 {
            x = (x + n / x) / 2
            i = i + 1
        }
        Ok(x)
    }
}

// Parse a string → validate positive → compute integer square root.
// Each step can fail; ? short-circuits on the first error.
fn sqrt_of_string(s: str) -> Result<i64, str> {
    let n = parse_positive(s)?
    isqrt(n)
}

// Safe division — avoids a panic on divide-by-zero.
fn safe_div(a: i64, b: i64) -> Result<i64, str> {
    if b == 0 {
        Err("division by zero")
    } else {
        Ok(a / b)
    }
}

// Print a labelled Result<i64, str> line.
fn show(label: str, r: Result<i64, str>) {
    match r {
        Ok(v)  => println("{label} => Ok({to_str(v)})")
        Err(e) => println("{label} => Err({e})")
    }
}

fn main() -> i64 {
    // sqrt_of_string chains parse_positive and isqrt
    show("sqrt(\"144\")", sqrt_of_string("144"))    // Ok(12)
    show("sqrt(\"9\")",   sqrt_of_string("9"))       // Ok(3)
    show("sqrt(\"2\")",   sqrt_of_string("2"))       // Ok(1)  (truncated)

    // Error cases propagated by ?
    show("sqrt(\"-5\")",  sqrt_of_string("-5"))      // Err: not positive
    show("sqrt(\"0\")",   sqrt_of_string("0"))       // Err: not positive
    show("sqrt(\"abc\")", sqrt_of_string("abc"))     // Err: not numeric

    println("")

    // Direct safe_div usage
    show("100 / 4", safe_div(100, 4))    // Ok(25)
    show("1   / 0", safe_div(1,   0))    // Err: division by zero

    0
}

@[test]
fn test_parse_positive_ok() {
    match parse_positive("42") { Ok(n) => assert_eq(n, 42)  Err(e) => assert(false) }
    match parse_positive("1") { Ok(n) => assert_eq(n, 1)  Err(e) => assert(false) }
    match parse_positive("144") { Ok(n) => assert_eq(n, 144)  Err(e) => assert(false) }
}

@[test]
fn test_parse_positive_rejects_non_positive_and_non_numeric() {
    match parse_positive("0") { Ok(n) => assert(false)  Err(e) => assert(e == "expected a positive number, got 0") }
    match parse_positive("-5") { Ok(n) => assert(false)  Err(e) => assert(e == "expected a positive number, got -5") }
    match parse_positive("abc") { Ok(n) => assert(false)  Err(e) => assert(e == "could not parse `abc` as a base-10 integer") }
}

@[test]
fn test_isqrt_perfect_squares() {
    match isqrt(0) { Ok(v) => assert_eq(v, 0)  Err(e) => assert(false) }
    match isqrt(1) { Ok(v) => assert_eq(v, 1)  Err(e) => assert(false) }
    match isqrt(4) { Ok(v) => assert_eq(v, 2)  Err(e) => assert(false) }
    match isqrt(9) { Ok(v) => assert_eq(v, 3)  Err(e) => assert(false) }
    match isqrt(144) { Ok(v) => assert_eq(v, 12)  Err(e) => assert(false) }
    match isqrt(10000) { Ok(v) => assert_eq(v, 100)  Err(e) => assert(false) }
}

@[test]
fn test_isqrt_truncates_and_rejects_negative() {
    match isqrt(2) { Ok(v) => assert_eq(v, 1)  Err(e) => assert(false) }
    match isqrt(10) { Ok(v) => assert_eq(v, 3)  Err(e) => assert(false) }
    match isqrt(26) { Ok(v) => assert_eq(v, 5)  Err(e) => assert(false) }
    match isqrt(-4) { Ok(v) => assert(false)  Err(e) => assert(e == "cannot take square root of a negative number: -4") }
}

@[test]
fn test_sqrt_of_string_documented_ok() {
    match sqrt_of_string("144") { Ok(v) => assert_eq(v, 12)  Err(e) => assert(false) }
    match sqrt_of_string("9") { Ok(v) => assert_eq(v, 3)  Err(e) => assert(false) }
    match sqrt_of_string("2") { Ok(v) => assert_eq(v, 1)  Err(e) => assert(false) }
    match sqrt_of_string("1") { Ok(v) => assert_eq(v, 1)  Err(e) => assert(false) }
}

@[test]
fn test_sqrt_of_string_documented_errors() {
    match sqrt_of_string("-5") { Ok(v) => assert(false)  Err(e) => assert(e == "expected a positive number, got -5") }
    match sqrt_of_string("0") { Ok(v) => assert(false)  Err(e) => assert(e == "expected a positive number, got 0") }
    match sqrt_of_string("abc") { Ok(v) => assert(false)  Err(e) => assert(e == "could not parse `abc` as a base-10 integer") }
}

@[test]
fn test_safe_div_documented() {
    match safe_div(100, 4) { Ok(v) => assert_eq(v, 25)  Err(e) => assert(false) }
    match safe_div(1, 0) { Ok(v) => assert(false)  Err(e) => assert(e == "division by zero") }
    match safe_div(0, 0) { Ok(v) => assert(false)  Err(e) => assert(e == "division by zero") }
}

@[test]
fn test_safe_div_integer_division() {
    match safe_div(7, 2) { Ok(v) => assert_eq(v, 3)  Err(e) => assert(false) }
    match safe_div(0, 5) { Ok(v) => assert_eq(v, 0)  Err(e) => assert(false) }
    match safe_div(-12, 3) { Ok(v) => assert_eq(v, -4)  Err(e) => assert(false) }
    match safe_div(5, 1) { Ok(v) => assert_eq(v, 5)  Err(e) => assert(false) }
}
