// R14 (iOS slice 2) — the iOS compute-parity ORACLE.
//
// This is a PURE-COMPUTE program (no device, no gfx, no platform) so it runs
// identically on every engine and target: the tree-walking interpreter (the
// oracle), the native x86-64/aarch64 binary, and — the point of this file — the
// SAME Axon logic cross-compiled to an iOS triple and run under an iOS Simulator
// in the macOS CI job (`.github/workflows/ios.yml`). Invariant I-2 (parity): the
// iOS run's stdout/exit MUST equal the interpreter oracle's.
//
// It deliberately exercises the arithmetic/control-flow the codegen path lowers
// (i64 + - * / %, comparisons, recursion, a while loop) — the shapes most likely
// to diverge across an ISA/ABI boundary — and prints a single deterministic line
// the CI parity check diffs against the oracle.
//
// Run on a dev laptop (the oracle):   axon run examples/mobile/ios_compute_parity.ax
// Run under the iOS Simulator (CI):   built to aarch64-apple-ios-sim, launched
//                                     via `xcrun simctl`, stdout diffed vs oracle.

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd(b, a % b) }
}

fn fib(n: i64) -> i64 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn sum_to(n: i64) -> i64 {
    let acc = 0
    let i = 1
    while i <= n {
        acc = acc + i
        i = i + 1
    }
    acc
}

fn main() {
    let g = gcd(1071, 462)        // 21
    let f = fib(20)               // 6765
    let s = sum_to(100)           // 5050
    let mix = (g * f + s) % 1000  // (21*6765 + 5050) % 1000 = 147115 % 1000 = 115
    // One deterministic line the CI parity check diffs against the oracle.
    println("ios-parity gcd={to_str(g)} fib={to_str(f)} sum={to_str(s)} mix={to_str(mix)}")
}

@[test]
fn test_gcd_documented() {
    assert_eq(gcd(1071, 462), 21)
    assert_eq(gcd(462, 1071), 21)
    assert_eq(gcd(48, 18), 6)
    assert_eq(gcd(13, 0), 13)
    assert_eq(gcd(17, 5), 1)
}

@[test]
fn test_fib_documented() {
    assert_eq(fib(20), 6765)
    assert_eq(fib(0), 0)
    assert_eq(fib(1), 1)
    assert_eq(fib(2), 1)
    assert_eq(fib(10), 55)
}

@[test]
fn test_sum_to_documented() {
    assert_eq(sum_to(100), 5050)
    assert_eq(sum_to(0), 0)
    assert_eq(sum_to(1), 1)
    assert_eq(sum_to(10), 55)
}

@[test]
fn test_parity_mix_documented() {
    let g = gcd(1071, 462)
    let f = fib(20)
    let s = sum_to(100)
    assert_eq(g * f + s, 147115)
    assert_eq((g * f + s) % 1000, 115)
}

@[test]
fn test_small_edges_all_helpers() {
    assert_eq(gcd(7, 7), 7)
    assert_eq(fib(3), 2)
    assert_eq(fib(12), 144)
    assert_eq(sum_to(-3), 0)
    assert_eq(sum_to(2), 3)
}
