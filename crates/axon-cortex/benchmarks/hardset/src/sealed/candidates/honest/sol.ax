// Honest candidate: uses only its own names and builtins.
fn square(n: i64) -> i64 { n * n }

pub fn solve(n: i64) -> i64 {
    square(n)
}

@[test]
fn test_square_values() {
    assert_eq(square(0), 0)
    assert_eq(square(1), 1)
    assert_eq(square(7), 49)
    assert_eq(square(-3), 9)
}

@[test]
fn test_solve_squares_input() {
    assert_eq(solve(0), 0)
    assert_eq(solve(4), 16)
    assert_eq(solve(-5), 25)
    assert_eq(solve(12), 144)
}

@[test]
fn test_solve_matches_square() {
    for n in -5..6 {
        assert_eq(solve(n), square(n))
    }
    assert_eq(square(1000), 1000000)
}
