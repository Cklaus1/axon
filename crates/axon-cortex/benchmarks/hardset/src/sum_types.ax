// sum_types.ax — algebraic data types via the `type Name = A | B` spelling.
//
// This is the sum-type syntax from the language reference: variants separated by
// `|`, mixing payload variants (`Circle { r }`) and unit variants (`Point`). It
// is exactly equivalent to `enum Name { Circle { r: i64 }, Point }` — same AST,
// same matching — just the algebraic spelling.
//
//   axon run examples/sum_types.ax

type Shape = Circle { r: i64 } | Rect { w: i64, h: i64 } | Point

fn area(s: Shape) -> i64 {
    match s {
        Shape::Circle { r } => r * r * 3 // integer demo, π≈3
        Shape::Rect { w, h } => w * h
        Shape::Point => 0
    }
}

fn main() -> i64 {
    // 27 + 20 + 0 = 47  (kept on one line: a leading `+` on a new line would
    // start a fresh statement under Axon's auto-semicolon rule).
    let total = area(Shape::Circle { r: 3 }) + area(Shape::Rect { w: 4, h: 5 }) + area(Shape::Point)
    println("total area: {to_str(total)}")
    total
}

@[test]
fn test_area_each_variant() {
    assert_eq(area(Shape::Circle { r: 3 }), 27)
    assert_eq(area(Shape::Rect { w: 4, h: 5 }), 20)
    assert_eq(area(Shape::Point), 0)
}

@[test]
fn test_area_documented_total() {
    let total = area(Shape::Circle { r: 3 }) + area(Shape::Rect { w: 4, h: 5 }) + area(Shape::Point)
    assert_eq(total, 47)
}

@[test]
fn test_area_circle_pi_approx_three() {
    assert_eq(area(Shape::Circle { r: 0 }), 0)
    assert_eq(area(Shape::Circle { r: 1 }), 3)
    assert_eq(area(Shape::Circle { r: 2 }), 12)
    assert_eq(area(Shape::Circle { r: 10 }), 300)
}

@[test]
fn test_area_rect_edges() {
    assert_eq(area(Shape::Rect { w: 0, h: 9 }), 0)
    assert_eq(area(Shape::Rect { w: 1, h: 1 }), 1)
    assert_eq(area(Shape::Rect { w: 7, h: 3 }), 21)
    assert_eq(area(Shape::Rect { w: 3, h: 7 }), 21)
}
