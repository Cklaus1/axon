// Destination counting and attack detection on an 8x8 board.

fn square_index(sq: str) -> i64 {
    if len(sq) != 2 {
        return -1
    }
    let file = char_at(sq, 0) - 97
    let rank = char_at(sq, 1) - 49
    if file < 0 || file > 7 || rank < 0 || rank > 7 {
        return -1
    }
    rank * 8 + file
}

fn on_board(file: i64, rank: i64) -> bool {
    file >= 0 && file < 8 && rank >= 0 && rank < 8
}

fn square_name(file: i64, rank: i64) -> str {
    chr(97 + file) + chr(49 + rank)
}

fn step_sign(d: i64) -> i64 {
    if d > 0 {
        1
    } else if d < 0 {
        -1
    } else {
        0
    }
}

fn path_clear(f1: i64, r1: i64, f2: i64, r2: i64, occupied: [str]) -> bool {
    let sf = step_sign(f2 - f1)
    let sr = step_sign(r2 - r1)
    let f = f1 + sf
    let r = r1 + sr
    while f != f2 || r != r2 {
        if arr_contains(occupied, square_name(f, r)) {
            return false
        }
        f = f + sf
        r = r + sr
    }
    true
}

fn count_moves(piece: str, from: str, friendly: [str], enemy: [str]) -> i64 {
    let origin = square_index(from)
    if origin < 0 {
        return -1
    }
    let rook_dirs = [1, 0, -1, 0, 0, 1, 0, -1]
    let bishop_dirs = [1, 1, 1, -1, -1, 1, -1, -1]
    let steps: [i64] = []
    let sliding = true
    if piece == "king" {
        steps = arr_concat(rook_dirs, bishop_dirs)
        sliding = false
    } else if piece == "knight" {
        steps = [1, 2, 2, 1, 2, -1, 1, -2, -1, -2, -2, -1, -2, 1, -1, 2]
        sliding = false
    } else if piece == "rook" {
        steps = rook_dirs
    } else if piece == "bishop" {
        steps = bishop_dirs
    } else if piece == "queen" {
        steps = arr_concat(rook_dirs, bishop_dirs)
    } else {
        return -1
    }
    let count = 0
    let k = 0
    while k < len(steps) {
        let df = steps[k]
        let dr = steps[k + 1]
        let f = origin % 8 + df
        let r = origin / 8 + dr
        let going = true
        while going && on_board(f, r) {
            let name = square_name(f, r)
            if arr_contains(friendly, name) {
                going = false
            } else {
                count = count + 1
                going = sliding && !arr_contains(enemy, name)
                f = f + df
                r = r + dr
            }
        }
        k = k + 2
    }
    count
}

fn is_attacked(king_sq: str, enemies: [str], friendly: [str]) -> bool {
    let target = square_index(king_sq)
    if target < 0 {
        return false
    }
    let tf = target % 8
    let tr = target / 8
    let occupied = friendly
    for e in enemies {
        occupied = arr_push(occupied, str_slice(e, 1, len(e)))
    }
    for e in enemies {
        let kind = str_slice(e, 0, 1)
        let at = square_index(str_slice(e, 1, len(e)))
        if at >= 0 {
            let df = tf - at % 8
            let dr = tr - at / 8
            let adf = abs_i64(df)
            let adr = abs_i64(dr)
            let hits = false
            if kind == "K" {
                hits = max_i64(adf, adr) == 1
            } else if kind == "N" {
                hits = (adf == 1 && adr == 2) || (adf == 2 && adr == 1)
            } else {
                let straight = (df == 0) != (dr == 0)
                let diagonal = adf == adr && adf > 0
                let aligned = (kind == "R" && straight) || (kind == "B" && diagonal) || (kind == "Q" && (straight || diagonal))
                hits = aligned && path_clear(at % 8, at / 8, tf, tr, occupied)
            }
            if hits {
                return true
            }
        }
    }
    false
}

@[test]
fn test_square_index() {
    assert_eq(square_index("a1"), 0)
    assert_eq(square_index("h8"), 63)
    assert_eq(square_index("d4"), 27)
    assert_eq(square_index("i1"), -1)
    assert_eq(square_index("a9"), -1)
    assert_eq(square_index("a10"), -1)
}

@[test]
fn test_on_board_and_name() {
    assert(on_board(0, 7))
    assert(!on_board(8, 0))
    assert(!on_board(3, -1))
    assert_eq_str(square_name(4, 3), "e4")
}

@[test]
fn test_step_sign() {
    assert_eq(step_sign(5), 1)
    assert_eq(step_sign(-2), -1)
    assert_eq(step_sign(0), 0)
}

@[test]
fn test_path_clear() {
    assert(path_clear(0, 0, 0, 7, ["b2"]))
    assert(!path_clear(0, 0, 0, 7, ["a4"]))
    assert(path_clear(0, 0, 1, 1, ["b2"]))
}

@[test]
fn test_count_moves_knight() {
    assert_eq(count_moves("knight", "a1", [], []), 2)
    assert_eq(count_moves("knight", "d4", ["e6"], ["c6"]), 7)
}

@[test]
fn test_count_moves_king() {
    assert_eq(count_moves("king", "e1", ["d1", "f1"], []), 3)
    assert_eq(count_moves("king", "e4", [], ["e5"]), 8)
}

@[test]
fn test_count_moves_sliders_open_board() {
    assert_eq(count_moves("rook", "a1", [], []), 14)
    assert_eq(count_moves("bishop", "d4", [], []), 13)
    assert_eq(count_moves("queen", "d4", [], []), 27)
}

@[test]
fn test_count_moves_sliders_blocked() {
    assert_eq(count_moves("rook", "d4", ["d6"], ["d2"]), 10)
    assert_eq(count_moves("queen", "a1", ["a2", "b1", "b2"], []), 0)
    assert_eq(count_moves("bishop", "c1", ["b2"], ["e3"]), 2)
}

@[test]
fn test_count_moves_invalid_input() {
    assert_eq(count_moves("pawn", "e2", [], []), -1)
    assert_eq(count_moves("rook", "z9", [], []), -1)
}

@[test]
fn test_is_attacked_by_slider() {
    assert(is_attacked("a1", ["Ra8"], []))
    assert(!is_attacked("a1", ["Ra8"], ["a4"]))
    assert(is_attacked("a1", ["Bh8"], []))
    assert(!is_attacked("a1", ["Bh7"], []))
}

@[test]
fn test_is_attacked_by_knight_and_king() {
    assert(is_attacked("e4", ["Nf2"], []))
    assert(!is_attacked("e4", ["Nf3"], []))
    assert(is_attacked("e4", ["Kd5"], []))
    assert(!is_attacked("e4", ["Kc4"], []))
}

@[test]
fn test_is_attacked_queen_screened_by_enemy() {
    assert(!is_attacked("e1", ["Qe8", "Ne5"], []))
    assert(is_attacked("e1", ["Qe8", "Na5"], []))
    assert(!is_attacked("e1", ["Re8"], ["e2"]))
}

@[test]
fn test_is_attacked_invalid_and_empty() {
    assert(!is_attacked("x0", ["Qe8"], []))
    assert(!is_attacked("e1", [], []))
    assert(!is_attacked("e1", ["Pe2"], []))
}
