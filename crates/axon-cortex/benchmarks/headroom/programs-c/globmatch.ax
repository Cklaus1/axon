// Glob matching: `*`, `?`, character classes, and a path-aware variant.

fn class_end(pat: str, open: i64) -> i64 {
    let n = len(pat)
    let j = open + 1
    if j < n && char_at(pat, j) == 33 {
        j = j + 1
    }
    if j < n && char_at(pat, j) == 93 {
        j = j + 1
    }
    while j < n && char_at(pat, j) != 93 {
        j = j + 1
    }
    if j < n {
        j
    } else {
        -1
    }
}

fn class_matches(pat: str, lo: i64, hi: i64, c: i64) -> bool {
    let negate = false
    let j = lo
    if j < hi && char_at(pat, j) == 33 {
        negate = true
        j = j + 1
    }
    let found = false
    while j < hi {
        let first = char_at(pat, j)
        if j + 2 < hi && char_at(pat, j + 1) == 45 {
            let last = char_at(pat, j + 2)
            if c >= first && c <= last {
                found = true
            }
            j = j + 3
        } else {
            if c == first {
                found = true
            }
            j = j + 1
        }
    }
    if negate {
        !found
    } else {
        found
    }
}

fn glob_match(pat: str, text: str) -> bool {
    let pn = len(pat)
    let tn = len(text)
    let pi = 0
    let ti = 0
    let star_p = -1
    let star_t = 0
    while ti < tn {
        let advanced = false
        if pi < pn {
            let pc = char_at(pat, pi)
            let tc = char_at(text, ti)
            if pc == 42 {
                star_p = pi
                star_t = ti
                pi = pi + 1
                advanced = true
            } else if pc == 91 && class_end(pat, pi) > 0 {
                let close = class_end(pat, pi)
                if class_matches(pat, pi + 1, close, tc) {
                    pi = close + 1
                    ti = ti + 1
                    advanced = true
                }
            } else if pc == 63 || pc == tc {
                pi = pi + 1
                ti = ti + 1
                advanced = true
            }
        }
        if !advanced {
            if star_p < 0 {
                return false
            }
            star_t = star_t + 1
            ti = star_t
            pi = star_p + 1
        }
    }
    while pi < pn && char_at(pat, pi) == 42 {
        pi = pi + 1
    }
    pi == pn
}

fn path_match_from(pat: str, pi: i64, text: str, ti: i64) -> bool {
    let pn = len(pat)
    let tn = len(text)
    if pi == pn {
        return ti == tn
    }
    let pc = char_at(pat, pi)
    if pc == 42 {
        if pi + 1 < pn && char_at(pat, pi + 1) == 42 {
            let rest = pi + 2
            if rest < pn && char_at(pat, rest) == 47 && path_match_from(pat, rest + 1, text, ti) {
                return true
            }
            let k = ti
            while k <= tn {
                if path_match_from(pat, rest, text, k) {
                    return true
                }
                k = k + 1
            }
            return false
        }
        let k = ti
        while k <= tn {
            if path_match_from(pat, pi + 1, text, k) {
                return true
            }
            if k < tn && char_at(text, k) == 47 {
                return false
            }
            k = k + 1
        }
        return false
    }
    if ti >= tn {
        return false
    }
    let tc = char_at(text, ti)
    if pc == 63 {
        return tc != 47 && path_match_from(pat, pi + 1, text, ti + 1)
    }
    if pc == 91 {
        let close = class_end(pat, pi)
        if close > 0 {
            return tc != 47 && class_matches(pat, pi + 1, close, tc) && path_match_from(pat, close + 1, text, ti + 1)
        }
    }
    pc == tc && path_match_from(pat, pi + 1, text, ti + 1)
}

fn path_match(pat: str, text: str) -> bool {
    path_match_from(pat, 0, text, 0)
}

fn count_matching(names: [str], pat: str, path_aware: bool) -> i64 {
    let count = 0
    for name in names {
        let ok = if path_aware {
            path_match(pat, name)
        } else {
            glob_match(pat, name)
        }
        if ok {
            count = count + 1
        }
    }
    count
}

@[test]
fn test_class_end_simple() {
    assert_eq(class_end("[abc]x", 0), 4)
}

@[test]
fn test_class_end_leading_bracket_and_unclosed() {
    assert_eq(class_end("a[]x]", 1), 4)
    assert_eq(class_end("[!]]", 0), 3)
    assert_eq(class_end("[abc", 0), -1)
}

@[test]
fn test_class_matches_members() {
    assert(class_matches("[abc]", 1, 4, 98))
    assert(!class_matches("[abc]", 1, 4, 100))
}

@[test]
fn test_class_matches_range() {
    assert(class_matches("[a-z0-9]", 1, 7, 109))
    assert(class_matches("[a-z0-9]", 1, 7, 53))
    assert(!class_matches("[a-z0-9]", 1, 7, 77))
}

@[test]
fn test_class_matches_negated() {
    assert(!class_matches("[!x]", 1, 3, 120))
    assert(class_matches("[!x]", 1, 3, 121))
    assert(class_matches("[!a-c]", 1, 5, 100))
}

@[test]
fn test_glob_literal_and_question() {
    assert(glob_match("abc", "abc"))
    assert(glob_match("a?c", "axc"))
    assert(!glob_match("a?c", "ac"))
    assert(!glob_match("abc", "abcd"))
}

@[test]
fn test_glob_star_backtracking() {
    assert(glob_match("a*b*c", "axxbyyc"))
    assert(glob_match("*.txt", "notes.txt"))
    assert(!glob_match("*.txt", "notes.txt.bak"))
    assert(glob_match("a*", "a"))
    assert(glob_match("**", ""))
}

@[test]
fn test_glob_classes() {
    assert(glob_match("file[0-9].log", "file7.log"))
    assert(!glob_match("file[0-9].log", "fileA.log"))
    assert(glob_match("[!.]*", "readme"))
    assert(!glob_match("[!.]*", ".hidden"))
}

@[test]
fn test_glob_unclosed_bracket_is_literal() {
    assert(glob_match("a[b", "a[b"))
    assert(!glob_match("a[b", "ab"))
}

@[test]
fn test_glob_star_crosses_slash() {
    assert(glob_match("src/*.rs", "src/a/b.rs"))
}

@[test]
fn test_path_from_single_star_stays_in_segment() {
    assert(path_match_from("src/*.rs", 0, "src/main.rs", 0))
    assert(!path_match_from("src/*.rs", 0, "src/a/b.rs", 0))
}

@[test]
fn test_path_from_double_star() {
    assert(path_match_from("src/**/*.rs", 0, "src/a/b/c.rs", 0))
    assert(path_match_from("src/**/*.rs", 0, "src/c.rs", 0))
    assert(path_match_from("**", 0, "x/y/z", 0))
    assert(!path_match_from("src/**/*.rs", 0, "lib/c.rs", 0))
}

@[test]
fn test_path_from_question_and_class_reject_slash() {
    assert(!path_match_from("a?b", 0, "a/b", 0))
    assert(!path_match_from("a[!x]b", 0, "a/b", 0))
    assert(path_match_from("a[!x]b", 0, "a-b", 0))
}

@[test]
fn test_path_from_offsets() {
    assert(path_match_from("xx*.md", 2, "dir/readme.md", 4))
    assert(!path_match_from("abc", 3, "abc", 2))
}

@[test]
fn test_path_match_wrapper() {
    assert(path_match("docs/*/index.html", "docs/api/index.html"))
    assert(!path_match("docs/*/index.html", "docs/api/v1/index.html"))
}

@[test]
fn test_count_matching_plain() {
    let names = ["a.txt", "b.txt", "c.md", "d/e.txt"]
    assert_eq(count_matching(names, "*.txt", false), 3)
}

@[test]
fn test_count_matching_path_aware() {
    let names = ["a.txt", "b.txt", "c.md", "d/e.txt"]
    assert_eq(count_matching(names, "*.txt", true), 2)
    assert_eq(count_matching(names, "**.txt", true), 3)
    assert_eq(count_matching([], "*", true), 0)
}
