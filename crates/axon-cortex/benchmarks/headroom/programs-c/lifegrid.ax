// Conway's Game of Life on a bounded grid of 0/1 cells stored row by row.

fn parse_rows(rows: [str]) -> [i64] {
    let out = []
    for row in rows {
        for ch in str_chars(row) {
            if ch == "#" {
                out = arr_push(out, 1)
            } else {
                out = arr_push(out, 0)
            }
        }
    }
    out
}

fn population(grid: [i64]) -> i64 {
    arr_sum_i64(grid)
}

fn grids_equal(a: [i64], b: [i64]) -> bool {
    if len(a) != len(b) {
        return false
    }
    for i in 0..len(a) {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn step_grid(grid: [i64], width: i64, height: i64) -> [i64] {
    if width <= 0 || height <= 0 || len(grid) != width * height {
        return []
    }
    let next = arr_repeat(0, width * height)
    for y in 0..height {
        for x in 0..width {
            let count = 0
            for dy in -1..2 {
                for dx in -1..2 {
                    let nx = x + dx
                    let ny = y + dy
                    let inside = nx >= 0 && nx < width && ny >= 0 && ny < height
                    if (dx != 0 || dy != 0) && inside {
                        count = count + grid[ny * width + nx]
                    }
                }
            }
            let alive = grid[y * width + x] == 1
            if alive && (count == 2 || count == 3) {
                next[y * width + x] = 1
            } else if !alive && count == 3 {
                next[y * width + x] = 1
            }
        }
    }
    next
}

fn population_after(grid: [i64], width: i64, height: i64, steps: i64) -> i64 {
    if len(grid) != width * height {
        return -1
    }
    let current = grid
    let remaining = steps
    let settled = false
    while remaining > 0 && !settled {
        if population(current) == 0 {
            settled = true
        } else {
            let next = step_grid(current, width, height)
            if grids_equal(next, current) {
                settled = true
            } else {
                current = next
                remaining = remaining - 1
            }
        }
    }
    population(current)
}

fn is_still_life(grid: [i64], width: i64, height: i64) -> bool {
    population(grid) > 0 && grids_equal(step_grid(grid, width, height), grid)
}

fn is_period_two(grid: [i64], width: i64, height: i64) -> bool {
    let once = step_grid(grid, width, height)
    if grids_equal(once, grid) || population(once) == 0 {
        return false
    }
    grids_equal(step_grid(once, width, height), grid)
}

fn bounding_box(grid: [i64], width: i64, height: i64) -> [i64] {
    if width <= 0 || len(grid) != width * height {
        return []
    }
    let min_x = width
    let max_x = -1
    let min_y = height
    let max_y = -1
    for i in 0..len(grid) {
        if grid[i] == 1 {
            let x = i % width
            let y = i / width
            if x < min_x {
                min_x = x
            }
            if x > max_x {
                max_x = x
            }
            if y < min_y {
                min_y = y
            }
            if y > max_y {
                max_y = y
            }
        }
    }
    if max_x < 0 {
        return [0, 0]
    }
    [max_x - min_x + 1, max_y - min_y + 1]
}

fn block() -> [i64] {
    parse_rows(["....", ".##.", ".##.", "...."])
}

fn blinker() -> [i64] {
    parse_rows([".....", "..#..", "..#..", "..#..", "....."])
}

fn glider() -> [i64] {
    parse_rows([".#....", "..#...", "###...", "......", "......", "......"])
}

@[test]
fn test_parse_rows_marks_live_cells() {
    let g = parse_rows(["#.", ".#"])
    assert_eq(len(g), 4)
    assert_eq(g[0], 1)
    assert_eq(g[1], 0)
    assert_eq(g[3], 1)
}

@[test]
fn test_grids_equal_cases() {
    assert(grids_equal([1, 0], [1, 0]))
    assert(!grids_equal([1, 0], [0, 1]))
    assert(!grids_equal([1], [1, 0]))
}

@[test]
fn test_step_grid_block_unchanged() {
    assert(grids_equal(step_grid(block(), 4, 4), block()))
}

@[test]
fn test_step_grid_blinker_rotates() {
    let horizontal = parse_rows([".....", ".....", ".###.", ".....", "....."])
    assert(grids_equal(step_grid(blinker(), 5, 5), horizontal))
}

@[test]
fn test_step_grid_corner_birth() {
    let next = step_grid(parse_rows(["##.", "#..", "..."]), 3, 3)
    assert_eq(next[4], 1)
    assert_eq(population(next), 4)
}

@[test]
fn test_step_grid_lonely_cell_dies() {
    assert_eq(population(step_grid(parse_rows(["...", ".#.", "..."]), 3, 3)), 0)
}

@[test]
fn test_step_grid_bad_shape() {
    assert_eq(len(step_grid([1, 0, 1], 2, 2)), 0)
    assert_eq(len(step_grid([], 0, 0)), 0)
}

@[test]
fn test_population_after_glider_hits_wall() {
    assert_eq(population_after(glider(), 6, 6, 0), 5)
    assert_eq(population_after(glider(), 6, 6, 13), 4)
    assert_eq(population_after(glider(), 6, 6, 14), 3)
    assert_eq(population_after(glider(), 6, 6, 40), 4)
}

@[test]
fn test_population_after_dies_out() {
    assert_eq(population_after(parse_rows(["#..", "...", "..#"]), 3, 3, 5), 0)
}

@[test]
fn test_population_after_still_and_oscillating() {
    assert_eq(population_after(block(), 4, 4, 1000), 4)
    assert_eq(population_after(blinker(), 5, 5, 7), 3)
}

@[test]
fn test_population_after_bad_shape() {
    assert_eq(population_after([1, 1], 3, 3, 2), -1)
}

@[test]
fn test_is_still_life() {
    assert(is_still_life(block(), 4, 4))
    assert(is_still_life(parse_rows(["##", "##"]), 2, 2))
    assert(!is_still_life(blinker(), 5, 5))
    assert(!is_still_life(arr_repeat(0, 9), 3, 3))
}

@[test]
fn test_is_period_two() {
    assert(is_period_two(blinker(), 5, 5))
    assert(!is_period_two(block(), 4, 4))
    assert(!is_period_two(glider(), 6, 6))
    assert(!is_period_two(parse_rows(["#..", "...", "..."]), 3, 3))
}

@[test]
fn test_bounding_box_empty_grid() {
    let b = bounding_box(arr_repeat(0, 12), 4, 3)
    assert_eq(b[0], 0)
    assert_eq(b[1], 0)
}

@[test]
fn test_bounding_box_glider() {
    let b = bounding_box(glider(), 6, 6)
    assert_eq(b[0], 3)
    assert_eq(b[1], 3)
}

@[test]
fn test_bounding_box_spread_cells() {
    let b = bounding_box(parse_rows(["......", "..#...", "......", ".....#"]), 6, 4)
    assert_eq(b[0], 4)
    assert_eq(b[1], 3)
}

@[test]
fn test_bounding_box_invalid() {
    assert_eq(len(bounding_box([1, 1, 1], 2, 2)), 0)
    assert_eq(len(bounding_box([], 0, 0)), 0)
}

@[test]
fn test_bounding_box_after_step() {
    let b = bounding_box(step_grid(glider(), 6, 6), 6, 6)
    assert_eq(b[0], 3)
    assert_eq(b[1], 3)
}
