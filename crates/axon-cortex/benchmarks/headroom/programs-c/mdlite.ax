// A lightweight markup analyzer: headings, list items, paragraphs, emphasis.

fn heading_level(line: str) -> i64 {
    let n = len(line)
    let level = 0
    while level < n && char_at(line, level) == 35 {
        level = level + 1
    }
    if level == 0 || level > 3 {
        return 0
    }
    if level == n || char_at(line, level) == 32 {
        level
    } else {
        0
    }
}

fn is_list_item(line: str) -> bool {
    str_starts_with(line, "- ")
}

fn count_headings(lines: [str], level: i64) -> i64 {
    arr_count_if(lines, |l| heading_level(l) == level)
}

fn count_list_items(lines: [str]) -> i64 {
    arr_count_if(lines, |l| is_list_item(l))
}

fn count_paragraphs(lines: [str]) -> i64 {
    let count = 0
    let in_para = false
    let in_list = false
    for raw in lines {
        let line = str_trim(raw)
        if len(line) == 0 {
            in_para = false
            in_list = false
        } else if heading_level(raw) > 0 {
            in_para = false
            in_list = false
        } else if is_list_item(raw) {
            in_para = false
            in_list = true
        } else if in_list && str_starts_with(raw, "  ") {
            in_list = true
        } else if !in_para {
            count = count + 1
            in_para = true
            in_list = false
        }
    }
    count
}

fn outline(lines: [str]) -> str {
    let parts: [str] = []
    let h1 = 0
    let h2 = 0
    let h3 = 0
    for line in lines {
        let level = heading_level(line)
        if level > 0 {
            let number = ""
            if level == 1 {
                h1 = h1 + 1
                h2 = 0
                h3 = 0
                number = to_str(h1)
            } else if level == 2 {
                h2 = h2 + 1
                h3 = 0
                number = to_str(h1) + "." + to_str(h2)
            } else {
                h3 = h3 + 1
                number = to_str(h1) + "." + to_str(h2) + "." + to_str(h3)
            }
            let title = str_trim(str_slice(line, level, len(line)))
            if len(title) == 0 {
                title = "(untitled)"
            }
            parts = arr_push(parts, str_repeat("  ", level - 1) + number + " " + title)
        }
    }
    str_join(parts, "\n")
}

fn emphasis_spans(line: str) -> [i64] {
    let n = len(line)
    let closed = 0
    let unclosed = 0
    let open = -1
    let i = 0
    while i < n {
        let c = char_at(line, i)
        if c == 92 {
            i = i + 2
        } else if c == 42 {
            let prev = if i > 0 { char_at(line, i - 1) } else { 32 }
            let next = if i + 1 < n { char_at(line, i + 1) } else { 32 }
            let can_open = next != 32 && next != 42
            if open >= 0 && prev != 32 && i > open + 1 {
                closed = closed + 1
                open = -1
            } else if can_open {
                if open >= 0 {
                    unclosed = unclosed + 1
                }
                open = i
            }
            i = i + 1
        } else {
            i = i + 1
        }
    }
    if open >= 0 {
        unclosed = unclosed + 1
    }
    [closed, unclosed]
}

fn emphasis_totals(lines: [str]) -> [i64] {
    let closed = 0
    let unclosed = 0
    for line in lines {
        let spans = emphasis_spans(line)
        closed = closed + spans[0]
        unclosed = unclosed + spans[1]
    }
    [closed, unclosed]
}

fn summarize(lines: [str]) -> str {
    let emph = emphasis_totals(lines)
    "h1=" + to_str(count_headings(lines, 1)) + " h2=" + to_str(count_headings(lines, 2)) + " h3=" + to_str(count_headings(lines, 3)) + " items=" + to_str(count_list_items(lines)) + " paragraphs=" + to_str(count_paragraphs(lines)) + " emph=" + to_str(emph[0]) + "/" + to_str(emph[1])
}

@[test]
fn test_heading_level_valid() {
    assert_eq(heading_level("# Title"), 1)
    assert_eq(heading_level("### Deep"), 3)
    assert_eq(heading_level("##"), 2)
}

@[test]
fn test_heading_level_invalid() {
    assert_eq(heading_level("#### Too deep"), 0)
    assert_eq(heading_level("#nospace"), 0)
    assert_eq(heading_level("plain"), 0)
}

@[test]
fn test_is_list_item() {
    assert(is_list_item("- milk"))
    assert(!is_list_item("-milk"))
    assert(!is_list_item("  - nested"))
}

@[test]
fn test_count_headings_and_items() {
    let doc = ["# A", "## B", "## C", "- x", "- y", "text"]
    assert_eq(count_headings(doc, 2), 2)
    assert_eq(count_headings(doc, 3), 0)
    assert_eq(count_list_items(doc), 2)
}

@[test]
fn test_paragraphs_blank_separated() {
    assert_eq(count_paragraphs(["one", "still one", "", "two", "   ", "three"]), 3)
}

@[test]
fn test_paragraphs_broken_by_headings_and_lists() {
    assert_eq(count_paragraphs(["intro", "# Head", "after head", "- item", "after item"]), 3)
}

@[test]
fn test_paragraphs_list_continuation() {
    assert_eq(count_paragraphs(["- item", "  continued", "  more", "", "  indented para"]), 1)
    assert_eq(count_paragraphs([]), 0)
}

@[test]
fn test_outline_numbering() {
    let doc = ["# Intro", "text", "## Setup", "### Linux", "## Usage", "# Notes"]
    assert_eq_str(outline(doc), "1 Intro\n  1.1 Setup\n    1.1.1 Linux\n  1.2 Usage\n2 Notes")
}

@[test]
fn test_outline_untitled_and_orphan() {
    assert_eq_str(outline(["## Orphan", "#"]), "  0.1 Orphan\n1 (untitled)")
}

@[test]
fn test_outline_no_headings() {
    assert_eq_str(outline(["just text", "- item"]), "")
}

@[test]
fn test_emphasis_well_formed() {
    let s = emphasis_spans("a *b* and *c d* end")
    assert_eq(s[0], 2)
    assert_eq(s[1], 0)
}

@[test]
fn test_emphasis_unclosed() {
    let s = emphasis_spans("*open and *again*")
    assert_eq(s[0], 1)
    assert_eq(s[1], 1)
    let t = emphasis_spans("dangling *star")
    assert_eq(t[1], 1)
}

@[test]
fn test_emphasis_ignored_stars() {
    let s = emphasis_spans("2 * 3 and \\*literal\\* and **")
    assert_eq(s[0], 0)
    assert_eq(s[1], 0)
}

@[test]
fn test_emphasis_double_star_bold() {
    let s = emphasis_spans("**bold**")
    assert_eq(s[0], 1)
    assert_eq(s[1], 0)
}

@[test]
fn test_emphasis_totals() {
    let t = emphasis_totals(["*a*", "*b", "plain"])
    assert_eq(t[0], 1)
    assert_eq(t[1], 1)
}

@[test]
fn test_summarize() {
    let doc = ["# T", "para *x*", "", "## S", "- a", "- b *c", "tail"]
    assert_eq_str(summarize(doc), "h1=1 h2=1 h3=0 items=2 paragraphs=2 emph=1/1")
}
