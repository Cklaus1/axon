// A tiny stack machine. Instructions are strings:
// push N, add, sub, mul, dup, swap, pop, jz K, jmp K, halt.
// Opcodes: 1 push, 2 add, 3 sub, 4 mul, 5 dup, 6 swap, 7 pop, 8 jz, 9 jmp, 10 halt.
// Error codes: -1 stack underflow, -2 bad instruction, -3 step limit, -4 bad jump.

fn parse_instr(text: str) -> [i64] {
    let parts = arr_filter(str_split(str_trim(text), " "), |p| len(p) > 0)
    if len(parts) == 0 {
        return [-1, 0]
    }
    let name = str_to_lower(parts[0])
    let with_arg = match name {
        "push" => 1,
        "jz" => 8,
        "jmp" => 9,
        _ => 0
    }
    if with_arg > 0 {
        if len(parts) != 2 {
            return [-1, 0]
        }
        let (ok, arg) = match parse_int(parts[1]) {
            Ok(v) => (true, v),
            Err(_) => (false, 0)
        }
        if !ok {
            return [-1, 0]
        }
        return [with_arg, arg]
    }
    if len(parts) != 1 {
        return [-1, 0]
    }
    let op = match name {
        "add" => 2,
        "sub" => 3,
        "mul" => 4,
        "dup" => 5,
        "swap" => 6,
        "pop" => 7,
        "halt" => 10,
        _ => -1
    }
    [op, 0]
}

fn pops_needed(op: i64) -> i64 {
    if op >= 2 && op <= 4 || op == 6 {
        2
    } else if op == 5 || op == 7 || op == 8 {
        1
    } else {
        0
    }
}

fn stack_effect(op: i64) -> i64 {
    if op == 1 || op == 5 {
        1
    } else if op >= 2 && op <= 4 || op == 7 || op == 8 {
        -1
    } else {
        0
    }
}

fn validate(program: [str]) -> i64 {
    let n = len(program)
    let decoded = arr_map(program, |s| parse_instr(s))
    let i = 0
    while i < n {
        let ins = decoded[i]
        if ins[0] < 0 {
            return i
        }
        if ins[0] == 8 || ins[0] == 9 {
            if ins[1] < 0 || ins[1] >= n {
                return i
            }
            if ins[0] == 9 && ins[1] == i {
                return i
            }
        }
        i = i + 1
    }
    let depth = 0
    let k = 0
    while k < n {
        let op = decoded[k][0]
        if depth < pops_needed(op) {
            return k
        }
        depth = depth + stack_effect(op)
        if op == 8 || op == 9 || op == 10 {
            break
        }
        k = k + 1
    }
    -1
}

fn run(program: [str], max_steps: i64) -> i64 {
    let n = len(program)
    let stack: [i64] = []
    let pc = 0
    let steps = 0
    while pc < n {
        if steps >= max_steps {
            return -3
        }
        steps = steps + 1
        let ins = parse_instr(program[pc])
        let op = ins[0]
        if op < 0 {
            return -2
        }
        let depth = len(stack)
        if depth < pops_needed(op) {
            return -1
        }
        pc = pc + 1
        if op == 1 {
            stack = arr_push(stack, ins[1])
        } else if op >= 2 && op <= 4 {
            let b = stack[depth - 1]
            let a = stack[depth - 2]
            let r = if op == 2 { wrapping_add(a, b) } else if op == 3 { wrapping_sub(a, b) } else { wrapping_mul(a, b) }
            stack = arr_push(arr_take(stack, depth - 2), r)
        } else if op == 5 {
            stack = arr_push(stack, stack[depth - 1])
        } else if op == 6 {
            let top = stack[depth - 1]
            let below = stack[depth - 2]
            stack = arr_push(arr_push(arr_take(stack, depth - 2), top), below)
        } else if op == 7 {
            stack = arr_take(stack, depth - 1)
        } else if op == 8 || op == 9 {
            let jump = op == 9
            if op == 8 {
                jump = stack[depth - 1] == 0
                stack = arr_take(stack, depth - 1)
            }
            if jump {
                if ins[1] < 0 || ins[1] >= n {
                    return -4
                }
                pc = ins[1]
            }
        } else {
            break
        }
    }
    if len(stack) == 0 {
        return -1
    }
    stack[len(stack) - 1]
}

fn run_checked(program: [str], max_steps: i64) -> i64 {
    if validate(program) >= 0 {
        return -2
    }
    run(program, max_steps)
}

fn error_name(code: i64) -> str {
    match code {
        -1 => "stack underflow",
        -2 => "bad instruction",
        -3 => "step limit",
        -4 => "bad jump",
        _ => "ok"
    }
}

fn countdown_program() -> [str] {
    ["push 3", "dup", "jz 6", "push 1", "sub", "jmp 1", "push 42", "add"]
}

@[test]
fn test_parse_instr_with_args() {
    let p = parse_instr("push -12")
    assert_eq(p[0], 1)
    assert_eq(p[1], -12)
    let j = parse_instr("  JZ   4 ")
    assert_eq(j[0], 8)
    assert_eq(j[1], 4)
}

@[test]
fn test_parse_instr_plain_ops() {
    assert_eq(parse_instr("add")[0], 2)
    assert_eq(parse_instr("swap")[0], 6)
    assert_eq(parse_instr("halt")[0], 10)
}

@[test]
fn test_parse_instr_rejects() {
    assert_eq(parse_instr("")[0], -1)
    assert_eq(parse_instr("push")[0], -1)
    assert_eq(parse_instr("push x")[0], -1)
    assert_eq(parse_instr("add 3")[0], -1)
    assert_eq(parse_instr("fly")[0], -1)
}

@[test]
fn test_stack_tables() {
    assert_eq(pops_needed(6), 2)
    assert_eq(pops_needed(8), 1)
    assert_eq(pops_needed(1), 0)
    assert_eq(stack_effect(5), 1)
    assert_eq(stack_effect(3), -1)
    assert_eq(stack_effect(9), 0)
}

@[test]
fn test_validate_accepts_good_program() {
    assert_eq(validate(countdown_program()), -1)
    assert_eq(validate([]), -1)
}

@[test]
fn test_validate_bad_text_and_jumps() {
    assert_eq(validate(["push 1", "fly"]), 1)
    assert_eq(validate(["push 1", "jz 7"]), 1)
    assert_eq(validate(["push 1", "jmp -1"]), 1)
    assert_eq(validate(["jmp 0"]), 0)
}

@[test]
fn test_validate_entry_underflow() {
    assert_eq(validate(["push 1", "add"]), 1)
    assert_eq(validate(["pop"]), 0)
    assert_eq(validate(["push 1", "jz 3", "add", "push 2"]), -1)
}

@[test]
fn test_run_arithmetic() {
    assert_eq(run(["push 7", "push 3", "sub"], 10), 4)
    assert_eq(run(["push 6", "push 7", "mul"], 10), 42)
    assert_eq(run(["push 5", "dup", "mul"], 10), 25)
    assert_eq(run(["push 1", "push 2", "swap", "sub"], 10), 1)
}

@[test]
fn test_run_pop_and_halt() {
    assert_eq(run(["push 1", "push 2", "pop"], 10), 1)
    assert_eq(run(["push 9", "halt", "push 1"], 10), 9)
}

@[test]
fn test_run_loop_and_step_limit() {
    assert_eq(run(countdown_program(), 20), 42)
    assert_eq(run(countdown_program(), 19), -3)
    assert_eq(run(["push 1", "jmp 0"], 50), -3)
}

@[test]
fn test_run_conditional_falls_through() {
    assert_eq(run(["push 5", "jz 3", "push 10", "push 1", "add"], 10), 11)
    assert_eq(run(["push 0", "jz 3", "push 10", "push 1"], 10), 1)
}

@[test]
fn test_run_errors() {
    assert_eq(run(["add"], 10), -1)
    assert_eq(run(["push 1", "pop"], 10), -1)
    assert_eq(run(["push x"], 10), -2)
    assert_eq(run(["jmp 10"], 10), -4)
}

@[test]
fn test_run_checked_rejects_before_running() {
    assert_eq(run_checked(["push 1", "jmp 9"], 10), -2)
    assert_eq(run_checked(countdown_program(), 100), 42)
}

@[test]
fn test_error_names() {
    assert_eq_str(error_name(-3), "step limit")
    assert_eq_str(error_name(-4), "bad jump")
    assert_eq_str(error_name(7), "ok")
}
