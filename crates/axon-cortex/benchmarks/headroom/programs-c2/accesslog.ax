// Parse web server access log lines (common log format) and aggregate
// status codes, request paths, transferred bytes and hourly traffic.

fn all_digits(s: str) -> bool {
    if len(s) == 0 {
        return false
    }
    let ok = true
    for c in str_chars(s) {
        if !char_is_digit(c) {
            ok = false
        }
    }
    ok
}

fn log_field(line: str, name: str) -> str {
    let open_bracket = str_index_of(line, "[")
    let close_bracket = str_index_of(line, "]")
    let first_quote = str_index_of(line, "\"")
    if open_bracket < 1 || close_bracket < open_bracket || first_quote < close_bracket {
        return ""
    }
    let rest = str_slice(line, first_quote + 1, len(line))
    let second_quote = str_index_of(rest, "\"")
    if second_quote < 0 {
        return ""
    }
    let head = str_split(str_trim(str_slice(line, 0, open_bracket)), " ")
    let request = str_split(str_slice(rest, 0, second_quote), " ")
    let tail = str_split(str_trim(str_slice(rest, second_quote + 1, len(rest))), " ")
    if name == "ip" {
        return head[0]
    }
    if name == "user" {
        if len(head) == 3 && head[2] != "-" {
            return head[2]
        }
        return ""
    }
    if name == "time" {
        return str_slice(line, open_bracket + 1, close_bracket)
    }
    if name == "method" || name == "path" || name == "protocol" {
        if len(request) != 3 {
            return ""
        }
        let idx = if name == "method" { 0 } else if name == "path" { 1 } else { 2 }
        return request[idx]
    }
    if len(tail) != 2 {
        return ""
    }
    if name == "status" && all_digits(tail[0]) && len(tail[0]) == 3 {
        return tail[0]
    }
    if name == "bytes" {
        if tail[1] == "-" {
            return "0"
        }
        if all_digits(tail[1]) {
            return tail[1]
        }
    }
    ""
}

fn status_class_counts(lines: [str]) -> [i64] {
    let counts = [0, 0, 0, 0, 0, 0]
    for raw in lines {
        let line = str_trim(raw)
        if len(line) == 0 || str_starts_with(line, "#") {
            continue
        }
        let status = log_field(line, "status")
        if status == "" {
            counts[5] = counts[5] + 1
            continue
        }
        let code = parse_int_or(status, 0)
        if code >= 100 && code < 200 {
            counts[0] = counts[0] + 1
        } else if code >= 200 && code < 300 {
            counts[1] = counts[1] + 1
        } else if code >= 300 && code < 400 {
            counts[2] = counts[2] + 1
        } else if code >= 400 && code < 500 {
            counts[3] = counts[3] + 1
        } else if code >= 500 && code < 600 {
            counts[4] = counts[4] + 1
        } else {
            counts[5] = counts[5] + 1
        }
    }
    counts
}

fn top_paths(lines: [str], limit: i64) -> [str] {
    let counts = dict_new()
    for line in lines {
        let path = log_field(line, "path")
        if path == "" {
            continue
        }
        let query = str_index_of(path, "?")
        if query >= 0 {
            path = str_slice(path, 0, query)
        }
        let fragment = str_index_of(path, "#")
        if fragment >= 0 {
            path = str_slice(path, 0, fragment)
        }
        if len(path) > 1 && str_ends_with(path, "/") {
            path = str_slice(path, 0, len(path) - 1)
        }
        if path == "" {
            path = "/"
        }
        dict_inc(counts, path)
    }
    let pairs: [(str, i64)] = dict_to_pairs(counts)
    let ranked = arr_sort_by(pairs, |a: (str, i64), b: (str, i64)| b.1 - a.1)
    let out: [str] = []
    for entry in ranked {
        if len(out) >= limit {
            break
        }
        out = arr_push(out, entry.0 + " " + to_str(entry.1))
    }
    out
}

fn bytes_summary(lines: [str]) -> str {
    let requests = 0
    let total = 0
    let largest = 0 - 1
    let largest_path = "-"
    let skipped = 0
    for line in lines {
        let bytes = log_field(line, "bytes")
        let status = log_field(line, "status")
        if bytes == "" || status == "" {
            skipped = skipped + 1
            continue
        }
        let size = parse_int_or(bytes, 0)
        requests = requests + 1
        total = total + size
        if size > largest {
            largest = size
            largest_path = log_field(line, "path")
        }
    }
    if requests == 0 {
        return "requests=0 skipped=" + to_str(skipped)
    }
    let avg = total / requests
    let summary = "requests=" + to_str(requests) + " bytes=" + to_str(total)
    summary = summary + " avg=" + to_str(avg) + " largest=" + largest_path
    if skipped > 0 {
        summary = summary + " skipped=" + to_str(skipped)
    }
    summary
}

fn requests_per_hour(lines: [str]) -> [i64] {
    let buckets = arr_repeat(0, 24)
    for line in lines {
        let stamp = log_field(line, "time")
        let parts = str_split(stamp, " ")
        if len(parts) != 2 {
            continue
        }
        let clock = str_split(parts[0], ":")
        let zone = parts[1]
        if len(clock) != 4 || len(zone) != 5 {
            continue
        }
        let hour = parse_int_or(clock[1], 0 - 1)
        let minute = parse_int_or(clock[2], 0 - 1)
        let zone_hours = parse_int_or(str_slice(zone, 1, 3), 0 - 1)
        let zone_minutes = parse_int_or(str_slice(zone, 3, 5), 0 - 1)
        if hour < 0 || hour > 23 || minute < 0 || minute > 59 || zone_hours < 0 || zone_minutes < 0 {
            continue
        }
        let offset = zone_hours * 60 + zone_minutes
        if str_starts_with(zone, "-") {
            offset = 0 - offset
        }
        let utc = (hour * 60 + minute - offset) % 1440
        if utc < 0 {
            utc = utc + 1440
        }
        buckets[utc / 60] = buckets[utc / 60] + 1
    }
    buckets
}

fn fixture_lines() -> [str] {
    [
        "192.168.1.10 - alice [10/Oct/2023:13:55:36 -0700] \"GET /index.html HTTP/1.1\" 200 2326",
        "10.0.0.5 - - [10/Oct/2023:14:02:11 +0000] \"POST /api/login?next=home HTTP/1.1\" 302 -",
        "10.0.0.5 - - [10/Oct/2023:14:05:00 +0000] \"GET /missing HTTP/1.1\" 404 512",
        "172.16.0.2 - bob [11/Oct/2023:00:30:00 +0130] \"GET /index.html HTTP/1.1\" 500 128",
        "garbage line without structure",
        "10.0.0.9 - - [10/Oct/2023:20:59:59 +0000] \"GET /api/login/ HTTP/1.1\" 200 64",
    ]
}

@[test]
fn test_field_request_parts() {
    let line = "192.168.1.10 - alice [10/Oct/2023:13:55:36 -0700] \"GET /index.html HTTP/1.1\" 200 2326"
    assert_eq_str(log_field(line, "ip"), "192.168.1.10")
    assert_eq_str(log_field(line, "user"), "alice")
    assert_eq_str(log_field(line, "method"), "GET")
    assert_eq_str(log_field(line, "path"), "/index.html")
}

@[test]
fn test_field_status_and_bytes() {
    let line = "10.0.0.5 - - [10/Oct/2023:14:02:11 +0000] \"POST /api/login HTTP/1.1\" 302 -"
    assert_eq_str(log_field(line, "status"), "302")
    assert_eq_str(log_field(line, "bytes"), "0")
    assert_eq_str(log_field(line, "time"), "10/Oct/2023:14:02:11 +0000")
}

@[test]
fn test_field_malformed() {
    assert_eq_str(log_field("no brackets here", "ip"), "")
    let bad = "1.2.3.4 - - [x] \"GET / HTTP/1.1\" 2x0 10"
    assert_eq_str(log_field(bad, "status"), "")
    assert_eq_str(log_field(bad, "protocol"), "HTTP/1.1")
}

@[test]
fn test_status_counts_fixture() {
    assert(status_class_counts(fixture_lines()) == [0, 2, 1, 1, 1, 1])
}

@[test]
fn test_status_counts_skips_comments() {
    let lines = ["# header", "", "1.1.1.1 - - [t] \"GET /a HTTP/1.0\" 101 0"]
    assert(status_class_counts(lines) == [1, 0, 0, 0, 0, 0])
}

@[test]
fn test_status_counts_out_of_range() {
    let lines = ["1.1.1.1 - - [t] \"GET /a HTTP/1.0\" 700 0", "1.1.1.1 - - [t] \"GET /b HTTP/1.0\" 503 9"]
    assert(status_class_counts(lines) == [0, 0, 0, 0, 1, 1])
}

@[test]
fn test_top_paths_ranked() {
    assert(top_paths(fixture_lines(), 2) == ["/api/login 2", "/index.html 2"])
}

@[test]
fn test_top_paths_all() {
    assert(top_paths(fixture_lines(), 10) == ["/api/login 2", "/index.html 2", "/missing 1"])
}

@[test]
fn test_top_paths_root_and_fragment() {
    let lines = ["1.1.1.1 - - [t] \"GET /?q=1 HTTP/1.0\" 200 1", "1.1.1.1 - - [t] \"GET /#top HTTP/1.0\" 200 1", "1.1.1.1 - - [t] \"GET /docs/ HTTP/1.0\" 200 1"]
    assert(top_paths(lines, 5) == ["/ 2", "/docs 1"])
}

@[test]
fn test_bytes_summary_fixture() {
    assert_eq_str(bytes_summary(fixture_lines()), "requests=5 bytes=3030 avg=606 largest=/index.html skipped=1")
}

@[test]
fn test_bytes_summary_clean() {
    let lines = ["1.1.1.1 - - [t] \"GET /a HTTP/1.0\" 200 10", "1.1.1.1 - - [t] \"GET /b HTTP/1.0\" 200 30"]
    assert_eq_str(bytes_summary(lines), "requests=2 bytes=40 avg=20 largest=/b")
}

@[test]
fn test_bytes_summary_nothing_valid() {
    assert_eq_str(bytes_summary(["junk", "more junk"]), "requests=0 skipped=2")
}

@[test]
fn test_hourly_fixture_in_utc() {
    let hours = requests_per_hour(fixture_lines())
    assert_eq(hours[20], 2)
    assert_eq(hours[14], 2)
    assert_eq(hours[23], 1)
    assert_eq(arr_sum_i64(hours), 5)
}

@[test]
fn test_hourly_wraps_past_midnight() {
    let lines = ["1.1.1.1 - - [01/Jan/2024:23:30:00 -0100] \"GET / HTTP/1.0\" 200 1"]
    let hours = requests_per_hour(lines)
    assert_eq(hours[0], 1)
    assert_eq(arr_sum_i64(hours), 1)
}

@[test]
fn test_hourly_rejects_bad_clock() {
    let lines = ["1.1.1.1 - - [01/Jan/2024:25:30:00 +0000] \"GET / HTTP/1.0\" 200 1", "1.1.1.1 - - [01/Jan/2024:05:10:00 +0000] \"GET / HTTP/1.0\" 200 1"]
    let hours = requests_per_hour(lines)
    assert_eq(hours[5], 1)
    assert_eq(arr_sum_i64(hours), 1)
}
