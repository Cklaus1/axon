type Bid = { bidder: str, amount: i64 }

// Sealed-bid first-price auction: the highest valid bid at or above the
// reserve wins and pays its own bid. Equal top bids go to the earliest one.
fn first_price(bids: [Bid], reserve: i64) -> str {
    let best_name = ""
    let best_amount = 0
    let found = false
    let tied = 0
    for b in bids {
        if b.amount <= 0 || b.amount < reserve {
            continue
        }
        if !found || b.amount > best_amount {
            best_name = b.bidder
            best_amount = b.amount
            found = true
            tied = 1
        } else if b.amount == best_amount {
            tied = tied + 1
        }
    }
    if !found {
        return "no sale"
    }
    let label = best_name + "@" + to_str(best_amount)
    if tied > 1 {
        label = label + " tie:" + to_str(tied)
    }
    label
}

// Vickrey auction: the price paid is the second-highest bid among distinct
// bidders (each bidder counts with their highest bid), never below the
// reserve. Returns 0 when no bid meets the reserve.
fn second_price(bids: [Bid], reserve: i64) -> i64 {
    let names: [str] = []
    let tops: [i64] = []
    for b in bids {
        if b.amount < reserve || b.amount <= 0 {
            continue
        }
        let idx = -1
        for i in 0..len(names) {
            if names[i] == b.bidder {
                idx = i
            }
        }
        if idx < 0 {
            names = arr_push(names, b.bidder)
            tops = arr_push(tops, b.amount)
        } else if b.amount > tops[idx] {
            tops[idx] = b.amount
        }
    }
    if len(tops) == 0 {
        return 0
    }
    let first = -1
    let second = -1
    for t in tops {
        if t > first {
            second = first
            first = t
        } else if t > second {
            second = t
        }
    }
    max_i64(second, reserve)
}

// Ascending-clock English auction. The price starts at the reserve and rises
// by `step` while at least two bidders remain willing to pay it.
fn english_auction(names: [str], values: [i64], reserve: i64, step: i64) -> str {
    if len(names) != len(values) || step <= 0 {
        return "invalid"
    }
    let price = reserve
    let active = 0
    for v in values {
        if v >= price {
            active = active + 1
        }
    }
    if active == 0 {
        return "unsold"
    }
    while active > 1 {
        let next = price + step
        let still = 0
        for v in values {
            if v >= next {
                still = still + 1
            }
        }
        if still == 0 {
            break
        }
        price = next
        active = still
    }
    let winner = -1
    for i in 0..len(values) {
        if values[i] >= price && (winner < 0 || values[i] > values[winner]) {
            winner = i
        }
    }
    names[winner] + "@" + to_str(price)
}

// Order in which bidders leave an English auction as the clock rises.
// Bidders that never leave are listed last in index order.
fn dropout_order(values: [i64], reserve: i64, step: i64) -> [i64] {
    let order: [i64] = []
    if step <= 0 {
        return order
    }
    let out = arr_repeat(false, len(values))
    let price = reserve
    let remaining = len(values)
    while remaining > 1 {
        let leaving = 0
        for i in 0..len(values) {
            if !out[i] && values[i] < price {
                leaving = leaving + 1
            }
        }
        if leaving == remaining {
            break
        }
        for i in 0..len(values) {
            if !out[i] && values[i] < price {
                out[i] = true
                order = arr_push(order, i)
                remaining = remaining - 1
            }
        }
        price = price + step
    }
    for i in 0..len(values) {
        if !out[i] {
            order = arr_push(order, i)
        }
    }
    order
}

// Picks the reserve from `candidates` that maximises second-price revenue
// for the given bids. Ties favour the lower reserve.
fn best_reserve(values: [i64], candidates: [i64]) -> i64 {
    let best = 0
    let best_revenue = -1
    for r in candidates {
        let first = -1
        let second = -1
        let valid = 0
        for v in values {
            if v >= r {
                valid = valid + 1
                if v > first {
                    second = first
                    first = v
                } else if v > second {
                    second = v
                }
            }
        }
        let revenue = 0
        if valid == 1 {
            revenue = r
        } else if valid > 1 {
            revenue = max_i64(second, r)
        }
        if revenue > best_revenue || (revenue == best_revenue && r < best) {
            best_revenue = revenue
            best = r
        }
    }
    best
}

@[test]
fn test_first_price_highest_wins() {
    let bids = [Bid { bidder: "ana", amount: 120 }, Bid { bidder: "bo", amount: 150 }, Bid { bidder: "cy", amount: 90 }]
    assert_eq_str(first_price(bids, 100), "bo@150")
}

@[test]
fn test_first_price_reserve_not_met() {
    let bids = [Bid { bidder: "ana", amount: 80 }, Bid { bidder: "bo", amount: 95 }]
    assert_eq_str(first_price(bids, 100), "no sale")
}

@[test]
fn test_first_price_tie_goes_to_earliest() {
    let bids = [Bid { bidder: "ana", amount: 200 }, Bid { bidder: "bo", amount: 200 }, Bid { bidder: "cy", amount: 150 }]
    assert_eq_str(first_price(bids, 0), "ana@200 tie:2")
}

@[test]
fn test_second_price_pays_runner_up() {
    let bids = [Bid { bidder: "ana", amount: 120 }, Bid { bidder: "bo", amount: 150 }, Bid { bidder: "cy", amount: 90 }]
    assert_eq(second_price(bids, 50), 120)
}

@[test]
fn test_second_price_single_bidder_pays_reserve() {
    let bids = [Bid { bidder: "ana", amount: 300 }, Bid { bidder: "ana", amount: 340 }, Bid { bidder: "bo", amount: 40 }]
    assert_eq(second_price(bids, 100), 100)
}

@[test]
fn test_second_price_reserve_above_runner_up() {
    let bids = [Bid { bidder: "ana", amount: 500 }, Bid { bidder: "bo", amount: 210 }, Bid { bidder: "bo", amount: 260 }]
    assert_eq(second_price(bids, 250), 260)
    assert_eq(second_price(bids, 300), 300)
}

@[test]
fn test_english_auction_runs_to_second_value() {
    assert_eq_str(english_auction(["ana", "bo", "cy"], [100, 175, 140], 50, 10), "bo@150")
}

@[test]
fn test_english_auction_unsold_below_reserve() {
    assert_eq_str(english_auction(["ana", "bo"], [40, 60], 70, 5), "unsold")
}

@[test]
fn test_english_auction_equal_values() {
    assert_eq_str(english_auction(["ana", "bo", "cy"], [90, 120, 120], 80, 25), "bo@105")
}

@[test]
fn test_dropout_order_by_value() {
    assert(dropout_order([100, 175, 140, 30], 50, 10) == [3, 0, 2, 1])
}

@[test]
fn test_dropout_order_survivors_listed() {
    assert(dropout_order([90, 90, 60], 50, 20) == [2, 0, 1])
}

@[test]
fn test_dropout_order_none_meet_reserve() {
    assert(dropout_order([10, 20], 50, 5) == [0, 1])
}

@[test]
fn test_best_reserve_raises_revenue() {
    assert_eq(best_reserve([200, 60, 50], [0, 100, 150, 250]), 150)
}

@[test]
fn test_best_reserve_competitive_bids() {
    assert_eq(best_reserve([200, 190, 50], [120, 150, 30]), 30)
}

@[test]
fn test_best_reserve_single_candidate() {
    assert_eq(best_reserve([80, 70], [75]), 75)
}
