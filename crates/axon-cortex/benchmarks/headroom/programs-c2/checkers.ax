// English draughts on an 8x8 board.
// Squares are indexed 0..63 as row * 8 + col, row 0 at the top.
// Pieces: 0 empty, 1 white man, 2 white king, 3 black man, 4 black king.
// White moves toward row 0 and black toward row 7.

fn parse_board(text: str) -> [i64] {
    let cells = str_chars(str_replace(text, "/", ""))
    let board = arr_repeat(0, 64)
    let i = 0
    for ch in cells {
        if i < 64 {
            if ch == "w" {
                board[i] = 1
            } else if ch == "W" {
                board[i] = 2
            } else if ch == "b" {
                board[i] = 3
            } else if ch == "B" {
                board[i] = 4
            }
        }
        i = i + 1
    }
    board
}

fn owner(piece: i64) -> i64 {
    if piece == 1 || piece == 2 {
        1
    } else if piece == 3 || piece == 4 {
        2
    } else {
        0
    }
}

fn may_step(piece: i64, dr: i64) -> bool {
    if piece == 2 || piece == 4 {
        true
    } else if owner(piece) == 1 {
        dr == -1
    } else {
        dr == 1
    }
}

fn crown(piece: i64, row: i64) -> i64 {
    if piece == 1 && row == 0 {
        2
    } else if piece == 3 && row == 7 {
        4
    } else {
        piece
    }
}

fn simple_moves(board: [i64], player: i64) -> [i64] {
    let moves: [i64] = []
    for sq in 0..64 {
        let piece = board[sq]
        if owner(piece) == player {
            let r = sq / 8
            let c = sq % 8
            for dr in [-1, 1] {
                if may_step(piece, dr) {
                    for dc in [-1, 1] {
                        let nr = r + dr
                        let nc = c + dc
                        if nr >= 0 && nr < 8 && nc >= 0 && nc < 8 {
                            let target = nr * 8 + nc
                            if board[target] == 0 {
                                moves = arr_push(moves, sq * 100 + target)
                            }
                        }
                    }
                }
            }
        }
    }
    moves
}

fn longest_capture(board: [i64], from: i64) -> i64 {
    let piece = board[from]
    let side = owner(piece)
    let best = 0
    if side == 0 {
        return 0
    }
    let r = from / 8
    let c = from % 8
    for dr in [-1, 1] {
        if may_step(piece, dr) {
            for dc in [-1, 1] {
                let lr = r + 2 * dr
                let lc = c + 2 * dc
                if lr >= 0 && lr < 8 && lc >= 0 && lc < 8 {
                    let mid = (r + dr) * 8 + c + dc
                    let land = lr * 8 + lc
                    let foe = owner(board[mid])
                    if foe != 0 && foe != side && board[land] == 0 {
                        let next = arr_take(board, 64)
                        let moved = crown(piece, lr)
                        next[from] = 0
                        next[mid] = 0
                        next[land] = moved
                        let total = 1
                        if moved == piece {
                            total = 1 + longest_capture(next, land)
                        }
                        best = max_i64(best, total)
                    }
                }
            }
        }
    }
    best
}

fn apply_path(board: [i64], path: [i64]) -> [i64] {
    let empty: [i64] = []
    let n = len(path)
    if n < 2 || path[0] < 0 || path[0] >= 64 {
        return empty
    }
    let cur = arr_take(board, 64)
    let piece = cur[path[0]]
    let ok = owner(piece) != 0
    let i = 1
    while ok && i < n {
        let from = path[i - 1]
        let to = path[i]
        if to < 0 || to >= 64 || cur[to] != 0 {
            ok = false
        } else {
            let dr = to / 8 - from / 8
            let step = abs_i64(dr)
            if step < 1 || step > 2 || step != abs_i64(to % 8 - from % 8) {
                ok = false
            } else if !may_step(piece, dr / step) || (step == 1 && n > 2) {
                ok = false
            } else if step == 2 && (owner(cur[(from + to) / 2]) == 0 || owner(cur[(from + to) / 2]) == owner(piece)) {
                ok = false
            } else if crown(piece, to / 8) != piece && i < n - 1 {
                ok = false
            } else {
                if step == 2 {
                    cur[(from + to) / 2] = 0
                }
                cur[from] = 0
                cur[to] = piece
            }
        }
        i = i + 1
    }
    if !ok {
        return empty
    }
    let last = path[n - 1]
    cur[last] = crown(piece, last / 8)
    cur
}

fn move_notation(path: [i64]) -> str {
    let n = len(path)
    let parts: [str] = []
    let jumps = 0
    let valid = n >= 2
    for i in 0..n {
        let sq = path[i]
        if sq < 0 || sq >= 64 || (sq / 8 + sq % 8) % 2 == 0 {
            valid = false
        } else {
            parts = arr_push(parts, to_str((sq / 8) * 4 + (sq % 8) / 2 + 1))
            if i > 0 {
                let dist = abs_i64(sq / 8 - path[i - 1] / 8)
                if dist != abs_i64(sq % 8 - path[i - 1] % 8) {
                    valid = false
                } else if dist == 2 {
                    jumps = jumps + 1
                } else if dist != 1 {
                    valid = false
                }
            }
        }
    }
    if !valid {
        return ""
    }
    if jumps == 0 && n == 2 {
        return str_join(parts, "-")
    }
    if jumps != n - 1 {
        return ""
    }
    str_join(parts, "x")
}

fn game_result(board: [i64], to_move: i64) -> str {
    let white = 0
    let black = 0
    let mobile = false
    for sq in 0..64 {
        let side = owner(board[sq])
        if side == 1 {
            white = white + 1
        } else if side == 2 {
            black = black + 1
        }
        if side == to_move && !mobile {
            if longest_capture(board, sq) > 0 {
                mobile = true
            }
        }
    }
    if white == 0 && black == 0 {
        return "empty"
    }
    if white == 0 {
        return "black wins"
    }
    if black == 0 {
        return "white wins"
    }
    if !mobile && len(simple_moves(board, to_move)) > 0 {
        mobile = true
    }
    if mobile {
        "ongoing"
    } else if to_move == 1 {
        "black wins"
    } else {
        "white wins"
    }
}

fn initial_text() -> str {
    ".b.b.b.b/b.b.b.b./.b.b.b.b/......../......../w.w.w.w./.w.w.w.w/w.w.w.w."
}

@[test]
fn test_simple_moves_single_man_on_edge() {
    let board = parse_board("......../......../......../......../......../w......./......../........")
    assert(simple_moves(board, 1) == [4033])
}

@[test]
fn test_simple_moves_king_goes_both_ways() {
    let board = parse_board("......../......../.b....../..W...../......../......../......../........")
    assert(simple_moves(board, 1) == [2619, 2633, 2635])
}

@[test]
fn test_simple_moves_opening_for_black() {
    let moves = simple_moves(parse_board(initial_text()), 2)
    assert_eq(len(moves), 7)
    assert_eq(moves[0], 1724)
}

@[test]
fn test_longest_capture_double_jump() {
    let board = parse_board("......../......../......../....b.../......../..b...../.w....../........")
    assert_eq(longest_capture(board, 49), 2)
}

@[test]
fn test_longest_capture_triple_jump() {
    let board = parse_board("......../......../.....b../......../...b..../......../.b....../w.......")
    assert_eq(longest_capture(board, 56), 3)
}

@[test]
fn test_longest_capture_man_cannot_jump_backwards() {
    let man = parse_board("......../......../.w....../..b...../......../......../......../........")
    let king = parse_board("......../......../.W....../..b...../......../......../......../........")
    assert_eq(longest_capture(man, 17), 0)
    assert_eq(longest_capture(king, 17), 1)
}

@[test]
fn test_longest_capture_stops_on_crowning() {
    let board = parse_board("......../..b.b.../.....w../......../......../......../......../........")
    assert_eq(longest_capture(board, 21), 1)
}

@[test]
fn test_apply_path_simple_move() {
    let after = apply_path(parse_board(initial_text()), [40, 33])
    assert_eq(after[33], 1)
    assert_eq(after[40], 0)
}

@[test]
fn test_apply_path_double_jump_removes_pieces() {
    let board = parse_board("......../......../......../....b.../......../..b...../.w....../........")
    let after = apply_path(board, [49, 35, 21])
    assert_eq(after[21], 1)
    assert_eq(after[42], 0)
    assert_eq(after[28], 0)
    assert_eq(after[49], 0)
}

@[test]
fn test_apply_path_crowns_man() {
    let board = parse_board("......../..w...../......../......../......../......../......../........")
    let after = apply_path(board, [10, 1])
    assert_eq(after[1], 2)
}

@[test]
fn test_apply_path_rejects_backward_man() {
    let board = parse_board("......../......../......../......../.w....../......../......../........")
    assert_eq(len(apply_path(board, [33, 40])), 0)
}

@[test]
fn test_move_notation_simple() {
    assert_eq_str(move_notation([40, 33]), "21-17")
}

@[test]
fn test_move_notation_multi_jump() {
    assert_eq_str(move_notation([49, 35, 21]), "25x18x11")
}

@[test]
fn test_move_notation_single_jump() {
    assert_eq_str(move_notation([56, 42]), "29x22")
}

@[test]
fn test_move_notation_light_square() {
    assert_eq_str(move_notation([0, 9]), "")
}

@[test]
fn test_game_result_opening() {
    assert_eq_str(game_result(parse_board(initial_text()), 1), "ongoing")
}

@[test]
fn test_game_result_no_black_pieces() {
    let board = parse_board("......../......../......../......../......../w......./......../........")
    assert_eq_str(game_result(board, 2), "white wins")
}

@[test]
fn test_game_result_white_blocked() {
    let board = parse_board(".b....../w......./......../......../......../......../......../........")
    assert_eq_str(game_result(board, 1), "black wins")
}
