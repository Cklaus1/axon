// Classical substitution ciphers: Caesar, Vigenere, Atbash, and a
// letter-frequency guess of a Caesar key.

fn english_freq() -> [f64] {
    [8.167, 1.492, 2.782, 4.253, 12.702, 2.228, 2.015, 6.094, 6.966, 0.153,
     0.772, 4.025, 2.406, 6.749, 7.507, 1.929, 0.095, 5.987, 6.327, 9.056,
     2.758, 0.978, 2.360, 0.150, 1.974, 0.074]
}

fn caesar_shift(text: str, shift: i64, rotate_digits: bool) -> str {
    let letter_shift = ((shift % 26) + 26) % 26
    let digit_shift = ((shift % 10) + 10) % 10
    let out = ""
    for ch in str_chars(text) {
        let c = char_at(ch, 0)
        let base = -1
        let span = 26
        let amount = letter_shift
        if c >= 65 && c <= 90 {
            base = 65
        } else if c >= 97 && c <= 122 {
            base = 97
        } else if rotate_digits && c >= 48 && c <= 57 {
            base = 48
            span = 10
            amount = digit_shift
        }
        if base < 0 {
            out = out + ch
        } else {
            out = out + chr(base + (c - base + amount) % span)
        }
    }
    out
}

fn vigenere(text: str, key: str, decrypt: bool) -> str {
    let shifts: [i64] = []
    for k in str_chars(str_to_upper(key)) {
        let c = char_at(k, 0)
        if c >= 65 && c <= 90 {
            shifts = arr_push(shifts, c - 65)
        }
    }
    let out = ""
    let pos = 0
    for ch in str_chars(text) {
        let c = char_at(ch, 0)
        let base = -1
        if c >= 65 && c <= 90 {
            base = 65
        } else if c >= 97 && c <= 122 {
            base = 97
        }
        if base < 0 || len(shifts) == 0 {
            out = out + ch
        } else {
            let s = shifts[pos % len(shifts)]
            if decrypt {
                s = 26 - s
            }
            out = out + chr(base + (c - base + s) % 26)
            pos = pos + 1
        }
    }
    out
}

fn atbash(text: str, group: i64) -> str {
    let out = ""
    let count = 0
    for ch in str_chars(text) {
        let c = char_at(ch, 0)
        let mapped = ""
        if c >= 65 && c <= 90 {
            mapped = chr(155 - c)
        } else if c >= 97 && c <= 122 {
            mapped = chr(219 - c)
        } else if c >= 48 && c <= 57 {
            mapped = ch
        }
        if group > 0 {
            if str_len(mapped) > 0 {
                if count > 0 && count % group == 0 {
                    out = out + " "
                }
                out = out + str_to_upper(mapped)
                count = count + 1
            }
        } else if str_len(mapped) > 0 {
            out = out + mapped
        } else {
            out = out + ch
        }
    }
    out
}

fn chi_squared_score(text: str, shift: i64) -> f64 {
    let expected = english_freq()
    let counts = arr_repeat(0, 26)
    let total = 0
    let back = ((shift % 26) + 26) % 26
    for ch in str_chars(str_to_upper(text)) {
        let c = char_at(ch, 0)
        if c >= 65 && c <= 90 {
            let plain = (c - 65 - back + 26) % 26
            counts[plain] = counts[plain] + 1
            total = total + 1
        }
    }
    if total == 0 {
        return -1.0
    }
    let score = 0.0
    let i = 0
    while i < 26 {
        let want = expected[i] / 100.0 * i64_to_f64(total)
        let diff = i64_to_f64(counts[i]) - want
        score = score + diff * diff / want
        i = i + 1
    }
    score
}

fn guess_caesar_key(ciphertext: str) -> i64 {
    let expected = english_freq()
    let counts = arr_repeat(0, 26)
    let total = 0
    for ch in str_chars(str_to_upper(ciphertext)) {
        let c = char_at(ch, 0)
        if c >= 65 && c <= 90 {
            counts[c - 65] = counts[c - 65] + 1
            total = total + 1
        }
    }
    if total == 0 {
        return -1
    }
    let best_shift = 0
    let best_score = -1.0
    let shift = 0
    while shift < 26 {
        let score = 0.0
        let i = 0
        while i < 26 {
            let observed = counts[(i + shift) % 26]
            let want = expected[i] / 100.0 * i64_to_f64(total)
            let diff = i64_to_f64(observed) - want
            score = score + diff * diff / want
            i = i + 1
        }
        if best_score < 0.0 || score < best_score {
            best_score = score
            best_shift = shift
        }
        shift = shift + 1
    }
    best_shift
}

@[test]
fn test_caesar_shift_classic() {
    assert_eq_str(caesar_shift("Hello, World!", 3, false), "Khoor, Zruog!")
}

@[test]
fn test_caesar_shift_negative_wraps() {
    assert_eq_str(caesar_shift("abc xyz", -1, false), "zab wxy")
}

@[test]
fn test_caesar_shift_digits() {
    assert_eq_str(caesar_shift("Room 101", 29, true), "Urrp 090")
    assert_eq_str(caesar_shift("Room 101", 29, false), "Urrp 101")
}

@[test]
fn test_vigenere_encrypt_classic() {
    assert_eq_str(vigenere("ATTACKATDAWN", "LEMON", false), "LXFOPVEFRNHR")
}

@[test]
fn test_vigenere_skips_non_letters() {
    assert_eq_str(vigenere("Attack at dawn!", "lemon", false), "Lxfopv ef rnhr!")
}

@[test]
fn test_vigenere_decrypt() {
    assert_eq_str(vigenere("LXFOPVEFRNHR", "Le-Mon", true), "ATTACKATDAWN")
    assert_eq_str(vigenere("abc", "123", false), "abc")
}

@[test]
fn test_atbash_plain() {
    assert_eq_str(atbash("abc XYZ!", 0), "zyx CBA!")
}

@[test]
fn test_atbash_grouped() {
    assert_eq_str(atbash("Hello, World", 5), "SVOOL DLIOW")
}

@[test]
fn test_atbash_grouped_digits() {
    assert_eq_str(atbash("Agent 007", 3), "ZTV MG0 07")
}

@[test]
fn test_chi_squared_single_letter() {
    assert(abs_f64(chi_squared_score("AAAA", 0) - 44.97755275131628) < 0.000001)
}

@[test]
fn test_chi_squared_shift_undone() {
    assert(abs_f64(chi_squared_score("dddd", 3) - 44.97755275131628) < 0.000001)
}

@[test]
fn test_chi_squared_no_letters() {
    assert_eq_f64(chi_squared_score("123 !", 4), -1.0)
}

@[test]
fn test_guess_caesar_key_long_text() {
    let c = "Opqpyo esp plde hlww zq esp nldewp le olhy mpqzcp esp pypxj lcctgpd"
    assert_eq(guess_caesar_key(c), 11)
}

@[test]
fn test_guess_caesar_key_with_punctuation() {
    assert_eq(guess_caesar_key("Cn qum nby vymn iz ncgym, cn qum nby qilmn iz ncgym"), 20)
}

@[test]
fn test_guess_caesar_key_short_text() {
    assert_eq(guess_caesar_key("Qiix qi riev xli sph wxexmsr xsrmklx"), 4)
    assert_eq(guess_caesar_key("2024"), -1)
}
