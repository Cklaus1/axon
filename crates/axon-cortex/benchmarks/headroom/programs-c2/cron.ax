fn expand_field(field: str, lo: i64, hi: i64) -> [i64] {
    let marks = arr_repeat(false, hi + 1)
    for piece in str_split(field, ",") {
        let slash = str_index_of(piece, "/")
        let step = 1
        let range = str_slice(piece, 0, len(piece))
        if slash >= 0 {
            step = parse_int_or(str_slice(piece, slash + 1, len(piece)), 0)
            range = str_slice(piece, 0, slash)
        }
        if step <= 0 || len(range) == 0 {
            return []
        }
        let a = lo
        let b = hi
        if range != "*" {
            let dash = str_index_of(range, "-")
            if dash >= 0 {
                a = parse_int_or(str_slice(range, 0, dash), -1)
                b = parse_int_or(str_slice(range, dash + 1, len(range)), -1)
            } else {
                a = parse_int_or(range, -1)
                b = if slash >= 0 { hi } else { a }
            }
        }
        if a < lo || b > hi || a > b {
            return []
        }
        let v = a
        while v <= b {
            marks[v] = true
            v = v + step
        }
    }
    let out = []
    let i = lo
    while i <= hi {
        if marks[i] {
            out = arr_push(out, i)
        }
        i = i + 1
    }
    out
}

fn timestamp_fields(ts: i64) -> [i64] {
    let days = ts / 1440
    let rem = ts % 1440
    if rem < 0 {
        rem = rem + 1440
        days = days - 1
    }
    let weekday = (days + 4) % 7
    if weekday < 0 {
        weekday = weekday + 7
    }
    let z = days + 719468
    let era = if z >= 0 { z / 146097 } else { (z - 146096) / 146097 }
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    let month = mp - 9
    if mp < 10 {
        month = mp + 3
    }
    let year = yoe + era * 400
    if month <= 2 {
        year = year + 1
    }
    [rem % 60, rem / 60, day, month, weekday, year]
}

fn replace_names(field: str, names: [str], first: i64) -> str {
    let out = str_to_lower(field)
    let i = 0
    while i < len(names) {
        out = str_replace(out, names[i], to_str(first + i))
        i = i + 1
    }
    out
}

fn parse_cron(expr: str) -> [[i64]] {
    let trimmed = str_to_lower(str_trim(expr))
    let text = trimmed
    if text == "@hourly" {
        text = "0 * * * *"
    } else if text == "@daily" || text == "@midnight" {
        text = "0 0 * * *"
    } else if text == "@weekly" {
        text = "0 0 * * 0"
    } else if text == "@monthly" {
        text = "0 0 1 * *"
    } else if text == "@yearly" || text == "@annually" {
        text = "0 0 1 1 *"
    }
    let fields = arr_filter(str_split(text, " "), |p| len(p) > 0)
    if len(fields) != 5 {
        return []
    }
    let months = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
    let days = ["sun", "mon", "tue", "wed", "thu", "fri", "sat"]
    let lows = [0, 0, 1, 1, 0]
    let highs = [59, 23, 31, 12, 7]
    let sets = []
    let i = 0
    while i < 5 {
        let field = fields[i]
        if i == 3 {
            field = replace_names(field, months, 1)
        } else if i == 4 {
            field = replace_names(field, days, 0)
        }
        let values = expand_field(field, lows[i], highs[i])
        if len(values) == 0 {
            return []
        }
        sets = arr_push(sets, values)
        i = i + 1
    }
    let dom_star = if str_starts_with(fields[2], "*") { 1 } else { 0 }
    let dow_star = if str_starts_with(fields[4], "*") { 1 } else { 0 }
    arr_push(sets, [dom_star, dow_star])
}

fn day_ok(sets: [[i64]], f: [i64]) -> bool {
    let dom_ok = arr_contains(sets[2], f[2])
    let dow_ok = arr_contains(sets[4], f[4]) || (f[4] == 0 && arr_contains(sets[4], 7))
    let flags = sets[5]
    if flags[0] == 1 || flags[1] == 1 {
        dom_ok && dow_ok
    } else {
        dom_ok || dow_ok
    }
}

fn cron_matches(expr: str, ts: i64) -> bool {
    let sets = parse_cron(expr)
    if len(sets) == 0 {
        return false
    }
    let f = timestamp_fields(ts)
    if !arr_contains(sets[0], f[0]) || !arr_contains(sets[1], f[1]) || !arr_contains(sets[3], f[3]) {
        return false
    }
    day_ok(sets, f)
}

fn next_match(expr: str, after: i64, horizon: i64) -> i64 {
    let sets = parse_cron(expr)
    if len(sets) == 0 || horizon <= 0 {
        return -1
    }
    let limit = after + horizon
    let t = after + 1
    while t <= limit {
        let f = timestamp_fields(t)
        let day_start = t - f[1] * 60 - f[0]
        if !arr_contains(sets[3], f[3]) {
            t = day_start + 1440
        } else if !day_ok(sets, f) {
            t = day_start + 1440
        } else if !arr_contains(sets[1], f[1]) {
            t = t - f[0] + 60
        } else if !arr_contains(sets[0], f[0]) {
            t = t + 1
        } else {
            return t
        }
    }
    -1
}

fn count_matches(expr: str, start: i64, end: i64) -> i64 {
    let sets = parse_cron(expr)
    if len(sets) == 0 || end <= start {
        return 0
    }
    let total = 0
    let t = start
    while t < end {
        let f = timestamp_fields(t)
        let day_start = t - f[1] * 60 - f[0]
        let day_end = day_start + 1440
        if arr_contains(sets[3], f[3]) && day_ok(sets, f) {
            if t == day_start && day_end <= end {
                total = total + len(sets[0]) * len(sets[1])
            } else {
                let stop = min_i64(day_end, end)
                let u = t
                while u < stop {
                    let m = u - day_start
                    if arr_contains(sets[1], m / 60) && arr_contains(sets[0], m % 60) {
                        total = total + 1
                    }
                    u = u + 1
                }
            }
        }
        t = day_end
    }
    total
}

@[test]
fn test_expand_field_step_and_range() {
    assert(expand_field("*/15", 0, 59) == [0, 15, 30, 45])
    assert(expand_field("1-5", 0, 7) == [1, 2, 3, 4, 5])
}

@[test]
fn test_expand_field_lists_merge_sorted() {
    assert(expand_field("20,1-3,10-20/5", 0, 59) == [1, 2, 3, 10, 15, 20])
    assert(expand_field("5/20", 0, 59) == [5, 25, 45])
}

@[test]
fn test_expand_field_rejects_out_of_range() {
    assert_eq(len(expand_field("61", 0, 59)), 0)
    assert_eq(len(expand_field("3-1", 0, 59)), 0)
    assert_eq(len(expand_field("*/0", 0, 59)), 0)
    assert(expand_field("0", 0, 59) == [0])
}

@[test]
fn test_timestamp_fields_epoch() {
    assert(timestamp_fields(0) == [0, 0, 1, 1, 4, 1970])
}

@[test]
fn test_timestamp_fields_leap_day() {
    assert(timestamp_fields(28486830) == [30, 12, 29, 2, 4, 2024])
}

@[test]
fn test_timestamp_fields_before_epoch() {
    assert(timestamp_fields(-1) == [59, 23, 31, 12, 3, 1969])
}

@[test]
fn test_parse_cron_named_weekdays() {
    let sets = parse_cron("*/30 9-17 * * mon-fri")
    assert_eq(len(sets), 6)
    assert(sets[0] == [0, 30])
    assert(sets[4] == [1, 2, 3, 4, 5])
    assert(sets[5] == [1, 0])
}

@[test]
fn test_parse_cron_macro_and_months() {
    let daily = parse_cron("@daily")
    assert(daily[0] == [0])
    assert(daily[1] == [0])
    let half = parse_cron("0 0 1 JAN,jul *")
    assert(half[3] == [1, 7])
    assert(half[5] == [0, 1])
}

@[test]
fn test_parse_cron_invalid() {
    assert_eq(len(parse_cron("* * *")), 0)
    assert_eq(len(parse_cron("0 24 * * *")), 0)
    assert_eq(len(parse_cron("@sometimes")), 0)
}

@[test]
fn test_cron_matches_basic() {
    assert(cron_matches("30 12 * * thu", 28486830))
    assert(cron_matches("30 12 29 2 *", 28486830))
    assert(!cron_matches("0 12 * * *", 28486830))
}

@[test]
fn test_cron_matches_day_union() {
    assert(cron_matches("30 12 29 * mon", 28486830))
    assert(!cron_matches("30 12 1 * mon", 28486830))
    assert(!cron_matches("30 12 1 * *", 28486830))
}

@[test]
fn test_cron_matches_sunday_as_seven() {
    assert(cron_matches("0 8 * * 7", 28490880))
    assert(cron_matches("0 8 * * sun", 28490880))
    assert(!cron_matches("0 8 * * 1-6", 28490880))
}

@[test]
fn test_next_match_next_weekday_morning() {
    assert_eq(next_match("0 9 * * mon-fri", 28486830, 10080), 28488060)
}

@[test]
fn test_next_match_leap_day_years_ahead() {
    assert_eq(next_match("0 0 29 2 *", 28487520, 2700000), 30589920)
}

@[test]
fn test_next_match_within_hour_and_horizon() {
    assert_eq(next_match("*/20 * * * *", 28486830, 60), 28486840)
    assert_eq(next_match("0 9 * * mon-fri", 28486830, 60), -1)
}

@[test]
fn test_count_matches_full_day() {
    assert_eq(count_matches("*/15 * * * *", 0, 1440), 96)
}

@[test]
fn test_count_matches_office_hours_week() {
    assert_eq(count_matches("0 9-17 * * mon-fri", 0, 10080), 45)
    assert_eq(count_matches("0 12 13 * fri", 28401120, 28928160), 62)
}

@[test]
fn test_count_matches_partial_days() {
    assert_eq(count_matches("*/30 * * * *", 620, 720), 3)
    assert_eq(count_matches("*/30 * * * *", 620, 2980), 79)
    assert_eq(count_matches("bad", 0, 1440), 0)
}
