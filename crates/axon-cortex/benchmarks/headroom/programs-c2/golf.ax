// Golf round scoring: course and playing handicaps, strokes received per
// hole, stableford points, score differentials and a round summary.
// A gross score of 0 on a hole means the player made no return there.

// Playing handicap for each handicap index. With `relative` set every
// player is expressed against the lowest handicap in the group.
fn course_handicaps(indexes: [f64], slope: i64, rating: f64, par: i64, allowance_pct: i64, relative: bool) -> [i64] {
    let out = []
    if slope < 55 || slope > 155 || allowance_pct <= 0 || allowance_pct > 100 {
        return out
    }
    for idx in indexes {
        let capped = min_f64(idx, 54.0)
        let course = capped * i64_to_f64(slope) / 113.0 + (rating - i64_to_f64(par))
        let whole = round_f64(course)
        let playing = round_f64(whole * i64_to_f64(allowance_pct) / 100.0)
        out = arr_push(out, f64_to_i64(playing))
    }
    if !relative || len(out) == 0 {
        return out
    }
    let low = out[0]
    for h in out {
        if h < low {
            low = h
        }
    }
    let shifted = []
    for h in out {
        shifted = arr_push(shifted, h - low)
    }
    shifted
}

// Strokes given (or, for a plus handicap, given back) on each hole,
// allocated by the hole's stroke index.
fn strokes_received(handicap: i64, stroke_index: [i64]) -> [i64] {
    let holes = len(stroke_index)
    let out = []
    if holes == 0 {
        return out
    }
    for si in stroke_index {
        if si < 1 || si > holes {
            return []
        }
    }
    let size = abs_i64(handicap)
    let base = size / holes
    let extra = size % holes
    for si in stroke_index {
        let s = base
        if handicap >= 0 && si <= extra {
            s = s + 1
        } else if handicap < 0 && si > holes - extra {
            s = s + 1
        }
        if handicap < 0 {
            s = 0 - s
        }
        out = arr_push(out, s)
    }
    out
}

// Standard stableford awards par + 2 - net (never below zero); the
// modified scale rewards net eagles and birdies and penalises bogeys.
fn stableford_points(gross: [i64], par: [i64], stroke_index: [i64], handicap: i64, modified: bool) -> i64 {
    if len(gross) != len(par) || len(par) != len(stroke_index) {
        return -1
    }
    let strokes = strokes_received(handicap, stroke_index)
    if len(strokes) != len(par) {
        return -1
    }
    let total = 0
    for i in 0..len(gross) {
        let net = gross[i] - strokes[i]
        let under = par[i] - net
        if !modified {
            if gross[i] > 0 && under + 2 > 0 {
                total = total + under + 2
            }
        } else if gross[i] <= 0 || under <= -2 {
            total = total - 3
        } else if under >= 3 {
            total = total + 8
        } else if under == 2 {
            total = total + 5
        } else if under == 1 {
            total = total + 2
        } else if under == -1 {
            total = total - 1
        }
    }
    total
}

// Handicap differential after capping every hole at net double bogey,
// rounded to one decimal; -999.0 marks an unusable card, including one
// with no return on more than half of its holes.
fn score_differential(gross: [i64], par: [i64], stroke_index: [i64], handicap: i64, rating: f64, slope: i64) -> f64 {
    let n = len(gross)
    if n == 0 || n != len(par) || n != len(stroke_index) || slope <= 0 {
        return -999.0
    }
    let strokes = strokes_received(handicap, stroke_index)
    if len(strokes) != n {
        return -999.0
    }
    let adjusted = 0
    let missing = 0
    for i in 0..n {
        let cap = par[i] + 2 + strokes[i]
        let score = gross[i]
        if score <= 0 {
            missing = missing + 1
        }
        if score <= 0 || score > cap {
            score = cap
        }
        adjusted = adjusted + score
    }
    if missing * 2 > n {
        return -999.0
    }
    let diff = 113.0 / i64_to_f64(slope) * (i64_to_f64(adjusted) - rating)
    round_f64(diff * 10.0) / 10.0
}

fn round_summary(gross: [i64], par: [i64]) -> str {
    if len(gross) == 0 || len(gross) != len(par) {
        return "invalid round"
    }
    let total = 0
    let par_total = 0
    let counts = [0, 0, 0, 0, 0]
    let no_return = 0
    for i in 0..len(gross) {
        if gross[i] <= 0 {
            no_return = no_return + 1
        } else {
            total = total + gross[i]
            par_total = par_total + par[i]
            let slot = clamp_i64(gross[i] - par[i] + 2, 0, 4)
            counts[slot] = counts[slot] + 1
        }
    }
    let diff = total - par_total
    let rel = to_str(diff)
    if diff == 0 {
        rel = "E"
    } else if diff > 0 {
        rel = "+" + rel
    }
    let labels = ["eagle", "birdie", "par", "bogey", "double"]
    let parts = [to_str(total) + " (" + rel + ")"]
    for k in 0..5 {
        if counts[k] == 1 {
            parts = arr_push(parts, "1 " + labels[k])
        } else if counts[k] > 1 {
            parts = arr_push(parts, to_str(counts[k]) + " " + labels[k] + "s")
        }
    }
    if no_return > 0 {
        parts = arr_push(parts, to_str(no_return) + " no return")
    }
    str_join(parts, ", ")
}

@[test]
fn test_course_handicaps_single_player() {
    assert(course_handicaps([10.0], 113, 72.0, 72, 100, false) == [10])
    assert(course_handicaps([18.4], 125, 71.2, 72, 95, false) == [19])
    assert(course_handicaps([-2.0], 113, 72.0, 72, 100, false) == [-2])
}

@[test]
fn test_course_handicaps_group_relative() {
    let group = [5.0, 12.3, 20.0]
    assert(course_handicaps(group, 130, 73.1, 72, 100, false) == [7, 15, 24])
    assert(course_handicaps(group, 130, 73.1, 72, 100, true) == [0, 8, 17])
}

@[test]
fn test_course_handicaps_limits() {
    assert(course_handicaps([60.0], 113, 72.0, 72, 100, false) == [54])
    assert(course_handicaps([10.0], 200, 72.0, 72, 100, false) == [])
}

@[test]
fn test_strokes_received_partial_allocation() {
    let si = [3, 1, 5, 7, 9, 2, 4, 6, 8]
    assert(strokes_received(4, si) == [1, 1, 0, 0, 0, 1, 1, 0, 0])
    assert(strokes_received(0, si) == [0, 0, 0, 0, 0, 0, 0, 0, 0])
}

@[test]
fn test_strokes_received_more_than_one_per_hole() {
    let si = [3, 1, 5, 7, 9, 2, 4, 6, 8]
    assert(strokes_received(11, si) == [1, 2, 1, 1, 1, 2, 1, 1, 1])
}

@[test]
fn test_strokes_received_plus_and_invalid() {
    let si = [3, 1, 5, 7, 9, 2, 4, 6, 8]
    assert(strokes_received(-2, si) == [0, 0, 0, 0, -1, 0, 0, 0, -1])
    assert(strokes_received(4, [1, 2, 10]) == [])
}

@[test]
fn test_stableford_standard() {
    let par = [4, 4, 3, 5, 4, 4, 3, 5, 4]
    let si = [3, 1, 5, 7, 9, 2, 4, 6, 8]
    assert_eq(stableford_points([5, 5, 3, 5, 5, 4, 4, 6, 4], par, si, 4, false), 17)
    assert_eq(stableford_points([3, 5, 2, 5, 7, 0, 4, 4, 4], par, si, 4, false), 18)
}

@[test]
fn test_stableford_modified() {
    let par = [4, 4, 3, 5, 4, 4, 3, 5, 4]
    let si = [3, 1, 5, 7, 9, 2, 4, 6, 8]
    assert_eq(stableford_points([3, 5, 2, 5, 7, 0, 4, 4, 4], par, si, 4, true), 3)
    assert_eq(stableford_points([2, 4, 3, 5, 4, 4, 3, 5, 4], par, si, 0, true), 5)
}

@[test]
fn test_stableford_mismatched_card() {
    assert_eq(stableford_points([4, 4], [4, 4, 3], [1, 2, 3], 0, false), -1)
    assert_eq(stableford_points([4, 4], [4, 4], [1, 5], 0, false), -1)
}

@[test]
fn test_differential_without_caps() {
    let par = [4, 4, 3, 5, 4, 4, 3, 5, 4]
    let si = [3, 1, 5, 7, 9, 2, 4, 6, 8]
    assert_eq_f64(score_differential([5, 5, 3, 5, 5, 4, 4, 6, 4], par, si, 4, 35.5, 120), 5.2)
}

@[test]
fn test_differential_net_double_bogey_cap() {
    let par = [4, 4, 3, 5, 4, 4, 3, 5, 4]
    let si = [3, 1, 5, 7, 9, 2, 4, 6, 8]
    assert_eq_f64(score_differential([3, 5, 2, 5, 7, 0, 4, 4, 4], par, si, 4, 35.5, 120), 4.2)
    assert_eq_f64(score_differential(arr_repeat(9, 9), par, si, 4, 35.5, 120), 21.2)
}

@[test]
fn test_differential_unusable_card() {
    assert_eq_f64(score_differential([], [], [], 0, 70.0, 113), -999.0)
    assert_eq_f64(score_differential([4], [4], [1], 0, 70.0, 0), -999.0)
    assert_eq_f64(score_differential([4, 0, 0], [4, 4, 4], [1, 2, 3], 0, 12.0, 113), -999.0)
}

@[test]
fn test_round_summary_over_par() {
    let par = [4, 4, 3, 5, 4, 4, 3, 5, 4]
    assert_eq_str(round_summary([5, 5, 3, 5, 5, 4, 4, 6, 4], par), "41 (+5), 4 pars, 5 bogeys")
}

@[test]
fn test_round_summary_mixed_card() {
    let par = [4, 4, 3, 5, 4, 4, 3, 5, 4]
    let card = [3, 5, 2, 5, 7, 0, 4, 4, 4]
    assert_eq_str(round_summary(card, par), "34 (+2), 3 birdies, 2 pars, 2 bogeys, 1 double, 1 no return")
}

@[test]
fn test_round_summary_level_and_under() {
    let par = [4, 4, 3, 5, 4, 4, 3, 5, 4]
    assert_eq_str(round_summary([4, 4, 3, 3, 4, 4, 3, 5, 6], par), "36 (E), 1 eagle, 7 pars, 1 double")
    assert_eq_str(round_summary([3, 4, 3, 5, 4, 4, 3, 5, 4], par), "35 (-1), 1 birdie, 8 pars")
    assert_eq_str(round_summary([4], [4, 4]), "invalid round")
}
