fn box_blur(g: [[i64]], radius: i64) -> [[i64]] {
    let rows = len(g)
    let out: [[i64]] = []
    if rows == 0 {
        return out
    }
    let r = max_i64(radius, 0)
    for y in 0..rows {
        let row: [i64] = g[y]
        let line: [i64] = []
        for x in 0..len(row) {
            let sum = 0
            let count = 0
            for yy in max_i64(0, y - r)..min_i64(rows, y + r + 1) {
                let src: [i64] = g[yy]
                let hi = min_i64(len(src), x + r + 1)
                for xx in max_i64(0, x - r)..hi {
                    sum = sum + src[xx]
                    count = count + 1
                }
            }
            let v = if count == 0 { row[x] } else { (2 * sum + count) / (2 * count) }
            line = arr_push(line, v)
        }
        out = arr_push(out, line)
    }
    out
}

fn threshold(g: [[i64]], level: i64, mode: str) -> [[i64]] {
    let out: [[i64]] = []
    for y in 0..len(g) {
        let row: [i64] = g[y]
        let line: [i64] = []
        for x in 0..len(row) {
            let v = clamp_i64(row[x], 0, 255)
            let above = v > level
            let w = if str_eq(mode, "binary") {
                if above { 255 } else { 0 }
            } else if str_eq(mode, "binary_inv") {
                if above { 0 } else { 255 }
            } else if str_eq(mode, "truncate") {
                if above { level } else { v }
            } else if str_eq(mode, "tozero") {
                if above { v } else { 0 }
            } else if str_eq(mode, "tozero_inv") {
                if above { 0 } else { v }
            } else {
                v
            }
            line = arr_push(line, w)
        }
        out = arr_push(out, line)
    }
    out
}

fn invert_region(g: [[i64]], top: i64, left: i64, bottom: i64, right: i64, maxval: i64) -> [[i64]] {
    let y0 = min_i64(top, bottom)
    let y1 = max_i64(top, bottom)
    let x0 = min_i64(left, right)
    let x1 = max_i64(left, right)
    let peak = if maxval <= 0 { 255 } else { maxval }
    let out: [[i64]] = []
    for y in 0..len(g) {
        let row: [i64] = g[y]
        let line: [i64] = []
        let row_hit = y >= y0 && y < y1
        for x in 0..len(row) {
            let v = row[x]
            if row_hit && x >= x0 && x < x1 {
                let c = clamp_i64(v, 0, peak)
                line = arr_push(line, peak - c)
            } else {
                line = arr_push(line, v)
            }
        }
        out = arr_push(out, line)
    }
    out
}

fn histogram(g: [[i64]], bins: i64, lo: i64, hi: i64, cumulative: bool) -> [i64] {
    if bins <= 0 || hi < lo {
        return []
    }
    let width = hi - lo + 1
    let counts = arr_repeat(0, bins)
    for y in 0..len(g) {
        let row: [i64] = g[y]
        for x in 0..len(row) {
            let v = row[x]
            if v >= lo && v <= hi {
                let idx = (v - lo) * bins / width
                counts[idx] = counts[idx] + 1
            }
        }
    }
    if cumulative {
        let running = 0
        for i in 0..bins {
            running = running + counts[i]
            counts[i] = running
        }
    }
    counts
}

fn otsu_threshold(g: [[i64]]) -> i64 {
    let hist = arr_repeat(0, 256)
    let total = 0
    let sum_all = 0
    let maxv = 0
    for y in 0..len(g) {
        let row: [i64] = g[y]
        for x in 0..len(row) {
            let v = clamp_i64(row[x], 0, 255)
            hist[v] = hist[v] + 1
            total = total + 1
            sum_all = sum_all + v
            maxv = max_i64(maxv, v)
        }
    }
    let best = 0.0
    let chosen = -1
    let w_back = 0
    let sum_back = 0
    for t in 0..256 {
        w_back = w_back + hist[t]
        sum_back = sum_back + t * hist[t]
        let w_fore = total - w_back
        if w_back > 0 && w_fore > 0 {
            let m_back = i64_to_f64(sum_back) / i64_to_f64(w_back)
            let m_fore = i64_to_f64(sum_all - sum_back) / i64_to_f64(w_fore)
            let between = i64_to_f64(w_back * w_fore) * (m_back - m_fore) * (m_back - m_fore)
            if between > best {
                best = between
                chosen = t
            }
        }
    }
    if chosen < 0 { maxv } else { chosen }
}

@[test]
fn test_blur_radius_one_corner_and_center() {
    let g = [[0, 0, 0], [0, 90, 0], [0, 0, 0]]
    assert(box_blur(g, 1) == [[23, 15, 23], [15, 10, 15], [23, 15, 23]])
}

@[test]
fn test_blur_rounds_half_up() {
    let g = [[1, 2], [2, 2]]
    assert(box_blur(g, 1) == [[2, 2], [2, 2]])
}

@[test]
fn test_blur_zero_radius_keeps_pixels() {
    let g = [[5, 6, 7], [8, 9, 10]]
    assert(box_blur(g, 0) == [[5, 6, 7], [8, 9, 10]])
}

@[test]
fn test_blur_single_row() {
    assert(box_blur([[0, 30, 60, 90]], 1) == [[15, 30, 60, 75]])
}

@[test]
fn test_threshold_binary_and_inverse() {
    let g = [[10, 128, 129], [255, 0, 300]]
    assert(threshold(g, 128, "binary") == [[0, 0, 255], [255, 0, 255]])
    assert(threshold(g, 128, "binary_inv") == [[255, 255, 0], [0, 255, 0]])
}

@[test]
fn test_threshold_truncate() {
    assert(threshold([[50, 100, 150], [200, -5, 99]], 100, "truncate") == [[50, 100, 100], [100, 0, 99]])
}

@[test]
fn test_threshold_tozero_modes() {
    let g = [[30, 60], [90, 120]]
    assert(threshold(g, 60, "tozero") == [[0, 0], [90, 120]])
    assert(threshold(g, 60, "tozero_inv") == [[30, 60], [0, 0]])
}

@[test]
fn test_invert_whole_image() {
    assert(invert_region([[0, 100], [255, 30]], 0, 0, 2, 2, 255) == [[255, 155], [0, 225]])
}

@[test]
fn test_invert_partial_region_reversed_corners() {
    let g = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    assert(invert_region(g, 3, 3, 1, 1, 10) == [[1, 2, 3], [4, 5, 4], [7, 2, 1]])
}

@[test]
fn test_invert_clamps_and_default_peak() {
    assert(invert_region([[300, -20, 40]], 0, 0, 1, 3, 0) == [[0, 255, 215]])
}

@[test]
fn test_histogram_four_bins() {
    let g = [[0, 63, 64, 128], [200, 255, 255, 10]]
    assert(histogram(g, 4, 0, 255, false) == [3, 1, 1, 3])
}

@[test]
fn test_histogram_cumulative() {
    let g = [[0, 63, 64, 128], [200, 255, 255, 10]]
    assert(histogram(g, 4, 0, 255, true) == [3, 4, 5, 8])
}

@[test]
fn test_histogram_sub_range_ignores_outside() {
    let g = [[5, 10, 11, 14], [15, 20, 12, 13]]
    assert(histogram(g, 3, 10, 15, false) == [2, 2, 2])
}

@[test]
fn test_otsu_bimodal() {
    assert_eq(otsu_threshold([[20, 20, 30], [200, 210, 220]]), 30)
}

@[test]
fn test_otsu_three_levels() {
    assert_eq(otsu_threshold([[10, 10, 10, 10], [100, 100, 240, 240]]), 100)
}

@[test]
fn test_otsu_uniform_image() {
    assert_eq(otsu_threshold([[50, 50], [50, 50]]), 50)
}
