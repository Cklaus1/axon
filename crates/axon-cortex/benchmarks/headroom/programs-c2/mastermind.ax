// Mastermind: codes are strings of colour letters such as "RGBY".

// Scores a guess against the secret as [exact, colour]: exact counts pegs of
// the right colour in the right place, colour counts the remaining pegs of a
// right colour in the wrong place. Codes of different length give [-1, -1].
fn score(secret: str, guess: str) -> [i64] {
    let n = len(secret)
    if n != len(guess) || n == 0 {
        return [-1, -1]
    }
    let exact = 0
    let left_secret = arr_repeat(0, 256)
    let left_guess = arr_repeat(0, 256)
    let i = 0
    while i < n {
        let a = char_at(secret, i)
        let b = char_at(guess, i)
        if a == b {
            exact = exact + 1
        } else {
            left_secret[a] = left_secret[a] + 1
            left_guess[b] = left_guess[b] + 1
        }
        i = i + 1
    }
    let colour = 0
    let c = 0
    while c < 256 {
        colour = colour + min_i64(left_secret[c], left_guess[c])
        c = c + 1
    }
    [exact, colour]
}

// Every code of the given length over the palette, in lexicographic order of
// palette positions.
fn all_codes(colours: str, length: i64) -> [str] {
    let k = len(colours)
    let out: [str] = []
    if k == 0 || length <= 0 {
        return out
    }
    let idx = arr_repeat(0, length)
    let done = false
    while !done {
        let code = ""
        let i = 0
        while i < length {
            code = code + str_slice(colours, idx[i], idx[i] + 1)
            i = i + 1
        }
        out = arr_push(out, code)
        let pos = length - 1
        let carry = true
        while carry && pos >= 0 {
            idx[pos] = idx[pos] + 1
            if idx[pos] == k {
                idx[pos] = 0
                pos = pos - 1
            } else {
                carry = false
            }
        }
        if carry {
            done = true
        }
    }
    out
}

// Keeps the candidates that agree with every recorded guess. The history is
// a list of entries "GUESS=exact/colour" separated by ";"; malformed entries
// are ignored.
fn filter_consistent(candidates: [str], history: str) -> [str] {
    let guesses: [str] = []
    let exacts: [i64] = []
    let colours: [i64] = []
    for entry in str_split(history, ";") {
        let item = str_trim(entry)
        let eq = str_index_of(item, "=")
        let slash = str_index_of(item, "/")
        if eq > 0 && slash > eq {
            guesses = arr_push(guesses, str_slice(item, 0, eq))
            exacts = arr_push(exacts, parse_int_or(str_slice(item, eq + 1, slash), -1))
            colours = arr_push(colours, parse_int_or(str_slice(item, slash + 1, len(item)), -1))
        }
    }
    let out: [str] = []
    for code in candidates {
        let ok = true
        let i = 0
        while ok && i < len(guesses) {
            let s = score(code, guesses[i])
            if s[0] != exacts[i] || s[1] != colours[i] {
                ok = false
            }
            i = i + 1
        }
        if ok {
            out = arr_push(out, code)
        }
    }
    out
}

// Minimax choice of the next guess: the pool entry whose largest group of
// candidates sharing one score is smallest. Ties favour a guess that could
// itself be the secret, then the earlier pool entry.
fn best_guess(candidates: [str], pool: [str]) -> str {
    if len(candidates) == 1 {
        return candidates[0]
    }
    let best = ""
    let best_worst = len(candidates) + 1
    let best_is_candidate = false
    for g in pool {
        let buckets = arr_repeat(0, 100)
        let worst = 0
        for c in candidates {
            let s = score(c, g)
            if s[0] >= 0 {
                let key = s[0] * 10 + s[1]
                buckets[key] = buckets[key] + 1
                if buckets[key] > worst {
                    worst = buckets[key]
                }
            }
        }
        let is_candidate = arr_contains(candidates, g)
        let better = worst < best_worst
        if worst == best_worst && is_candidate && !best_is_candidate {
            better = true
        }
        if better {
            best = g
            best_worst = worst
            best_is_candidate = is_candidate
        }
    }
    best
}

// Checks that a code has the right length, uses only palette colours (case
// insensitive) and, when repeats are not allowed, no colour twice.
fn valid_code(code: str, colours: str, length: i64, repeats: bool) -> bool {
    let c = str_to_upper(code)
    let palette = str_to_upper(colours)
    if len(c) != length || length == 0 {
        return false
    }
    let used = arr_repeat(false, 256)
    let i = 0
    while i < len(c) {
        let b = char_at(c, i)
        let allowed = false
        let j = 0
        while j < len(palette) {
            if char_at(palette, j) == b {
                allowed = true
            }
            j = j + 1
        }
        if !allowed {
            return false
        }
        if used[b] && !repeats {
            return false
        }
        used[b] = true
        i = i + 1
    }
    true
}

@[test]
fn test_score_exact_and_permuted() {
    assert(score("RGBY", "RGBY") == [4, 0])
    assert(score("RGBY", "YBGR") == [0, 4])
}

@[test]
fn test_score_duplicates() {
    assert(score("RRGB", "RGRR") == [1, 2])
    assert(score("AABB", "ABBA") == [2, 2])
}

@[test]
fn test_score_length_mismatch() {
    assert(score("RGB", "RGBY") == [-1, -1])
    assert(score("ABCD", "EFGA") == [0, 1])
}

@[test]
fn test_all_codes_two_colours() {
    assert(all_codes("AB", 2) == ["AA", "AB", "BA", "BB"])
}

@[test]
fn test_all_codes_single_peg() {
    assert(all_codes("XYZ", 1) == ["X", "Y", "Z"])
    assert_eq(len(all_codes("", 2)), 0)
}

@[test]
fn test_all_codes_three_pegs() {
    let cs = all_codes("AB", 3)
    assert_eq(len(cs), 8)
    assert_eq_str(cs[5], "BAB")
}

@[test]
fn test_filter_single_entry() {
    assert(filter_consistent(["AB", "BA", "AA", "BB"], "AB=1/0") == ["AA", "BB"])
}

@[test]
fn test_filter_two_entries() {
    let cands = ["ABC", "ACB", "BAC", "BCA", "CAB", "CBA"]
    assert(filter_consistent(cands, "ABC=1/2; BAC=0/3") == ["ACB", "CBA"])
}

@[test]
fn test_filter_ignores_malformed() {
    assert(filter_consistent(["AB", "BA"], "junk; ;AB=0/2") == ["BA"])
}

@[test]
fn test_best_guess_prefers_candidate_on_tie() {
    assert_eq_str(best_guess(["AAB", "ABA", "BAA"], ["AAA", "ABB", "AAB"]), "AAB")
}

@[test]
fn test_best_guess_smallest_worst_case() {
    assert_eq_str(best_guess(["AAB", "ABA", "BAA"], ["AAA", "BBB", "ABA"]), "ABA")
}

@[test]
fn test_best_guess_single_candidate() {
    assert_eq_str(best_guess(["CAB"], ["AAA", "BBB"]), "CAB")
}

@[test]
fn test_valid_code_lowercase() {
    assert(valid_code("rgby", "RGBYOP", 4, false))
    assert(!valid_code("RGB", "RGBYOP", 4, true))
}

@[test]
fn test_valid_code_repeats() {
    assert(valid_code("RRGB", "RGBYOP", 4, true))
    assert(!valid_code("RRGB", "RGBYOP", 4, false))
}

@[test]
fn test_valid_code_palette() {
    assert(valid_code("BOP", "BOPY", 3, false))
    assert(!valid_code("RGBX", "RGBYOP", 4, true))
}
