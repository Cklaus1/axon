// Nonogram line utilities. A row is a string where `#` is a filled cell, `.` an
// empty cell and `?` a cell whose state is not yet known. A clue lists the
// lengths of the filled blocks from left to right; `[0]` describes a blank row.

// The clue for a complete row. `1`, `0`, `x` and space are accepted as
// alternative spellings of filled and empty cells. Returns [] when the row
// contains any other character.
fn row_clue(row: str) -> [i64] {
    let out: [i64] = []
    let run = 0
    let n = str_len(row)
    for i in 0..n {
        let ch = str_char_at(row, i)
        if ch == "#" || ch == "1" {
            run = run + 1
        } else if ch == "." || ch == "0" || ch == "x" || ch == " " {
            if run > 0 {
                out = arr_push(out, run)
                run = 0
            }
        } else {
            let bad: [i64] = []
            return bad
        }
    }
    if run > 0 {
        out = arr_push(out, run)
    }
    if len(out) == 0 {
        out = arr_push(out, 0)
    }
    out
}

// Whether a complete row of `#` and `.` matches the clue exactly.
fn row_satisfies(row: str, clue: [i64]) -> bool {
    let blocks: [i64] = []
    for k in 0..len(clue) {
        if clue[k] < 0 {
            return false
        }
        if clue[k] > 0 {
            blocks = arr_push(blocks, clue[k])
        }
    }
    let idx = 0
    let run = 0
    let n = str_len(row)
    for i in 0..(n + 1) {
        let filled = false
        if i < n {
            let ch = str_char_at(row, i)
            if ch == "#" {
                filled = true
            } else if ch != "." {
                return false
            }
        }
        if filled {
            run = run + 1
            if idx >= len(blocks) || run > blocks[idx] {
                return false
            }
        } else if run > 0 {
            if run != blocks[idx] {
                return false
            }
            idx = idx + 1
            run = 0
        }
    }
    idx == len(blocks)
}

// Column clues of a solved grid, each rendered as space-separated block
// lengths. Short rows are treated as empty past their end.
fn column_clues(rows: [str]) -> [str] {
    let width = 0
    for r in 0..len(rows) {
        width = max_i64(width, str_len(rows[r]))
    }
    let out: [str] = []
    for c in 0..width {
        let parts: [str] = []
        let run = 0
        for r in 0..len(rows) {
            if str_char_at(rows[r], c) == "#" {
                run = run + 1
            } else if run > 0 {
                parts = arr_push(parts, to_str(run))
                run = 0
            }
        }
        if run > 0 {
            parts = arr_push(parts, to_str(run))
        }
        if len(parts) == 0 {
            out = arr_push(out, "0")
        } else {
            out = arr_push(out, str_join(parts, " "))
        }
    }
    out
}

// Cells that are filled in every arrangement of the clue on an empty line of
// the given length, found by overlapping the leftmost and rightmost packings.
// Returns -1 when the clue does not fit.
fn forced_cells(length: i64, clue: [i64]) -> i64 {
    let blocks: [i64] = []
    for k in 0..len(clue) {
        if clue[k] > 0 {
            blocks = arr_push(blocks, clue[k])
        }
    }
    let m = len(blocks)
    if m == 0 {
        return 0
    }
    let left = arr_repeat(0, m)
    for i in 1..m {
        left[i] = left[i - 1] + blocks[i - 1] + 1
    }
    if left[m - 1] + blocks[m - 1] > length {
        return -1
    }
    let right = arr_repeat(0, m)
    right[m - 1] = length - blocks[m - 1]
    let j = m - 2
    while j >= 0 {
        right[j] = right[j + 1] - blocks[j] - 1
        j = j - 1
    }
    let total = 0
    for i in 0..m {
        let slack = right[i] - left[i]
        if blocks[i] > slack {
            total = total + blocks[i] - slack
        }
    }
    total
}

fn place_blocks(prefix: str, blocks: [i64], idx: i64, length: i64) -> [str] {
    let out: [str] = []
    let used = str_len(prefix)
    if idx == len(blocks) {
        out = arr_push(out, prefix + str_repeat(".", length - used))
        return out
    }
    let rest = 0
    for k in (idx + 1)..len(blocks) {
        rest = rest + blocks[k] + 1
    }
    let b = blocks[idx]
    let start = used
    while start + b + rest <= length {
        let piece = prefix + str_repeat(".", start - used) + str_repeat("#", b)
        let next = if idx + 1 < len(blocks) { piece + "." } else { piece }
        out = arr_concat(out, place_blocks(next, blocks, idx + 1, length))
        start = start + 1
    }
    out
}

// Line solving: given a partially known row and its clue, mark every cell that
// has the same state in all consistent arrangements. Returns "" when no
// arrangement is consistent with the known cells.
fn solve_line(partial: str, clue: [i64]) -> str {
    let n = str_len(partial)
    let blocks: [i64] = []
    for k in 0..len(clue) {
        if clue[k] > 0 {
            blocks = arr_push(blocks, clue[k])
        }
    }
    let candidates = place_blocks("", blocks, 0, n)
    let filled_votes = arr_repeat(0, n)
    let found = 0
    for cand in candidates {
        let ok = true
        for i in 0..n {
            let p = str_char_at(partial, i)
            let c = str_char_at(cand, i)
            if (p == "#" && c != "#") || (p == "." && c == "#") {
                ok = false
            }
        }
        if ok {
            found = found + 1
            for i in 0..n {
                if str_char_at(cand, i) == "#" {
                    filled_votes[i] = filled_votes[i] + 1
                }
            }
        }
    }
    if found == 0 {
        return ""
    }
    let out = ""
    for i in 0..n {
        if filled_votes[i] == found {
            out = out + "#"
        } else if filled_votes[i] == 0 {
            out = out + "."
        } else {
            out = out + "?"
        }
    }
    out
}

@[test]
fn test_row_clue_blocks() {
    assert(row_clue("##.#") == [2, 1])
    assert(row_clue(".###.") == [3])
}

@[test]
fn test_row_clue_blank_and_invalid() {
    assert(row_clue(".....") == [0])
    let none: [i64] = []
    assert(row_clue("#?#") == none)
}

@[test]
fn test_row_clue_alternate_spellings() {
    assert(row_clue("1101") == [2, 1])
    assert(row_clue("#x##x#") == [1, 2, 1])
}

@[test]
fn test_row_satisfies_match() {
    assert(row_satisfies("##.#", [2, 1]))
    assert(!row_satisfies("##.#", [1, 2]))
}

@[test]
fn test_row_satisfies_blank_row() {
    assert(row_satisfies(".....", [0]))
    assert(!row_satisfies("..#..", [0]))
}

@[test]
fn test_row_satisfies_rejects_overlong_and_unknown() {
    assert(row_satisfies("#.#.#", [1, 1, 1]))
    assert(!row_satisfies("###", [2]))
    assert(!row_satisfies("#?#", [1, 1]))
}

@[test]
fn test_column_clues_mixed() {
    assert(column_clues(["#.#", "#..", ".##", "#.#"]) == ["2 1", "1", "1 2"])
}

@[test]
fn test_column_clues_blank_columns() {
    assert(column_clues(["...", "..."]) == ["0", "0", "0"])
}

@[test]
fn test_column_clues_single_column_and_short_rows() {
    assert(column_clues(["#", "#", ".", "#"]) == ["2 1"])
    assert(column_clues(["##", "#", "##"]) == ["3", "1 1"])
}

@[test]
fn test_forced_cells_single_block() {
    assert_eq(forced_cells(10, [8]), 6)
    assert_eq(forced_cells(10, [5]), 0)
}

@[test]
fn test_forced_cells_exact_fit() {
    assert_eq(forced_cells(5, [2, 2]), 4)
    assert_eq(forced_cells(5, [0]), 0)
}

@[test]
fn test_forced_cells_partial_overlap_and_misfit() {
    assert_eq(forced_cells(10, [3, 4]), 3)
    assert_eq(forced_cells(5, [3, 3]), 0 - 1)
}

@[test]
fn test_solve_line_empty_line() {
    assert_eq_str(solve_line("??????????", [8]), "??######??")
    assert_eq_str(solve_line("?????", [2, 2]), "##.##")
}

@[test]
fn test_solve_line_uses_known_cells() {
    assert_eq_str(solve_line("#????", [2, 1]), "##.??")
    assert_eq_str(solve_line("????#", [3]), "..###")
}

@[test]
fn test_solve_line_contradiction() {
    assert_eq_str(solve_line("?#?", [0]), "")
    assert_eq_str(solve_line("???", [0]), "...")
}
