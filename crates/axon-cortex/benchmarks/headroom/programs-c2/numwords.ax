// English number words: spelling integers out and reading simple number
// phrases back. Spelling follows the American style without "and", with
// hyphenated compounds from twenty-one to ninety-nine.

fn ones_word(n: i64) -> str {
    let words = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"]
    words[n]
}

fn tens_word(n: i64) -> str {
    let words = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
    words[n]
}

// Value of a single word below one hundred, or -1 when it is not one.
fn small_value(w: str) -> i64 {
    for i in 0..20 {
        if ones_word(i) == w {
            return i
        }
    }
    for i in 2..10 {
        if tens_word(i) == w {
            return i * 10
        }
    }
    -1
}

fn scale_value(w: str) -> i64 {
    if w == "thousand" {
        1000
    } else if w == "million" {
        1000000
    } else if w == "billion" {
        1000000000
    } else if w == "trillion" {
        1000000000000
    } else if w == "quadrillion" {
        1000000000000000
    } else if w == "quintillion" {
        1000000000000000000
    } else {
        0
    }
}

fn below_thousand(n: i64) -> str {
    let parts: [str] = []
    if n >= 100 {
        parts = arr_push(parts, ones_word(n / 100) + " hundred")
    }
    let rem = n % 100
    if rem >= 20 {
        let t = tens_word(rem / 10)
        parts = arr_push(parts, if rem % 10 > 0 { t + "-" + ones_word(rem % 10) } else { t })
    } else if rem > 0 {
        parts = arr_push(parts, ones_word(rem))
    }
    str_join(parts, " ")
}

fn tokens_of(s: str) -> [str] {
    let out: [str] = []
    let raw = str_split(str_replace(str_to_lower(str_trim(s)), "-", " "), " ")
    for t in raw {
        if t != "" {
            out = arr_push(out, t)
        }
    }
    out
}

fn is_number_word(w: str) -> bool {
    let lower = str_to_lower(w)
    if lower == "" {
        return false
    }
    let parts = str_split(lower, "-")
    for p in parts {
        if small_value(p) < 0 && scale_value(p) == 0 && p != "hundred" {
            return false
        }
    }
    true
}

fn trim_punct(w: str) -> str {
    let end = str_len(w)
    while end > 0 && str_contains(",.;:!?", str_slice(w, end - 1, end)) {
        end = end - 1
    }
    str_slice(w, 0, end)
}

// The English spelling of any i64, e.g. "minus one thousand two hundred five".
fn spell_number(n: i64) -> str {
    if n == 0 {
        return "zero"
    }
    let scales = ["", "thousand", "million", "billion", "trillion", "quadrillion", "quintillion"]
    let groups: [i64] = []
    let rest = n
    while rest != 0 {
        groups = arr_push(groups, abs_i64(rest % 1000))
        rest = rest / 1000
    }
    let parts: [str] = []
    if n < 0 {
        parts = arr_push(parts, "minus")
    }
    let g = len(groups) - 1
    while g >= 0 {
        let chunk = groups[g]
        if chunk > 0 {
            parts = arr_push(parts, below_thousand(chunk))
            if g > 0 {
                parts = arr_push(parts, scales[g])
            }
        }
        g = g - 1
    }
    str_join(parts, " ")
}

// Reads a number phrase such as "two thousand and twenty-four". Case, hyphens
// and "and" are tolerated. Unrecognised input reads as 0; is_number_phrase
// tells the two apart.
fn parse_number_words(s: str) -> i64 {
    let tokens = tokens_of(s)
    let total = 0
    let current = 0
    let sign = 1
    for i in 0..len(tokens) {
        let t = tokens[i]
        let v = small_value(t)
        let scale = scale_value(t)
        if i == 0 && (t == "minus" || t == "negative") {
            sign = -1
        } else if v >= 0 {
            current = current + v
        } else if t == "a" {
            current = current + 1
        } else if t == "hundred" {
            current = if current == 0 { 100 } else { current * 100 }
        } else if scale > 0 {
            total = total + (if current == 0 { 1 } else { current }) * scale
            current = 0
        } else if t != "and" {
            return 0
        }
    }
    sign * (total + current)
}

// Whether a phrase is a well-formed English cardinal: optional leading
// "minus", groups below one thousand joined by strictly decreasing scale
// words, hyphens only inside compounds like "forty-two", and "and" only after
// "hundred" or a scale word.
fn is_number_phrase(s: str) -> bool {
    let words = str_split(str_to_lower(str_trim(s)), " ")
    for w in words {
        let halves = str_split(w, "-")
        if len(halves) > 2 {
            return false
        }
        if len(halves) == 2 {
            let tens = small_value(halves[0])
            let unit = small_value(halves[1])
            if tens < 20 || tens % 10 != 0 || unit < 1 || unit > 9 {
                return false
            }
        }
    }
    let tokens = tokens_of(s)
    let n = len(tokens)
    let last_scale = 0
    let unit = false
    let tens = false
    let hundred = false
    let prev = ""
    for i in 0..n {
        let t = tokens[i]
        let v = small_value(t)
        let scale = scale_value(t)
        if t == "minus" {
            if i != 0 || n == 1 { return false }
        } else if t == "zero" {
            if n != 1 { return false }
        } else if v >= 1 && v <= 9 {
            if unit { return false }
            unit = true
        } else if v >= 10 {
            if unit || tens { return false }
            tens = true
            unit = v < 20
        } else if t == "hundred" {
            if !unit || tens || hundred { return false }
            hundred = true
            unit = false
        } else if scale > 0 {
            if !(unit || tens || hundred) || (last_scale > 0 && scale >= last_scale) { return false }
            last_scale = scale
            unit = false
            tens = false
            hundred = false
        } else if t != "and" || i == n - 1 || (prev != "hundred" && scale_value(prev) == 0) {
            return false
        }
        prev = t
    }
    n > 0 && prev != "minus"
}

// The ordinal spelling, e.g. 21 -> "twenty-first". Negative input gives "".
fn spell_ordinal(n: i64) -> str {
    if n < 0 {
        return ""
    }
    let cardinal = spell_number(n)
    let cut = str_len(cardinal)
    while cut > 0 {
        let ch = str_slice(cardinal, cut - 1, cut)
        if ch == " " || ch == "-" {
            break
        }
        cut = cut - 1
    }
    let head = str_slice(cardinal, 0, cut)
    let last = str_slice(cardinal, cut, str_len(cardinal))
    let ending = if last == "one" {
        "first"
    } else if last == "two" {
        "second"
    } else if last == "three" {
        "third"
    } else if last == "five" {
        "fifth"
    } else if last == "eight" {
        "eighth"
    } else if last == "nine" {
        "ninth"
    } else if last == "twelve" {
        "twelfth"
    } else if str_ends_with(last, "y") {
        str_slice(last, 0, str_len(last) - 1) + "ieth"
    } else {
        last + "th"
    }
    head + ending
}

// Rewrites runs of number words in running text as digits, keeping the other
// words and trailing punctuation as written.
fn digits_in_text(text: str) -> str {
    let words = str_split(text, " ")
    let out: [str] = []
    let run: [str] = []
    let n = len(words)
    for i in 0..n {
        let w = words[i]
        let core = trim_punct(w)
        let tail = str_slice(w, str_len(core), str_len(w))
        let joins = str_to_lower(core) == "and" && tail == "" && len(run) > 0 && i + 1 < n && is_number_word(trim_punct(words[i + 1]))
        if is_number_word(core) || joins {
            run = arr_push(run, core)
            if tail != "" {
                out = arr_push(out, to_str(parse_number_words(str_join(run, " "))) + tail)
                let cleared: [str] = []
                run = cleared
            }
        } else {
            if len(run) > 0 {
                out = arr_push(out, to_str(parse_number_words(str_join(run, " "))))
                let cleared: [str] = []
                run = cleared
            }
            out = arr_push(out, w)
        }
    }
    if len(run) > 0 {
        out = arr_push(out, to_str(parse_number_words(str_join(run, " "))))
    }
    str_join(out, " ")
}

@[test]
fn test_spell_number_small() {
    assert_eq_str(spell_number(0), "zero")
    assert_eq_str(spell_number(13), "thirteen")
    assert_eq_str(spell_number(45), "forty-five")
    assert_eq_str(spell_number(90), "ninety")
}

@[test]
fn test_spell_number_hundreds_and_scales() {
    assert_eq_str(spell_number(123), "one hundred twenty-three")
    assert_eq_str(spell_number(1000000), "one million")
    assert_eq_str(spell_number(1002003), "one million two thousand three")
}

@[test]
fn test_spell_number_negative() {
    assert_eq_str(spell_number(0 - 15), "minus fifteen")
    let lowest = 0 - 9223372036854775807 - 1
    assert_eq_str(spell_number(lowest), "minus nine quintillion two hundred twenty-three quadrillion three hundred seventy-two trillion thirty-six billion eight hundred fifty-four million seven hundred seventy-five thousand eight hundred eight")
}

@[test]
fn test_parse_number_words_basic() {
    assert_eq(parse_number_words("forty-two"), 42)
    assert_eq(parse_number_words("one hundred and five"), 105)
    assert_eq(parse_number_words("a hundred"), 100)
}

@[test]
fn test_parse_number_words_scales() {
    assert_eq(parse_number_words("two thousand twenty-four"), 2024)
    assert_eq(parse_number_words("Three Million Four Hundred Thousand"), 3400000)
}

@[test]
fn test_parse_number_words_sign_and_unknown() {
    assert_eq(parse_number_words("minus seventeen"), 0 - 17)
    assert_eq(parse_number_words("banana"), 0)
}

@[test]
fn test_is_number_phrase_accepts() {
    assert(is_number_phrase("forty-two"))
    assert(is_number_phrase("one hundred and five"))
    assert(is_number_phrase("minus nine hundred ninety-nine thousand"))
}

@[test]
fn test_is_number_phrase_rejects_order() {
    assert(is_number_phrase("one million two thousand"))
    assert(!is_number_phrase("one thousand one million"))
    assert(!is_number_phrase("two three"))
    assert(!is_number_phrase("hundred"))
}

@[test]
fn test_is_number_phrase_rejects_hyphens_and_zero() {
    assert(is_number_phrase("zero"))
    assert(!is_number_phrase("seven-twenty"))
    assert(!is_number_phrase("forty-"))
    assert(!is_number_phrase("zero zero"))
}

@[test]
fn test_spell_ordinal_irregular() {
    assert_eq_str(spell_ordinal(1), "first")
    assert_eq_str(spell_ordinal(2), "second")
    assert_eq_str(spell_ordinal(12), "twelfth")
    assert_eq_str(spell_ordinal(8), "eighth")
}

@[test]
fn test_spell_ordinal_compounds() {
    assert_eq_str(spell_ordinal(21), "twenty-first")
    assert_eq_str(spell_ordinal(45), "forty-fifth")
    assert_eq_str(spell_ordinal(20), "twentieth")
}

@[test]
fn test_spell_ordinal_large_and_zero() {
    assert_eq_str(spell_ordinal(100), "one hundredth")
    assert_eq_str(spell_ordinal(1000005), "one million fifth")
    assert_eq_str(spell_ordinal(0), "zeroth")
    assert_eq_str(spell_ordinal(0 - 3), "")
}

@[test]
fn test_digits_in_text_sentence() {
    assert_eq_str(digits_in_text("I have twenty-one apples and three pears"), "I have 21 apples and 3 pears")
}

@[test]
fn test_digits_in_text_and_inside_number() {
    assert_eq_str(digits_in_text("one hundred and five people came."), "105 people came.")
    assert_eq_str(digits_in_text("Nothing here"), "Nothing here")
}

@[test]
fn test_digits_in_text_punctuation() {
    assert_eq_str(digits_in_text("Chapter Twelve, verse nine"), "Chapter 12, verse 9")
}
