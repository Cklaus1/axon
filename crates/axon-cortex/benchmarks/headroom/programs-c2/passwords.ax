// Password strength scoring: character class analysis, run detection,
// policy rule checks and suggestions for missing character classes.

fn common_passwords() -> [str] {
    ["password", "123456", "12345678", "qwerty", "letmein", "welcome", "admin",
     "iloveyou", "monkey", "dragon", "football", "sunshine", "abc123", "passw0rd"]
}

fn class_counts(pw: str) -> [i64] {
    let lower = 0
    let upper = 0
    let digit = 0
    let symbol = 0
    let space = 0
    let other = 0
    for c in str_chars(pw) {
        let code = char_at(c, 0)
        if len(c) > 1 {
            other = other + 1
        } else if code >= 97 && code <= 122 {
            lower = lower + 1
        } else if code >= 65 && code <= 90 {
            upper = upper + 1
        } else if code >= 48 && code <= 57 {
            digit = digit + 1
        } else if code == 32 {
            space = space + 1
        } else if code > 32 && code < 127 {
            symbol = symbol + 1
        } else {
            other = other + 1
        }
    }
    [lower, upper, digit, symbol, space, other]
}

fn longest_run(pw: str) -> i64 {
    let chars = str_chars(pw)
    let n = len(chars)
    if n == 0 {
        return 0
    }
    let best = 1
    let same = 1
    let up = 1
    let down = 1
    let i = 1
    while i < n {
        let a = char_at(str_to_lower(chars[i - 1]), 0)
        let b = char_at(str_to_lower(chars[i]), 0)
        let ascii = len(chars[i - 1]) == 1 && len(chars[i]) == 1
        same = if ascii && a == b { same + 1 } else { 1 }
        up = if ascii && b == a + 1 { up + 1 } else { 1 }
        down = if ascii && b == a - 1 { down + 1 } else { 1 }
        best = max_i64(best, max_i64(same, max_i64(up, down)))
        i = i + 1
    }
    best
}

fn password_score(pw: str) -> i64 {
    let n = str_len_chars(pw)
    if n == 0 {
        return 0
    }
    let counts = class_counts(pw)
    let classes = 0
    let k = 0
    while k < 4 {
        if counts[k] > 0 {
            classes = classes + 1
        }
        k = k + 1
    }
    if counts[4] + counts[5] > 0 {
        classes = classes + 1
    }
    let score = min_i64(n, 20) * 3 + max_i64(0, min_i64(n - 20, 20))
    score = score + (classes - 1) * 8
    let run = longest_run(pw)
    if run >= 3 {
        score = score - (run - 2) * 5
    }
    let distinct = len(arr_unique(str_chars(str_to_lower(pw))))
    if distinct * 3 < n {
        score = score - 10
    }
    let lowered = str_to_lower(pw)
    for word in common_passwords() {
        if str_contains(lowered, word) {
            score = score - 25
        }
    }
    if counts[2] == n {
        score = score - 10
    }
    clamp_i64(score, 0, 100)
}

fn strength_label(pw: str) -> str {
    let score = password_score(pw)
    let lowered = str_to_lower(pw)
    if arr_contains(common_passwords(), lowered) {
        return "very weak"
    }
    let counts = class_counts(pw)
    let label = if score < 25 {
        "very weak"
    } else if score < 45 {
        "weak"
    } else if score < 65 {
        "fair"
    } else if score < 85 {
        "strong"
    } else {
        "very strong"
    }
    if str_len_chars(pw) < 8 && score >= 25 {
        label = "weak"
    }
    if label == "very strong" && counts[0] + counts[1] == 0 {
        label = "strong"
    }
    label
}

fn policy_violations(pw: str, username: str, min_len: i64) -> [str] {
    let out = []
    let n = str_len_chars(pw)
    if n < min_len {
        out = arr_push(out, "too-short")
    }
    if n > 128 {
        out = arr_push(out, "too-long")
    }
    if str_starts_with(pw, " ") || str_ends_with(pw, " ") {
        out = arr_push(out, "edge-whitespace")
    }
    let lowered = str_to_lower(pw)
    let user = str_to_lower(str_trim(username))
    if len(user) >= 3 && (str_contains(lowered, user) || str_contains(lowered, str_reverse(user))) {
        out = arr_push(out, "contains-username")
    }
    if arr_contains(common_passwords(), lowered) {
        out = arr_push(out, "common-password")
    }
    let chars = str_chars(pw)
    let same = 1
    let flagged = false
    let i = 1
    while i < len(chars) && !flagged {
        same = if chars[i] == chars[i - 1] { same + 1 } else { 1 }
        if same >= 4 {
            flagged = true
        }
        i = i + 1
    }
    if flagged {
        out = arr_push(out, "repeated-chars")
    }
    out
}

fn suggest_missing(pw: str, min_len: i64, required: i64) -> [str] {
    let lower = 0
    let upper = 0
    let digit = 0
    let symbol = 0
    for c in str_chars(pw) {
        if char_is_digit(c) {
            digit = digit + 1
        } else if len(c) == 1 && char_at(c, 0) >= 97 && char_at(c, 0) <= 122 {
            lower = lower + 1
        } else if len(c) == 1 && char_at(c, 0) >= 65 && char_at(c, 0) <= 90 {
            upper = upper + 1
        } else if !char_is_space(c) {
            symbol = symbol + 1
        }
    }
    let present = 0
    let missing = []
    if lower > 0 { present = present + 1 } else { missing = arr_push(missing, "add a lowercase letter") }
    if upper > 0 { present = present + 1 } else { missing = arr_push(missing, "add an uppercase letter") }
    if digit > 0 { present = present + 1 } else { missing = arr_push(missing, "add a digit") }
    if symbol > 0 { present = present + 1 } else { missing = arr_push(missing, "add a symbol") }
    let out = []
    let short = min_len - str_len_chars(pw)
    if short == 1 {
        out = arr_push(out, "add 1 more character")
    } else if short > 1 {
        out = arr_push(out, "add " + to_str(short) + " more characters")
    }
    let need = required - present
    let i = 0
    while i < len(missing) && i < need {
        out = arr_push(out, missing[i])
        i = i + 1
    }
    out
}

@[test]
fn test_class_counts_mixed() {
    assert(class_counts("Ab3$ x") == [2, 1, 1, 1, 1, 0])
}

@[test]
fn test_class_counts_non_ascii() {
    assert(class_counts("café9") == [3, 0, 1, 0, 0, 1])
}

@[test]
fn test_class_counts_symbols_only() {
    assert(class_counts("!?#") == [0, 0, 0, 3, 0, 0])
}

@[test]
fn test_longest_run_repeats() {
    assert_eq(longest_run("xaaaay"), 4)
    assert_eq(longest_run(""), 0)
}

@[test]
fn test_longest_run_sequences() {
    assert_eq(longest_run("q1234w"), 4)
    assert_eq(longest_run("zyxw!"), 4)
}

@[test]
fn test_longest_run_case_insensitive() {
    assert_eq(longest_run("aBcD"), 4)
    assert_eq(longest_run("q7m"), 1)
}

@[test]
fn test_password_score_strong() {
    assert_eq(password_score("Tr0ub4dor&Horse"), 69)
}

@[test]
fn test_password_score_penalties() {
    assert_eq(password_score("password1"), 10)
    assert_eq(password_score("12345678"), 0)
}

@[test]
fn test_password_score_long_passphrase() {
    assert_eq(password_score("correct horse battery staple"), 76)
}

@[test]
fn test_strength_label_common() {
    assert_eq_str(strength_label("Password"), "very weak")
    assert_eq_str(strength_label("Zq9!"), "weak")
}

@[test]
fn test_strength_label_levels() {
    assert_eq_str(strength_label("Tr0ub4dor&Horse"), "strong")
    assert_eq_str(strength_label("blue-finch-42"), "fair")
}

@[test]
fn test_strength_label_no_letters_cap() {
    assert_eq_str(strength_label("4%9#1&7@3*8^2!6~5-0+4%9#1&7@3*8^2!6~5-0+"), "strong")
}

@[test]
fn test_policy_violations_clean() {
    assert(len(policy_violations("Gr8-Lakes-Trip", "maria", 10)) == 0)
    assert(policy_violations("maria2024!", "Maria", 12) == ["too-short", "contains-username"])
}

@[test]
fn test_policy_violations_common_and_edges() {
    assert(policy_violations(" qwerty", "bob", 6) == ["edge-whitespace"])
    assert(policy_violations("qwerty", "bo", 6) == ["common-password"])
}

@[test]
fn test_policy_violations_reversed_and_repeats() {
    assert(policy_violations("xxxxairam", "maria", 8) == ["contains-username", "repeated-chars"])
}

@[test]
fn test_suggest_missing_classes() {
    assert(suggest_missing("hello", 8, 4) == ["add 3 more characters", "add an uppercase letter", "add a digit", "add a symbol"])
}

@[test]
fn test_suggest_missing_policy_three_of_four() {
    assert(suggest_missing("hello", 5, 3) == ["add an uppercase letter", "add a digit"])
    assert(suggest_missing("Hello1", 5, 3) == [])
}

@[test]
fn test_suggest_missing_one_character() {
    assert(suggest_missing("Ab1!xyz", 8, 4) == ["add 1 more character"])
}
