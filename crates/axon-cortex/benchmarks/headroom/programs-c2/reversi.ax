// Reversi (Othello). Boards are square lists of rows, "." empty, "B" black,
// "W" white. Squares are addressed by flat index row * size + col.

fn opponent(player: str) -> str {
    if player == "B" {
        "W"
    } else {
        "B"
    }
}

fn square(rows: [str], r: i64, c: i64) -> str {
    if r < 0 || r >= len(rows) || c < 0 {
        return ""
    }
    str_char_at(rows[r], c)
}

fn line_flips(rows: [str], r: i64, c: i64, dr: i64, dc: i64, player: str) -> i64 {
    let opp = opponent(player)
    let k = 1
    while square(rows, r + dr * k, c + dc * k) == opp {
        k = k + 1
    }
    if k > 1 && square(rows, r + dr * k, c + dc * k) == player {
        k - 1
    } else {
        0
    }
}

fn initial_board(size: i64) -> [str] {
    let rows: [str] = []
    let mid = size / 2
    for r in arr_range(0, size) {
        let line = ""
        for c in arr_range(0, size) {
            if (r == mid - 1 && c == mid - 1) || (r == mid && c == mid) {
                line = line + "W"
            } else if (r == mid - 1 && c == mid) || (r == mid && c == mid - 1) {
                line = line + "B"
            } else {
                line = line + "."
            }
        }
        rows = arr_push(rows, line)
    }
    rows
}

fn flips_for_move(rows: [str], r: i64, c: i64, player: str) -> [i64] {
    let size = len(rows)
    let out: [i64] = []
    if player != "B" && player != "W" {
        return out
    }
    if square(rows, r, c) != "." {
        return out
    }
    for dr in [-1, 0, 1] {
        for dc in [-1, 0, 1] {
            if dr == 0 && dc == 0 {
                continue
            }
            let n = line_flips(rows, r, c, dr, dc, player)
            let k = 1
            while k <= n {
                out = arr_push(out, (r + dr * k) * size + (c + dc * k))
                k = k + 1
            }
        }
    }
    let i = 1
    while i < len(out) {
        let j = i
        while j > 0 && out[j - 1] > out[j] {
            let tmp = out[j]
            out[j] = out[j - 1]
            out[j - 1] = tmp
            j = j - 1
        }
        i = i + 1
    }
    out
}

fn legal_moves(rows: [str], player: str, by_gain: bool) -> [i64] {
    let size = len(rows)
    let moves: [i64] = []
    let gains: [i64] = []
    for r in arr_range(0, size) {
        for c in arr_range(0, size) {
            if square(rows, r, c) != "." {
                continue
            }
            let total = 0
            for dr in [-1, 0, 1] {
                for dc in [-1, 0, 1] {
                    if dr != 0 || dc != 0 {
                        total = total + line_flips(rows, r, c, dr, dc, player)
                    }
                }
            }
            if total > 0 {
                moves = arr_push(moves, r * size + c)
                gains = arr_push(gains, total)
            }
        }
    }
    if !by_gain {
        return moves
    }
    let i = 1
    while i < len(moves) {
        let j = i
        while j > 0 && gains[j - 1] < gains[j] {
            let g = gains[j]
            gains[j] = gains[j - 1]
            gains[j - 1] = g
            let m = moves[j]
            moves[j] = moves[j - 1]
            moves[j - 1] = m
            j = j - 1
        }
        i = i + 1
    }
    moves
}

fn apply_move(rows: [str], r: i64, c: i64, player: str) -> [str] {
    let size = len(rows)
    let flips = flips_for_move(rows, r, c, player)
    let changed = arr_repeat(false, size * size)
    if len(flips) > 0 {
        changed[r * size + c] = true
        for f in flips {
            changed[f] = true
        }
    }
    let out: [str] = []
    for row in arr_range(0, size) {
        let line = ""
        for col in arr_range(0, size) {
            if changed[row * size + col] {
                line = line + player
            } else {
                line = line + str_char_at(rows[row], col)
            }
        }
        out = arr_push(out, line)
    }
    out
}

fn final_score(rows: [str], empties_to_winner: bool) -> str {
    let black = 0
    let white = 0
    let empty = 0
    for row in rows {
        for ch in str_chars(row) {
            if ch == "B" {
                black = black + 1
            } else if ch == "W" {
                white = white + 1
            } else {
                empty = empty + 1
            }
        }
    }
    if empties_to_winner {
        if black > white {
            black = black + empty
        } else if white > black {
            white = white + empty
        }
    }
    let score = to_str(black) + "-" + to_str(white)
    if black > white {
        return "B wins " + score
    }
    if white > black {
        return "W wins " + score
    }
    "draw " + score
}

fn play_game(moves: [i64]) -> str {
    let board = initial_board(8)
    let player = "B"
    for i in arr_range(0, len(moves)) {
        let options = legal_moves(board, player, false)
        if len(options) == 0 {
            player = opponent(player)
            options = legal_moves(board, player, false)
        }
        if len(options) == 0 {
            return "game over before move " + to_str(i + 1)
        }
        let m = moves[i]
        if !arr_contains(options, m) {
            return "illegal move " + to_str(i + 1)
        }
        board = apply_move(board, m / 8, m % 8, player)
        player = opponent(player)
    }
    let mine = len(legal_moves(board, player, false))
    let theirs = len(legal_moves(board, opponent(player), false))
    if mine == 0 && theirs == 0 {
        return final_score(board, false)
    }
    if mine == 0 {
        player = opponent(player)
    }
    let black = 0
    let white = 0
    for row in board {
        black = black + str_count(row, "B")
        white = white + str_count(row, "W")
    }
    "B:" + to_str(black) + " W:" + to_str(white) + ", " + player + " to move"
}

@[test]
fn test_flips_for_move_opening() {
    assert(flips_for_move(initial_board(8), 2, 3, "B") == [27])
}

@[test]
fn test_flips_for_move_multiple_directions() {
    assert(flips_for_move(["B.B.", "WWW.", "BW..", "...."], 2, 2, "B") == [5, 6, 9])
}

@[test]
fn test_flips_for_move_occupied() {
    assert(flips_for_move(initial_board(8), 3, 3, "B") == [])
}

@[test]
fn test_flips_for_move_long_line() {
    assert(flips_for_move(["BWWW.", ".....", ".....", ".....", "....."], 0, 4, "B") == [1, 2, 3])
}

@[test]
fn test_legal_moves_opening_black() {
    assert(legal_moves(initial_board(8), "B", false) == [19, 26, 37, 44])
}

@[test]
fn test_legal_moves_opening_white() {
    assert(legal_moves(initial_board(8), "W", false) == [20, 29, 34, 43])
}

@[test]
fn test_legal_moves_by_gain() {
    assert(legal_moves(["BWW.", "WW..", "W...", "...."], "B", true) == [3, 12, 10])
}

@[test]
fn test_legal_moves_scan_order() {
    assert(legal_moves(["BWW.", "WW..", "W...", "...."], "B", false) == [3, 10, 12])
}

@[test]
fn test_legal_moves_none() {
    assert(legal_moves(["BB", "BB"], "W", false) == [])
}

@[test]
fn test_apply_move_opening() {
    let after = apply_move(initial_board(4), 0, 1, "B")
    assert(after == [".B..", ".BB.", ".BW.", "...."])
}

@[test]
fn test_apply_move_two_lines() {
    let after = apply_move(["B.B.", "WWW.", "BW..", "...."], 2, 2, "B")
    assert(after == ["B.B.", "WBB.", "BBB.", "...."])
}

@[test]
fn test_apply_move_illegal_unchanged() {
    let after = apply_move(["B..", ".W.", "..."], 0, 2, "B")
    assert(after == ["B..", ".W.", "..."])
}

@[test]
fn test_final_score_black_wins() {
    assert_eq_str(final_score(["BBW", "BWB", "B.."], false), "B wins 5-2")
}

@[test]
fn test_final_score_empties_to_winner() {
    assert_eq_str(final_score(["BBW", "BWB", "B.."], true), "B wins 7-2")
}

@[test]
fn test_final_score_white_and_draw() {
    assert_eq_str(final_score(["WW", "WB"], true), "W wins 1-3")
    assert_eq_str(final_score(["BW", ".."], true), "draw 1-1")
}

@[test]
fn test_play_game_one_move() {
    assert_eq_str(play_game([19]), "B:4 W:1, W to move")
}

@[test]
fn test_play_game_two_moves() {
    assert_eq_str(play_game([19, 18]), "B:3 W:3, B to move")
}

@[test]
fn test_play_game_illegal() {
    assert_eq_str(play_game([19, 19]), "illegal move 2")
}

@[test]
fn test_play_game_empty() {
    assert_eq_str(play_game([]), "B:2 W:2, B to move")
}
