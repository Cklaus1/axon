// Sokoban board logic. A board is a list of rows using the standard symbols:
// '#' wall, ' ' floor, '.' goal, '$' box, '*' box on goal, '@' player, '+' player on goal.
// Moves are the letters U, D, L, R in either case.

fn cell_at(grid: [str], r: i64, c: i64) -> str {
    if r < 0 || r >= len(grid) {
        return "#"
    }
    let row = grid[r]
    if c < 0 || c >= str_len(row) {
        return "#"
    }
    str_slice(row, c, c + 1)
}

fn put_cell(grid: [str], r: i64, c: i64, ch: str) -> [str] {
    let row = grid[r]
    let out = grid
    out[r] = str_slice(row, 0, c) + ch + str_slice(row, c + 1, str_len(row))
    out
}

fn find_player(grid: [str]) -> [i64] {
    let r = 0
    while r < len(grid) {
        let row = grid[r]
        let c = 0
        while c < str_len(row) {
            let ch = str_slice(row, c, c + 1)
            if str_eq(ch, "@") || str_eq(ch, "+") {
                return [r, c]
            }
            c = c + 1
        }
        r = r + 1
    }
    [-1, -1]
}

fn direction(m: str) -> [i64] {
    let u = str_to_upper(m)
    if str_eq(u, "U") {
        [-1, 0]
    } else if str_eq(u, "D") {
        [1, 0]
    } else if str_eq(u, "L") {
        [0, -1]
    } else if str_eq(u, "R") {
        [0, 1]
    } else {
        [0, 0]
    }
}

fn has_box(ch: str) -> bool {
    str_eq(ch, "$") || str_eq(ch, "*")
}

fn is_open(ch: str) -> bool {
    str_eq(ch, " ") || str_eq(ch, ".")
}

fn step(grid: [str], m: str) -> [str] {
    let pos = find_player(grid)
    let d = direction(m)
    let blocked = pos[0] < 0 || (d[0] == 0 && d[1] == 0)
    let r = pos[0]
    let c = pos[1]
    let r1 = r + d[0]
    let c1 = c + d[1]
    let r2 = r1 + d[0]
    let c2 = c1 + d[1]
    let target = cell_at(grid, r1, c1)
    let beyond = cell_at(grid, r2, c2)
    let pushing = has_box(target)
    if pushing && !is_open(beyond) {
        blocked = true
    }
    if !pushing && !is_open(target) {
        blocked = true
    }
    let here = cell_at(grid, r, c)
    let left_behind = if str_eq(here, "+") { "." } else { " " }
    let onto_goal = str_eq(target, ".") || str_eq(target, "*")
    let player_ch = if onto_goal { "+" } else { "@" }
    if blocked {
        grid
    } else if pushing {
        let box_ch = if str_eq(beyond, ".") { "*" } else { "$" }
        let moved = put_cell(grid, r2, c2, box_ch)
        put_cell(put_cell(moved, r1, c1, player_ch), r, c, left_behind)
    } else {
        put_cell(put_cell(grid, r1, c1, player_ch), r, c, left_behind)
    }
}

fn is_solved(grid: [str]) -> bool {
    let players = 0
    let loose = 0
    let stored = 0
    let open_goals = 0
    for row in grid {
        for ch in str_chars(row) {
            match ch {
                "@" => { players = players + 1 }
                "+" => {
                    players = players + 1
                    open_goals = open_goals + 1
                }
                "$" => { loose = loose + 1 }
                "*" => { stored = stored + 1 }
                "." => { open_goals = open_goals + 1 }
                "#" => {}
                " " => {}
                _ => { return false }
            }
        }
    }
    if players != 1 || stored == 0 {
        return false
    }
    loose == 0 && open_goals == 0
}

fn play(grid: [str], moves: str) -> [i64] {
    let applied = 0
    let pushes = 0
    let blocked = 0
    let solved_at = -1
    let board = grid
    let i = 0
    for m in str_chars(moves) {
        i = i + 1
        let d = direction(m)
        let pos = find_player(board)
        if d[0] == 0 && d[1] == 0 || pos[0] < 0 {
            blocked = blocked + 1
            continue
        }
        let target = cell_at(board, pos[0] + d[0], pos[1] + d[1])
        let next = step(board, m)
        if next == board {
            blocked = blocked + 1
        } else {
            applied = applied + 1
            if has_box(target) {
                pushes = pushes + 1
            }
            board = next
            if is_solved(board) {
                solved_at = i
                break
            }
        }
    }
    [applied, pushes, blocked, solved_at]
}

fn dead_boxes(grid: [str]) -> i64 {
    let count = 0
    let r = 0
    while r < len(grid) {
        let row = grid[r]
        let c = 0
        while c < str_len(row) {
            if str_eq(str_slice(row, c, c + 1), "$") {
                let up = str_eq(cell_at(grid, r - 1, c), "#")
                let down = str_eq(cell_at(grid, r + 1, c), "#")
                let left = str_eq(cell_at(grid, r, c - 1), "#")
                let right = str_eq(cell_at(grid, r, c + 1), "#")
                let dead = (up || down) && (left || right)
                for side in [-1, 1] {
                    if has_box(cell_at(grid, r, c + side)) {
                        let both_up = up && str_eq(cell_at(grid, r - 1, c + side), "#")
                        let both_down = down && str_eq(cell_at(grid, r + 1, c + side), "#")
                        dead = dead || both_up || both_down
                    }
                    if has_box(cell_at(grid, r + side, c)) {
                        let both_left = left && str_eq(cell_at(grid, r + side, c - 1), "#")
                        let both_right = right && str_eq(cell_at(grid, r + side, c + 1), "#")
                        dead = dead || both_left || both_right
                    }
                }
                if dead {
                    count = count + 1
                }
            }
            c = c + 1
        }
        r = r + 1
    }
    count
}

fn reachable(grid: [str]) -> i64 {
    let start = find_player(grid)
    if start[0] < 0 {
        return 0
    }
    let width = 0
    for row in grid {
        width = max_i64(width, str_len(row))
    }
    let seen = arr_repeat(false, len(grid) * width)
    let queue: [i64] = [start[0] * width + start[1]]
    seen[start[0] * width + start[1]] = true
    let head = 0
    while head < len(queue) {
        let at = queue[head]
        head = head + 1
        let r = at / width
        let c = at % width
        for d in [[-1, 0], [1, 0], [0, -1], [0, 1]] {
            let nr = r + d[0]
            let nc = c + d[1]
            if is_open(cell_at(grid, nr, nc)) {
                let key = nr * width + nc
                if !seen[key] {
                    seen[key] = true
                    queue = arr_push(queue, key)
                }
            }
        }
    }
    len(queue)
}

@[test]
fn test_step_walk_onto_floor() {
    assert(step(["#####", "#@ .#", "#####"], "R") == ["#####", "# @.#", "#####"])
}

@[test]
fn test_step_push_box_onto_goal() {
    assert(step(["######", "#@$ .#", "######"], "r") == ["######", "# @$.#", "######"])
    assert(step(["#####", "#@$.#", "#####"], "R") == ["#####", "# @*#", "#####"])
}

@[test]
fn test_step_leave_goal_restores_it() {
    assert(step(["#####", "# +.#", "#####"], "L") == ["#####", "#@..#", "#####"])
}

@[test]
fn test_step_blocked_by_wall_and_double_box() {
    let wall = ["####", "#@ #", "####"]
    assert(step(wall, "U") == wall)
    let pair = ["######", "#@$$ #", "######"]
    assert(step(pair, "R") == pair)
}

@[test]
fn test_is_solved_true() {
    assert(is_solved(["#####", "#@**#", "#####"]))
}

@[test]
fn test_is_solved_with_player_on_goal() {
    assert(is_solved(["#####", "# +*#", "#####"]) == false)
    assert(is_solved(["######", "#+ ** #", "######"]) == false)
    assert(is_solved(["#####", "#*@ #", "#####"]))
}

@[test]
fn test_is_solved_rejects_loose_box_and_bad_symbols() {
    assert(is_solved(["#####", "#@*$#", "#####"]) == false)
    assert(is_solved(["#####", "#@*x#", "#####"]) == false)
    assert(is_solved(["#####", "#@@*#", "#####"]) == false)
}

@[test]
fn test_play_solves_and_stops() {
    let level = ["#######", "#@ $ .#", "#######"]
    assert(play(level, "RRRLL") == [3, 2, 0, 3])
}

@[test]
fn test_play_counts_blocked_moves() {
    let level = ["######", "#@ $.#", "#    #", "######"]
    assert(play(level, "LUDRx") == [2, 0, 3, -1])
}

@[test]
fn test_play_around_corner() {
    let level = ["######", "#    #", "# $  #", "#@ . #", "######"]
    assert(play(level, "URURDLL") == [5, 2, 0, 5])
}

@[test]
fn test_dead_boxes_corner() {
    assert_eq(dead_boxes(["#####", "#$ .#", "#  @#", "#####"]), 1)
}

@[test]
fn test_dead_boxes_frozen_pair_against_wall() {
    assert_eq(dead_boxes(["#######", "# $$ .#", "#   @.#", "#######"]), 2)
}

@[test]
fn test_dead_boxes_ignores_stored_and_free() {
    assert_eq(dead_boxes(["#######", "#*   .#", "#  $ @#", "#######"]), 0)
    assert_eq(dead_boxes(["######", "#*$ @#", "#    #", "######"]), 1)
}

@[test]
fn test_reachable_open_room() {
    assert_eq(reachable(["#####", "#@  #", "#   #", "#####"]), 6)
}

@[test]
fn test_reachable_blocked_by_box() {
    assert_eq(reachable(["#######", "#@ $ .#", "#######"]), 2)
}

@[test]
fn test_reachable_counts_goal_cells() {
    assert_eq(reachable(["######", "#+ ..#", "## ###", "######"]), 5)
}
