// Fares and routes over a transit network of one-way legs. Changing lines at a
// station costs a transfer penalty on top of the leg fares.

type Leg = { depart: str, arrive: str, line: str, fare: i64 }

// Cost of continuing from leg `u` onto leg `j`, or -1 when `j` does not leave
// the station where `u` arrives.
fn step_cost(legs: &[Leg], u: i64, j: i64, penalty: i64) -> i64 {
    if legs[j].depart != legs[u].arrive {
        return -1
    }
    if legs[j].line == legs[u].line {
        legs[j].fare
    } else {
        legs[j].fare + penalty
    }
}

fn station_names(legs: &[Leg]) -> [str] {
    let names: [str] = []
    for leg in legs {
        if !arr_contains(names, leg.depart) {
            names = arr_push(names, leg.depart)
        }
        if !arr_contains(names, leg.arrive) {
            names = arr_push(names, leg.arrive)
        }
    }
    arr_sort_by(names, |a, b| str_cmp(a, b))
}

// Cheapest cost from `origin` to every station, in alphabetical station
// order; -1 marks stations that cannot be reached.
fn fare_table(legs: [Leg], origin: str, penalty: i64) -> [i64] {
    let names = station_names(&legs)
    let m = len(legs)
    let dist = arr_repeat(-1, m)
    let settled = arr_repeat(false, m)
    for i in arr_range(0, m) {
        if legs[i].depart == origin {
            dist[i] = legs[i].fare
        }
    }
    let u = 0
    while u >= 0 {
        u = -1
        for k in arr_range(0, m) {
            if !settled[k] && dist[k] >= 0 && (u < 0 || dist[k] < dist[u]) {
                u = k
            }
        }
        if u >= 0 {
            settled[u] = true
            for j in arr_range(0, m) {
                let c = step_cost(&legs, u, j, penalty)
                if c >= 0 && (dist[j] < 0 || dist[u] + c < dist[j]) {
                    dist[j] = dist[u] + c
                }
            }
        }
    }
    let out = arr_repeat(-1, len(names))
    for s in arr_range(0, len(names)) {
        if names[s] == origin {
            out[s] = 0
        } else {
            for i in arr_range(0, m) {
                if legs[i].arrive == names[s] && dist[i] >= 0 && (out[s] < 0 || dist[i] < out[s]) {
                    out[s] = dist[i]
                }
            }
        }
    }
    out
}

// Stations visited on a cheapest trip from `origin` to `dest`, both included.
// Empty when `dest` cannot be reached.
fn cheapest_route(legs: [Leg], origin: str, dest: str, penalty: i64) -> [str] {
    if origin == dest {
        return [dest]
    }
    let m = len(legs)
    let dist = arr_repeat(-1, m)
    let prev = arr_repeat(-1, m)
    let settled = arr_repeat(false, m)
    for i in arr_range(0, m) {
        if legs[i].depart == origin {
            dist[i] = legs[i].fare
        }
    }
    let best = -1
    let u = 0
    while u >= 0 {
        u = -1
        for k in arr_range(0, m) {
            if !settled[k] && dist[k] >= 0 && (u < 0 || dist[k] < dist[u]) {
                u = k
            }
        }
        if u >= 0 {
            settled[u] = true
            if best < 0 && legs[u].arrive == dest {
                best = u
            }
            for j in arr_range(0, m) {
                let c = step_cost(&legs, u, j, penalty)
                if c >= 0 && (dist[j] < 0 || dist[u] + c < dist[j]) {
                    dist[j] = dist[u] + c
                    prev[j] = u
                }
            }
        }
    }
    let stops: [str] = []
    let cur = best
    while cur >= 0 {
        stops = arr_push(stops, legs[cur].arrive)
        cur = prev[cur]
    }
    if best < 0 {
        []
    } else {
        arr_reverse(arr_push(stops, origin))
    }
}

// Cheapest fare from `origin` to `dest` using at most `max_transfers` line
// changes; -1 when no such trip exists.
fn capped_fare(legs: [Leg], origin: str, dest: str, penalty: i64, max_transfers: i64) -> i64 {
    if origin == dest {
        return 0
    }
    let m = len(legs)
    let w = max_transfers + 1
    let dist = arr_repeat(-1, m * w)
    let settled = arr_repeat(false, m * w)
    for i in arr_range(0, m) {
        if legs[i].depart == origin {
            dist[i * w] = legs[i].fare
        }
    }
    let answer = -1
    let u = 0
    while u >= 0 && answer < 0 {
        u = -1
        for k in arr_range(0, m * w) {
            if !settled[k] && dist[k] >= 0 && (u < 0 || dist[k] < dist[u]) {
                u = k
            }
        }
        if u >= 0 {
            settled[u] = true
            let leg = u / w
            let used = u % w
            if legs[leg].arrive == dest {
                answer = dist[u]
            }
            for j in arr_range(0, m) {
                let c = step_cost(&legs, leg, j, penalty)
                let t = used
                if legs[j].line != legs[leg].line {
                    t = used + 1
                }
                if c >= 0 && t < w && (dist[j * w + t] < 0 || dist[u] + c < dist[j * w + t]) {
                    dist[j * w + t] = dist[u] + c
                }
            }
        }
    }
    answer
}

// Smallest number of line changes needed to travel from `origin` to `dest`,
// regardless of fare; -1 when `dest` cannot be reached.
fn fewest_transfers(legs: [Leg], origin: str, dest: str) -> i64 {
    if origin == dest {
        return 0
    }
    let m = len(legs)
    let changes = arr_repeat(-1, m)
    for i in arr_range(0, m) {
        if legs[i].depart == origin {
            changes[i] = 0
        }
    }
    let changed = true
    while changed {
        changed = false
        for u in arr_range(0, m) {
            for j in arr_range(0, m) {
                if changes[u] >= 0 && legs[j].depart == legs[u].arrive {
                    let t = changes[u]
                    if legs[j].line != legs[u].line {
                        t = t + 1
                    }
                    if changes[j] < 0 || t < changes[j] {
                        changes[j] = t
                        changed = true
                    }
                }
            }
        }
    }
    let best = -1
    for i in arr_range(0, m) {
        if legs[i].arrive == dest && changes[i] >= 0 && (best < 0 || changes[i] < best) {
            best = changes[i]
        }
    }
    best
}

// Price a planned trip: `stops` lists the stations in order and `lines[h]`
// the line ridden from `stops[h]` to `stops[h + 1]`. The cheapest matching leg
// is used for each hop. Returns -1 when the plan is malformed or a hop has no
// service on the named line.
fn itinerary_fare(legs: [Leg], stops: [str], lines: [str], penalty: i64) -> i64 {
    let hops = len(lines)
    if len(stops) != hops + 1 {
        return -1
    }
    let total = 0
    let valid = true
    let h = 0
    while h < hops && valid {
        let cheapest = -1
        for leg in legs {
            if leg.depart == stops[h] && leg.arrive == stops[h + 1] && leg.line == lines[h] {
                if cheapest < 0 || leg.fare < cheapest {
                    cheapest = leg.fare
                }
            }
        }
        if cheapest < 0 {
            valid = false
        } else {
            total = total + cheapest
            if h > 0 && lines[h] != lines[h - 1] {
                total = total + penalty
            }
        }
        h = h + 1
    }
    if valid {
        total
    } else {
        -1
    }
}

fn lg(depart: str, arrive: str, line: str, fare: i64) -> Leg {
    Leg { depart: depart, arrive: arrive, line: line, fare: fare }
}

fn network() -> [Leg] {
    [lg("A", "B", "red", 2), lg("B", "C", "red", 2), lg("C", "D", "red", 3), lg("B", "D", "green", 2), lg("A", "E", "blue", 3), lg("E", "D", "blue", 3), lg("D", "F", "green", 1), lg("C", "F", "blue", 1)]
}

@[test]
fn test_table_from_a() {
    assert(fare_table(network(), "A", 1) == [0, 2, 4, 5, 3, 6])
}

@[test]
fn test_table_from_b() {
    assert(fare_table(network(), "B", 2) == [-1, 0, 2, 2, -1, 3])
}

@[test]
fn test_table_from_e() {
    assert(fare_table(network(), "E", 0) == [-1, -1, -1, 3, 0, 4])
}

@[test]
fn test_route_small_penalty() {
    assert(cheapest_route(network(), "A", "D", 1) == ["A", "B", "D"])
}

@[test]
fn test_route_large_penalty() {
    assert(cheapest_route(network(), "A", "D", 3) == ["A", "E", "D"])
}

@[test]
fn test_route_single_line() {
    assert(cheapest_route(network(), "B", "F", 2) == ["B", "D", "F"])
}

@[test]
fn test_route_unreachable() {
    assert(len(cheapest_route(network(), "F", "A", 0)) == 0)
}

@[test]
fn test_capped_no_transfers() {
    assert_eq(capped_fare(network(), "A", "D", 0, 0), 6)
}

@[test]
fn test_capped_one_transfer() {
    assert_eq(capped_fare(network(), "A", "F", 0, 1), 5)
}

@[test]
fn test_capped_penalised_transfer() {
    assert_eq(capped_fare(network(), "A", "F", 4, 1), 9)
}

@[test]
fn test_capped_impossible() {
    assert_eq(capped_fare(network(), "A", "F", 0, 0), -1)
}

@[test]
fn test_fewest_one_change() {
    assert_eq(fewest_transfers(network(), "A", "F"), 1)
}

@[test]
fn test_fewest_unreachable() {
    assert_eq(fewest_transfers(network(), "F", "A"), -1)
}

@[test]
fn test_fewest_avoids_cheap_zigzag() {
    let legs = [lg("X", "Y", "red", 1), lg("Y", "Z", "blue", 1), lg("Z", "W", "red", 1), lg("X", "V", "green", 5), lg("V", "W", "green", 5)]
    assert_eq(fewest_transfers(legs, "X", "W"), 0)
}

@[test]
fn test_fewest_two_changes() {
    let legs = [lg("X", "Y", "red", 1), lg("Y", "Z", "blue", 1), lg("Z", "W", "red", 1)]
    assert_eq(fewest_transfers(legs, "X", "W"), 2)
}

@[test]
fn test_itinerary_with_transfer() {
    assert_eq(itinerary_fare(network(), ["A", "B", "D"], ["red", "green"], 1), 5)
}

@[test]
fn test_itinerary_single_line() {
    assert_eq(itinerary_fare(network(), ["A", "B", "C", "D"], ["red", "red", "red"], 5), 7)
}

@[test]
fn test_itinerary_wrong_line() {
    assert_eq(itinerary_fare(network(), ["A", "B", "D"], ["red", "red"], 1), -1)
}

@[test]
fn test_itinerary_malformed() {
    assert_eq(itinerary_fare(network(), ["A", "B"], ["red", "red"], 1), -1)
}
