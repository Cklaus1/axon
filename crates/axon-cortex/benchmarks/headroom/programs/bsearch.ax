// Binary search family on an ascending i64 array (duplicates allowed).

fn is_sorted(xs: &[i64]) -> bool {
    for i in 1..len(xs) {
        if xs[i - 1] > xs[i] { return false }
    }
    true
}

// First index i with xs[i] >= target (len(xs) when none).
fn lower_bound(xs: &[i64], target: i64) -> i64 {
    let lo = 0
    let hi = len(xs)
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if xs[mid] < target { lo = mid + 1 } else { hi = mid }
    }
    lo
}

// First index i with xs[i] > target (len(xs) when none).
fn upper_bound(xs: &[i64], target: i64) -> i64 {
    let lo = 0
    let hi = len(xs)
    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if xs[mid] <= target { lo = mid + 1 } else { hi = mid }
    }
    lo
}

fn count_occurrences(xs: &[i64], target: i64) -> i64 { upper_bound(&xs, target) - lower_bound(&xs, target) }

fn find(xs: &[i64], target: i64) -> Option<i64> {
    let i = lower_bound(&xs, target)
    if i < len(xs) && xs[i] == target { Some(i) } else { None }
}

// Where to insert `target` to keep order, after any equal elements.
fn insertion_position(xs: &[i64], target: i64) -> Result<i64, str> {
    if !is_sorted(&xs) { return Err("input not sorted") }
    Ok(upper_bound(&xs, target))
}

fn insert_sorted(xs: &[i64], target: i64) -> Result<[i64], str> {
    let pos = insertion_position(&xs, target)?
    let out = []
    for i in 0..len(xs) {
        if i == pos { out = arr_push(out, target) }
        out = arr_push(out, xs[i])
    }
    if pos == len(xs) { out = arr_push(out, target) }
    Ok(out)
}

fn count_in_range(xs: &[i64], lo: i64, hi: i64) -> i64 {
    if hi < lo { 0 } else { upper_bound(&xs, hi) - lower_bound(&xs, lo) }
}

fn data() -> [i64] { [1, 3, 3, 3, 5, 8, 8, 13] }

fn main() {
    println("threes: {to_str(count_occurrences(&data(), 3))}")
}

@[test]
fn test_is_sorted() {
    assert(is_sorted(&data()))
    assert(is_sorted(&[]))
    assert(!is_sorted(&[2, 1]))
}

@[test]
fn test_lower_bound() {
    let d = data()
    assert_eq(lower_bound(&d, 3), 1)
    assert_eq(lower_bound(&d, 4), 4)
    assert_eq(lower_bound(&d, 0), 0)
    assert_eq(lower_bound(&d, 14), 8)
    assert_eq(lower_bound(&[], 5), 0)
}

@[test]
fn test_upper_bound() {
    let d = data()
    assert_eq(upper_bound(&d, 3), 4)
    assert_eq(upper_bound(&d, 8), 7)
    assert_eq(upper_bound(&d, 13), 8)
    assert_eq(upper_bound(&d, 0), 0)
}

@[test]
fn test_count_occurrences() {
    let d = data()
    assert_eq(count_occurrences(&d, 3), 3)
    assert_eq(count_occurrences(&d, 8), 2)
    assert_eq(count_occurrences(&d, 13), 1)
    assert_eq(count_occurrences(&d, 4), 0)
}

@[test]
fn test_find() {
    let d = data()
    assert_eq(match find(&d, 5) { Some(i) => i, None => -1 }, 4)
    assert_eq(match find(&d, 3) { Some(i) => i, None => -1 }, 1)
    assert_eq(match find(&d, 6) { Some(i) => i, None => -1 }, -1)
    assert_eq(match find(&d, 99) { Some(i) => i, None => -1 }, -1)
}

@[test]
fn test_insertion_position() {
    let d = data()
    assert_eq(match insertion_position(&d, 3) { Ok(p) => p, Err(_) => -1 }, 4)
    assert_eq(match insertion_position(&d, 0) { Ok(p) => p, Err(_) => -1 }, 0)
    assert_eq(match insertion_position(&d, 20) { Ok(p) => p, Err(_) => -1 }, 8)
    assert(match insertion_position(&[3, 1], 2) { Ok(_) => false, Err(e) => str_eq(e, "input not sorted") })
}

@[test]
fn test_insert_sorted() {
    let a: [i64] = match insert_sorted(&data(), 4) { Ok(v) => v, Err(_) => [] }
    assert_eq(len(a), 9)
    assert_eq(a[4], 4)
    assert(is_sorted(&a))
    let b: [i64] = match insert_sorted(&data(), 99) { Ok(v) => v, Err(_) => [] }
    assert_eq(b[8], 99)
    let c: [i64] = match insert_sorted(&[], 7) { Ok(v) => v, Err(_) => [] }
    assert_eq(len(c), 1)
    assert_eq(c[0], 7)
}

@[test]
fn test_count_in_range() {
    let d = data()
    assert_eq(count_in_range(&d, 3, 8), 6)
    assert_eq(count_in_range(&d, 4, 7), 1)
    assert_eq(count_in_range(&d, 9, 12), 0)
    assert_eq(count_in_range(&d, 8, 3), 0)
    assert_eq(count_in_range(&d, -100, 100), 8)
}
