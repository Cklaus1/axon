// CSV row handling: a parser for one line with quoted fields and doubled
// quote escapes, column count, column selection, a decimal column sum in
// cents, and the inverse operation of writing a row back out.

// Splits one CSV line into fields. Inside quotes, "" is a literal quote
// and commas are data. A quote may only open a field; after a closing
// quote the next byte must be a comma or the end of the line.
fn parse_line(line: str) -> Result<[str], str> {
    let fields: [str] = []
    let cur = ""
    let in_quotes = false
    let after_quote = false
    let n = len(line)
    let i = 0
    while i < n {
        let c = char_at(line, i)
        if in_quotes {
            if c == 34 {
                if i + 1 < n && char_at(line, i + 1) == 34 {
                    cur = cur + "\""
                    i = i + 1
                } else {
                    in_quotes = false
                    after_quote = true
                }
            } else {
                cur = cur + str_slice(line, i, i + 1)
            }
        } else if c == 44 {
            fields = arr_push(fields, cur)
            cur = ""
            after_quote = false
        } else if after_quote {
            return Err("unexpected character after quote")
        } else if c == 34 {
            if len(cur) > 0 {
                return Err("quote inside unquoted field")
            }
            in_quotes = true
        } else {
            cur = cur + str_slice(line, i, i + 1)
        }
        i = i + 1
    }
    if in_quotes {
        return Err("unterminated quote")
    }
    Ok(arr_push(fields, cur))
}

fn column_count(line: str) -> Result<i64, str> {
    let fields: [str] = parse_line(line)?
    Ok(len(fields))
}

fn select_column(line: str, idx: i64 where idx >= 0) -> Result<str, str> {
    let fields: [str] = parse_line(line)?
    if idx >= len(fields) {
        return Err("column out of range")
    }
    Ok(fields[idx])
}

// "12.5" -> 1250, "-0.07" -> -7, " 3 " -> 300. At most two decimals.
@[contained]
fn parse_cents(raw: str) -> Result<i64, str> {
    let s = str_trim(raw)
    let n = len(s)
    let i = 0
    let neg = false
    if n > 0 && char_at(s, 0) == 45 {
        neg = true
        i = 1
    }
    let whole = 0
    let digits = 0
    let frac = 0
    let frac_digits = 0
    let seen_dot = false
    while i < n {
        let c = char_at(s, i)
        if c == 46 {
            if seen_dot {
                return Err("bad number")
            }
            seen_dot = true
        } else if c >= 48 && c <= 57 {
            if seen_dot {
                if frac_digits == 2 {
                    return Err("too many decimals")
                }
                frac = frac * 10 + (c - 48)
                frac_digits = frac_digits + 1
            } else {
                whole = whole * 10 + (c - 48)
            }
            digits = digits + 1
        } else {
            return Err("bad number")
        }
        i = i + 1
    }
    if digits == 0 {
        return Err("no digits")
    }
    if frac_digits == 1 {
        frac = frac * 10
    }
    let v = whole * 100 + frac
    Ok(if neg { -v } else { v })
}

// Sum of a decimal column across lines, in cents. Empty cells count as 0.
fn column_sum(lines: &[str], idx: i64) -> Result<i64, str> {
    let total = 0
    for r in 0..len(lines) {
        let cell = select_column(lines[r], idx)?
        if len(str_trim(cell)) > 0 {
            match parse_cents(cell) {
                Ok(v) => total = total + v
                Err(e) => return Err("row " + to_str(r) + ": " + e)
            }
        }
    }
    Ok(total)
}

@[contained]
fn needs_quotes(field: str) -> bool {
    for i in 0..len(field) {
        let c = char_at(field, i)
        if c == 44 || c == 34 || c == 10 {
            return true
        }
    }
    false
}

fn quote_field(field: str) -> str {
    if needs_quotes(field) {
        "\"" + str_replace(field, "\"", "\"\"") + "\""
    } else {
        field
    }
}

fn join_row(fields: &[str]) -> str {
    let out = ""
    for i in 0..len(fields) {
        if i > 0 {
            out = out + ","
        }
        out = out + quote_field(fields[i])
    }
    out
}

fn load_text(path: str) -> Result<str, str> {
    read_file(path)
}

fn main() {
    match select_column("a,\"b, c\",d", 1) {
        Ok(v) => println(v)
        Err(e) => eprintln(e)
    }
}

fn fields_of(line: str) -> [str] {
    match parse_line(line) {
        Ok(fs) => fs
        Err(_) => ["<error>"]
    }
}

fn err_of(line: str) -> str {
    match parse_line(line) {
        Ok(_) => "ok"
        Err(e) => e
    }
}

@[test]
fn test_parse_line_plain() {
    let f = fields_of("a,b,c")
    assert_eq(len(f), 3)
    assert(f[0] == "a")
    assert(f[2] == "c")
    let e = fields_of("x,,")
    assert_eq(len(e), 3)
    assert_eq(len(e[1]), 0)
    let one = fields_of("")
    assert_eq(len(one), 1)
}

@[test]
fn test_parse_line_quoted() {
    let f = fields_of("1,\"hello, world\",3")
    assert_eq(len(f), 3)
    assert(f[1] == "hello, world")
    let g = fields_of("\"say \"\"hi\"\"\",x")
    assert(g[0] == "say \"hi\"")
    assert(g[1] == "x")
    let h = fields_of("\"\",\"\"\"\"")
    assert_eq(len(h[0]), 0)
    assert(h[1] == "\"")
}

@[test]
fn test_parse_line_errors() {
    assert(err_of("a,\"open") == "unterminated quote")
    assert(err_of("\"ab\"c,d") == "unexpected character after quote")
    assert(err_of("ab\"c") == "quote inside unquoted field")
    assert(err_of("\"ab\",c") == "ok")
}

@[test]
fn test_column_count() {
    match column_count("a,b,c,d") { Ok(n) => assert_eq(n, 4)  Err(_) => assert(false) }
    match column_count("\"a,b\",c") { Ok(n) => assert_eq(n, 2)  Err(_) => assert(false) }
    match column_count("solo") { Ok(n) => assert_eq(n, 1)  Err(_) => assert(false) }
    match column_count("\"x") { Ok(_) => assert(false)  Err(_) => assert(true) }
}

@[test]
fn test_select_column() {
    match select_column("a,\"b, c\",d", 1) { Ok(v) => assert(v == "b, c")  Err(_) => assert(false) }
    match select_column("a,b,d", 0) { Ok(v) => assert(v == "a")  Err(_) => assert(false) }
    match select_column("a,b,d", 2) { Ok(v) => assert(v == "d")  Err(_) => assert(false) }
    match select_column("a,b,d", 3) { Ok(_) => assert(false)  Err(e) => assert(e == "column out of range") }
}

@[test]
fn test_parse_cents() {
    match parse_cents("12.5") { Ok(v) => assert_eq(v, 1250)  Err(_) => assert(false) }
    match parse_cents("-0.07") { Ok(v) => assert_eq(v, -7)  Err(_) => assert(false) }
    match parse_cents(" 3 ") { Ok(v) => assert_eq(v, 300)  Err(_) => assert(false) }
    match parse_cents("4.") { Ok(v) => assert_eq(v, 400)  Err(_) => assert(false) }
    match parse_cents(".25") { Ok(v) => assert_eq(v, 25)  Err(_) => assert(false) }
}

@[test]
fn test_parse_cents_errors() {
    match parse_cents("1.234") { Ok(_) => assert(false)  Err(e) => assert(e == "too many decimals") }
    match parse_cents("-") { Ok(_) => assert(false)  Err(e) => assert(e == "no digits") }
    match parse_cents("1.2.3") { Ok(_) => assert(false)  Err(e) => assert(e == "bad number") }
    match parse_cents("12a") { Ok(_) => assert(false)  Err(e) => assert(e == "bad number") }
}

@[test]
fn test_column_sum() {
    let rows = ["apple,1.50,3", "\"pear, green\",2.25,1", "fig,0.05,10"]
    match column_sum(&rows, 1) { Ok(v) => assert_eq(v, 380)  Err(_) => assert(false) }
    match column_sum(&rows, 2) { Ok(v) => assert_eq(v, 1400)  Err(_) => assert(false) }
}

@[test]
fn test_column_sum_empty_and_negative() {
    let rows = ["a,-2.5", "b,", "c,1"]
    match column_sum(&rows, 1) { Ok(v) => assert_eq(v, -150)  Err(_) => assert(false) }
    let none: [str] = []
    match column_sum(&none, 0) { Ok(v) => assert_eq(v, 0)  Err(_) => assert(false) }
}

@[test]
fn test_column_sum_errors() {
    let rows = ["a,1", "b,x", "c,2"]
    match column_sum(&rows, 1) { Ok(_) => assert(false)  Err(e) => assert(e == "row 1: bad number") }
    let short = ["a,1", "b"]
    match column_sum(&short, 1) { Ok(_) => assert(false)  Err(e) => assert(e == "column out of range") }
}

@[test]
fn test_needs_quotes_and_quote_field() {
    assert(!needs_quotes("plain"))
    assert(needs_quotes("a,b"))
    assert(needs_quotes("say \"x\""))
    assert(quote_field("plain") == "plain")
    assert(quote_field("a,b") == "\"a,b\"")
    assert(quote_field("\"") == "\"\"\"\"")
}

@[test]
fn test_join_row_roundtrip() {
    let f = ["x", "a,b", "q\"t", ""]
    let line = join_row(&f)
    assert(line == "x,\"a,b\",\"q\"\"t\",")
    let back = fields_of(line)
    assert_eq(len(back), 4)
    assert(back[1] == "a,b")
    assert(back[2] == "q\"t")
    let none: [str] = []
    assert_eq(len(join_row(&none)), 0)
}
