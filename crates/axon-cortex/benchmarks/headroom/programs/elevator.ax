// Elevator controller (LOOK policy). The car keeps moving in its current
// direction while requests lie ahead, then reverses. An idle car (direction
// 0) goes to the nearest request, preferring the lower floor on a tie.
// Direction: 1 = up, -1 = down, 0 = idle.

@[contained]
fn dist(a: i64, b: i64) -> i64 {
    if a > b { a - b } else { b - a }
}

// True if `floor` lies strictly ahead of `cur` when moving in `dir`.
fn is_ahead(cur: i64, dir: i64, floor: i64) -> bool {
    if dir > 0 { floor > cur } else if dir < 0 { floor < cur } else { false }
}

// Nearest request strictly ahead in `dir`, or -1 if there is none.
fn nearest_ahead(cur: i64, dir: i64, reqs: &[i64]) -> i64 {
    let best = -1
    for i in 0..len(reqs) {
        let f = reqs[i]
        if is_ahead(cur, dir, f) {
            if best < 0 || dist(cur, f) < dist(cur, best) { best = f }
        }
    }
    best
}

fn next_stop(cur: i64, dir: i64, reqs: &[i64]) -> Option<i64> {
    if len(reqs) == 0 { return None }
    for i in 0..len(reqs) {
        if reqs[i] == cur { return Some(cur) }
    }
    if dir == 0 {
        let best = reqs[0]
        for i in 1..len(reqs) {
            let f = reqs[i]
            let d = dist(cur, f)
            if d < dist(cur, best) || (d == dist(cur, best) && f < best) { best = f }
        }
        return Some(best)
    }
    let ahead = nearest_ahead(cur, dir, reqs)
    if ahead >= 0 { return Some(ahead) }
    let back = nearest_ahead(cur, 0 - dir, reqs)
    if back >= 0 { Some(back) } else { None }
}

// Copy of `reqs` without any occurrence of `floor`.
fn remove_floor(reqs: &[i64], floor: i64) -> [i64] {
    let out: [i64] = []
    for i in 0..len(reqs) {
        if reqs[i] != floor { out = arr_push(out, reqs[i]) }
    }
    out
}

// Order in which the stops are visited.
fn serve_all(start: i64, dir: i64, reqs: &[i64]) -> [i64] {
    let pending: [i64] = reqs
    let cur = start
    let d = dir
    let order: [i64] = []
    let going = true
    while going {
        match next_stop(cur, d, &pending) {
            Some(f) => {
                if f > cur { d = 1 } else if f < cur { d = -1 }
                cur = f
                order = arr_push(order, f)
                pending = remove_floor(&pending, f)
            }
            None => { going = false }
        }
    }
    order
}

fn total_distance(start: i64, dir: i64, reqs: &[i64]) -> i64 {
    let order = serve_all(start, dir, reqs)
    let cur = start
    let total = 0
    for i in 0..len(order) {
        total = total + dist(cur, order[i])
        cur = order[i]
    }
    total
}

// Keep only requests for floors 0..=top.
fn filter_valid(reqs: &[i64], top: i64 where top >= 0) -> [i64] {
    let out: [i64] = []
    for i in 0..len(reqs) {
        if reqs[i] >= 0 && reqs[i] <= top { out = arr_push(out, reqs[i]) }
    }
    out
}

fn load_text(path: str) -> Result<str, str> {
    read_file(path)
}

fn stop_or(cur: i64, dir: i64, reqs: &[i64]) -> i64 {
    match next_stop(cur, dir, reqs) { Some(f) => f  None => -99 }
}

@[test]
fn test_dist() {
    assert_eq(dist(3, 8), 5)
    assert_eq(dist(8, 3), 5)
    assert_eq(dist(4, 4), 0)
}

@[test]
fn test_is_ahead() {
    assert(is_ahead(3, 1, 4))
    assert(!is_ahead(3, 1, 3))
    assert(is_ahead(3, -1, 0))
    assert(!is_ahead(3, -1, 5))
    assert(!is_ahead(3, 0, 5))
}

@[test]
fn test_nearest_ahead() {
    assert_eq(nearest_ahead(5, 1, &[9, 2, 7, 6]), 6)
    assert_eq(nearest_ahead(5, -1, &[9, 2, 7, 3]), 3)
    assert_eq(nearest_ahead(5, 1, &[1, 2, 5]), -1)
}

@[test]
fn test_next_stop_directional() {
    assert_eq(stop_or(5, 1, &[8, 2, 6]), 6)
    assert_eq(stop_or(5, -1, &[8, 2, 6]), 2)
    assert_eq(stop_or(5, 1, &[1, 3]), 3)
    assert_eq(stop_or(5, -1, &[9, 7]), 7)
}

@[test]
fn test_next_stop_idle_current_and_empty() {
    assert_eq(stop_or(5, 0, &[3, 7]), 3)
    assert_eq(stop_or(5, 0, &[8, 3]), 3)
    assert_eq(stop_or(5, 0, &[6, 1]), 6)
    assert_eq(stop_or(4, 1, &[9, 4]), 4)
    let empty: [i64] = []
    assert_eq(stop_or(4, 1, &empty), -99)
}

@[test]
fn test_remove_floor() {
    let r = remove_floor(&[3, 5, 3, 7], 3)
    assert_eq(len(r), 2)
    assert_eq(r[0], 5)
    assert_eq(r[1], 7)
    assert_eq(len(remove_floor(&[1, 2], 9)), 2)
}

@[test]
fn test_serve_all_up_then_down() {
    let o = serve_all(4, 1, &[8, 2, 6, 1, 9])
    assert_eq(len(o), 5)
    assert_eq(o[0], 6)
    assert_eq(o[1], 8)
    assert_eq(o[2], 9)
    assert_eq(o[3], 2)
    assert_eq(o[4], 1)
}

@[test]
fn test_serve_all_down_then_up() {
    let o = serve_all(4, -1, &[8, 2, 6, 1, 9])
    assert_eq(o[0], 2)
    assert_eq(o[1], 1)
    assert_eq(o[2], 6)
    assert_eq(o[4], 9)
}

@[test]
fn test_serve_all_idle_duplicates() {
    let o = serve_all(5, 0, &[5, 7, 5, 3])
    assert_eq(len(o), 3)
    assert_eq(o[0], 5)
    assert_eq(o[1], 3)
    assert_eq(o[2], 7)
}

@[test]
fn test_total_distance() {
    assert_eq(total_distance(4, 1, &[8, 2, 6, 1, 9]), 13)
    assert_eq(total_distance(4, -1, &[8, 2, 6, 1, 9]), 11)
    assert_eq(total_distance(5, 0, &[3, 7]), 6)
}

@[test]
fn test_total_distance_edges() {
    let empty: [i64] = []
    assert_eq(total_distance(3, 1, &empty), 0)
    assert_eq(total_distance(3, 1, &[3, 3]), 0)
    assert_eq(total_distance(0, -1, &[10]), 10)
}

@[test]
fn test_filter_valid() {
    let r = filter_valid(&[-1, 0, 4, 5, 2], 4)
    assert_eq(len(r), 3)
    assert_eq(r[0], 0)
    assert_eq(r[1], 4)
    assert_eq(len(filter_valid(&[1, 2], 0)), 0)
    assert_eq(total_distance(2, 1, &filter_valid(&[9, 0, 3], 5)), 4)
}
