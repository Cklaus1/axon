// Graphs as adjacency lists over nodes 0..n-1: BFS distances, reachability, components.

fn filled(n: i64, v: i64) -> [i64] {
    let out = []
    for i in 0..n { out = arr_push(out, v) }
    out
}

fn empty_graph(n: i64) -> [[i64]] {
    let g = []
    for i in 0..n { g = arr_push(g, []) }
    g
}

fn add_edge(g: &mut [[i64]], a: i64, b: i64) {
    g[a] = arr_push(g[a], b)
    g[b] = arr_push(g[b], a)
}

fn from_edges(n: i64, edges: &[(i64, i64)]) -> [[i64]] {
    let g = empty_graph(n)
    for i in 0..len(edges) { add_edge(&mut g, edges[i].0, edges[i].1) }
    g
}

// Hop distance from `src` to every node; -1 where unreachable.
fn bfs(g: &[[i64]], src: i64) -> [i64] {
    let dist = filled(len(g), -1)
    dist[src] = 0
    let queue = [src]
    let head = 0
    while head < len(queue) {
        let u = queue[head]
        head = head + 1
        let nbrs = g[u]
        for k in 0..len(nbrs) {
            let v = nbrs[k]
            if dist[v] < 0 {
                dist[v] = dist[u] + 1
                queue = arr_push(queue, v)
            }
        }
    }
    dist
}

fn hop_distance(g: &[[i64]], a: i64, b: i64) -> Option<i64> {
    if a < 0 || b < 0 || a >= len(g) || b >= len(g) { return None }
    let d = bfs(&g, a)[b]
    if d < 0 { None } else { Some(d) }
}

fn reachable_count(g: &[[i64]], src: i64) -> i64 {
    let d = bfs(&g, src)
    let n = 0
    for i in 0..len(d) {
        if d[i] >= 0 { n = n + 1 }
    }
    n
}

fn components(g: &[[i64]]) -> i64 {
    let seen = filled(len(g), 0)
    let count = 0
    for s in 0..len(g) {
        if seen[s] == 0 {
            count = count + 1
            let d = bfs(&g, s)
            for i in 0..len(d) {
                if d[i] >= 0 { seen[i] = 1 }
            }
        }
    }
    count
}

// 0-1-2-3 path, 1-4 branch, 5-6 separate, 7 isolated.
fn sample() -> [[i64]] { from_edges(8, &[(0, 1), (1, 2), (2, 3), (1, 4), (5, 6)]) }

fn hops_or(g: &[[i64]], a: i64, b: i64) -> i64 { match hop_distance(&g, a, b) { Some(d) => d, None => -1 } }

fn main() {
    println("components: {to_str(components(&sample()))}")
}

@[test]
fn test_filled_and_empty() {
    let f = filled(3, 7)
    assert_eq(len(f), 3)
    assert_eq(f[2], 7)
    let g = empty_graph(4)
    assert_eq(len(g), 4)
    assert_eq(len(g[3]), 0)
}

@[test]
fn test_add_edge() {
    let g = empty_graph(3)
    add_edge(&mut g, 0, 2)
    assert_eq(len(g[0]), 1)
    assert_eq(g[0][0], 2)
    assert_eq(g[2][0], 0)
    assert_eq(len(g[1]), 0)
}

@[test]
fn test_from_edges() {
    let g = sample()
    assert_eq(len(g), 8)
    assert_eq(len(g[1]), 3)
    assert_eq(len(g[7]), 0)
}

@[test]
fn test_bfs() {
    let d = bfs(&sample(), 0)
    assert_eq(d[0], 0)
    assert_eq(d[1], 1)
    assert_eq(d[3], 3)
    assert_eq(d[4], 2)
    assert_eq(d[5], -1)
    assert_eq(d[7], -1)
}

@[test]
fn test_hop_distance() {
    let g = sample()
    assert_eq(hops_or(&g, 3, 4), 3)
    assert_eq(hops_or(&g, 6, 5), 1)
    assert_eq(hops_or(&g, 2, 2), 0)
    assert_eq(hops_or(&g, 0, 6), -1)
    assert_eq(hops_or(&g, 0, 99), -1)
}

@[test]
fn test_reachable_count() {
    let g = sample()
    assert_eq(reachable_count(&g, 0), 5)
    assert_eq(reachable_count(&g, 6), 2)
    assert_eq(reachable_count(&g, 7), 1)
}

@[test]
fn test_components() {
    assert_eq(components(&sample()), 3)
    assert_eq(components(&empty_graph(4)), 4)
    let none: [[i64]] = []
    assert_eq(components(&none), 0)
}

@[test]
fn test_cycle_shortcut() {
    let g = from_edges(5, &[(0, 1), (1, 2), (2, 3), (3, 4), (4, 0)])
    assert_eq(hops_or(&g, 0, 3), 2)
    assert_eq(components(&g), 1)
    assert_eq(reachable_count(&g, 2), 5)
}
