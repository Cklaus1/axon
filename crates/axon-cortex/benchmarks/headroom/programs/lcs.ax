// String similarity: longest common subsequence (length and one witness),
// Levenshtein edit distance, percentages derived from both, and a
// nearest-candidate lookup. Strings are compared byte by byte.

@[contained]
fn min3(a: i64, b: i64, c: i64) -> i64 {
    let m = a
    if b < m { m = b }
    if c < m { m = c }
    m
}

// t[i][j] = LCS length of a[0..i] and b[0..j].
fn lcs_table(a: str, b: str) -> [[i64]] {
    let n = len(a)
    let m = len(b)
    let t: [[i64]] = []
    for i in 0..n + 1 {
        let row: [i64] = []
        for j in 0..m + 1 { row = arr_push(row, 0) }
        t = arr_push(t, row)
    }
    for i in 1..n + 1 {
        for j in 1..m + 1 {
            if char_at(a, i - 1) == char_at(b, j - 1) {
                t[i][j] = t[i - 1][j - 1] + 1
            } else {
                t[i][j] = max_i64(t[i - 1][j], t[i][j - 1])
            }
        }
    }
    t
}

fn lcs_len(a: str, b: str) -> i64 {
    let t = lcs_table(a, b)
    t[len(a)][len(b)]
}

// One longest common subsequence (prefers dropping from `a` on ties).
fn lcs_string(a: str, b: str) -> str {
    let t = lcs_table(a, b)
    let i = len(a)
    let j = len(b)
    let out = ""
    while i > 0 && j > 0 {
        if char_at(a, i - 1) == char_at(b, j - 1) {
            out = str_slice(a, i - 1, i) + out
            i = i - 1
            j = j - 1
        } else if t[i - 1][j] >= t[i][j - 1] {
            i = i - 1
        } else {
            j = j - 1
        }
    }
    out
}

fn edit_distance(a: str, b: str) -> i64 {
    let n = len(a)
    let m = len(b)
    let prev: [i64] = []
    for j in 0..m + 1 { prev = arr_push(prev, j) }
    for i in 1..n + 1 {
        let cur: [i64] = [i]
        for j in 1..m + 1 {
            let cost = if char_at(a, i - 1) == char_at(b, j - 1) { 0 } else { 1 }
            cur = arr_push(cur, min3(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost))
        }
        prev = cur
    }
    prev[m]
}

// 100 * (1 - distance / longer length), truncated; two empty strings are 100.
fn similarity_pct(a: str, b: str) -> i64 {
    let longest = max_i64(len(a), len(b))
    if longest == 0 { return 100 }
    (longest - edit_distance(a, b)) * 100 / longest
}

// 200 * lcs / (len a + len b), truncated; two empty strings are 100.
fn common_ratio_pct(a: str, b: str) -> i64 {
    let total = len(a) + len(b)
    if total == 0 { return 100 }
    lcs_len(a, b) * 200 / total
}

// Index of the candidate nearest to `word` within `max_dist` edits
// (first one wins a tie), or -1.
fn closest(word: str, candidates: &[str], max_dist: i64 where max_dist >= 0) -> i64 {
    let best = -1
    let best_d = max_dist + 1
    for i in 0..len(candidates) {
        let d = edit_distance(word, candidates[i])
        if d < best_d {
            best = i
            best_d = d
        }
    }
    best
}

fn load_text(path: str) -> Result<str, str> {
    read_file(path)
}

@[test]
fn test_min3() {
    assert_eq(min3(3, 1, 2), 1)
    assert_eq(min3(1, 3, 2), 1)
    assert_eq(min3(3, 2, 1), 1)
    assert_eq(min3(4, 4, 4), 4)
}

@[test]
fn test_lcs_table_shape() {
    let t = lcs_table("ab", "b")
    assert_eq(len(t), 3)
    assert_eq(len(t[0]), 2)
    assert_eq(t[1][1], 0)
    assert_eq(t[2][1], 1)
}

@[test]
fn test_lcs_len() {
    assert_eq(lcs_len("ABCBDAB", "BDCABA"), 4)
    assert_eq(lcs_len("abc", "abc"), 3)
    assert_eq(lcs_len("abc", "def"), 0)
    assert_eq(lcs_len("", "xyz"), 0)
}

@[test]
fn test_lcs_string() {
    assert(lcs_string("AGGTAB", "GXTXAYB") == "GTAB")
    assert(lcs_string("abcdef", "acf") == "acf")
    assert(lcs_string("abc", "xyz") == "")
    assert(lcs_string("", "") == "")
}

@[test]
fn test_lcs_string_length_matches() {
    let s = lcs_string("ABCBDAB", "BDCABA")
    assert_eq(len(s), 4)
    assert_eq(lcs_len(s, "ABCBDAB"), 4)
    assert_eq(lcs_len(s, "BDCABA"), 4)
}

@[test]
fn test_edit_distance() {
    assert_eq(edit_distance("kitten", "sitting"), 3)
    assert_eq(edit_distance("flaw", "lawn"), 2)
    assert_eq(edit_distance("", "abc"), 3)
    assert_eq(edit_distance("abc", ""), 3)
    assert_eq(edit_distance("same", "same"), 0)
}

@[test]
fn test_edit_distance_single_ops() {
    assert_eq(edit_distance("cat", "cut"), 1)
    assert_eq(edit_distance("cat", "cats"), 1)
    assert_eq(edit_distance("cat", "at"), 1)
    assert_eq(edit_distance("ab", "ba"), 2)
}

@[test]
fn test_similarity_pct() {
    assert_eq(similarity_pct("kitten", "sitting"), 57)
    assert_eq(similarity_pct("abc", "abc"), 100)
    assert_eq(similarity_pct("", ""), 100)
    assert_eq(similarity_pct("abc", ""), 0)
}

@[test]
fn test_similarity_pct_partial() {
    assert_eq(similarity_pct("abcd", "abce"), 75)
    assert_eq(similarity_pct("ab", "ba"), 0)
    assert_eq(similarity_pct("a", "ab"), 50)
}

@[test]
fn test_common_ratio_pct() {
    assert_eq(common_ratio_pct("AGGTAB", "GXTXAYB"), 61)
    assert_eq(common_ratio_pct("abc", "abc"), 100)
    assert_eq(common_ratio_pct("", ""), 100)
    assert_eq(common_ratio_pct("ab", "cd"), 0)
}

@[test]
fn test_common_ratio_pct_uneven() {
    assert_eq(common_ratio_pct("abc", "a"), 50)
    assert_eq(common_ratio_pct("", "abcd"), 0)
}

@[test]
fn test_closest() {
    let c = ["apply", "apple", "maple"]
    assert_eq(closest("aple", &c, 2), 1)
    assert_eq(closest("aple", &c, 0), -1)
    assert_eq(closest("apply", &c, 0), 0)
    let none: [str] = []
    assert_eq(closest("x", &none, 5), -1)
}

@[test]
fn test_closest_limit_boundary() {
    let c = ["dog", "frog"]
    assert_eq(closest("fog", &c, 1), 0)
    assert_eq(closest("cat", &c, 2), -1)
    assert_eq(closest("cat", &c, 3), 0)
}
