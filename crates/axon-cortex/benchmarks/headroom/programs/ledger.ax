// Account ledger: apply deposits, withdrawals and transfers to a table of
// balances (indexed by account id), reject overdrafts, and report a running
// balance and per-month net totals for one account.

type Kind = Deposit | Withdraw | Transfer

// `from` is the debited account for Withdraw/Transfer; `to` is the credited
// account for Deposit/Transfer. Unused ids are ignored.
type Txn = { kind: Kind, from: i64, to: i64, amount: i64, month: i64 }

type Outcome = { balances: [i64], applied: i64, rejected: i64 }

fn dep(to: i64, amount: i64, month: i64) -> Txn {
    Txn { kind: Kind::Deposit, from: -1, to: to, amount: amount, month: month }
}

fn wd(from: i64, amount: i64, month: i64) -> Txn {
    Txn { kind: Kind::Withdraw, from: from, to: -1, amount: amount, month: month }
}

fn xfer(from: i64, to: i64, amount: i64, month: i64) -> Txn {
    Txn { kind: Kind::Transfer, from: from, to: to, amount: amount, month: month }
}

fn valid_account(balances: &[i64], id: i64) -> bool {
    id >= 0 && id < len(balances)
}

// A debit is allowed only if it leaves the balance at zero or above.
@[contained]
fn can_debit(balance: i64, amount: i64) -> bool {
    amount > 0 && amount <= balance
}

// Apply one transaction, returning the new balance table or a reason.
fn apply_txn(balances: &[i64], t: Txn) -> Result<[i64], str> {
    if t.amount <= 0 {
        return Err("non-positive amount")
    }
    let out = balances
    match t.kind {
        Kind::Deposit => {
            if !valid_account(&out, t.to) { return Err("unknown account") }
            out[t.to] = out[t.to] + t.amount
        }
        Kind::Withdraw => {
            if !valid_account(&out, t.from) { return Err("unknown account") }
            if !can_debit(out[t.from], t.amount) { return Err("overdraft") }
            out[t.from] = out[t.from] - t.amount
        }
        Kind::Transfer => {
            if !valid_account(&out, t.from) || !valid_account(&out, t.to) {
                return Err("unknown account")
            }
            if t.from == t.to { return Err("self transfer") }
            if !can_debit(out[t.from], t.amount) { return Err("overdraft") }
            out[t.from] = out[t.from] - t.amount
            out[t.to] = out[t.to] + t.amount
        }
    }
    Ok(out)
}

// Apply every transaction in order; rejected ones leave balances untouched.
fn apply_all(balances: &[i64], txns: &[Txn]) -> Outcome {
    let cur = balances
    let applied = 0
    let rejected = 0
    for i in 0..len(txns) {
        match apply_txn(&cur, txns[i]) {
            Ok(next) => {
                cur = next
                applied = applied + 1
            }
            Err(_) => { rejected = rejected + 1 }
        }
    }
    Outcome { balances: cur, applied: applied, rejected: rejected }
}

// Signed effect of a transaction on one account, ignoring overdraft rules.
@[contained]
fn txn_delta(t: Txn, account: i64) -> i64 {
    if t.amount <= 0 { return 0 }
    match t.kind {
        Kind::Deposit => if t.to == account { t.amount } else { 0 }
        Kind::Withdraw => if t.from == account { 0 - t.amount } else { 0 }
        Kind::Transfer => {
            if t.from == t.to { 0 }
            else if t.from == account { 0 - t.amount }
            else if t.to == account { t.amount }
            else { 0 }
        }
    }
}

// Balance of `account` after each transaction, starting from `start`.
// A debit that would overdraw the account is skipped (balance repeats).
fn running_balance(txns: &[Txn], account: i64, start: i64) -> [i64] {
    let out: [i64] = []
    let bal = start
    for i in 0..len(txns) {
        let d = txn_delta(txns[i], account)
        if d >= 0 {
            bal = bal + d
        } else if can_debit(bal, 0 - d) {
            bal = bal + d
        }
        out = arr_push(out, bal)
    }
    out
}

// Net movement for `account` in each month 1..=months.
fn monthly_totals(txns: &[Txn], account: i64, months: i64 where months >= 1) -> [i64] {
    let out: [i64] = []
    for m in 1..months + 1 {
        let net = 0
        for i in 0..len(txns) {
            if txns[i].month == m {
                net = net + txn_delta(txns[i], account)
            }
        }
        out = arr_push(out, net)
    }
    out
}

fn load_text(path: str) -> Result<str, str> {
    read_file(path)
}

@[test]
fn test_can_debit_edges() {
    assert(can_debit(100, 100))
    assert(!can_debit(100, 101))
    assert(!can_debit(50, 0))
    assert(!can_debit(0, 1))
}

@[test]
fn test_valid_account_bounds() {
    let b = [10, 20, 30]
    assert(valid_account(&b, 0))
    assert(valid_account(&b, 2))
    assert(!valid_account(&b, 3))
    assert(!valid_account(&b, -1))
}

@[test]
fn test_apply_deposit_and_withdraw() {
    let b = [100, 0]
    match apply_txn(&b, dep(1, 40, 1)) {
        Ok(nb) => { assert_eq(nb[0], 100) assert_eq(nb[1], 40) }
        Err(_) => assert(false)
    }
    match apply_txn(&b, wd(0, 100, 1)) {
        Ok(nb) => assert_eq(nb[0], 0)
        Err(_) => assert(false)
    }
}

@[test]
fn test_apply_rejects() {
    let b = [100, 5]
    match apply_txn(&b, wd(1, 6, 1)) { Ok(_) => assert(false) Err(e) => assert(e == "overdraft") }
    match apply_txn(&b, dep(2, 6, 1)) { Ok(_) => assert(false) Err(e) => assert(e == "unknown account") }
    match apply_txn(&b, dep(0, 0, 1)) { Ok(_) => assert(false) Err(e) => assert(e == "non-positive amount") }
    match apply_txn(&b, xfer(0, 0, 10, 1)) { Ok(_) => assert(false) Err(e) => assert(e == "self transfer") }
}

@[test]
fn test_apply_transfer() {
    let b = [70, 30, 0]
    match apply_txn(&b, xfer(0, 2, 70, 1)) {
        Ok(nb) => { assert_eq(nb[0], 0) assert_eq(nb[1], 30) assert_eq(nb[2], 70) }
        Err(_) => assert(false)
    }
    match apply_txn(&b, xfer(1, 2, 31, 1)) { Ok(_) => assert(false) Err(e) => assert(e == "overdraft") }
}

@[test]
fn test_txn_delta_directions() {
    assert_eq(txn_delta(dep(1, 25, 1), 1), 25)
    assert_eq(txn_delta(dep(1, 25, 1), 0), 0)
    assert_eq(txn_delta(wd(0, 9, 1), 0), -9)
    assert_eq(txn_delta(xfer(0, 1, 15, 1), 0), -15)
    assert_eq(txn_delta(xfer(0, 1, 15, 1), 1), 15)
    assert_eq(txn_delta(xfer(2, 2, 15, 1), 2), 0)
}

@[test]
fn test_apply_all_counts_and_balances() {
    let txns = [dep(0, 50, 1), wd(1, 10, 1), xfer(0, 1, 60, 2), wd(1, 61, 2), wd(1, 60, 3)]
    let o = apply_all(&[20, 0], &txns)
    assert_eq(o.applied, 3)
    assert_eq(o.rejected, 2)
    assert_eq(o.balances[0], 10)
    assert_eq(o.balances[1], 0)
}

@[test]
fn test_apply_all_empty_and_exact_drain() {
    let none: [Txn] = []
    let o = apply_all(&[5, 6], &none)
    assert_eq(o.applied, 0)
    assert_eq(o.balances[1], 6)
    let o2 = apply_all(&[5, 6], &[xfer(1, 0, 6, 1), wd(0, 11, 1)])
    assert_eq(o2.applied, 2)
    assert_eq(o2.rejected, 0)
    assert_eq(o2.balances[0], 0)
    assert_eq(o2.balances[1], 0)
}

@[test]
fn test_apply_all_bad_account_rejected() {
    let o = apply_all(&[10], &[dep(3, 5, 1), xfer(0, 1, 5, 1), wd(0, 10, 1)])
    assert_eq(o.rejected, 2)
    assert_eq(o.applied, 1)
    assert_eq(o.balances[0], 0)
}

@[test]
fn test_running_balance_skips_overdraft() {
    let txns = [dep(0, 30, 1), wd(0, 50, 1), wd(0, 30, 2), dep(1, 99, 2), xfer(1, 0, 5, 3)]
    let r = running_balance(&txns, 0, 10)
    assert_eq(len(r), 5)
    assert_eq(r[0], 40)
    assert_eq(r[1], 40)
    assert_eq(r[2], 10)
    assert_eq(r[3], 10)
    assert_eq(r[4], 15)
}

@[test]
fn test_running_balance_exact_zero() {
    let r = running_balance(&[wd(2, 7, 1), wd(2, 1, 1)], 2, 7)
    assert_eq(r[0], 0)
    assert_eq(r[1], 0)
    let none: [Txn] = []
    assert_eq(len(running_balance(&none, 0, 5)), 0)
}

@[test]
fn test_monthly_totals_basic() {
    let txns = [dep(0, 100, 1), wd(0, 40, 1), xfer(1, 0, 25, 2), xfer(0, 1, 5, 3), dep(1, 7, 3)]
    let m = monthly_totals(&txns, 0, 3)
    assert_eq(len(m), 3)
    assert_eq(m[0], 60)
    assert_eq(m[1], 25)
    assert_eq(m[2], -5)
}

@[test]
fn test_monthly_totals_edges() {
    let txns = [dep(0, 10, 2), dep(0, 3, 4), wd(0, 0, 1)]
    let one = monthly_totals(&txns, 0, 1)
    assert_eq(len(one), 1)
    assert_eq(one[0], 0)
    let four = monthly_totals(&txns, 0, 4)
    assert_eq(four[1], 10)
    assert_eq(four[2], 0)
    assert_eq(four[3], 3)
}

@[test]
fn test_running_balance_transfers_both_sides() {
    let txns = [xfer(0, 1, 20, 1), xfer(1, 0, 50, 1), xfer(1, 0, 45, 2)]
    let r = running_balance(&txns, 1, 25)
    assert_eq(r[0], 45)
    assert_eq(r[1], 45)
    assert_eq(r[2], 0)
}

@[test]
fn test_monthly_totals_transfers_and_overdraft_ignored() {
    let txns = [xfer(2, 0, 8, 1), xfer(0, 2, 3, 1), wd(0, 500, 2), xfer(0, 0, 9, 2)]
    let m = monthly_totals(&txns, 0, 2)
    assert_eq(m[0], 5)
    assert_eq(m[1], -500)
}
