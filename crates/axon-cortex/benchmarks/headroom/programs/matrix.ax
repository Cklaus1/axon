// Integer matrices as rows of i64: shape checks, transpose, multiply, trace, identity.

fn rows(m: &[[i64]]) -> i64 { len(m) }

fn cols(m: &[[i64]]) -> i64 {
    if len(m) == 0 { 0 } else { len(m[0]) }
}

fn is_rectangular(m: &[[i64]]) -> bool {
    let c = cols(&m)
    for i in 0..len(m) {
        if len(m[i]) != c { return false }
    }
    true
}

fn zeros(r: i64, c: i64) -> [[i64]] {
    let out = []
    for i in 0..r {
        let row = []
        for j in 0..c { row = arr_push(row, 0) }
        out = arr_push(out, row)
    }
    out
}

fn transpose(m: &[[i64]]) -> [[i64]] {
    let t = zeros(cols(&m), rows(&m))
    for i in 0..rows(&m) {
        for j in 0..cols(&m) { t[j][i] = m[i][j] }
    }
    t
}

fn multiply(a: &[[i64]], b: &[[i64]]) -> Result<[[i64]], str> {
    if !is_rectangular(&a) || !is_rectangular(&b) { return Err("ragged matrix") }
    if cols(&a) != rows(&b) { return Err("shape mismatch") }
    let p = zeros(rows(&a), cols(&b))
    for i in 0..rows(&a) {
        for j in 0..cols(&b) {
            let s = 0
            for k in 0..cols(&a) { s = s + a[i][k] * b[k][j] }
            p[i][j] = s
        }
    }
    Ok(p)
}

fn trace(m: &[[i64]]) -> Option<i64> {
    if rows(&m) != cols(&m) || !is_rectangular(&m) { return None }
    let s = 0
    for i in 0..rows(&m) { s = s + m[i][i] }
    Some(s)
}

fn is_identity(m: &[[i64]]) -> bool {
    if rows(&m) != cols(&m) || !is_rectangular(&m) { return false }
    for i in 0..rows(&m) {
        for j in 0..cols(&m) {
            let want = if i == j { 1 } else { 0 }
            if m[i][j] != want { return false }
        }
    }
    true
}

fn main() {
    let a = [[1, 2], [3, 4]]
    println("trace: {to_str(match trace(&a) { Some(t) => t, None => -1 })}")
}

@[test]
fn test_shape() {
    let m = [[1, 2, 3], [4, 5, 6]]
    assert_eq(rows(&m), 2)
    assert_eq(cols(&m), 3)
    let e: [[i64]] = []
    assert_eq(cols(&e), 0)
}

@[test]
fn test_is_rectangular() {
    assert(is_rectangular(&[[1, 2], [3, 4]]))
    assert(!is_rectangular(&[[1, 2], [3]]))
}

@[test]
fn test_zeros() {
    let z = zeros(2, 3)
    assert_eq(rows(&z), 2)
    assert_eq(cols(&z), 3)
    assert_eq(z[1][2], 0)
}

@[test]
fn test_transpose() {
    let t = transpose(&[[1, 2, 3], [4, 5, 6]])
    assert_eq(rows(&t), 3)
    assert_eq(cols(&t), 2)
    assert_eq(t[0][1], 4)
    assert_eq(t[2][0], 3)
    assert_eq(t[2][1], 6)
}

@[test]
fn test_multiply() {
    let p = match multiply(&[[1, 2], [3, 4]], &[[5, 6], [7, 8]]) { Ok(m) => m, Err(_) => [] }
    assert_eq(p[0][0], 19)
    assert_eq(p[0][1], 22)
    assert_eq(p[1][0], 43)
    assert_eq(p[1][1], 50)
}

@[test]
fn test_multiply_rect() {
    let p = match multiply(&[[1, 2, 3]], &[[1], [2], [3]]) { Ok(m) => m, Err(_) => [] }
    assert_eq(rows(&p), 1)
    assert_eq(cols(&p), 1)
    assert_eq(p[0][0], 14)
}

@[test]
fn test_multiply_errors() {
    assert(match multiply(&[[1, 2]], &[[1, 2]]) { Ok(_) => false, Err(e) => str_eq(e, "shape mismatch") })
    assert(match multiply(&[[1], [2, 3]], &[[1]]) { Ok(_) => false, Err(e) => str_eq(e, "ragged matrix") })
}

@[test]
fn test_trace() {
    assert_eq(match trace(&[[1, 2], [3, 4]]) { Some(t) => t, None => -1 }, 5)
    assert_eq(match trace(&[[1, 2, 3]]) { Some(t) => t, None => -1 }, -1)
}

@[test]
fn test_is_identity() {
    assert(is_identity(&[[1, 0], [0, 1]]))
    assert(!is_identity(&[[1, 0], [1, 1]]))
    assert(!is_identity(&[[1, 0, 0], [0, 1, 0]]))
    let a = [[2, 1], [7, 4]]
    let inv = [[4, -1], [-7, 2]]
    assert(is_identity(&match multiply(&a, &inv) { Ok(m) => m, Err(_) => [] }))
}
