// Exact rational arithmetic. Every Rat produced by this module is in
// lowest terms with a positive denominator; zero is 0/1.

type Rat = { num: i64, den: i64 }

@[contained]
fn gcd(a: i64, b: i64) -> i64 {
    let x = abs_i64(a)
    let y = abs_i64(b)
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    x
}

fn normalize(n: i64, d: i64 where d != 0) -> Rat {
    if n == 0 {
        return Rat { num: 0, den: 1 }
    }
    let g = gcd(n, d)
    let nn = n / g
    let dd = d / g
    if dd < 0 {
        nn = -nn
        dd = -dd
    }
    Rat { num: nn, den: dd }
}

fn add(a: Rat, b: Rat) -> Rat {
    normalize(a.num * b.den + b.num * a.den, a.den * b.den)
}

fn sub(a: Rat, b: Rat) -> Rat {
    add(a, Rat { num: -b.num, den: b.den })
}

fn mul(a: Rat, b: Rat) -> Rat {
    normalize(a.num * b.num, a.den * b.den)
}

fn div(a: Rat, b: Rat) -> Result<Rat, str> {
    if b.num == 0 {
        return Err("division by zero")
    }
    Ok(normalize(a.num * b.den, a.den * b.num))
}

// -1, 0 or 1 by cross multiplication (denominators are positive).
@[contained]
fn compare(a: Rat, b: Rat) -> i64 {
    let l = a.num * b.den
    let r = b.num * a.den
    if l < r { -1 } else if l > r { 1 } else { 0 }
}

// "3", "-1/2", "1 1/2", "-2 3/4", "0".
fn to_mixed(r: Rat) -> str {
    let neg = r.num < 0
    let n = abs_i64(r.num)
    let whole = n / r.den
    let rem = n % r.den
    let sign = if neg { "-" } else { "" }
    if rem == 0 {
        sign + to_str(whole)
    } else if whole == 0 {
        sign + to_str(rem) + "/" + to_str(r.den)
    } else {
        sign + to_str(whole) + " " + to_str(rem) + "/" + to_str(r.den)
    }
}

fn sum_all(rs: &[Rat]) -> Rat {
    let acc = Rat { num: 0, den: 1 }
    for i in 0..len(rs) {
        acc = add(acc, rs[i])
    }
    acc
}

// Index of the largest value; the first one wins ties, -1 when empty.
fn max_index(rs: &[Rat]) -> i64 {
    if len(rs) == 0 {
        return -1
    }
    let best = 0
    for i in 1..len(rs) {
        if compare(rs[i], rs[best]) > 0 {
            best = i
        }
    }
    best
}

fn load_text(path: str) -> Result<str, str> {
    read_file(path)
}

fn q(n: i64, d: i64) -> Rat {
    normalize(n, d)
}

fn main() {
    println(to_mixed(add(q(1, 2), q(5, 4))))
}

@[test]
fn test_gcd() {
    assert_eq(gcd(12, 18), 6)
    assert_eq(gcd(-12, 18), 6)
    assert_eq(gcd(7, 0), 7)
    assert_eq(gcd(0, 5), 5)
    assert_eq(gcd(17, 5), 1)
}

@[test]
fn test_normalize_reduces() {
    let r = normalize(6, 8)
    assert_eq(r.num, 3)
    assert_eq(r.den, 4)
    let s = normalize(10, 5)
    assert_eq(s.num, 2)
    assert_eq(s.den, 1)
}

@[test]
fn test_normalize_sign_and_zero() {
    let r = normalize(3, -9)
    assert_eq(r.num, -1)
    assert_eq(r.den, 3)
    let s = normalize(-4, -6)
    assert_eq(s.num, 2)
    assert_eq(s.den, 3)
    let z = normalize(0, -7)
    assert_eq(z.num, 0)
    assert_eq(z.den, 1)
}

@[test]
fn test_add_and_sub() {
    let a = add(q(1, 2), q(1, 3))
    assert_eq(a.num, 5)
    assert_eq(a.den, 6)
    let b = add(q(1, 4), q(3, 4))
    assert_eq(b.num, 1)
    assert_eq(b.den, 1)
    let c = sub(q(1, 3), q(1, 2))
    assert_eq(c.num, -1)
    assert_eq(c.den, 6)
    let d = sub(q(2, 5), q(2, 5))
    assert_eq(d.num, 0)
    assert_eq(d.den, 1)
}

@[test]
fn test_mul() {
    let a = mul(q(2, 3), q(9, 4))
    assert_eq(a.num, 3)
    assert_eq(a.den, 2)
    let b = mul(q(-1, 2), q(2, 7))
    assert_eq(b.num, -1)
    assert_eq(b.den, 7)
    let c = mul(q(0, 1), q(5, 3))
    assert_eq(c.num, 0)
    assert_eq(c.den, 1)
}

@[test]
fn test_div() {
    match div(q(1, 2), q(3, 4)) {
        Ok(r) => {
            assert_eq(r.num, 2)
            assert_eq(r.den, 3)
        }
        Err(_) => assert(false)
    }
    match div(q(1, 2), q(-1, 4)) {
        Ok(r) => {
            assert_eq(r.num, -2)
            assert_eq(r.den, 1)
        }
        Err(_) => assert(false)
    }
    match div(q(1, 2), q(0, 1)) {
        Ok(_) => assert(false)
        Err(e) => assert(e == "division by zero")
    }
}

@[test]
fn test_compare() {
    assert_eq(compare(q(1, 3), q(1, 2)), -1)
    assert_eq(compare(q(2, 4), q(1, 2)), 0)
    assert_eq(compare(q(-1, 2), q(-2, 3)), 1)
    assert_eq(compare(q(7, 3), q(2, 1)), 1)
}

@[test]
fn test_to_mixed() {
    assert(to_mixed(q(0, 5)) == "0")
    assert(to_mixed(q(6, 2)) == "3")
    assert(to_mixed(q(1, 2)) == "1/2")
    assert(to_mixed(q(3, 2)) == "1 1/2")
    assert(to_mixed(q(-11, 4)) == "-2 3/4")
    assert(to_mixed(q(-1, 3)) == "-1/3")
    assert(to_mixed(q(-8, 4)) == "-2")
}

@[test]
fn test_mixed_of_arithmetic() {
    assert(to_mixed(add(q(1, 2), q(5, 4))) == "1 3/4")
    assert(to_mixed(sub(q(1, 4), q(5, 2))) == "-2 1/4")
    assert(to_mixed(mul(q(4, 3), q(3, 2))) == "2")
}

@[test]
fn test_sum_all() {
    let rs = [q(1, 2), q(1, 3), q(1, 6)]
    let s = sum_all(&rs)
    assert_eq(s.num, 1)
    assert_eq(s.den, 1)
    let mixed = [q(3, 4), q(-1, 4), q(5, 8)]
    let t = sum_all(&mixed)
    assert_eq(t.num, 9)
    assert_eq(t.den, 8)
    let none: [Rat] = []
    let z = sum_all(&none)
    assert_eq(z.num, 0)
    assert_eq(z.den, 1)
}

@[test]
fn test_max_index() {
    let rs = [q(1, 3), q(3, 4), q(2, 3)]
    assert_eq(max_index(&rs), 1)
    let tie = [q(1, 2), q(2, 4), q(-1, 2)]
    assert_eq(max_index(&tie), 0)
    let neg = [q(-3, 2), q(-1, 2)]
    assert_eq(max_index(&neg), 1)
    let none: [Rat] = []
    assert_eq(max_index(&none), -1)
}
