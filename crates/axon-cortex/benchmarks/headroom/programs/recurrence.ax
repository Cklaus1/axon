// Recurring events on integer day numbers. A schedule fires on `start`
// and then every `every` days; `until` is the last allowed day, or -1 for
// an open-ended schedule. Ranges below are inclusive on both ends.

type Schedule = { start: i64, every: i64, until: i64 }

fn make_schedule(start: i64, every: i64 where every >= 1, until: i64) -> Schedule {
    Schedule { start: start, every: every, until: until }
}

fn within_until(s: Schedule, day: i64) -> bool {
    s.until < 0 || day <= s.until
}

@[contained]
fn occurs_on(s: Schedule, day: i64) -> bool {
    if day < s.start || !within_until(s, day) {
        return false
    }
    (day - s.start) % s.every == 0
}

// Earliest occurrence on or after day d, or -1 if the schedule has ended.
@[contained]
fn first_on_or_after(s: Schedule, d: i64) -> i64 {
    let day = s.start
    if d > s.start {
        let steps = (d - s.start + s.every - 1) / s.every
        day = s.start + steps * s.every
    }
    if within_until(s, day) { day } else { -1 }
}

fn next_after(s: Schedule, d: i64) -> i64 {
    first_on_or_after(s, d + 1)
}

fn occurrences_in(s: Schedule, lo: i64, hi: i64) -> [i64] {
    let out: [i64] = []
    let day = first_on_or_after(s, lo)
    while day >= 0 && day <= hi && within_until(s, day) {
        out = arr_push(out, day)
        day = day + s.every
    }
    out
}

// Closed-form count of occurrences in [lo, hi].
fn count_in(s: Schedule, lo: i64, hi: i64) -> i64 {
    let first = first_on_or_after(s, lo)
    let last_day = if s.until >= 0 && s.until < hi { s.until } else { hi }
    if first < 0 || first > last_day {
        return 0
    }
    (last_day - first) / s.every + 1
}

// First day on or after `from` when both schedules fire, or -1.
fn first_common(a: Schedule, b: Schedule, from: i64) -> i64 {
    let lo = if from > b.start { from } else { b.start }
    let x = first_on_or_after(a, lo)
    for k in 0..b.every {
        if x < 0 {
            return -1
        }
        if occurs_on(b, x) {
            return x
        }
        x = next_after(a, x)
    }
    -1
}

// Days in [lo, hi] when both schedules fire.
fn overlap_days(a: Schedule, b: Schedule, lo: i64, hi: i64) -> [i64] {
    let days = occurrences_in(a, lo, hi)
    let out: [i64] = []
    for i in 0..len(days) {
        if occurs_on(b, days[i]) {
            out = arr_push(out, days[i])
        }
    }
    out
}

fn load_text(path: str) -> Result<str, str> {
    read_file(path)
}

fn main() {
    let a = make_schedule(3, 7, -1)
    println("next after 10: " + to_str(next_after(a, 10)))
}

@[test]
fn test_occurs_on() {
    let s = make_schedule(10, 7, -1)
    assert(occurs_on(s, 10))
    assert(occurs_on(s, 24))
    assert(!occurs_on(s, 3))
    assert(!occurs_on(s, 23))
    let e = make_schedule(10, 7, 24)
    assert(occurs_on(e, 24))
    assert(!occurs_on(e, 31))
}

@[test]
fn test_first_on_or_after() {
    let s = make_schedule(10, 7, -1)
    assert_eq(first_on_or_after(s, 0), 10)
    assert_eq(first_on_or_after(s, 10), 10)
    assert_eq(first_on_or_after(s, 11), 17)
    assert_eq(first_on_or_after(s, 17), 17)
    assert_eq(first_on_or_after(s, 18), 24)
    let e = make_schedule(10, 7, 20)
    assert_eq(first_on_or_after(e, 18), -1)
}

@[test]
fn test_next_after() {
    let s = make_schedule(3, 7, -1)
    assert_eq(next_after(s, 0), 3)
    assert_eq(next_after(s, 3), 10)
    assert_eq(next_after(s, 9), 10)
    assert_eq(next_after(s, 10), 17)
    let daily = make_schedule(5, 1, 6)
    assert_eq(next_after(daily, 5), 6)
    assert_eq(next_after(daily, 6), -1)
}

@[test]
fn test_occurrences_in() {
    let s = make_schedule(3, 7, -1)
    let d = occurrences_in(s, 0, 30)
    assert_eq(len(d), 4)
    assert_eq(d[0], 3)
    assert_eq(d[3], 24)
    let edge = occurrences_in(s, 10, 24)
    assert_eq(len(edge), 3)
    assert_eq(edge[0], 10)
    assert_eq(edge[2], 24)
    assert_eq(len(occurrences_in(s, 11, 16)), 0)
}

@[test]
fn test_occurrences_in_until() {
    let s = make_schedule(0, 5, 12)
    let d = occurrences_in(s, 0, 100)
    assert_eq(len(d), 3)
    assert_eq(d[2], 10)
    assert_eq(len(occurrences_in(s, 13, 100)), 0)
}

@[test]
fn test_count_in() {
    let s = make_schedule(3, 7, -1)
    assert_eq(count_in(s, 0, 30), 4)
    assert_eq(count_in(s, 10, 24), 3)
    assert_eq(count_in(s, 11, 16), 0)
    assert_eq(count_in(s, 3, 3), 1)
    let e = make_schedule(0, 5, 12)
    assert_eq(count_in(e, 0, 100), 3)
    assert_eq(count_in(e, 11, 100), 0)
}

@[test]
fn test_count_matches_list() {
    let s = make_schedule(2, 3, 40)
    assert_eq(count_in(s, 5, 35), len(occurrences_in(s, 5, 35)))
    assert_eq(count_in(s, 0, 50), 13)
    assert_eq(len(occurrences_in(s, 0, 50)), 13)
}

@[test]
fn test_first_common() {
    let a = make_schedule(0, 4, -1)
    let b = make_schedule(0, 6, -1)
    assert_eq(first_common(a, b, 0), 0)
    assert_eq(first_common(a, b, 1), 12)
    assert_eq(first_common(a, b, 13), 24)
    let c = make_schedule(1, 4, -1)
    let d = make_schedule(3, 6, -1)
    assert_eq(first_common(c, d, 0), 9)
}

@[test]
fn test_first_common_never() {
    let even = make_schedule(0, 2, -1)
    let odd = make_schedule(1, 2, -1)
    assert_eq(first_common(even, odd, 0), -1)
    let a = make_schedule(0, 4, 20)
    let b = make_schedule(0, 6, -1)
    assert_eq(first_common(a, b, 13), -1)
}

@[test]
fn test_overlap_days() {
    let a = make_schedule(0, 4, -1)
    let b = make_schedule(0, 6, -1)
    let o = overlap_days(a, b, 0, 40)
    assert_eq(len(o), 4)
    assert_eq(o[0], 0)
    assert_eq(o[1], 12)
    assert_eq(o[3], 36)
    let later = overlap_days(a, b, 1, 23)
    assert_eq(len(later), 1)
    assert_eq(later[0], 12)
}

@[test]
fn test_overlap_days_with_until() {
    let a = make_schedule(1, 4, -1)
    let b = make_schedule(3, 6, 30)
    let o = overlap_days(a, b, 0, 60)
    assert_eq(len(o), 2)
    assert_eq(o[0], 9)
    assert_eq(o[1], 21)
    let even = make_schedule(0, 2, -1)
    let odd = make_schedule(1, 2, -1)
    assert_eq(len(overlap_days(even, odd, 0, 50)), 0)
}
