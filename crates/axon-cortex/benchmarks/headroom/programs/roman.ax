// Roman numerals for 1..=3999 in canonical subtractive form, both directions.

fn symbols() -> [str] { ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"] }

fn values() -> [i64] { [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1] }

fn to_roman(n: i64) -> Result<str, str> {
    if n < 1 || n > 3999 { return Err("out of range") }
    let syms = symbols()
    let vals = values()
    let out = ""
    let left = n
    for i in 0..len(vals) {
        while left >= vals[i] {
            out = out + syms[i]
            left = left - vals[i]
        }
    }
    Ok(out)
}

fn digit_value(c: i64) -> Option<i64> {
    let letters = "IVXLCDM"
    let vals = [1, 5, 10, 50, 100, 500, 1000]
    for i in 0..len(letters) {
        if char_at(letters, i) == c { return Some(vals[i]) }
    }
    None
}

fn raw_value(s: str) -> Result<i64, str> {
    let total = 0
    for i in 0..len(s) {
        let v = match digit_value(char_at(s, i)) { Some(x) => x, None => -1 }
        if v < 0 { return Err("bad symbol") }
        let next = if i + 1 < len(s) {
            match digit_value(char_at(s, i + 1)) { Some(x) => x, None => 0 }
        } else { 0 }
        if v < next { total = total - v } else { total = total + v }
    }
    Ok(total)
}

// Accepts only canonical numerals: the value must re-encode to the same text.
fn from_roman(s: str) -> Result<i64, str> {
    if len(s) == 0 { return Err("empty") }
    let v = raw_value(s)?
    match to_roman(v) {
        Ok(back) => if str_eq(back, s) { Ok(v) } else { Err("not canonical") }
        Err(e) => Err(e)
    }
}

fn roman_or(n: i64, dflt: str) -> str {
    match to_roman(n) {
        Ok(s) => s
        Err(_) => dflt
    }
}

fn main() {
    println(roman_or(2024, "?"))
}

@[test]
fn test_tables_align() {
    assert_eq(len(symbols()), len(values()))
    assert_eq(len(symbols()), 13)
}

@[test]
fn test_to_roman_basic() {
    assert(str_eq(roman_or(1, "?"), "I"))
    assert(str_eq(roman_or(4, "?"), "IV"))
    assert(str_eq(roman_or(9, "?"), "IX"))
    assert(str_eq(roman_or(14, "?"), "XIV"))
    assert(str_eq(roman_or(40, "?"), "XL"))
}

@[test]
fn test_to_roman_large() {
    assert(str_eq(roman_or(1994, "?"), "MCMXCIV"))
    assert(str_eq(roman_or(2024, "?"), "MMXXIV"))
    assert(str_eq(roman_or(3999, "?"), "MMMCMXCIX"))
    assert(str_eq(roman_or(444, "?"), "CDXLIV"))
}

@[test]
fn test_to_roman_range() {
    assert(str_eq(roman_or(0, "range"), "range"))
    assert(str_eq(roman_or(4000, "range"), "range"))
}

@[test]
fn test_digit_value() {
    assert_eq(match digit_value(char_at("M", 0)) { Some(v) => v, None => -1 }, 1000)
    assert_eq(match digit_value(char_at("L", 0)) { Some(v) => v, None => -1 }, 50)
    assert_eq(match digit_value(char_at("Q", 0)) { Some(v) => v, None => -1 }, -1)
}

@[test]
fn test_raw_value() {
    assert_eq(match raw_value("MCMXCIV") { Ok(v) => v, Err(_) => -1 }, 1994)
    assert_eq(match raw_value("IIII") { Ok(v) => v, Err(_) => -1 }, 4)
    assert_eq(match raw_value("AB") { Ok(v) => v, Err(_) => -1 }, -1)
}

@[test]
fn test_from_roman() {
    assert_eq(match from_roman("XLII") { Ok(v) => v, Err(_) => -1 }, 42)
    assert_eq(match from_roman("MMMCMXCIX") { Ok(v) => v, Err(_) => -1 }, 3999)
    assert(match from_roman("IIII") { Ok(_) => false, Err(e) => str_eq(e, "not canonical") })
    assert(match from_roman("") { Ok(_) => false, Err(e) => str_eq(e, "empty") })
    assert(match from_roman("xiv") { Ok(_) => false, Err(e) => str_eq(e, "bad symbol") })
}

@[test]
fn test_round_trip_all() {
    let bad = 0
    for n in 1..4000 {
        let back = match to_roman(n) {
            Ok(s) => match from_roman(s) { Ok(v) => v, Err(_) => -1 }
            Err(_) => -1
        }
        if back != n { bad = bad + 1 }
    }
    assert_eq(bad, 0)
}
