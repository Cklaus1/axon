// Integer arithmetic: tokenizer, infix -> RPN (shunting-yard, left-assoc + - * /), RPN evaluator.

fn is_digit(c: i64) -> bool { c >= 48 && c <= 57 }
fn is_op(t: str) -> bool { str_eq(t, "+") || str_eq(t, "-") || str_eq(t, "*") || str_eq(t, "/") }

fn tokenize(s: str) -> Result<[str], str> {
    let out = []
    let i = 0
    while i < len(s) {
        let c = char_at(s, i)
        if c == 32 { i = i + 1 } else if is_digit(c) {
            let j = i
            while j < len(s) && is_digit(char_at(s, j)) { j = j + 1 }
            out = arr_push(out, str_slice(s, i, j))
            i = j
        } else {
            let t = str_slice(s, i, i + 1)
            if !is_op(t) && !str_eq(t, "(") && !str_eq(t, ")") { return Err("bad char at {to_str(i)}") }
            out = arr_push(out, t)
            i = i + 1
        }
    }
    Ok(out)
}

fn precedence(op: str) -> i64 { if str_eq(op, "*") || str_eq(op, "/") { 2 } else { 1 } }
fn top(xs: &[str]) -> str { if len(xs) == 0 { "" } else { xs[len(xs) - 1] } }

fn without_last(xs: &[str]) -> [str] {
    let out = []
    for i in 0..(len(xs) - 1) { out = arr_push(out, xs[i]) }
    out
}

fn to_rpn(tokens: &[str]) -> Result<[str], str> {
    let out = []
    let ops = []
    for i in 0..len(tokens) {
        let t = tokens[i]
        if is_op(t) {
            while is_op(top(&ops)) && precedence(top(&ops)) >= precedence(t) {
                out = arr_push(out, top(&ops))
                ops = without_last(&ops)
            }
            ops = arr_push(ops, t)
        } else if str_eq(t, "(") { ops = arr_push(ops, t) } else if str_eq(t, ")") {
            while len(ops) > 0 && !str_eq(top(&ops), "(") {
                out = arr_push(out, top(&ops))
                ops = without_last(&ops)
            }
            if len(ops) == 0 { return Err("unbalanced )") }
            ops = without_last(&ops)
        } else { out = arr_push(out, t) }
    }
    while len(ops) > 0 {
        if str_eq(top(&ops), "(") { return Err("unbalanced (") }
        out = arr_push(out, top(&ops))
        ops = without_last(&ops)
    }
    Ok(out)
}

fn apply(op: str, a: i64, b: i64) -> Result<i64, str> {
    if str_eq(op, "+") { Ok(a + b) } else if str_eq(op, "-") { Ok(a - b) } else if str_eq(op, "*") { Ok(a * b) } else if b == 0 { Err("division by zero") } else { Ok(a / b) }
}

fn eval_rpn(tokens: &[str]) -> Result<i64, str> {
    let stack = []
    for i in 0..len(tokens) {
        let t = tokens[i]
        if is_op(t) {
            let n = len(stack)
            if n < 2 { return Err("stack underflow") }
            let r = apply(t, stack[n - 2], stack[n - 1])?
            let next = []
            for k in 0..(n - 2) { next = arr_push(next, stack[k]) }
            stack = arr_push(next, r)
        } else { stack = arr_push(stack, parse_int(t)?) }
    }
    if len(stack) != 1 { Err("malformed expression") } else { Ok(stack[0]) }
}

fn calc(s: str) -> Result<i64, str> {
    let toks = tokenize(s)?
    let rpn = to_rpn(&toks)?
    eval_rpn(&rpn)
}

fn join_tokens(ts: &[str]) -> str {
    let s = ""
    for i in 0..len(ts) { s = if i == 0 { ts[i] } else { s + " " + ts[i] } }
    s
}
fn joined(r: Result<[str], str>) -> str { match r { Ok(ts) => join_tokens(&ts), Err(e) => "error: " + e } }
fn calc_or(s: str, dflt: i64) -> i64 { match calc(s) { Ok(v) => v, Err(_) => dflt } }
fn main() { println(to_str(calc_or("2 + 3 * 4", -1))) }

@[test]
fn test_tokenize() {
    assert(str_eq(joined(tokenize("12+(3 * 45)")), "12 + ( 3 * 45 )"))
    assert(str_eq(joined(tokenize("2 ^ 3")), "error: bad char at 2"))
    assert(str_eq(joined(tokenize("")), ""))
}

@[test]
fn test_is_op_precedence() {
    assert(is_op("/"))
    assert(!is_op("("))
    assert_eq(precedence("*"), 2)
    assert_eq(precedence("-"), 1)
}

@[test]
fn test_stack_helpers() {
    let w = without_last(&["a", "b", "c"])
    assert_eq(len(w), 2)
    assert(str_eq(top(&w), "b"))
    assert(str_eq(top(&[]), ""))
    assert(str_eq(join_tokens(&w), "a b"))
}

@[test]
fn test_to_rpn() {
    assert(str_eq(joined(to_rpn(&["2", "+", "3", "*", "4"])), "2 3 4 * +"))
    assert(str_eq(joined(to_rpn(&["(", "2", "+", "3", ")", "*", "4"])), "2 3 + 4 *"))
    assert(str_eq(joined(to_rpn(&["8", "-", "3", "-", "2"])), "8 3 - 2 -"))
    assert(str_eq(joined(to_rpn(&["(", "1"])), "error: unbalanced ("))
    assert(str_eq(joined(to_rpn(&["1", ")"])), "error: unbalanced )"))
}

@[test]
fn test_apply() {
    assert_eq(match apply("-", 7, 10) { Ok(v) => v, Err(_) => 999 }, -3)
    assert_eq(match apply("/", 7, 2) { Ok(v) => v, Err(_) => 999 }, 3)
    assert(match apply("/", 1, 0) { Ok(_) => false, Err(e) => str_eq(e, "division by zero") })
}

@[test]
fn test_eval_rpn() {
    assert_eq(match eval_rpn(&["3", "4", "+", "2", "*"]) { Ok(v) => v, Err(_) => -1 }, 14)
    assert_eq(match eval_rpn(&["10", "2", "8", "*", "+", "3", "-"]) { Ok(v) => v, Err(_) => -1 }, 23)
    assert(match eval_rpn(&["1", "+"]) { Ok(_) => false, Err(e) => str_eq(e, "stack underflow") })
    assert(match eval_rpn(&["1", "2"]) { Ok(_) => false, Err(e) => str_eq(e, "malformed expression") })
}

@[test]
fn test_calc() {
    assert_eq(calc_or("2 + 3 * 4", -1), 14)
    assert_eq(calc_or("(2 + 3) * 4", -1), 20)
    assert_eq(calc_or("100 / 7 / 2", -1), 7)
    assert_eq(calc_or("8 - 3 - 2", -1), 3)
    assert_eq(calc_or("2 * (3 + 4) - 10 / (1 + 1)", -1), 9)
}

@[test]
fn test_calc_errors() {
    assert(match calc("4 / (2 - 2)") { Ok(_) => false, Err(e) => str_eq(e, "division by zero") })
    assert(match calc("1 +") { Ok(_) => false, Err(e) => str_eq(e, "stack underflow") })
    assert_eq(calc_or("", -1), -1)
}
