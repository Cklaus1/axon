// Semantic version strings "MAJOR.MINOR.PATCH[-PRE]": parsing, ordering,
// bumping and caret-range matching ("^1.2.3" means >=1.2.3 and below the
// next breaking release). Pre-release ordering compares the tag bytes.

type Version = { major: i64, minor: i64, patch: i64, pre: str }

// Splits on a single byte; "a..b" yields an empty middle part.
fn split_on(s: str, sep: i64) -> [str] {
    let parts: [str] = []
    let start = 0
    for i in 0..len(s) {
        if char_at(s, i) == sep {
            parts = arr_push(parts, str_slice(s, start, i))
            start = i + 1
        }
    }
    arr_push(parts, str_slice(s, start, len(s)))
}

// Decimal digits only, no leading zero unless the number is exactly "0".
@[contained]
fn parse_num(s: str) -> Result<i64, str> {
    let n = len(s)
    if n == 0 {
        return Err("empty number")
    }
    if n > 1 && char_at(s, 0) == 48 {
        return Err("leading zero")
    }
    let v = 0
    for i in 0..n {
        let c = char_at(s, i)
        if c < 48 || c > 57 {
            return Err("not a digit")
        }
        v = v * 10 + (c - 48)
    }
    Ok(v)
}

fn parse_version(s: str) -> Result<Version, str> {
    let dash = str_index_of(s, "-")
    let end = if dash >= 0 { dash } else { len(s) }
    let core = str_slice(s, 0, end)
    let pre = if dash >= 0 { str_slice(s, dash + 1, len(s)) } else { "" }
    if dash >= 0 && len(pre) == 0 {
        return Err("empty pre-release")
    }
    let parts = split_on(core, 46)
    if len(parts) != 3 {
        return Err("expected three numbers")
    }
    let ma = parse_num(parts[0])?
    let mi = parse_num(parts[1])?
    let pa = parse_num(parts[2])?
    Ok(Version { major: ma, minor: mi, patch: pa, pre: pre })
}

fn to_string(v: Version) -> str {
    let core = to_str(v.major) + "." + to_str(v.minor) + "." + to_str(v.patch)
    if len(v.pre) == 0 { core } else { core + "-" + v.pre }
}

// -1, 0 or 1. A release ranks above any pre-release of the same core.
@[contained]
fn compare(a: Version, b: Version) -> i64 {
    if a.major != b.major {
        return if a.major < b.major { -1 } else { 1 }
    }
    if a.minor != b.minor {
        return if a.minor < b.minor { -1 } else { 1 }
    }
    if a.patch != b.patch {
        return if a.patch < b.patch { -1 } else { 1 }
    }
    let ea = len(a.pre) == 0
    let eb = len(b.pre) == 0
    if ea && eb {
        0
    } else if ea {
        1
    } else if eb {
        -1
    } else {
        str_cmp(a.pre, b.pre)
    }
}

// Bumping "patch" on a pre-release just drops the tag (1.2.3-rc -> 1.2.3).
fn bump(v: Version, part: str) -> Result<Version, str> {
    if part == "major" {
        Ok(Version { major: v.major + 1, minor: 0, patch: 0, pre: "" })
    } else if part == "minor" {
        Ok(Version { major: v.major, minor: v.minor + 1, patch: 0, pre: "" })
    } else if part == "patch" {
        let p = if len(v.pre) > 0 { v.patch } else { v.patch + 1 }
        Ok(Version { major: v.major, minor: v.minor, patch: p, pre: "" })
    } else {
        Err("unknown part")
    }
}

// Exclusive upper bound of a caret range.
fn caret_upper(base: Version) -> Version {
    if base.major > 0 {
        Version { major: base.major + 1, minor: 0, patch: 0, pre: "" }
    } else if base.minor > 0 {
        Version { major: 0, minor: base.minor + 1, patch: 0, pre: "" }
    } else {
        Version { major: 0, minor: 0, patch: base.patch + 1, pre: "" }
    }
}

// Pre-release versions only match when the range names the same core.
fn satisfies_caret(v: Version, range: str) -> Result<bool, str> {
    if !str_starts_with(range, "^") {
        return Err("not a caret range")
    }
    let base = parse_version(str_slice(range, 1, len(range)))?
    if len(v.pre) > 0 {
        let same_core = v.major == base.major && v.minor == base.minor && v.patch == base.patch
        if !(same_core && len(base.pre) > 0) {
            return Ok(false)
        }
    }
    Ok(compare(v, base) >= 0 && compare(v, caret_upper(base)) < 0)
}

// Index of the highest listed version matching the range, -1 if none.
// Unparseable entries are skipped.
fn max_satisfying(versions: &[str], range: str) -> Result<i64, str> {
    let best = -1
    let best_v = Version { major: 0, minor: 0, patch: 0, pre: "" }
    for i in 0..len(versions) {
        match parse_version(versions[i]) {
            Ok(v) => {
                let ok = satisfies_caret(v, range)?
                if ok && (best < 0 || compare(v, best_v) > 0) {
                    best = i
                    best_v = v
                }
            }
            Err(_) => {}
        }
    }
    Ok(best)
}

fn load_text(path: str) -> Result<str, str> {
    read_file(path)
}

fn ver(s: str) -> Version {
    match parse_version(s) {
        Ok(v) => v
        Err(_) => Version { major: -1, minor: -1, patch: -1, pre: "bad" }
    }
}

fn sat(v: str, range: str) -> bool {
    match satisfies_caret(ver(v), range) {
        Ok(b) => b
        Err(_) => false
    }
}

fn main() {
    println(to_string(ver("1.4.2-beta")))
}

@[test]
fn test_split_on() {
    let p = split_on("1.22.3", 46)
    assert_eq(len(p), 3)
    assert(p[1] == "22")
    let q = split_on("abc", 46)
    assert_eq(len(q), 1)
    let r = split_on("1..", 46)
    assert_eq(len(r), 3)
    assert_eq(len(r[2]), 0)
}

@[test]
fn test_parse_num() {
    match parse_num("0") { Ok(v) => assert_eq(v, 0)  Err(_) => assert(false) }
    match parse_num("407") { Ok(v) => assert_eq(v, 407)  Err(_) => assert(false) }
    match parse_num("07") { Ok(_) => assert(false)  Err(e) => assert(e == "leading zero") }
    match parse_num("") { Ok(_) => assert(false)  Err(e) => assert(e == "empty number") }
    match parse_num("1a") { Ok(_) => assert(false)  Err(e) => assert(e == "not a digit") }
}

@[test]
fn test_parse_version_ok() {
    let v = ver("1.20.3")
    assert_eq(v.major, 1)
    assert_eq(v.minor, 20)
    assert_eq(v.patch, 3)
    assert_eq(len(v.pre), 0)
    let p = ver("0.0.9-rc.1")
    assert_eq(p.patch, 9)
    assert(p.pre == "rc.1")
}

@[test]
fn test_parse_version_errors() {
    match parse_version("1.2") { Ok(_) => assert(false)  Err(e) => assert(e == "expected three numbers") }
    match parse_version("1.2.3.4") { Ok(_) => assert(false)  Err(_) => assert(true) }
    match parse_version("1.02.3") { Ok(_) => assert(false)  Err(e) => assert(e == "leading zero") }
    match parse_version("1.2.3-") { Ok(_) => assert(false)  Err(e) => assert(e == "empty pre-release") }
    match parse_version("1.x.3") { Ok(_) => assert(false)  Err(e) => assert(e == "not a digit") }
}

@[test]
fn test_compare_core() {
    assert_eq(compare(ver("1.2.3"), ver("1.2.3")), 0)
    assert_eq(compare(ver("1.2.3"), ver("1.2.4")), -1)
    assert_eq(compare(ver("1.10.0"), ver("1.9.9")), 1)
    assert_eq(compare(ver("2.0.0"), ver("10.0.0")), -1)
}

@[test]
fn test_compare_prerelease() {
    assert_eq(compare(ver("1.0.0-alpha"), ver("1.0.0")), -1)
    assert_eq(compare(ver("1.0.0"), ver("1.0.0-rc")), 1)
    assert_eq(compare(ver("1.0.0-alpha"), ver("1.0.0-beta")), -1)
    assert_eq(compare(ver("1.0.0-beta"), ver("1.0.0-beta")), 0)
}

@[test]
fn test_bump() {
    match bump(ver("1.4.7"), "major") { Ok(v) => assert(to_string(v) == "2.0.0")  Err(_) => assert(false) }
    match bump(ver("1.4.7"), "minor") { Ok(v) => assert(to_string(v) == "1.5.0")  Err(_) => assert(false) }
    match bump(ver("1.4.7"), "patch") { Ok(v) => assert(to_string(v) == "1.4.8")  Err(_) => assert(false) }
    match bump(ver("1.4.7-rc"), "patch") { Ok(v) => assert(to_string(v) == "1.4.7")  Err(_) => assert(false) }
    match bump(ver("1.4.7"), "build") { Ok(_) => assert(false)  Err(e) => assert(e == "unknown part") }
}

@[test]
fn test_to_string_roundtrip() {
    assert(to_string(ver("0.1.0")) == "0.1.0")
    assert(to_string(ver("3.2.1-x.7")) == "3.2.1-x.7")
}

@[test]
fn test_caret_upper() {
    assert(to_string(caret_upper(ver("1.2.3"))) == "2.0.0")
    assert(to_string(caret_upper(ver("0.3.1"))) == "0.4.0")
    assert(to_string(caret_upper(ver("0.0.4"))) == "0.0.5")
}

@[test]
fn test_satisfies_major() {
    assert(sat("1.2.3", "^1.2.3"))
    assert(sat("1.9.0", "^1.2.3"))
    assert(!sat("2.0.0", "^1.2.3"))
    assert(!sat("1.2.2", "^1.2.3"))
}

@[test]
fn test_satisfies_zero_major() {
    assert(sat("0.3.9", "^0.3.1"))
    assert(!sat("0.4.0", "^0.3.1"))
    assert(sat("0.0.4", "^0.0.4"))
    assert(!sat("0.0.5", "^0.0.4"))
}

@[test]
fn test_satisfies_prerelease_and_errors() {
    assert(!sat("1.5.0-beta", "^1.2.3"))
    assert(sat("1.2.3-beta", "^1.2.3-alpha"))
    assert(!sat("1.2.3-alpha", "^1.2.3-beta"))
    match satisfies_caret(ver("1.0.0"), "~1.0.0") { Ok(_) => assert(false)  Err(e) => assert(e == "not a caret range") }
    match satisfies_caret(ver("1.0.0"), "^1.0") { Ok(_) => assert(false)  Err(_) => assert(true) }
}

@[test]
fn test_max_satisfying() {
    let vs = ["1.2.0", "1.8.1", "2.0.0", "1.10.0-rc", "1.9.4", "junk"]
    match max_satisfying(&vs, "^1.2.0") { Ok(i) => assert_eq(i, 4)  Err(_) => assert(false) }
    match max_satisfying(&vs, "^2.0.0") { Ok(i) => assert_eq(i, 2)  Err(_) => assert(false) }
    match max_satisfying(&vs, "^3.0.0") { Ok(i) => assert_eq(i, -1)  Err(_) => assert(false) }
    match max_satisfying(&vs, "1.2.0") { Ok(_) => assert(false)  Err(_) => assert(true) }
}
