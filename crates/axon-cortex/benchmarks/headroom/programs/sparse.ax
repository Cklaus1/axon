// Sparse integer vectors stored as (index, value) entries sorted by
// strictly increasing index, with no zero values kept.

type Entry = { idx: i64, val: i64 }

// Append (idx, val) unless val is zero.
@[contained]
fn push_nonzero(out: &[Entry], idx: i64, val: i64) -> [Entry] {
    let r: [Entry] = out
    if val != 0 {
        r = arr_push(r, Entry { idx: idx, val: val })
    }
    r
}

fn drop_zeros(v: &[Entry]) -> [Entry] {
    let out: [Entry] = []
    for i in 0..len(v) {
        out = push_nonzero(&out, v[i].idx, v[i].val)
    }
    out
}

// Sparse form of a dense block whose first element sits at index `offset`.
fn from_dense(xs: &[i64], offset: i64 where offset >= 0) -> [Entry] {
    let out: [Entry] = []
    for i in 0..len(xs) {
        out = push_nonzero(&out, offset + i, xs[i])
    }
    out
}

// Squared Euclidean distance |a - b|^2.
fn distance_sq(a: &[Entry], b: &[Entry]) -> i64 {
    let neg = scale(b, -1)
    let diff = add(a, &neg)
    norm_sq(&diff)
}

// Merge two sorted vectors; values that cancel are dropped.
fn add(a: &[Entry], b: &[Entry]) -> [Entry] {
    let out: [Entry] = []
    let i = 0
    let j = 0
    while i < len(a) || j < len(b) {
        if j >= len(b) || (i < len(a) && a[i].idx < b[j].idx) {
            out = push_nonzero(&out, a[i].idx, a[i].val)
            i = i + 1
        } else if i >= len(a) || b[j].idx < a[i].idx {
            out = push_nonzero(&out, b[j].idx, b[j].val)
            j = j + 1
        } else {
            out = push_nonzero(&out, a[i].idx, a[i].val + b[j].val)
            i = i + 1
            j = j + 1
        }
    }
    out
}

fn scale(v: &[Entry], k: i64) -> [Entry] {
    let out: [Entry] = []
    for i in 0..len(v) {
        out = push_nonzero(&out, v[i].idx, v[i].val * k)
    }
    out
}

fn dot(a: &[Entry], b: &[Entry]) -> i64 {
    let i = 0
    let j = 0
    let s = 0
    while i < len(a) && j < len(b) {
        if a[i].idx == b[j].idx {
            s = s + a[i].val * b[j].val
            i = i + 1
            j = j + 1
        } else if a[i].idx < b[j].idx {
            i = i + 1
        } else {
            j = j + 1
        }
    }
    s
}

fn norm_sq(v: &[Entry]) -> i64 {
    dot(v, v)
}

// Value at `idx` (binary search), 0 if absent.
fn get(v: &[Entry], idx: i64) -> i64 {
    let lo = 0
    let hi = len(v)
    while lo < hi {
        let mid = (lo + hi) / 2
        if v[mid].idx == idx { return v[mid].val }
        if v[mid].idx < idx { lo = mid + 1 } else { hi = mid }
    }
    0
}

fn load_text(path: str) -> Result<str, str> {
    read_file(path)
}

fn e(idx: i64, val: i64) -> Entry {
    Entry { idx: idx, val: val }
}

@[test]
fn test_push_nonzero() {
    let empty: [Entry] = []
    assert_eq(len(push_nonzero(&empty, 3, 0)), 0)
    let one = push_nonzero(&empty, 3, -2)
    assert_eq(len(one), 1)
    assert_eq(one[0].idx, 3)
    assert_eq(one[0].val, -2)
}

@[test]
fn test_drop_zeros() {
    let v = drop_zeros(&[e(0, 0), e(2, 5), e(4, 0), e(9, -1)])
    assert_eq(len(v), 2)
    assert_eq(v[0].idx, 2)
    assert_eq(v[1].val, -1)
}

@[test]
fn test_from_dense() {
    let v = from_dense(&[0, 7, 0, 0, -3], 0)
    assert_eq(len(v), 2)
    assert_eq(v[0].idx, 1)
    assert_eq(v[1].idx, 4)
    assert_eq(v[1].val, -3)
    let w = from_dense(&[5, 0, 6], 10)
    assert_eq(w[0].idx, 10)
    assert_eq(w[1].idx, 12)
    let none: [i64] = []
    assert_eq(len(from_dense(&none, 3)), 0)
}

@[test]
fn test_distance_sq() {
    assert_eq(distance_sq(&[e(0, 3), e(2, 1)], &[e(0, 1), e(1, 2), e(2, 1)]), 8)
    assert_eq(distance_sq(&[e(4, 7)], &[e(4, 7)]), 0)
    let empty: [Entry] = []
    assert_eq(distance_sq(&empty, &[e(1, -3), e(5, 4)]), 25)
}

@[test]
fn test_distance_sq_disjoint_and_dense() {
    assert_eq(distance_sq(&[e(0, 1)], &[e(9, 1)]), 2)
    assert_eq(distance_sq(&from_dense(&[1, 2, 3], 0), &from_dense(&[1, 2], 1)), 3)
}

@[test]
fn test_add_merges() {
    let s = add(&[e(0, 1), e(3, 2), e(7, 5)], &[e(1, 4), e(3, 3), e(9, 1)])
    assert_eq(len(s), 5)
    assert_eq(s[0].idx, 0)
    assert_eq(s[1].idx, 1)
    assert_eq(s[2].val, 5)
    assert_eq(s[3].idx, 7)
    assert_eq(s[4].idx, 9)
}

@[test]
fn test_add_cancellation_and_empty() {
    let s = add(&[e(2, 3), e(5, 1)], &[e(2, -3)])
    assert_eq(len(s), 1)
    assert_eq(s[0].idx, 5)
    let empty: [Entry] = []
    assert_eq(len(add(&empty, &empty)), 0)
    let t = add(&empty, &[e(4, 4)])
    assert_eq(t[0].val, 4)
}

@[test]
fn test_add_drops_input_zeros() {
    let s = add(&[e(1, 0)], &[e(2, 0), e(3, 6)])
    assert_eq(len(s), 1)
    assert_eq(get(&s, 3), 6)
}

@[test]
fn test_scale() {
    let v = scale(&[e(1, 2), e(4, -3)], 3)
    assert_eq(v[0].val, 6)
    assert_eq(v[1].val, -9)
    assert_eq(len(scale(&v, 0)), 0)
}

@[test]
fn test_scale_then_add_is_difference() {
    let a = [e(0, 5), e(2, 4)]
    let b = [e(0, 5), e(1, 1)]
    let d = add(&a, &scale(&b, -1))
    assert_eq(len(d), 2)
    assert_eq(get(&d, 1), -1)
    assert_eq(get(&d, 2), 4)
    assert_eq(get(&d, 0), 0)
}

@[test]
fn test_dot() {
    assert_eq(dot(&[e(0, 2), e(3, 4), e(5, 1)], &[e(3, 5), e(4, 9), e(5, -2)]), 18)
    assert_eq(dot(&[e(0, 2)], &[e(1, 2)]), 0)
    let empty: [Entry] = []
    assert_eq(dot(&empty, &[e(1, 2)]), 0)
}

@[test]
fn test_norm_sq() {
    assert_eq(norm_sq(&[e(0, 3), e(9, -4)]), 25)
    let empty: [Entry] = []
    assert_eq(norm_sq(&empty), 0)
    assert_eq(norm_sq(&from_dense(&[1, 0, 2, 0, 2], 4)), 9)
}

@[test]
fn test_norm_of_sum() {
    let s = add(&from_dense(&[1, 2, 0], 0), &from_dense(&[0, -2, 3], 0))
    assert_eq(norm_sq(&s), 10)
    assert_eq(dot(&s, &scale(&s, 2)), 20)
}

@[test]
fn test_get() {
    let v = [e(1, 10), e(4, 40), e(6, 60), e(9, 90)]
    assert_eq(get(&v, 1), 10)
    assert_eq(get(&v, 9), 90)
    assert_eq(get(&v, 6), 60)
    assert_eq(get(&v, 5), 0)
    assert_eq(get(&v, 0), 0)
    assert_eq(get(&v, 10), 0)
}
