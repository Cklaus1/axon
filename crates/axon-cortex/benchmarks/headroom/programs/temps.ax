// Daily temperature analytics in tenths of a degree (215 = 21.5 C).

type Drop = { day: i64, amount: i64 }

fn window_sum(xs: &[i64], start: i64, k: i64) -> i64 {
    let s = 0
    for i in start..(start + k) { s = s + xs[i] }
    s
}

// Average (floored) of every full window of k consecutive days.
fn moving_average(xs: &[i64], k: i64) -> Result<[i64], str> {
    if k <= 0 { return Err("window must be positive") }
    if k > len(xs) { return Err("window longer than series") }
    let out = []
    for i in 0..(len(xs) - k + 1) { out = arr_push(out, window_sum(&xs, i, k) / k) }
    Ok(out)
}

// Largest fall from one day to the next; `day` is the index of the colder day.
fn largest_drop(xs: &[i64]) -> Option<Drop> {
    let best = Drop { day: -1, amount: 0 }
    for i in 1..len(xs) {
        let d = xs[i - 1] - xs[i]
        if d > best.amount { best = Drop { day: i, amount: d } }
    }
    if best.day < 0 { None } else { Some(best) }
}

fn count_above(xs: &[i64], threshold: i64) -> i64 {
    let n = 0
    for i in 0..len(xs) {
        if xs[i] > threshold { n = n + 1 }
    }
    n
}

// Longest run of consecutive days strictly above `warm`, as (start index, length).
fn longest_warm_streak(xs: &[i64], warm: i64) -> (i64, i64) {
    let best_start = -1
    let best_len = 0
    let cur_start = 0
    let cur_len = 0
    for i in 0..len(xs) {
        if xs[i] > warm {
            if cur_len == 0 { cur_start = i }
            cur_len = cur_len + 1
            if cur_len > best_len {
                best_len = cur_len
                best_start = cur_start
            }
        } else { cur_len = 0 }
    }
    (best_start, best_len)
}

fn warm_share_percent(xs: &[i64], warm: i64) -> i64 {
    if len(xs) == 0 { 0 } else { count_above(&xs, warm) * 100 / len(xs) }
}

fn week() -> [i64] { [180, 215, 230, 190, 240, 255, 120] }

fn main() {
    let s = longest_warm_streak(&week(), 200)
    println("streak of {to_str(s.1)} days from day {to_str(s.0)}")
}

@[test]
fn test_window_sum() {
    assert_eq(window_sum(&week(), 0, 3), 625)
    assert_eq(window_sum(&week(), 4, 3), 615)
}

@[test]
fn test_moving_average() {
    let m: [i64] = match moving_average(&week(), 3) { Ok(v) => v, Err(_) => [] }
    assert_eq(len(m), 5)
    assert_eq(m[0], 208)
    assert_eq(m[1], 211)
    assert_eq(m[2], 220)
    assert_eq(m[3], 228)
    assert_eq(m[4], 205)
}

@[test]
fn test_moving_average_edges() {
    let one: [i64] = match moving_average(&week(), 7) { Ok(v) => v, Err(_) => [] }
    assert_eq(len(one), 1)
    assert_eq(one[0], 204)
    assert(match moving_average(&week(), 0) { Ok(_) => false, Err(e) => str_eq(e, "window must be positive") })
    assert(match moving_average(&week(), 8) { Ok(_) => false, Err(e) => str_eq(e, "window longer than series") })
}

@[test]
fn test_largest_drop() {
    let d = match largest_drop(&week()) { Some(x) => x, None => Drop { day: -1, amount: -1 } }
    assert_eq(d.day, 6)
    assert_eq(d.amount, 135)
}

@[test]
fn test_largest_drop_none() {
    assert(match largest_drop(&[10, 20, 30]) { Some(_) => false, None => true })
    assert(match largest_drop(&[5]) { Some(_) => false, None => true })
    assert_eq(match largest_drop(&[30, 20, 25, 5]) { Some(x) => x.day, None => -1 }, 3)
}

@[test]
fn test_count_above() {
    assert_eq(count_above(&week(), 200), 4)
    assert_eq(count_above(&week(), 255), 0)
    assert_eq(count_above(&week(), 0), 7)
}

@[test]
fn test_longest_warm_streak() {
    let s = longest_warm_streak(&week(), 200)
    assert_eq(s.0, 1)
    assert_eq(s.1, 2)
    let t = longest_warm_streak(&[250, 100, 210, 220, 230, 100], 200)
    assert_eq(t.0, 2)
    assert_eq(t.1, 3)
    let u = longest_warm_streak(&[1, 2], 200)
    assert_eq(u.0, -1)
    assert_eq(u.1, 0)
}

@[test]
fn test_warm_share_percent() {
    assert_eq(warm_share_percent(&week(), 200), 57)
    assert_eq(warm_share_percent(&[], 200), 0)
}
