// Tic-tac-toe board analysis. A board is a 9-char string read row by row:
// 'X', 'O' or '.' for an empty cell. Parsed cells are 1 (X), 2 (O), 0 (empty).
// X always moves first.

fn parse_board(s: str) -> Result<[i64], str> {
    if len(s) != 9 {
        return Err("need 9 cells")
    }
    let cells: [i64] = []
    for i in 0..9 {
        let c = char_at(s, i)
        if c == 88 { cells = arr_push(cells, 1) }
        else if c == 79 { cells = arr_push(cells, 2) }
        else if c == 46 { cells = arr_push(cells, 0) }
        else { return Err("bad cell " + to_str(i)) }
    }
    Ok(cells)
}

fn count_cell(b: &[i64], v: i64) -> i64 {
    let n = 0
    for i in 0..len(b) {
        if b[i] == v { n = n + 1 }
    }
    n
}

fn cell_at(b: &[i64], row: i64 where row >= 0 && row <= 2, col: i64 where col >= 0 && col <= 2) -> i64 {
    b[row * 3 + col]
}

// Owner of the line through cells i, j, k, or 0.
@[contained]
fn line_owner(b: &[i64], i: i64, j: i64, k: i64) -> i64 {
    if b[i] != 0 && b[i] == b[j] && b[j] == b[k] { b[i] } else { 0 }
}

// Bitmask of winners: 1 if X has a line, 2 if O has one, 3 for both.
fn winners(b: &[i64]) -> i64 {
    let lines = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]]
    let mask = 0
    for n in 0..8 {
        let w = line_owner(b, lines[n][0], lines[n][1], lines[n][2])
        if w == 1 && mask % 2 == 0 { mask = mask + 1 }
        if w == 2 && mask < 2 { mask = mask + 2 }
    }
    mask
}

// Could this position arise in a legal game?
fn is_consistent(b: &[i64]) -> bool {
    let x = count_cell(b, 1)
    let o = count_cell(b, 2)
    if x != o && x != o + 1 { return false }
    let w = winners(b)
    if w == 3 { return false }
    if w == 1 && x != o + 1 { return false }
    if w == 2 && x != o { return false }
    true
}

// 1 = X to move, 2 = O to move, 0 = game over.
fn whose_turn(b: &[i64]) -> Result<i64, str> {
    if !is_consistent(b) {
        return Err("inconsistent board")
    }
    if winners(b) != 0 || count_cell(b, 0) == 0 {
        return Ok(0)
    }
    if count_cell(b, 1) == count_cell(b, 2) { Ok(1) } else { Ok(2) }
}

fn valid_move(b: &[i64], pos: i64, player: i64) -> bool {
    if pos < 0 || pos > 8 { return false }
    if b[pos] != 0 { return false }
    match whose_turn(b) {
        Ok(t) => t != 0 && t == player
        Err(_) => false
    }
}

fn status(s: str) -> str {
    match parse_board(s) {
        Err(e) => "invalid: " + e
        Ok(cells) => {
            let b: [i64] = cells
            match whose_turn(&b) {
                Err(_) => "invalid: inconsistent board"
                Ok(t) => {
                    let w = winners(&b)
                    if w == 1 { "X wins" }
                    else if w == 2 { "O wins" }
                    else if t == 0 { "draw" }
                    else if t == 1 { "X to move" }
                    else { "O to move" }
                }
            }
        }
    }
}

fn load_text(path: str) -> Result<str, str> {
    read_file(path)
}

fn board(s: str) -> [i64] {
    match parse_board(s) { Ok(b) => b  Err(_) => [9, 9, 9, 9, 9, 9, 9, 9, 9] }
}

fn turn_or(s: str) -> i64 {
    let b = board(s)
    match whose_turn(&b) { Ok(t) => t  Err(_) => -1 }
}

@[test]
fn test_parse_board() {
    let b = board("XO.......")
    assert_eq(b[0], 1)
    assert_eq(b[1], 2)
    assert_eq(b[8], 0)
    match parse_board("XXO") { Ok(_) => assert(false)  Err(e) => assert(e == "need 9 cells") }
    match parse_board("XXO..Z...") { Ok(_) => assert(false)  Err(e) => assert(e == "bad cell 5") }
    match parse_board("x........") { Ok(_) => assert(false)  Err(e) => assert(e == "bad cell 0") }
}

@[test]
fn test_count_cell() {
    let b = board("XOXXOOOXX")
    assert_eq(count_cell(&b, 1), 5)
    assert_eq(count_cell(&b, 2), 4)
    assert_eq(count_cell(&b, 0), 0)
    assert_eq(count_cell(&board("........."), 0), 9)
}

@[test]
fn test_cell_at() {
    let b = board("X...O...X")
    assert_eq(cell_at(&b, 0, 0), 1)
    assert_eq(cell_at(&b, 1, 1), 2)
    assert_eq(cell_at(&b, 2, 2), 1)
    assert_eq(cell_at(&b, 2, 0), 0)
}

@[test]
fn test_line_owner() {
    let b = board("XXXOO.O..")
    assert_eq(line_owner(&b, 0, 1, 2), 1)
    assert_eq(line_owner(&b, 3, 4, 5), 0)
    assert_eq(line_owner(&b, 6, 7, 8), 0)
    assert_eq(line_owner(&board("..O.O.O.."), 2, 4, 6), 2)
}

@[test]
fn test_winners() {
    assert_eq(winners(&board("XXXOO....")), 1)
    assert_eq(winners(&board("OOOXX.X..")), 2)
    assert_eq(winners(&board("XXXOOO...")), 3)
    assert_eq(winners(&board("XOXXOOOXX")), 0)
    assert_eq(winners(&board("X..X..X..")), 1)
    assert_eq(winners(&board("O...O...O")), 2)
}

@[test]
fn test_is_consistent() {
    assert(is_consistent(&board(".........")))
    assert(is_consistent(&board("XXXOO....")))
    assert(!is_consistent(&board("OO.......")))
    assert(!is_consistent(&board("XXX......")))
    assert(!is_consistent(&board("XXXOO.O..")))
    assert(!is_consistent(&board("OOOXXX.X.")))
}

@[test]
fn test_whose_turn() {
    assert_eq(turn_or("........."), 1)
    assert_eq(turn_or("X........"), 2)
    assert_eq(turn_or("XX.OO...."), 1)
    assert_eq(turn_or("XXXOO...."), 0)
    assert_eq(turn_or("XOXXOOOXX"), 0)
    assert_eq(turn_or("OO......."), -1)
}

@[test]
fn test_valid_move() {
    let b = board("XX.OO....")
    assert(valid_move(&b, 2, 1))
    assert(!valid_move(&b, 2, 2))
    assert(!valid_move(&b, 0, 1))
    assert(!valid_move(&b, 9, 1))
    assert(!valid_move(&b, -1, 1))
}

@[test]
fn test_valid_move_game_over_and_bad_board() {
    assert(!valid_move(&board("XXXOO...."), 8, 2))
    assert(!valid_move(&board("XXXOO...."), 8, 1))
    assert(!valid_move(&board("OO......."), 5, 1))
    assert(valid_move(&board("X........"), 8, 2))
}

@[test]
fn test_status_outcomes() {
    assert(status("XXXOO....") == "X wins")
    assert(status("OOOXX.X..") == "O wins")
    assert(status("XOXXOOOXX") == "draw")
    assert(status(".........") == "X to move")
    assert(status("X...O...X") == "O to move")
}

@[test]
fn test_status_invalid() {
    assert(status("XXXOOO...") == "invalid: inconsistent board")
    assert(status("XO") == "invalid: need 9 cells")
    assert(status("XO.?.....") == "invalid: bad cell 3")
}

@[test]
fn test_status_win_on_last_move() {
    assert(status("XOXOXOOXX") == "X wins")
    assert(status("XXOXOOO.X") == "O wins")
}
