// Token-bucket rate limiter driven by an integer tick clock. The bucket
// gains `rate` tokens per elapsed tick up to `capacity`; a request of
// cost c is allowed when at least c tokens are available, and consumes
// them. Denied requests consume nothing.

type Bucket = { tokens: i64, capacity: i64, rate: i64, last_tick: i64 }
type Req = { tick: i64, cost: i64 }
type Step = { bucket: Bucket, allowed: bool }

fn new_bucket(capacity: i64, rate: i64, start_tick: i64) -> Bucket {
    Bucket { tokens: capacity, capacity: capacity, rate: rate, last_tick: start_tick }
}

// Adds tokens for ticks elapsed since the last refill, capped at
// capacity. A clock that goes backwards adds nothing and is ignored.
@[contained]
fn refill(b: Bucket, now: i64) -> Bucket {
    let elapsed = if now > b.last_tick { now - b.last_tick } else { 0 }
    let t = b.tokens + elapsed * b.rate
    if t > b.capacity {
        t = b.capacity
    }
    let last = if now > b.last_tick { now } else { b.last_tick }
    Bucket { tokens: t, capacity: b.capacity, rate: b.rate, last_tick: last }
}

@[contained]
fn try_take(b: Bucket, cost: i64 where cost >= 1) -> Step {
    if cost <= b.tokens {
        let nb = Bucket { tokens: b.tokens - cost, capacity: b.capacity, rate: b.rate, last_tick: b.last_tick }
        Step { bucket: nb, allowed: true }
    } else {
        Step { bucket: b, allowed: false }
    }
}

fn request(b: Bucket, now: i64, cost: i64) -> Step {
    try_take(refill(b, now), cost)
}

fn count_denied(b: Bucket, trace: &[Req]) -> i64 {
    let cur = b
    let denied = 0
    for i in 0..len(trace) {
        let s = request(cur, trace[i].tick, trace[i].cost)
        if !s.allowed {
            denied = denied + 1
        }
        cur = s.bucket
    }
    denied
}

// Index of the first denied request, or -1 if all are allowed.
fn first_denied(b: Bucket, trace: &[Req]) -> i64 {
    let cur = b
    for i in 0..len(trace) {
        let s = request(cur, trace[i].tick, trace[i].cost)
        if !s.allowed {
            return i
        }
        cur = s.bucket
    }
    -1
}

// Tokens left after replaying the trace and refilling up to `end_tick`.
fn tokens_after(b: Bucket, trace: &[Req], end_tick: i64) -> i64 {
    let cur = b
    for i in 0..len(trace) {
        cur = request(cur, trace[i].tick, trace[i].cost).bucket
    }
    refill(cur, end_tick).tokens
}

// Ticks to wait before a request of `cost` could pass; -1 if never.
fn ticks_until(b: Bucket, cost: i64) -> i64 {
    if cost > b.capacity {
        return -1
    }
    if cost <= b.tokens {
        return 0
    }
    if b.rate <= 0 {
        return -1
    }
    let missing = cost - b.tokens
    let wait = (missing + b.rate - 1) / b.rate
    wait
}

fn load_text(path: str) -> Result<str, str> {
    read_file(path)
}

fn rq(t: i64, c: i64) -> Req {
    Req { tick: t, cost: c }
}

fn bucket(tokens: i64, cap: i64, rate: i64, last: i64) -> Bucket {
    Bucket { tokens: tokens, capacity: cap, rate: rate, last_tick: last }
}

fn main() {
    let trace = [rq(0, 3), rq(0, 3), rq(1, 2), rq(5, 5)]
    println("denied: " + to_str(count_denied(new_bucket(5, 1, 0), &trace)))
}

@[test]
fn test_refill_basic() {
    let b = refill(bucket(1, 10, 2, 0), 3)
    assert_eq(b.tokens, 7)
    assert_eq(b.last_tick, 3)
    let c = refill(bucket(0, 10, 3, 4), 5)
    assert_eq(c.tokens, 3)
}

@[test]
fn test_refill_cap_and_backwards() {
    let b = refill(bucket(8, 10, 2, 0), 5)
    assert_eq(b.tokens, 10)
    let same = refill(bucket(4, 10, 2, 7), 7)
    assert_eq(same.tokens, 4)
    assert_eq(same.last_tick, 7)
    let back = refill(bucket(4, 10, 2, 7), 3)
    assert_eq(back.tokens, 4)
    assert_eq(back.last_tick, 7)
}

@[test]
fn test_try_take() {
    let s = try_take(bucket(5, 10, 1, 0), 5)
    assert(s.allowed)
    assert_eq(s.bucket.tokens, 0)
    let d = try_take(bucket(4, 10, 1, 0), 5)
    assert(!d.allowed)
    assert_eq(d.bucket.tokens, 4)
    let one = try_take(bucket(1, 10, 1, 0), 1)
    assert(one.allowed)
}

@[test]
fn test_request_refills_first() {
    let s = request(bucket(0, 5, 1, 0), 3, 3)
    assert(s.allowed)
    assert_eq(s.bucket.tokens, 0)
    let d = request(bucket(0, 5, 1, 0), 2, 3)
    assert(!d.allowed)
    assert_eq(d.bucket.tokens, 2)
    let big = request(bucket(5, 5, 1, 0), 100, 6)
    assert(!big.allowed)
}

@[test]
fn test_count_denied_simple() {
    // 5 tokens: take 3 (2 left), deny 3, tick 1 -> 3 take 2 (1 left),
    // tick 5 -> 5 take 5
    let trace = [rq(0, 3), rq(0, 3), rq(1, 2), rq(5, 5)]
    assert_eq(count_denied(new_bucket(5, 1, 0), &trace), 1)
}

@[test]
fn test_count_denied_burst() {
    let trace = [rq(0, 1), rq(0, 1), rq(0, 1), rq(0, 1), rq(1, 1), rq(1, 1)]
    // capacity 2, rate 1: two allowed at tick 0, one more at tick 1
    assert_eq(count_denied(new_bucket(2, 1, 0), &trace), 3)
    let empty: [Req] = []
    assert_eq(count_denied(new_bucket(2, 1, 0), &empty), 0)
}

@[test]
fn test_count_denied_cap_limits_saving() {
    // a long idle gap cannot bank more than capacity
    let trace = [rq(0, 4), rq(100, 4), rq(100, 1)]
    assert_eq(count_denied(new_bucket(4, 1, 0), &trace), 1)
    let trace2 = [rq(0, 4), rq(3, 4), rq(4, 1)]
    assert_eq(count_denied(new_bucket(4, 1, 0), &trace2), 1)
}

@[test]
fn test_first_denied() {
    let trace = [rq(0, 3), rq(0, 3), rq(1, 2), rq(5, 5)]
    assert_eq(first_denied(new_bucket(5, 1, 0), &trace), 1)
    let ok = [rq(0, 2), rq(2, 2), rq(4, 2)]
    assert_eq(first_denied(new_bucket(2, 1, 0), &ok), -1)
    let late = [rq(0, 2), rq(1, 2)]
    assert_eq(first_denied(new_bucket(2, 1, 0), &late), 1)
}

@[test]
fn test_tokens_after() {
    let trace = [rq(0, 3), rq(0, 3), rq(1, 2), rq(5, 5)]
    assert_eq(tokens_after(new_bucket(5, 1, 0), &trace, 5), 0)
    assert_eq(tokens_after(new_bucket(5, 1, 0), &trace, 7), 2)
    let empty: [Req] = []
    assert_eq(tokens_after(bucket(1, 6, 2, 0), &empty, 2), 5)
}

@[test]
fn test_ticks_until() {
    assert_eq(ticks_until(bucket(3, 10, 2, 0), 3), 0)
    assert_eq(ticks_until(bucket(3, 10, 2, 0), 4), 1)
    assert_eq(ticks_until(bucket(3, 10, 2, 0), 6), 2)
    assert_eq(ticks_until(bucket(3, 10, 2, 0), 10), 4)
    assert_eq(ticks_until(bucket(3, 10, 2, 0), 11), -1)
    assert_eq(ticks_until(bucket(0, 10, 0, 0), 1), -1)
}

@[test]
fn test_new_bucket() {
    let b = new_bucket(7, 3, 12)
    assert_eq(b.tokens, 7)
    assert_eq(b.capacity, 7)
    assert_eq(b.last_tick, 12)
}
