// Greedy word wrap and full justification. Words are separated by runs of
// spaces; a word longer than the width gets a line of its own (never split).
// Justified lines pad gaps from the left; the last line stays ragged.

fn split_words(s: str) -> [str] {
    let out: [str] = []
    let start = -1
    for i in 0..len(s) {
        if char_at(s, i) == 32 {
            if start >= 0 {
                out = arr_push(out, str_slice(s, start, i))
                start = -1
            }
        } else if start < 0 {
            start = i
        }
    }
    if start >= 0 {
        out = arr_push(out, str_slice(s, start, len(s)))
    }
    out
}

// words[from..to] joined by single spaces.
@[contained]
fn join_range(words: &[str], from: i64, to: i64) -> str {
    let out = ""
    for i in from..to {
        if i > from { out = out + " " }
        out = out + words[i]
    }
    out
}

fn wrap(s: str, width: i64 where width >= 1) -> [str] {
    let words = split_words(s)
    let lines: [str] = []
    let first = 0
    let used = 0
    for i in 0..len(words) {
        let w = len(words[i])
        if i > first && used + 1 + w > width {
            lines = arr_push(lines, join_range(&words, first, i))
            first = i
            used = w
        } else if i == first {
            used = w
        } else {
            used = used + 1 + w
        }
    }
    if first < len(words) {
        lines = arr_push(lines, join_range(&words, first, len(words)))
    }
    lines
}

// Spread `line` to exactly `width` chars; a single word is padded right.
fn justify_line(line: str, width: i64) -> str {
    let words = split_words(line)
    let n = len(words)
    if n == 0 { return str_repeat(" ", width) }
    let letters = 0
    for i in 0..n { letters = letters + len(words[i]) }
    if n == 1 {
        return words[0] + str_repeat(" ", max_i64(width - letters, 0))
    }
    let gaps = n - 1
    let spaces = max_i64(width - letters, gaps)
    let base = spaces / gaps
    let extra = spaces % gaps
    let out = words[0]
    for i in 1..n {
        let pad = if i <= extra { base + 1 } else { base }
        out = out + str_repeat(" ", pad) + words[i]
    }
    out
}

fn justify(s: str, width: i64 where width >= 1) -> [str] {
    let lines = wrap(s, width)
    let out: [str] = []
    let n = len(lines)
    for i in 0..n {
        if i + 1 < n {
            out = arr_push(out, justify_line(lines[i], width))
        } else {
            out = arr_push(out, lines[i])
        }
    }
    out
}

fn count_lines(s: str, width: i64 where width >= 1) -> i64 {
    let lines = wrap(s, width)
    len(lines)
}

fn longest_line(lines: &[str]) -> i64 {
    let best = 0
    for i in 0..len(lines) {
        best = max_i64(best, len(lines[i]))
    }
    best
}

fn load_text(path: str) -> Result<str, str> {
    read_file(path)
}

fn fox() -> str {
    "the quick brown fox jumps over the lazy dog"
}

@[test]
fn test_split_words() {
    let w = split_words("  hello   big world ")
    assert_eq(len(w), 3)
    assert(w[0] == "hello")
    assert(w[1] == "big")
    assert(w[2] == "world")
    assert_eq(len(split_words("")), 0)
    assert_eq(len(split_words("   ")), 0)
}

@[test]
fn test_join_range() {
    let w = ["a", "bb", "ccc"]
    assert(join_range(&w, 0, 3) == "a bb ccc")
    assert(join_range(&w, 1, 2) == "bb")
    assert(join_range(&w, 2, 2) == "")
}

@[test]
fn test_wrap_width_ten() {
    let l = wrap(fox(), 10)
    assert_eq(len(l), 5)
    assert(l[0] == "the quick")
    assert(l[1] == "brown fox")
    assert(l[2] == "jumps over")
    assert(l[3] == "the lazy")
    assert(l[4] == "dog")
}

@[test]
fn test_wrap_exact_fit_and_long_word() {
    let l = wrap(fox(), 15)
    assert(l[0] == "the quick brown")
    assert(l[1] == "fox jumps over")
    let m = wrap("a extraordinary b", 5)
    assert_eq(len(m), 3)
    assert(m[1] == "extraordinary")
    assert(m[2] == "b")
}

@[test]
fn test_wrap_empty_and_width_one() {
    assert_eq(len(wrap("", 5)), 0)
    let l = wrap("a b  c", 1)
    assert_eq(len(l), 3)
    assert(l[2] == "c")
    let m = wrap("a b c", 3)
    assert(m[0] == "a b")
    assert(m[1] == "c")
}

@[test]
fn test_justify_line() {
    assert(justify_line("the quick", 12) == "the    quick")
    assert(justify_line("a b c", 8) == "a   b  c")
    assert(justify_line("dog", 5) == "dog  ")
    assert(justify_line("ab cd", 5) == "ab cd")
}

@[test]
fn test_justify_line_overfull_and_empty() {
    assert(justify_line("abc def", 4) == "abc def")
    assert(justify_line("", 3) == "   ")
}

@[test]
fn test_justify_paragraph() {
    let j = justify(fox(), 10)
    assert_eq(len(j), 5)
    assert(j[0] == "the  quick")
    assert(j[1] == "brown  fox")
    assert(j[2] == "jumps over")
    assert(j[3] == "the   lazy")
    assert(j[4] == "dog")
}

@[test]
fn test_justify_single_line_untouched() {
    let j = justify("short text", 20)
    assert_eq(len(j), 1)
    assert(j[0] == "short text")
    assert_eq(len(justify("", 4)), 0)
}

@[test]
fn test_justify_pads_single_word_lines() {
    let j = justify("one two three four five six", 9)
    assert_eq(len(j), 4)
    assert(j[0] == "one   two")
    assert(j[1] == "three    ")
    assert(j[2] == "four five")
    assert(j[3] == "six")
}

@[test]
fn test_count_lines() {
    assert_eq(count_lines(fox(), 10), 5)
    assert_eq(count_lines(fox(), 15), 3)
    assert_eq(count_lines(fox(), 43), 1)
    assert_eq(count_lines(fox(), 42), 2)
    assert_eq(count_lines("", 5), 0)
}

@[test]
fn test_longest_line() {
    assert_eq(longest_line(&wrap(fox(), 10)), 10)
    assert_eq(longest_line(&wrap(fox(), 15)), 15)
    assert_eq(longest_line(&wrap("a extraordinary b", 5)), 13)
    let none: [str] = []
    assert_eq(longest_line(&none), 0)
}
