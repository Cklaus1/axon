// calendar.ax — proleptic Gregorian date arithmetic for a booking service.
//
// Dates are (year, month, day) with year >= 1, month 1..12 and a valid day.
// Weekdays are numbered ISO-style: 0 = Monday, 1 = Tuesday, ... 6 = Sunday.
//
//   axon test calendar.ax

// A year is a leap year if it is divisible by 4, except century years, which
// are leap years only when divisible by 400 (1900 is not, 2000 is).
fn is_leap(y: i64) -> bool {
    (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
}

fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        if is_leap(y) { 29 } else { 28 }
    } else if m == 4 || m == 6 || m == 9 || m == 11 {
        30
    } else {
        31
    }
}

// 1-based ordinal day within the year: Jan 1 = 1, Dec 31 = 365 (366 in a leap year).
fn day_of_year(y: i64, m: i64, d: i64) -> i64 {
    let n = d
    let k = 1
    while k < m {
        n = n + days_in_month(y, k)
        k = k + 1
    }
    n
}

// Signed number of days from the first date to the second (negative when the
// second date is earlier). Each date is turned into its ordinal counted from
// 0001-01-01: the days of all whole years before it (365 each, plus one per
// leap year) plus its day of the year.
fn days_between(y1: i64, m1: i64, d1: i64, y2: i64, m2: i64, d2: i64) -> i64 {
    let p1 = y1 - 1
    let a = p1 * 365 + p1 / 4 - p1 / 100 + p1 / 400 + day_of_year(y1, m1, d1)
    let p2 = y2 - 1
    let b = p2 * 365 + p2 / 4 - p2 / 100 + p2 / 400 + day_of_year(y2, m2, d2)
    b - a
}

// ISO weekday, 0 = Monday ... 6 = Sunday (Sakamoto's method; January and
// February count as months of the previous year).
fn weekday(y: i64, m: i64, d: i64) -> i64 {
    let t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    let yy = if m < 3 { y - 1 } else { y }
    let sunday_based = (yy + yy / 4 - yy / 100 + yy / 400 + t[m - 1] + d) % 7
    (sunday_based + 6) % 7
}

// Number of ISO weeks in year y: 53 when Jan 1 is a Thursday, or when y is a
// leap year and Jan 1 is a Wednesday; 52 otherwise.
fn weeks_in_year(y: i64) -> i64 {
    let jan1 = weekday(y, 1, 1)
    if jan1 == 3 || (is_leap(y) && jan1 == 2) { 53 } else { 52 }
}

// ISO 8601 week number (1..53). Weeks start on Monday and week 1 is the week
// that contains the year's first Thursday, so Jan 1-3 can belong to the last
// week of the previous year and Dec 29-31 to week 1 of the next.
fn iso_week(y: i64, m: i64, d: i64) -> i64 {
    let w = (day_of_year(y, m, d) - weekday(y, m, d) + 9) / 7
    if w < 1 {
        weeks_in_year(y - 1)
    } else if w > weeks_in_year(y) {
        1
    } else {
        w
    }
}

@[test]
fn test_leap_basic() {
    assert(is_leap(2024))
    assert(!is_leap(2023))
    assert(is_leap(1996))
}

@[test]
fn test_leap_centuries() {
    assert(!is_leap(1900))
    assert(is_leap(2000))
    assert(!is_leap(2100))
    assert(is_leap(2400))
}

@[test]
fn test_days_in_month() {
    assert_eq(days_in_month(2024, 2), 29)
    assert_eq(days_in_month(2023, 2), 28)
    assert_eq(days_in_month(2023, 4), 30)
    assert_eq(days_in_month(2023, 12), 31)
}

@[test]
fn test_day_of_year() {
    assert_eq(day_of_year(2023, 1, 1), 1)
    assert_eq(day_of_year(2023, 12, 31), 365)
    assert_eq(day_of_year(2024, 12, 31), 366)
    assert_eq(day_of_year(2024, 3, 1), 61)
}

@[test]
fn test_days_between_within_a_year() {
    assert_eq(days_between(2024, 1, 1, 2024, 3, 1), 60)
    assert_eq(days_between(2023, 1, 1, 2023, 3, 1), 59)
    assert_eq(days_between(2000, 2, 28, 2000, 3, 1), 2)
}

@[test]
fn test_days_between_across_years() {
    assert_eq(days_between(2019, 6, 15, 2024, 6, 15), 1827)
    assert_eq(days_between(1999, 12, 31, 2000, 1, 1), 1)
    assert_eq(days_between(2024, 3, 1, 2023, 3, 1), -366)
    assert_eq(days_between(2023, 11, 30, 2024, 2, 29), 91)
}

@[test]
fn test_days_between_long_spans() {
    assert_eq(days_between(1900, 1, 1, 2000, 1, 1), 36524)
    assert_eq(days_between(1970, 1, 1, 2024, 10, 12), 20008)
    assert_eq(days_between(1899, 12, 31, 1900, 3, 1), 60)
}

@[test]
fn test_weekday() {
    assert_eq(weekday(2024, 1, 15), 0)
    assert_eq(weekday(2000, 1, 1), 5)
    assert_eq(weekday(1970, 1, 1), 3)
    assert_eq(weekday(2024, 2, 29), 3)
}

@[test]
fn test_weekday_more() {
    assert_eq(weekday(1999, 12, 31), 4)
    assert_eq(weekday(2023, 3, 1), 2)
    assert_eq(weekday(2100, 3, 1), 0)
    assert_eq(weekday(1900, 2, 28), 2)
}

@[test]
fn test_iso_week_midyear() {
    assert_eq(iso_week(2024, 6, 15), 24)
    assert_eq(iso_week(2023, 10, 12), 41)
}

@[test]
fn test_iso_week_year_start() {
    assert_eq(iso_week(2021, 1, 1), 53)
    assert_eq(iso_week(2023, 1, 1), 52)
    assert_eq(iso_week(2024, 1, 1), 1)
    assert_eq(iso_week(2016, 1, 3), 53)
    assert_eq(iso_week(2027, 1, 1), 53)
}

@[test]
fn test_iso_week_year_end() {
    assert_eq(iso_week(2024, 12, 30), 1)
    assert_eq(iso_week(2026, 12, 31), 53)
    assert_eq(iso_week(2019, 12, 30), 1)
    assert_eq(iso_week(2015, 12, 31), 53)
    assert_eq(iso_week(2020, 12, 31), 53)
}
