// intervals.ax — half-open time intervals for a room-booking calendar.
//
// An interval [lo, hi) contains every t with lo <= t < hi. Two intervals that
// only touch ([1, 3) and [3, 5)) share no point, so they do not overlap; they
// are, however, adjacent, and merging joins them into one block. An interval
// with lo >= hi is empty and is ignored everywhere.
//
//   axon test intervals.ax

type Iv = { lo: i64, hi: i64 }

type Ev = { t: i64, d: i64 }

// The union of `xs` as disjoint, non-adjacent intervals sorted by start.
// Overlapping or touching intervals are joined; an interval inside another
// disappears into it.
fn merge(xs: &[Iv]) -> [Iv] {
    let s = arr_sort_by(xs, |a, b| a.lo - b.lo)
    let out = []
    for i in 0..len(s) {
        let iv = s[i]
        if iv.lo < iv.hi {
            let n = len(out)
            if n > 0 && iv.lo <= out[n - 1].hi {
                if iv.hi > out[n - 1].hi {
                    out[n - 1] = Iv { lo: out[n - 1].lo, hi: iv.hi }
                }
            } else {
                out = arr_push(out, iv)
            }
        }
    }
    out
}

// Total length of time covered by at least one interval.
fn covered_length(xs: &[Iv]) -> i64 {
    let m = merge(xs)
    let total = 0
    for i in 0..len(m) {
        total = total + m[i].hi - m[i].lo
    }
    total
}

// The largest number of intervals that share a common point: how many rooms
// the bookings need at the busiest moment. A sweep over start (+1) and end
// (-1) events; at the same instant an end is processed before a start,
// because a booking ending at t frees its room for one starting at t.
fn max_overlap(xs: &[Iv]) -> i64 {
    let ev = []
    for i in 0..len(xs) {
        if xs[i].lo < xs[i].hi {
            ev = arr_push(ev, Ev { t: xs[i].lo, d: 1 })
            ev = arr_push(ev, Ev { t: xs[i].hi, d: -1 })
        }
    }
    let s = arr_sort_by(ev, |a, b| if a.t != b.t { a.t - b.t } else { a.d - b.d })
    let cur = 0
    let best = 0
    for i in 0..len(s) {
        cur = cur + s[i].d
        if cur > best {
            best = cur
        }
    }
    best
}

// The earliest start t >= from such that [t, t + dur) overlaps no interval
// in `busy`.
fn first_free(busy: &[Iv], from: i64, dur: i64) -> i64 {
    let m = merge(busy)
    let t = from
    for i in 0..len(m) {
        if m[i].hi > t && m[i].lo < t + dur {
            t = m[i].hi
        }
    }
    t
}

@[test]
fn test_merge_basic() {
    let m = merge(&[Iv { lo: 1, hi: 3 }, Iv { lo: 2, hi: 6 }, Iv { lo: 8, hi: 10 }, Iv { lo: 15, hi: 18 }])
    assert_eq(len(m), 3)
    assert_eq(m[0].lo, 1)
    assert_eq(m[0].hi, 6)
    assert_eq(m[1].lo, 8)
    assert_eq(m[2].hi, 18)
}

@[test]
fn test_merge_unsorted_and_touching() {
    let m = merge(&[Iv { lo: 5, hi: 7 }, Iv { lo: 1, hi: 3 }, Iv { lo: 3, hi: 5 }])
    assert_eq(len(m), 1)
    assert_eq(m[0].lo, 1)
    assert_eq(m[0].hi, 7)
    let n = merge(&[Iv { lo: 4, hi: 9 }, Iv { lo: 1, hi: 2 }])
    assert_eq(len(n), 2)
    assert_eq(n[0].lo, 1)
    assert_eq(n[1].lo, 4)
}

@[test]
fn test_merge_contained_and_empty() {
    let m = merge(&[Iv { lo: 1, hi: 10 }, Iv { lo: 2, hi: 3 }, Iv { lo: 4, hi: 5 }])
    assert_eq(len(m), 1)
    assert_eq(m[0].hi, 10)
    let e = merge(&[Iv { lo: 3, hi: 3 }, Iv { lo: 5, hi: 4 }])
    assert_eq(len(e), 0)
}

@[test]
fn test_covered_length() {
    assert_eq(covered_length(&[Iv { lo: 1, hi: 3 }, Iv { lo: 2, hi: 6 }, Iv { lo: 8, hi: 10 }]), 7)
    assert_eq(covered_length(&[Iv { lo: 0, hi: 5 }, Iv { lo: 5, hi: 9 }]), 9)
    assert_eq(covered_length(&[Iv { lo: 2, hi: 12 }, Iv { lo: 4, hi: 6 }]), 10)
}

@[test]
fn test_max_overlap_nested() {
    assert_eq(max_overlap(&[Iv { lo: 0, hi: 10 }, Iv { lo: 1, hi: 2 }, Iv { lo: 3, hi: 4 }]), 2)
    assert_eq(max_overlap(&[Iv { lo: 0, hi: 10 }, Iv { lo: 1, hi: 9 }, Iv { lo: 2, hi: 8 }]), 3)
}

@[test]
fn test_max_overlap_touching() {
    assert_eq(max_overlap(&[Iv { lo: 0, hi: 5 }, Iv { lo: 5, hi: 9 }]), 1)
    assert_eq(max_overlap(&[Iv { lo: 1, hi: 3 }, Iv { lo: 3, hi: 4 }, Iv { lo: 4, hi: 6 }]), 1)
}

@[test]
fn test_max_overlap_meetings() {
    let day = [Iv { lo: 9, hi: 10 }, Iv { lo: 9, hi: 12 }, Iv { lo: 11, hi: 13 }, Iv { lo: 10, hi: 11 }, Iv { lo: 12, hi: 14 }, Iv { lo: 9, hi: 14 }]
    assert_eq(max_overlap(&day), 3)
    assert_eq(max_overlap(&[Iv { lo: 1, hi: 4 }, Iv { lo: 2, hi: 3 }, Iv { lo: 5, hi: 8 }, Iv { lo: 6, hi: 7 }]), 2)
}

@[test]
fn test_first_free() {
    let busy = [Iv { lo: 9, hi: 10 }, Iv { lo: 10, hi: 12 }, Iv { lo: 13, hi: 15 }]
    assert_eq(first_free(&busy, 9, 1), 12)
    assert_eq(first_free(&busy, 9, 2), 15)
    assert_eq(first_free(&busy, 8, 1), 8)
    assert_eq(first_free(&busy, 12, 1), 12)
}
