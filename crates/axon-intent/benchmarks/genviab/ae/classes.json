{
 "schema": "axon-ae-classes/1",
 "doc": "ae.py classes (spec AE-5): first matching rule wins. Facts: code (axon-diag/1), code_prefix, name_in_card (the first quoted name of the message appears in `axon card`; null when unknown), kind (m2, m2s, m2f), panic_kind, ended. Unmatched -> unassigned.",
 "rules": [
