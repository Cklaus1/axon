{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "axon.closed-loop.episode/1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "arm_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "trial_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "execution_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "task_id",
        "arm_id",
        "trial_id",
        "attempt_id",
        "operation_id",
        "execution_id"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "task_family": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "tenant_id",
        "task_family"
      ]
    },
    "policy_ref": {
      "type": "string",
      "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
    },
    "controls_ref": {
      "type": "string",
      "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
    },
    "context_ref": {
      "type": "string",
      "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
    },
    "candidate_set_ref": {
      "type": "string",
      "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
    },
    "input_workspace_ref": {
      "type": "string",
      "pattern": "^acf1:[0-9a-f]{64}$"
    },
    "output_workspace_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^acf1:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "acf_request_ref": {
      "type": "string",
      "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
    },
    "acf_receipt_ref": {
      "type": "string",
      "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
    },
    "source_episode_ref": {
      "type": "string",
      "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
    },
    "authority_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "outcome_unknown",
        "refused",
        "unsupported"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "unknown"
          ]
        },
        "matched_checks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issuer_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "verifier_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_workspace_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^acf1:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        }
      },
      "required": [
        "result",
        "matched_checks",
        "issuer_ref",
        "verifier_ref",
        "output_workspace_ref",
        "evidence_refs"
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "final",
            "estimated",
            "unknown"
          ]
        },
        "cost_micro": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "unresolved_liability_micro": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "price_schedule_ref": {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        "attempt_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        }
      },
      "required": [
        "state",
        "cost_micro",
        "unresolved_liability_micro",
        "currency",
        "price_schedule_ref",
        "attempt_refs"
      ]
    },
    "corpus_role": {
      "enum": [
        "discovery",
        "tuning",
        "confirmation",
        "reporting",
        "mechanism_test"
      ]
    },
    "data_use_ref": {
      "type": "string",
      "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
    },
    "projection_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "identity",
    "scope",
    "policy_ref",
    "controls_ref",
    "context_ref",
    "candidate_set_ref",
    "input_workspace_ref",
    "output_workspace_ref",
    "acf_request_ref",
    "acf_receipt_ref",
    "source_episode_ref",
    "authority_epoch",
    "status",
    "verification",
    "usage",
    "corpus_role",
    "data_use_ref",
    "projection_ref"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axon:closed-loop:episode:1",
  "title": "Post-preflight episode sidecar referencing unchanged source/Fabric records",
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "result": {
                "const": "passed"
              }
            },
            "required": [
              "result"
            ]
          }
        },
        "required": [
          "verification"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "completed"
          },
          "output_workspace_ref": {
            "type": "string",
            "pattern": "^acf1:[0-9a-f]{64}$"
          },
          "verification": {
            "properties": {
              "matched_checks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "issuer_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "verifier_ref": {
                "type": "string",
                "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
              },
              "output_workspace_ref": {
                "type": "string",
                "pattern": "^acf1:[0-9a-f]{64}$"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
                },
                "minItems": 1,
                "maxItems": 256,
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "outcome_unknown"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "result": {
                "enum": [
                  "not_run",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usage": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "usage"
        ]
      },
      "then": {
        "properties": {
          "usage": {
            "properties": {
              "cost_micro": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usage": {
            "properties": {
              "state": {
                "const": "final"
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "usage"
        ]
      },
      "then": {
        "properties": {
          "usage": {
            "properties": {
              "cost_micro": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "unresolved_liability_micro": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}
