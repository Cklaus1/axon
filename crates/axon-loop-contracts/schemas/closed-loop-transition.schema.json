{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "axon.closed-loop.transition/1"
    },
    "transition_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "kind": {
      "enum": [
        "activate",
        "rollback",
        "pause"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "task_family": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "tenant_id",
        "task_family"
      ]
    },
    "expected_policy_ref": {
      "type": "string",
      "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
    },
    "target_policy_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "next_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "admission_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_ref": {
      "type": "string",
      "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
    },
    "issuer_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "mechanism_test": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "transition_id",
    "kind",
    "scope",
    "expected_policy_ref",
    "target_policy_ref",
    "expected_epoch",
    "next_epoch",
    "admission_ref",
    "reason_ref",
    "issuer_ref",
    "mechanism_test"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axon:closed-loop:transition:1",
  "title": "Proposed fenced policy transition; authentication and admission remain external",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "pause"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "target_policy_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "activate",
              "rollback"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "target_policy_ref": {
            "type": "string",
            "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
          },
          "admission_ref": {
            "type": "string",
            "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
