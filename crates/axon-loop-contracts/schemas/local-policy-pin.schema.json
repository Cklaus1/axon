{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axon:loop-contracts:policy-pin:1",
  "title": "CRATE-LOCAL (no package schema): a consumer's record of pinning a policy version at an epoch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "digest": {"type": "string", "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"}
      },
      "required": ["policy_id", "digest"]
    },
    "epoch": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "pinned_at_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "ack": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {"state": {"const": "acknowledged"}},
          "required": ["state"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {"const": "refused"},
            "reason": {"type": "string", "minLength": 1, "maxLength": 512}
          },
          "required": ["state", "reason"]
        }
      ]
    }
  },
  "required": ["version", "epoch", "pinned_at_ms", "ack"]
}
