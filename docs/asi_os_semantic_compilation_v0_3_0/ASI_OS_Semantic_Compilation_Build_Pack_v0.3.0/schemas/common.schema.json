{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asi:common:0.3.0",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*@[1-9][0-9]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "type": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "object",
        "array",
        "artifact"
      ]
    },
    "port_map": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
      },
      "additionalProperties": {
        "$ref": "urn:asi:common:0.3.0#/$defs/type"
      }
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "input": {
              "$ref": "urn:asi:common:0.3.0#/$defs/id"
            }
          },
          "required": [
            "input"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "node": {
              "$ref": "urn:asi:common:0.3.0#/$defs/id"
            },
            "port": {
              "$ref": "urn:asi:common:0.3.0#/$defs/id"
            }
          },
          "required": [
            "node",
            "port"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "literal": {}
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        }
      ]
    },
    "node_limits": {
      "type": "object",
      "properties": {
        "max_cost_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max_cost_microusd",
        "timeout_ms"
      ],
      "additionalProperties": false
    },
    "run_limits": {
      "type": "object",
      "properties": {
        "max_cost_microusd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wall_time_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "max_cost_microusd",
        "wall_time_ms",
        "max_parallelism"
      ],
      "additionalProperties": false
    },
    "retry": {
      "type": "object",
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "required": [
        "max_attempts"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "node": {
          "$ref": "urn:asi:common:0.3.0#/$defs/id"
        },
        "port": {
          "$ref": "urn:asi:common:0.3.0#/$defs/id"
        }
      },
      "required": [
        "node",
        "port"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "tenant": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "digest",
        "tenant",
        "media_type",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "cost_microusd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cached_input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "cost_microusd",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "synthetic"
      ],
      "additionalProperties": false
    },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "deterministic"
            },
            "passed": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "passed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "probability"
            },
            "probability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "probability"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "choice"
            },
            "selected": {
              "type": "string",
              "minLength": 1
            },
            "probabilities": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "provider_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "selected",
            "probabilities"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "score"
            },
            "score": {
              "type": "number"
            },
            "rubric_ref": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "provider_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "probabilities": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "required": [
            "kind",
            "score",
            "rubric_ref"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
