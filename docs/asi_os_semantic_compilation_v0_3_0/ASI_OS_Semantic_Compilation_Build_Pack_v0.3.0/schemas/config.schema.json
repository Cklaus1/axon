{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asi:config:0.3.0",
  "type": "object",
  "properties": {
    "config_version": {
      "const": "asi.config/v0.3"
    },
    "mode": {
      "enum": [
        "captured",
        "sandbox",
        "live"
      ]
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_nodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_parallelism": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_attempts_per_node": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_repair_rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "max_run_cost_microusd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "max_node_cost_microusd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "max_wall_time_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_node_time_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "exploration_basis_points": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "automatic_promotion": {
      "type": "boolean"
    },
    "allow_external_effects": {
      "type": "boolean"
    },
    "max_plan_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_json_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "probability_tolerance_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    }
  },
  "required": [
    "config_version",
    "mode",
    "max_candidates",
    "max_nodes",
    "max_parallelism",
    "max_attempts_per_node",
    "max_repair_rounds",
    "max_run_cost_microusd",
    "max_node_cost_microusd",
    "max_wall_time_ms",
    "max_node_time_ms",
    "exploration_basis_points",
    "automatic_promotion",
    "allow_external_effects",
    "max_plan_bytes",
    "max_json_depth",
    "probability_tolerance_ppm"
  ],
  "additionalProperties": false
}
