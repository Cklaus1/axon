{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asi:experience:0.3.0",
  "type": "object",
  "properties": {
    "experience_version": {
      "const": "asi.experience/v0.3"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "trial_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "arm_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "plan_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evaluation_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "strategy_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "config_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "selection_probability": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "failed",
            "abstained",
            "cancelled"
          ]
        },
        "success": {
          "type": "boolean"
        },
        "quality": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "wall_time_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "status",
        "success",
        "quality",
        "wall_time_ms"
      ],
      "additionalProperties": false
    },
    "costs": {
      "type": "object",
      "properties": {
        "compile_microusd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "execute_microusd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluate_microusd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "repair_microusd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "failed_attempts_microusd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "Informational subset already included in disjoint stage totals. Do not add a second time."
        }
      },
      "required": [
        "compile_microusd",
        "execute_microusd",
        "evaluate_microusd",
        "repair_microusd",
        "failed_attempts_microusd"
      ],
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "minItems": 0
    }
  },
  "required": [
    "experience_version",
    "experiment_id",
    "task_id",
    "trial_id",
    "arm_id",
    "run_id",
    "plan_ref",
    "evaluation_ref",
    "strategy_ref",
    "config_ref",
    "synthetic",
    "selection_probability",
    "outcome",
    "costs",
    "evidence_refs"
  ],
  "additionalProperties": false
}
