{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asi:plan:0.3.0",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "intent_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evaluation_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "registry_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "config_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "task_class": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "input_types": {
      "$ref": "urn:asi:common:0.3.0#/$defs/port_map"
    },
    "limits": {
      "$ref": "urn:asi:common:0.3.0#/$defs/run_limits"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "args": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
            },
            "additionalProperties": {
              "$ref": "urn:asi:common:0.3.0#/$defs/binding"
            }
          },
          "outputs": {
            "$ref": "urn:asi:common:0.3.0#/$defs/port_map"
          },
          "limits": {
            "$ref": "urn:asi:common:0.3.0#/$defs/node_limits"
          },
          "retry": {
            "$ref": "urn:asi:common:0.3.0#/$defs/retry"
          },
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*@[1-9][0-9]*$"
          },
          "mechanism": {
            "enum": [
              "transform",
              "model.call",
              "tool.call",
              "code.execute",
              "evaluate",
              "human.request",
              "assert",
              "return"
            ]
          },
          "semantic_op": {
            "enum": [
              "observe",
              "rule",
              "retrieve",
              "decide",
              "generate",
              "reason",
              "predict",
              "check",
              "act"
            ]
          }
        },
        "required": [
          "id",
          "mechanism",
          "depends_on",
          "args",
          "outputs",
          "limits",
          "retry"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "mechanism": {
                  "enum": [
                    "transform",
                    "model.call",
                    "tool.call",
                    "code.execute",
                    "evaluate",
                    "human.request"
                  ]
                }
              },
              "required": [
                "mechanism"
              ]
            },
            "then": {
              "required": [
                "capability",
                "semantic_op"
              ]
            },
            "else": {
              "allOf": [
                {
                  "not": {
                    "required": [
                      "capability"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mechanism": {
                        "const": "assert"
                      }
                    },
                    "required": [
                      "mechanism"
                    ]
                  },
                  "then": {
                    "required": [
                      "semantic_op"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "semantic_op"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "plan_version": {
      "const": "asi.semantic-plan/v0.3"
    }
  },
  "required": [
    "plan_version",
    "name",
    "revision",
    "intent_ref",
    "evaluation_ref",
    "registry_ref",
    "config_ref",
    "task_class",
    "input_types",
    "limits",
    "nodes"
  ],
  "additionalProperties": false
}
