        "candidate_set_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_order_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "event_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/level"
          },
          "maxItems": 512
        },
        "requires_complete_scores": {
          "type": "boolean"
