            "question_isolation": {
              "$ref": "#/$defs/feature"
            },
            "batching": {
              "$ref": "#/$defs/feature"
            },
            "native_state": {
              "$ref": "#/$defs/feature"
            },
            "cancellation": {
              "$ref": "#/$defs/feature"
            },
            "usage": {
              "$ref": "#/$defs/feature"
            },
            "immutable_identity": {
              "$ref": "#/$defs/feature"
            }
