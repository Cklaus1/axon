      "type": "object",
      "properties": {
        "profile": {
          "const": "axon.ace-projection/1"
        },
        "record_type": {
          "const": "PhysicalExecutionProfile"
        },
        "mapping_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "air_node_kind": {
          "enum": [
            "Decide",
            "Generate",
            "Rule"
          ]
        },
        "cognitive_class": {
          "enum": [
            "REFLEX",
            "GENERATE",
            "RULE"
          ]
        },
        "operation_kind": {
          "enum": [
            "DECIDE",
            "TRANSFORM",
            "PROJECT"
          ]
        },
        "capability_class": {
          "enum": [
            "GENERAL_REFLEX",
            "SPECIALIZED_REFLEX",
            "GENERATE",
            "NEURAL_PROGRAM",
            "RULE"
          ]
        },
        "physical_mechanism": {
          "enum": [
            "structured_generation",
            "validated_text",
            "candidate_token_scoring",
            "sequence_scoring",
            "learned_head",
            "learned_function",
            "deterministic_projection"
          ]
        },
        "deployment_mode": {
          "enum": [
            "Embedded",
            "LocalSidecar",
            "RemoteService"
          ]
