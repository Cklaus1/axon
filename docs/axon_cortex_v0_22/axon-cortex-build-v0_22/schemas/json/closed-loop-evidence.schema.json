{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "axon.closed-loop.runtime-evidence/1"
    },
    "package_version": {
      "const": "0.22"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
            },
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true
          },
          "test_command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "test_cases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "minItems": 1,
            "maxItems": 4096,
            "uniqueItems": true
          },
          "assertions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "profile_ref": {
            "type": "string",
            "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
          },
          "issuer_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
            },
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true
          },
          "synthetic": {
            "type": "boolean"
          }
        },
        "required": [
          "gate_id",
          "result",
          "source_refs",
          "test_command",
          "test_cases",
          "assertions",
          "profile_ref",
          "issuer_ref",
          "evidence_refs",
          "synthetic"
        ]
      },
      "maxItems": 4096
    }
  },
  "required": [
    "schema",
    "package_version",
    "records"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:axon:closed-loop:evidence:1",
  "title": "External runtime evidence completeness input; structural validation never authenticates or qualifies it"
}
