{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.2/evaluation.schema.json",
  "title": "Evaluation",
  "type": "object",
  "required": [
    "id",
    "version",
    "hard_constraints",
    "objectives",
    "evaluators"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric",
          "operator",
          "value"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "operator": {
            "enum": [
              "==",
              "!=",
              ">",
              ">=",
              "<",
              "<=",
              "contains",
              "not_contains"
            ]
          },
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric",
          "direction"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "minimize",
              "maximize"
            ]
          },
          "weight": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "evaluators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "test",
              "benchmark",
              "static",
              "security",
              "model_judge",
              "human",
              "custom"
            ]
          },
          "config": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "results": {
      "type": [
        "object",
        "null"
      ]
    },
    "provenance": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}