{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.2/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "required": [
    "id",
    "kind",
    "subject",
    "environment",
    "result"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "test",
        "benchmark",
        "static_verification",
        "security",
        "human_judgment",
        "model_judgment",
        "compiler_probe",
        "retrieval_verification"
      ]
    },
    "subject": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "result": {
      "type": "object"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}