{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.2/provenance.schema.json",
  "title": "Provenance",
  "type": "object",
  "required": [
    "artifact_hash",
    "created_by",
    "inputs"
  ],
  "properties": {
    "artifact_hash": {
      "type": "string"
    },
    "created_by": {
      "type": "object",
      "required": [
        "kind",
        "identity"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent",
            "compiler",
            "transform",
            "build_program",
            "backend",
            "system"
          ]
        },
        "identity": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "identity"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          },
          "hash": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experiment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "strategy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}