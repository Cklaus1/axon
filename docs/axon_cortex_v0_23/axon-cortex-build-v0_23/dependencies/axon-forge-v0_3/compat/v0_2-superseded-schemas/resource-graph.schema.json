{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.2/resource-graph.schema.json",
  "title": "ResourceGraph",
  "type": "object",
  "required": [
    "id",
    "nodes",
    "edges"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "properties": {
            "type": "object"
          },
          "security_domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_residency": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "protocol": {
            "type": [
              "string",
              "null"
            ]
          },
          "properties": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}