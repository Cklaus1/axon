{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.2/strategy.schema.json",
  "title": "StrategyArtifact",
  "type": "object",
  "required": [
    "id",
    "version",
    "kind",
    "configuration"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "model_routing",
        "agent",
        "compiler_pipeline",
        "build",
        "backend",
        "evaluation",
        "search",
        "repair",
        "retrieval"
      ]
    },
    "configuration": {
      "type": "object"
    },
    "parent_strategy_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}