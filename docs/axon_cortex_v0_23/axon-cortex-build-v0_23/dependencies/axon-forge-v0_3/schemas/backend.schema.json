{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.3/backend.schema.json",
  "title": "Backend",
  "type": "object",
  "required": [
    "id",
    "version",
    "capabilities",
    "toolchain"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_sir_features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "toolchain": {
      "type": "object"
    },
    "determinism": {
      "type": "object"
    },
    "diagnostics": {
      "type": "object"
    },
    "resource_requirements": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
