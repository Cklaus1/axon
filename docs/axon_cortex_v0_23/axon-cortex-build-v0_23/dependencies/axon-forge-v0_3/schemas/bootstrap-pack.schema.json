{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.3/bootstrap-pack.schema.json",
  "title": "BootstrapPack",
  "type": "object",
  "required": [
    "language",
    "version",
    "compiler",
    "truth_priority",
    "canonical_sources"
  ],
  "properties": {
    "language": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "compiler": {
      "type": "object"
    },
    "truth_priority": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "canonical_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "priority"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "hash": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "quick_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "common_errors": {
      "type": [
        "string",
        "null"
      ]
    },
    "migration_notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
