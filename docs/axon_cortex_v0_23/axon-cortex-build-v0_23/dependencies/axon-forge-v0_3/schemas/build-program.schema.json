{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.3/build-program.schema.json",
  "title": "BuildProgram",
  "type": "object",
  "required": [
    "id",
    "version",
    "entry",
    "capability_request",
    "declared_inputs"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "entry": {
      "type": "string"
    },
    "capability_request": {
      "type": "object"
    },
    "declared_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_constraints": {
      "type": "object"
    },
    "deterministic": {
      "type": "boolean"
    },
    "output_graph_schema": {
      "const": "axon.forge-build-graph/1"
    }
  },
  "additionalProperties": false
}
