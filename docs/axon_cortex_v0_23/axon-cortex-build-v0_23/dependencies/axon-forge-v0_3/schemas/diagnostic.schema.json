{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.3/diagnostic.schema.json",
  "title": "Diagnostic",
  "type": "object",
  "required": [
    "severity",
    "code",
    "message",
    "compiler_identity"
  ],
  "properties": {
    "severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "fatal"
      ]
    },
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "sir_node_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_span": {
      "type": [
        "object",
        "null"
      ]
    },
    "expected": {
      "type": [
        "object",
        "null"
      ]
    },
    "actual": {
      "type": [
        "object",
        "null"
      ]
    },
    "causal_chain": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repair_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compiler_identity": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
