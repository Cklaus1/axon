{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.3/evaluation-profile.schema.json",
  "title": "ForgeEvaluationProfile",
  "type": "object",
  "required": [
    "evaluator_ref",
    "hard_invariants",
    "measurements"
  ],
  "properties": {
    "evaluator_ref": {
      "type": "string"
    },
    "hard_invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hidden_assets_external": {
      "type": "boolean"
    },
    "subject_may_modify_evaluator": {
      "const": false
    }
  },
  "additionalProperties": false
}
