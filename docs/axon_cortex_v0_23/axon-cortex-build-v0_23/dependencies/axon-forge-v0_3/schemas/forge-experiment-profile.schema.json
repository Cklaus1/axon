{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.3/forge-experiment-profile.schema.json",
  "title": "ForgeExperimentProfile",
  "type": "object",
  "required": [
    "axon_experiment_ref",
    "subject",
    "mutation"
  ],
  "properties": {
    "axon_experiment_ref": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "required": [
        "artifact_ref"
      ],
      "properties": {
        "artifact_ref": {
          "type": "string"
        },
        "sir_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_artifact_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "mutation": {
      "type": "object",
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "parameter",
            "implementation",
            "transform",
            "pipeline",
            "backend",
            "architecture",
            "resource_placement",
            "build",
            "compiler_strategy"
          ]
        },
        "transform_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "pipeline_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "semantic_diff_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "compiler_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "backend_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "resource_projection_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "forge_strategy_profile_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
