{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.3/forge-strategy-profile.schema.json",
  "title": "ForgeStrategyProfile",
  "type": "object",
  "required": [
    "strategy_ref",
    "kind",
    "configuration"
  ],
  "properties": {
    "strategy_ref": {
      "type": "string",
      "description": "Canonical Axon StrategyArtifact identity."
    },
    "kind": {
      "enum": [
        "compiler_pipeline",
        "build",
        "backend",
        "repair",
        "retrieval",
        "migration",
        "meta_execution"
      ]
    },
    "configuration": {
      "type": "object"
    },
    "forge_artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
