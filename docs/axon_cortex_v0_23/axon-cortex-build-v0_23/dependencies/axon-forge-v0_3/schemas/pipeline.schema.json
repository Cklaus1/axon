{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.3/pipeline.schema.json",
  "title": "TransformPipeline",
  "type": "object",
  "required": [
    "id",
    "version",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "transform_id",
          "version",
          "parameters"
        ],
        "properties": {
          "transform_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "preserves": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
