{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.3/resource-projection.schema.json",
  "title": "ResourceProjection",
  "type": "object",
  "required": [
    "id",
    "authority_ref",
    "observation_epoch",
    "nodes",
    "edges"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1
    },
    "observation_epoch": {
      "type": [
        "string",
        "integer"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_ref",
          "class"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "properties": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "source_ref"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "properties": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "authoritative": {
      "const": false
    }
  },
  "additionalProperties": false
}
