{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.3/semantic-diff.schema.json",
  "title": "SemanticDiff",
  "type": "object",
  "required": [
    "before_sir_ref",
    "after_sir_ref",
    "changes"
  ],
  "properties": {
    "before_sir_ref": {
      "type": "string"
    },
    "after_sir_ref": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "node_ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "node_ref": {
            "type": "string"
          },
          "before": {},
          "after": {},
          "semantic_effect": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "public_contract_change": {
      "type": "boolean"
    },
    "effect_changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "resource_changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
