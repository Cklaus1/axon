{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.3/semantic-ir.schema.json",
  "title": "SemanticIR",
  "type": "object",
  "required": [
    "schema_version",
    "program_id",
    "modules",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "type_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "attributes": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "artifact_hash"
      ],
      "properties": {
        "artifact_hash": {
          "type": "string"
        },
        "source_locations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "created_by": {
          "type": [
            "object",
            "null"
          ]
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transform_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
