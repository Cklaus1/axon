{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon-forge/spec/v0.3/transform.schema.json",
  "title": "Transform",
  "type": "object",
  "required": [
    "id",
    "version",
    "mutation_class",
    "preconditions",
    "invariants_preserved",
    "parameters_schema",
    "verification_plan"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string"
    },
    "mutation_class": {
      "enum": [
        "parameter",
        "implementation",
        "transform",
        "pipeline",
        "backend",
        "architecture",
        "model",
        "agent_strategy",
        "evaluator_strategy",
        "search_strategy",
        "resource_placement",
        "build_strategy"
      ]
    },
    "accepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "produces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants_preserved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permitted_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters_schema": {
      "type": "object"
    },
    "verification_plan": {
      "type": "object"
    },
    "expected_cost": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
