{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "axon.closed-loop.pilot/1"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "task_family": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "tenant_id",
        "task_family"
      ]
    },
    "mutable_surface": {
      "const": "eligible_tool_skill_shortlist"
    },
    "runtime_ready": {
      "type": "boolean"
    },
    "deployment_enabled": {
      "type": "boolean"
    },
    "operator_approved": {
      "type": "boolean"
    },
    "live_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
      },
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true
    },
    "task_manifest_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "repository_split_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "discovery_manifest_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmation_manifest_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reporting_manifest_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "controls_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "incumbent_policy_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_policy_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "analysis_method_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "data_use_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rollback_policy_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cl22|acf1|sha256):[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "independent_units": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
