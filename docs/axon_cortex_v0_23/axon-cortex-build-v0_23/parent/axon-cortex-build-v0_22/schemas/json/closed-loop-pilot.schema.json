    },
    "missing_data_rule": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "multiplicity_rule": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "order_rule": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
