// Axon ASI demo: UCB1 multi-armed bandit (using the reusable module).
//
// `mod bandit` imports the UCB1 algorithm from examples/stdlib/bandit.ax.
// The demo just wires the bandit to a noisy reward function and runs
// the exploration-exploitation loop. After 200 rounds the bandit
// converges to the actual best arm (arm-2 with true_mean=0.78).
//
//   AXON_PATH=examples/stdlib axon run examples/asi/bandit_ucb.ax

mod bandit
use bandit.{Bandit, bandit_new, bandit_select, bandit_update, bandit_pulls, bandit_mean, bandit_best_arm}

// Five arms. The TRUE means are hidden from the bandit — the demo
// fixes them so the test can assert convergence.
fn true_mean(arm_id: i64) -> f64 {
    let means = [0.20, 0.45, 0.78, 0.55, 0.35]
    means[arm_id]
}

fn n_arms() -> i64 { 5 }

// Pull arm `id`: returns a reward with small uniform noise around the
// true mean. The bandit only sees this value, not the underlying mean.
fn pull(arm_id: i64) -> f64 {
    let noise = (random_f64() - 0.5) * 0.05
    true_mean(arm_id) + noise
}

fn arm_label(id: i64) -> str {
    if id == 0 { "arm-0" }
    else if id == 1 { "arm-1" }
    else if id == 2 { "arm-2" }
    else if id == 3 { "arm-3" }
    else { "arm-4" }
}

fn main() -> i64 {
    let b = bandit_new(n_arms())
    let rounds = 200

    let t = 0
    while t < rounds {
        let arm = bandit_select(b, t + 1)
        let reward = pull(arm)
        bandit_update(b, arm, reward)
        t = t + 1
    }

    println("=== UCB1 bandit after {to_str(rounds)} rounds ===")
    let i = 0
    while i < n_arms() {
        let n = bandit_pulls(b, i)
        let m = bandit_mean(b, i)
        println("  {arm_label(i)}: pulls={to_str(n)} est_mean={to_str_f64(m)} true_mean={to_str_f64(true_mean(i))}")
        i = i + 1
    }

    let winner = bandit_best_arm(b)
    println("preferred arm: {arm_label(winner)} ({to_str(bandit_pulls(b, winner))} pulls)")

    // Exit 1 iff UCB converged to arm-2 (true_mean=0.78, the actual best).
    if winner == 2 { 1 } else { 0 }
}
