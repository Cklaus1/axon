// Phase 7 (R12) capstone — the kernel runtime services, assembled.
//
// This demo exercises all five Phase-7 kernel slices end to end, FOR a program,
// the way the runtime enforces them — not as pure userland values:
//
//   Slice 1  principal_authority — mint an attenuated worker principal.
//   Slice 2  cooperative scheduler — fan out worker fibers under it.
//   Slice 3  live supervisor — restart a failed worker, halt a crash loop.
//   Slice 4  durable Store — workers accumulate into a linearizable store
//            that survives a process and dedups retried ops.
//   Slice 5  kernel LLM<Caps> — an AI call metered against the principal's
//            budget, degrading to a fallback on overrun.
//
// Interp-only (the kernel services run under `axon run`, not native codegen):
//   axon run examples/asi/kernel_orchestrator.ax

fn worker_ok(n: i64) -> i64 { n * 10 }
fn worker_crash(n: i64) -> i64 { assert(false)  0 }

fn main() -> i64 {
    // ── Slice 1: mint an attenuated worker principal ─────────────────────────
    // Root holds net + a 100000 µ$ budget; the worker gets net only, 60000 µ$.
    let root = principal_root("orchestrator", true, true, true, 100000)
    let worker_p = principal_mint(root, "worker", true, false, false, 60000)
    println("worker principal: net={to_str(principal_holds(worker_p, \"net\"))} fs_write={to_str(principal_holds(worker_p, \"fs_write\"))} budget={to_str(principal_budget_remaining(worker_p))}")

    // ── Slice 2: fan out worker fibers under the scheduler ───────────────────
    let f1 = scheduler_spawn("worker_ok", 1)
    let f2 = scheduler_spawn("worker_ok", 2)
    let f3 = scheduler_spawn("worker_ok", 3)
    let done = scheduler_run()
    println("scheduler: {to_str(done)} fibers completed; f2={to_str(scheduler_result(f2))} f3={to_str(scheduler_result(f3))}")

    // ── Slice 3: a supervisor halts a crash loop instead of spinning ─────────
    let sup = supervisor_new(0, 2)
    let crasher = scheduler_spawn("worker_crash", 0)
    let _ = supervisor_supervise(sup, crasher)
    // (We DON'T call supervisor_run here — it would halt the program (exit 4).
    //  The crash-loop halt is exercised by the test harness; here we just show
    //  the supervisor is wired and alive before any failure.)
    println("supervisor alive before failures: {to_str(supervisor_alive(sup))}")

    // ── Slice 4: workers accumulate into a durable linearizable store ────────
    let _ = dstore_clear("orchestrator_run")
    let st = dstore_open("orchestrator_run", 1)
    let _ = dstore_apply(st, 1, scheduler_result(f1))
    let _ = dstore_apply(st, 2, scheduler_result(f2))
    let _ = dstore_apply(st, 2, scheduler_result(f2))   // retry — deduped
    println("durable store: value={to_str(dstore_value(st))} version={to_str(dstore_version(st))} (op 2 retry deduped)")

    // ── Slice 5: an AI call metered against the worker principal's budget ────
    let gw = llm_open("haiku", 5000, worker_p, "[budget exhausted — cached default]")
    let charged = llm_complete(gw, "summarize the run", 2000)   // 10000 µ$
    println("llm: charged {to_str(charged)} µ$; worker budget left {to_str(principal_budget_remaining(worker_p))}; gateway alive {to_str(llm_alive(gw))}")

    println("kernel orchestrator: all five Phase-7 slices exercised")
    0
}
