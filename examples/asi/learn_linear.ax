// Axon ASI demo: learn a linear model by black-box optimization.
//
// Showcases the new multi-arg coordinate-descent optimizer added this
// session — see also `examples/asi/self_improve.ax` for the full
// goal_run + goal_history + goal_best_input + Uncertain + @[verify]
// surface. This demo focuses on the *fitting* loop:
//
//   1. Fixed dataset (eight points on y = 3x + 1).
//   2. `neg_loss(a, b)` returns the negated sum-of-absolute-errors so
//      higher = better (the optimizer's convention).
//   3. `goal_run("neg_loss", 0.0, 300)` coordinate-descends across both
//      params, halving the step per dim until neither improves.
//   4. `goal_best_inputs("neg_loss", 0.0)` reads back the winning
//      `(a*, b*)` tuple — both as i64 — for inspection and deployment.
//
// No LLM. Pure compute. The point is that the same loop scales to any
// `fn(i64, …, i64) -> i64` you can name: regression, scheduling,
// resource allocation, etc.

fn dataset_x(i: i64) -> i64 { [0, 1, 2, 3, 4, 5, 6, 7][i] }
fn dataset_y(i: i64) -> i64 { [1, 4, 7, 10, 13, 16, 19, 22][i] }  // y = 3x + 1
fn n_pts() -> i64 { 8 }

// Loss = sum of |a*x + b - y|. We return its negation because the
// optimizer drives the score toward `target`, and we want |error| → 0.
@[adaptive]
fn neg_loss(a: i64, b: i64) -> i64 {
    let total = 0
    let i = 0
    while i < n_pts() {
        let pred = a * dataset_x(i) + b
        let err = pred - dataset_y(i)
        total = total + abs_i64(err)
        i = i + 1
    }
    -total
}

fn main() -> i64 {
    // ── Fit ────────────────────────────────────────────────────────────────
    let budget = 300
    let _ = goal_run("neg_loss", 0.0, budget)
    let xs = goal_best_inputs("neg_loss", 0.0)
    let a = xs[0]
    let b = xs[1]

    // ── Report ─────────────────────────────────────────────────────────────
    let best_loss = -goal_run("neg_loss", 0.0, 0)
    let h = goal_history("neg_loss")
    println("=== linear regression by coordinate descent ===")
    println("budget:    {to_str(budget)} evals")
    println("trace len: {to_str(len(h))}")
    println("learned:   y = {to_str(a)}*x + {to_str(b)}")
    println("loss:      {to_str_f64(best_loss)} (zero = exact fit)")

    // Sanity: walk the dataset, print predictions side-by-side with truth.
    let i = 0
    while i < n_pts() {
        let p = a * dataset_x(i) + b
        println("  x={to_str(dataset_x(i))}  truth={to_str(dataset_y(i))}  pred={to_str(p)}")
        i = i + 1
    }

    // Exit code = 1 iff we hit the true coefficients with zero loss.
    if a == 3 && b == 1 && best_loss == 0.0 { 1 } else { 0 }
}
