// Axon ASI demo: persistent self-improvement across program invocations.
//
// Demonstrates that an ASI loop can carry learned state between
// processes, not just between calls within one run. Each invocation:
//
//   1. Loads the previous best score + best input from a sidecar file.
//   2. Runs goal_run with a small per-invocation budget — too small to
//      reach the optimum from scratch.
//   3. If the new best beats the old, writes it back to disk.
//   4. Reports the cross-run trajectory.
//
// Three or four invocations under the same XDG_CACHE_HOME climb from
// a modest score to the optimum. Same shape as learn-goal.md, but the
// state machine is fully visible in user space — no environment-
// variable magic, no compiler-provided continuation. The optimizer is
// the only adaptive primitive used.

// Objective: peak at x = 200, score = 1000.
@[adaptive]
fn objective(x: i64) -> i64 {
    1000 - abs_i64(x - 200)
}

// ── Tiny on-disk state ──────────────────────────────────────────────────────
// "<best_x>,<best_score>" — two i64s separated by a comma. Parse-or-default
// keeps the demo robust to missing / corrupt state.

fn state_path() -> str { "/tmp/axon_persistent_learner.txt" }

fn load_state() -> (i64, i64) {
    match read_file(state_path()) {
        Ok(content) => {
            let parts = str_split(content, ",")
            if len(parts) >= 2 {
                let x = match parse_int(parts[0]) {
                    Ok(n) => n
                    Err(_) => 0
                }
                let s = match parse_int(parts[1]) {
                    Ok(n) => n
                    Err(_) => 0
                }
                (x, s)
            } else {
                (0, 0)
            }
        }
        Err(_) => (0, 0)
    }
}

fn save_state(x: i64, s: i64) {
    let payload = "{to_str(x)},{to_str(s)}"
    let _ = write_file(state_path(), payload)
}

fn main() {
    let (prev_x, prev_score) = load_state()
    println("=== persistent learner ===")
    println("loaded:  x={to_str(prev_x)}  score={to_str(prev_score)}")

    // Seed the optimizer with the prior best: one call lands the prior
    // entry in provenance, so subsequent goal_run sweeps anchor near it
    // (the optimizer's cur_input starts at 0, but the wide-step seed will
    // overlap the prior region if it's modest, then the halving cascade
    // narrows). For larger displacements we'd need a goal_seed primitive
    // — listed in the roadmap; this demo shows the existing primitives
    // are already enough to express persistence.
    let _ = objective(prev_x)

    // Per-invocation budget. Set deliberately small — the optimizer
    // needs multiple invocations to climb from 0 to 200.
    let budget = 20
    let _ = goal_run("objective", 1000.0, budget)
    let new_x = goal_best_input("objective", 1000.0)
    let new_score = f64_to_i64(goal_run("objective", 1000.0, 0))

    println("new:     x={to_str(new_x)}  score={to_str(new_score)}")

    if new_score > prev_score {
        save_state(new_x, new_score)
        println("status:  IMPROVED — wrote new best to {state_path()}")
    } else if new_score == prev_score && prev_score > 0 {
        println("status:  STABLE — converged at score {to_str(prev_score)}")
    } else {
        // First run or regression: still record so the next call can
        // resume from somewhere.
        save_state(new_x, new_score)
        println("status:  FIRST_RUN — recorded baseline")
    }

    // Trajectory is communicated via stdout and the sidecar file. (If
    // the return were `new_score`, an exit code in u8 would silently
    // truncate the score, masking real failure modes.)
}
