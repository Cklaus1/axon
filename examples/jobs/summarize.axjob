program = "summarize.ax"
intent  = "Summarize ./data/report.txt into ./out/summary.txt; no network."
seed    = 42
[grant]
fs_read   = ["./data/"]
fs_write  = ["./out/"]
net       = []
exec      = "none"
max_label = "internal"
[grant.budget]
calls       = 100
tokens      = 50000
cost_micro  = 1000000
