// R17 Slice 1 — inline asm, hex literals, @[naked]/@[interrupt], port I/O
//
// Exercises R17 Slice 1 features:
//   • Hex integer literals (0x3F8, 0xFF)
//   • Binary integer literals (0b0010_0000)
//   • Digit-separator underscore in integer literals (1_000)
//   • `asm("template" : outputs : inputs : clobbers)` expression
//   • @[naked] function attribute (LLVM: no prologue/epilogue)
//   • @[interrupt] function attribute (calling convention: x86-interrupt)
//   • port_out_u8 / port_in_u8 (R17 HAL: x86 I/O port access)
//
// Type-checks with:    axon check examples/kernel/hello_kernel_slice1.ax
//
// Build + boot under QEMU (see scripts/qemu_boot_test.sh):
//   axon build --freestanding --emit-obj examples/kernel/hello_kernel_slice1.ax \
//       --out /tmp/kernel.o
//   nasm -f elf64 examples/kernel/boot_stub.asm -o /tmp/boot_stub.o
//   ld -T scripts/kernel.ld --entry _start \
//       -o /tmp/kernel.elf /tmp/boot_stub.o /tmp/kernel.o
//   qemu-system-x86_64 -kernel /tmp/kernel.elf -debugcon stdio -display none

substrate

// QEMU debugcon: writing to I/O port 0xE9 sends bytes to -debugcon stdio.
// No UART initialisation needed — just write and QEMU captures it.
let DEBUGCON_PORT = 0xE9

// Hex + binary literals (R17 Slice 1 feature exercise)
let COM1_BASE = 0x3F8              // COM1 THR: transmit holding register (port I/O, not MMIO)
let COM1_SERIAL_THRE = 0b0010_0000 // LSR bit 5: transmitter holding register empty
let ONE_MILLION = 1_000_000        // underscore separators in integer literals

// Halt the CPU using inline asm (R17 Slice 1 feature exercise; identical to hlt() builtin).
fn cpu_halt() | {Hal} {
    asm("hlt" ::: "memory")
}

// Disable interrupts using inline asm (identical to cli() builtin).
fn cpu_cli() | {Hal} {
    asm("cli" ::: "memory")
}

// Write one byte to the QEMU debugcon port (no wait needed).
@[hal]
fn debugcon_write(b: i64) | {Hal} {
    port_out_u8(DEBUGCON_PORT, b)
}

// Write "axon s1\n" to prove Slice 1 booted.
@[hal]
fn write_banner() | {Hal} {
    debugcon_write(0x61)  // a
    debugcon_write(0x78)  // x
    debugcon_write(0x6F)  // o
    debugcon_write(0x6E)  // n
    debugcon_write(0x20)  // space
    debugcon_write(0x73)  // s
    debugcon_write(0x31)  // 1
    debugcon_write(0x0A)  // \n
}

// Divide-by-zero exception handler — @[interrupt] uses x86-interrupt CC.
@[interrupt]
fn isr_div_zero() | {Hal} {
    // Acknowledge and return; a real kernel would log + terminate the faulting task.
    asm("sti" ::: "memory")
}

// Kernel entry point — called by boot_stub.asm after switching to 64-bit long mode.
@[entry]
fn kmain() | {Hal} {
    cpu_cli()
    write_banner()
    while true {
        cpu_halt()
    }
}

@[panic_handler]
fn on_panic() | {Hal} {
    cpu_cli()
    // "PANIC\n"
    debugcon_write(0x50)  // P
    debugcon_write(0x41)  // A
    debugcon_write(0x4E)  // N
    debugcon_write(0x49)  // I
    debugcon_write(0x43)  // C
    debugcon_write(0x0A)  // \n
    while true {
        cpu_halt()
    }
}
