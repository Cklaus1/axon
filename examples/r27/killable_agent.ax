// R27 example: a killable agent. Loops doing pure computation until killed.
// Run with: axon-os run examples/r27/killable_agent.axjob --killable --out ./runs

fn fib(n: i64) -> i64 {
    if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }
}

fn main() {
    let i = 0
    while i < 1000000000 {
        let _ = fib(10)
        i = i + 1
    }
}
