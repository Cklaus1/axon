// Phase 5 — refinement types, @[pure], and @[total].
//
// A refinement type `T where <pred>` moves a precondition onto the type. The
// compiler proves the predicate for compile-time-CONSTANT arguments (a violation
// is a static error, E1209), and the refinement erases to its base type at
// runtime — so there is zero runtime cost and `axon run` == `axon build`.
//
// Run:   axon run   examples/refinements.ax
// Build: axon build examples/refinements.ax

// A named refinement: a strictly-positive integer.
type Positive = i64 where _ > 0

// A string that is not empty (uses the `str_len` projection).
type NonEmpty = str where str_len(_) > 0

// A percentage: a composite predicate.
type Percent = i64 where _ >= 0 && _ <= 100

// A WHOLE-STRUCT refinement: the binder `_` is the struct instance and `_.field`
// projects a field, so the predicate relates two fields. A constant literal that
// violates it (e.g. `Range { lo: 9, hi: 2 }`) is rejected at compile time.
type Range = { lo: i64, hi: i64 } where _.lo <= _.hi

// A `@[pure]` function is free of I/O, AI, time, randomness, and channels — so it
// is admitted into the predicate language. Here it backs an `Even` refinement.
@[pure]
fn is_even(n: i64) -> i64 {
    if n % 2 == 0 { 1 } else { 0 }
}

type Even = i64 where is_even(_) == 1

// `@[total]` proves termination: every recursive call must strictly decrease a
// measure. Here `n - 1` decreases the bounded-below parameter toward the base
// case. The inline refinement `n: i64 where _ >= 0` documents the precondition.
@[pure]
@[total]
fn factorial(n: i64 where _ >= 0) -> i64 {
    if n == 0 { 1 } else { n * factorial(n - 1) }
}

// A function whose parameters carry refinements. A constant caller that violates
// one (e.g. `scale(0, 5)`) would be rejected at compile time.
fn scale(factor: Positive, value: i64) -> i64 {
    factor * value
}

// The canonical example: a divisor that cannot be zero, enforced at the type.
fn divide(n: i64, d: i64 where _ != 0) -> i64 {
    n / d
}

fn greet(name: NonEmpty) -> i64 {
    str_len(name)
}

// A refinement RETURN type. `axon verify` (built with `--features smt`) proves
// statically — via Z3, over ALL i64 inputs — that the body always satisfies the
// refinement: |n| is never negative, so `abs_nn` really does return a `NonNeg`.
type NonNeg = i64 where _ >= 0
fn abs_nn(n: i64) -> NonNeg {
    if n < 0 { 0 - n } else { n }
}

// Refinement SUBTYPING across a call. `abs_nn` returns a `NonNeg`; `scale`'s
// first parameter wants a `Positive`. Forwarding here would need `NonNeg ⟹
// Positive`, which is false at 0 — so this file forwards into a `NonNeg` sink
// instead, which `axon verify` proves safe (`Positive ⟹ NonNeg` always holds).
fn nn_sink(x: NonNeg) -> i64 { x }
fn forward_pos(p: Positive) -> i64 { nn_sink(p) }

fn main() {
    // All arguments below SATISFY their refinements, so this checks and runs.
    println("factorial(5)   = {to_str(factorial(5))}")
    println("scale(3, 4)    = {to_str(scale(3, 4))}")
    println("divide(20, 4)  = {to_str(divide(20, 4))}")
    println("greet(\"axon\")  = {to_str(greet(\"axon\"))}")

    let pct: Percent = 75
    println("percent        = {to_str(pct)}")

    let e: Even = 8
    println("even           = {to_str(e)}")

    // A whole-struct refinement: `lo <= hi` is proved for this literal.
    let r = Range { lo: 3, hi: 9 }
    println("range lo+hi     = {to_str(r.lo + r.hi)}")

    // Refinements erase to their base type, so ordinary arithmetic just works.
    let p: Positive = 10
    println("positive * 2   = {to_str(p * 2)}")

    // A statically-proved refinement return, and a forwarded refinement arg.
    println("abs_nn(-7)     = {to_str(abs_nn(0 - 7))}")
    println("forward_pos(4) = {to_str(forward_pos(4))}")
}
