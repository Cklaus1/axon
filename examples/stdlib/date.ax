// date.ax — civil calendar arithmetic, in USERLAND.
//
// R42 Slice 6 / T9. This is a `.ax` module and NOT a set of builtins, on purpose:
// the spec's admission test says anything expressible in userland Axon must be,
// because a builtin is permanent TCB surface and a module is not. Calendar
// arithmetic is pure integer math, so it qualifies — and this was verified by
// running the algorithms before the spec committed to the claim, not after.
//
// Algorithms are Howard Hinnant's `days_from_civil` / `civil_from_days` (public
// domain), the same ones libc++ and Go's time package use.
//
// ── The one trap, and why the code looks like it does ────────────────────────
//
// Axon's `/` and `%` TRUNCATE toward zero (Rust semantics). Hinnant's algorithms
// need FLOOR division for negative inputs. So every era division is written as an
// explicit branch:
//
//     let era = if y >= 0 { y / 400 } else { (y - 399) / 400 }
//
// Delete that branch and every pre-1970 date is silently wrong — which is why
// `test_pre_epoch_round_trip` exists and asserts a 1969 date specifically.
//
// ── What is deliberately NOT here ───────────────────────────────────────────
//
// Timezones and DST. They need a tzdata table and a host clock offset; pretending
// otherwise produces wrong answers rather than missing ones. `now_ms()` is UTC
// and everything below is UTC. A local-time API that quietly assumed UTC would be
// worse than no local-time API.

type Date = { y: i64, m: i64, d: i64 }

/// Days since 1970-01-01 for a civil (proleptic Gregorian) date.
/// `m` is 1..12, `d` is 1..31. Negative results for dates before the epoch.
fn days_from_civil(y: i64, m: i64, d: i64) -> i64 {
    // March-based year: shifting the leap day to the END of the year is what
    // makes the rest of this branch-free.
    let ys = if m <= 2 { y - 1 } else { y }
    let era = if ys >= 0 { ys / 400 } else { (ys - 399) / 400 }
    let yoe = ys - era * 400
    let mp = (m + 9) % 12
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468
}

/// The inverse: a civil date from days since 1970-01-01.
fn civil_from_days(z0: i64) -> Date {
    let z = z0 + 719468
    let era = if z >= 0 { z / 146097 } else { (z - 146096) / 146097 }
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    let m = if mp < 10 { mp + 3 } else { mp - 9 }
    let yy = if m <= 2 { y + 1 } else { y }
    Date { y: yy, m: m, d: d }
}

fn date_new(y: i64, m: i64, d: i64) -> Date { Date { y: y, m: m, d: d } }

fn date_to_days(dt: Date) -> i64 { days_from_civil(dt.y, dt.m, dt.d) }

/// Days between two dates: `to - from`. Negative when `to` precedes `from`.
fn date_diff_days(from: Date, to: Date) -> i64 {
    date_to_days(to) - date_to_days(from)
}

fn date_add_days(dt: Date, n: i64) -> Date {
    civil_from_days(date_to_days(dt) + n)
}

/// 0 = Sunday .. 6 = Saturday. 1970-01-01 was a Thursday, hence the +4.
/// The extra `+ 7) % 7` is not redundant: `%` truncates, so a negative day
/// number (a pre-epoch date) would otherwise give a negative weekday.
fn date_weekday(dt: Date) -> i64 {
    let z = date_to_days(dt)
    ((z + 4) % 7 + 7) % 7
}

fn date_is_leap(y: i64) -> bool {
    if y % 4 != 0 { false } else { if y % 100 != 0 { true } else { y % 400 == 0 } }
}

fn date_days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        if date_is_leap(y) { 29 } else { 28 }
    } else {
        if m == 4 || m == 6 || m == 9 || m == 11 { 30 } else { 31 }
    }
}

/// The UTC date for a millisecond timestamp. Floor division again: a negative
/// timestamp (before 1970) must round DOWN to the earlier day, and truncation
/// would round it toward the epoch instead — off by one for every pre-1970 time.
fn date_from_ms(ms: i64) -> Date {
    let day_ms = 86400000
    let days = if ms >= 0 { ms / day_ms } else { (ms - (day_ms - 1)) / day_ms }
    civil_from_days(days)
}

fn date_today() -> Date { date_from_ms(now_ms()) }

/// ISO-8601 `YYYY-MM-DD`, zero-padded so the output sorts lexicographically.
fn date_to_iso(dt: Date) -> str {
    let mm = if dt.m < 10 { "0{to_str(dt.m)}" } else { to_str(dt.m) }
    let dd = if dt.d < 10 { "0{to_str(dt.d)}" } else { to_str(dt.d) }
    "{to_str(dt.y)}-{mm}-{dd}"
}

// ── Tests ────────────────────────────────────────────────────────────────────

@[test]
fn test_the_measured_task() {
    // The tasks_hard `datetime` task: days from 2020-01-01 to 2021-01-01. 2020 is
    // a leap year, so 366 — the case that previously passed only because the
    // model hand-rolled leap-year logic correctly.
    assert_eq(date_diff_days(date_new(2020, 1, 1), date_new(2021, 1, 1)), 366)
    assert_eq(date_diff_days(date_new(2021, 1, 1), date_new(2022, 1, 1)), 365)
}

@[test]
fn test_pre_epoch_round_trip() {
    // THE floor-division test. Replace any era branch with a plain `/` and this
    // fails: pre-epoch day numbers are negative.
    let moon = date_new(1969, 7, 20)
    let rt = civil_from_days(date_to_days(moon))
    assert_eq(rt.y, 1969)
    assert_eq(rt.m, 7)
    assert_eq(rt.d, 20)
    assert(date_to_days(moon) < 0)
    // 1600 also round-trips (a leap year divisible by 400).
    let old = date_new(1600, 2, 29)
    let rt2 = civil_from_days(date_to_days(old))
    assert_eq(rt2.y, 1600)
    assert_eq(rt2.m, 2)
    assert_eq(rt2.d, 29)
}

@[test]
fn test_floor_division_for_proleptic_years() {
    // THE floor-division test — and the premise matters, which I got wrong once.
    //
    // A 1969 date does NOT exercise the era branches: `ys` is 1969 (positive) and
    // `z` is ~719303 (positive), so truncating and flooring agree and a mutation
    // to plain `/` survives every pre-epoch test. The branches only diverge when
    // the shifted year `ys` or the shifted day `z` goes NEGATIVE, which needs a
    // year at or below 0 in the proleptic calendar.
    //
    // Year 0 with month <= 2 makes `ys` = -1: the smallest input that reaches the
    // else-branch at all.
    let y0 = date_new(0, 1, 1)
    let rt0 = civil_from_days(date_to_days(y0))
    assert_eq(rt0.y, 0)
    assert_eq(rt0.m, 1)
    assert_eq(rt0.d, 1)

    // Further back, where `z` also goes negative and the second branch matters.
    let bc = date_new(0 - 500, 3, 15)
    let rtb = civil_from_days(date_to_days(bc))
    assert_eq(rtb.y, 0 - 500)
    assert_eq(rtb.m, 3)
    assert_eq(rtb.d, 15)

    // A known anchor: 0000-03-01 is exactly -719468 days from the epoch under
    // Hinnant's shift, so any drift in the era arithmetic moves this number.
    assert_eq(days_from_civil(0, 3, 1), 0 - 719468)

    // Monotonicity across the boundary: consecutive days must differ by exactly 1
    // even where the era branch flips.
    assert_eq(days_from_civil(0, 1, 1) - days_from_civil(0 - 1, 12, 31), 1)
}

@[test]
fn test_epoch_and_weekday() {
    assert_eq(date_to_days(date_new(1970, 1, 1)), 0)
    // 1970-01-01 was a Thursday = 4.
    assert_eq(date_weekday(date_new(1970, 1, 1)), 4)
    // A pre-epoch weekday must not come back negative.
    assert(date_weekday(date_new(1969, 7, 20)) >= 0)
    assert(date_weekday(date_new(1969, 7, 20)) <= 6)
}

@[test]
fn test_leap_years_and_month_lengths() {
    assert(date_is_leap(2000))       // divisible by 400
    assert(!date_is_leap(1900))      // divisible by 100 but not 400
    assert(date_is_leap(2024))
    assert(!date_is_leap(2023))
    assert_eq(date_days_in_month(2024, 2), 29)
    assert_eq(date_days_in_month(2023, 2), 28)
    assert_eq(date_days_in_month(2023, 4), 30)
    assert_eq(date_days_in_month(2023, 12), 31)
}

@[test]
fn test_add_days_across_boundaries() {
    // Across a month end, a year end, and a leap day.
    let a = date_add_days(date_new(2023, 1, 31), 1)
    assert_eq(a.m, 2)
    assert_eq(a.d, 1)
    let b = date_add_days(date_new(2023, 12, 31), 1)
    assert_eq(b.y, 2024)
    assert_eq(b.m, 1)
    let c = date_add_days(date_new(2024, 2, 28), 1)
    assert_eq(c.d, 29)   // 2024 is a leap year
    // Subtraction is the same operation with a negative argument.
    let d = date_add_days(date_new(2024, 1, 1), 0 - 1)
    assert_eq(d.y, 2023)
    assert_eq(d.m, 12)
    assert_eq(d.d, 31)
}

@[test]
fn test_from_ms_floors_for_negative_timestamps() {
    assert(str_eq(date_to_iso(date_from_ms(0)), "1970-01-01"))
    // One millisecond BEFORE the epoch is 1969-12-31, not 1970-01-01. Truncating
    // division rounds toward zero and gets this wrong.
    assert(str_eq(date_to_iso(date_from_ms(0 - 1)), "1969-12-31"))
    // Late in a day still resolves to that day.
    assert(str_eq(date_to_iso(date_from_ms(86400000 - 1)), "1970-01-01"))
    assert(str_eq(date_to_iso(date_from_ms(86400000)), "1970-01-02"))
}

@[test]
fn test_iso_is_zero_padded_and_sorts() {
    assert(str_eq(date_to_iso(date_new(2024, 3, 7)), "2024-03-07"))
    assert(str_eq(date_to_iso(date_new(2024, 12, 25)), "2024-12-25"))
    // Zero padding is what makes lexicographic order match chronological order.
    assert(str_lt_helper(date_to_iso(date_new(2024, 3, 7)), date_to_iso(date_new(2024, 12, 25))))
}

/// `str <` is not an operator, so compare character by character.
fn str_lt_helper(a: str, b: str) -> bool {
    let n = if str_len(a) < str_len(b) { str_len(a) } else { str_len(b) }
    let i = 0
    let out = false
    let decided = false
    while i < n {
        if !decided {
            let ca = char_at(a, i)
            let cb = char_at(b, i)
            if ca != cb {
                out = ca < cb
                decided = true
            }
        }
        i = i + 1
    }
    if decided { out } else { str_len(a) < str_len(b) }
}

fn main() -> i64 {
    println(date_to_iso(date_new(2020, 1, 1)))
    println(to_str(date_diff_days(date_new(2020, 1, 1), date_new(2021, 1, 1))))
    println(date_to_iso(date_add_days(date_new(2024, 2, 28), 1)))
    println(to_str(date_weekday(date_new(1970, 1, 1))))
    0
}
