{
  "schema": "axon-gate-lanes/1",
  "about": "The gate's stages as the lane sees them (tasks/gate-lane-spec.md GL-2). Hand-edited; holds only what cannot be derived. Units come from `cargo metadata`, `needs` from the read-set audit. `scripts/gate_lane.py check` fails when a gate.sh stage, par stage or manifest crate has no row, a row names a vanished one, or a build/split command differs from gate.sh's text.",
  "par": [
    "VISION.md focus",
    "artifact admission",
    "cortex v0.15 package",
    "cortex v0.22 package",
    "cargo fmt --all --check",
    "no wildcard CORS",
    "no nested package roots",
    "v0.22 protected readiness",
    "v0.22 PSV negative matrix",
    "post-C9 hardening spec traceability",
    "opkit_ns_drift",
    "opkit_ns_drift selftest",
    "v0.22 protected refusal-site coverage",
    "v0.22 re-survey and value survey",
    "v0.22 release-claim separation",
    "benchmark docs",
    "analyser selftest",
    "cortex scorecard",
    "cortex repair-path receipt",
    "protected benchmark sets",
    "completeness manifest",
    "gate lane self-test",
    "G01 mutation anchors",
    "harness skip rules/shapes"
  ],
  "stages": [
    {"id": "S01", "banner": "managed-run supervision", "class": "always"},
    {"id": "S02", "banner": "cortex policy boundary tests", "class": "selectable", "split": "per-target",
     "split_cmd": "cargo test --locked -p axon-cortex -p cortex-policy-adapter -p axon-reflex"},
    {"id": "S03", "banner": "v0.22 closed-loop crate tests", "class": "selectable", "split": "per-target",
     "split_cmd": "cargo test --locked -p axon-loop-contracts -p axon-loop -p axon-fabric"},
    {"id": "S04", "banner": "cortex fence sweep (R1f)", "class": "selectable", "split": "none"},
    {"id": "S04H", "banner": "hardset build.py --check", "class": "selectable", "split": "none"},
    {"id": "S05", "banner": "v0.22 Stage-5 executed gates", "class": "selectable", "split": "none",
     "compile": "workspace"},
    {"id": "S06", "banner": "v0.22 PCI surfaces", "class": "selectable", "split": "none", "compile": "workspace"},
    {"id": "S07", "banner": "v0.22 trust-root preflight (inline, or its background start)", "class": "selectable",
     "split": "none", "compile": "workspace"},
    {"id": "S08", "banner": "v0.22 PSV real-guest boot", "class": "selectable", "split": "none"},
    {"id": "S09", "banner": "cortex ai-generator lint + tests", "class": "selectable", "split": "per-target",
     "split_cmd": "cargo test --locked -p axon-cortex --features ai", "lint_unit": true},
    {"id": "S10", "banner": "gate_verdict_is_read", "class": "selectable", "split": "none"},
    {"id": "S11", "banner": "native codegen build", "class": "selectable", "split": "none"},
    {"id": "S12", "banner": "serde-json feature builds + tests", "class": "selectable", "split": "none"},
    {"id": "S13", "banner": "lib clippy", "class": "selectable", "split": "none"},
    {"id": "S14", "banner": "runtime-crate clippy", "class": "selectable", "split": "none"},
    {"id": "S15", "banner": "clippy coverage", "class": "always"},
    {"id": "S16", "banner": "axon-core tests", "class": "selectable", "split": "per-target",
     "split_cmd": "cargo test --locked -p axon-core --no-default-features"},
    {"id": "S17", "banner": "codegen rebuild", "class": "selectable", "split": "none", "iff": "S16"},
    {"id": "S22", "banner": "vm parity (tree vs VM)", "class": "selectable", "split": "none"},
    {"id": "S19", "banner": "lockfile", "class": "always"},
    {"id": "S20", "banner": "required crate verification (manifest)", "class": "selectable", "split": "per-target",
     "split_cmd": "manifest",
     "crates": ["axon-ai", "axon-attest", "axon-audit", "axon-certcheck", "axon-cortex", "axon-domain",
                "axon-fabric", "axon-guest-init", "axon-intent", "axon-jobctl", "axon-ledger",
                "axon-loop", "axon-loop-contracts", "axon-os", "axon-psv", "axon-reflex", "axon-rt", "axon-rt-ai",
                "axon-signal", "axon-surface", "axon-vm", "axon-wasm", "axon-web", "axon-workspace-recipe",
                "cortex-policy-adapter"]},
    {"id": "S21", "banner": "v0.22 Stage-5 verification profile", "class": "profile-only"}
  ],
  "builds": [
    {"id": "B1", "stage": "S02", "cmd": "cargo build --locked -q -p axon-core --no-default-features --bin axon"},
    {"id": "B2", "stage": "S03", "cmd": "cargo build --locked -q -p axon-cortex --bins"},
    {"id": "B3", "stage": "S07", "cmd": "cargo build -q -p axon-fabric --bins"},
    {"id": "B4", "stage": "S08", "cmd": "cargo build -q -p axon-psv --example psv_dev"},
    {"id": "B5", "stage": "S11", "cmd": "cargo build --locked -p axon-core"},
    {"id": "B6", "stage": "S17", "cmd": "cargo build --locked -q -p axon-core --bin axon"},
    {"id": "B7", "stage": "S22", "cmd": "cargo build --locked -q --release -p axon-core --no-default-features --bin axon"}
  ]
}
