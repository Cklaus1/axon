+/// SPIKE (CE-9 C): read the whole program from an inherited descriptor. The fd
+/// is consumed (closed after the read) so the program cannot reach it later.
+#[cfg(unix)]
+fn read_source_fd(fd: i32) -> String {
+    use std::io::Read;
+    use std::os::fd::FromRawFd;
+    if fd < 3 {
+        eprintln!("error: --source-fd {fd}: stdin/stdout/stderr cannot carry the program");
+        process::exit(1);
+    }
+    // SAFETY: the fd is the caller's (the supervisor opened it for us); we take
+    // ownership and close it on drop. An fd that is not open fails the read.
+    let mut f = unsafe { std::fs::File::from_raw_fd(fd) };
+    let mut s = String::new();
+    if let Err(e) = f.read_to_string(&mut s) {
+        eprintln!("error reading --source-fd {fd}: {e}");
+        process::exit(1);
+    }
+    s
+}
+
+#[cfg(not(unix))]
+fn read_source_fd(fd: i32) -> String {
+    eprintln!("error: --source-fd {fd} is supported on unix only");
+    process::exit(1);
+}
